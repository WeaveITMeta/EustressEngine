  {
   "name": "an empty 4-thread machine",
   "rust_test": "four_threads_hold_exactly_four_occupied_60_hz_sessions",
   "fn": "capacity",
   "machine": {
    "id": "m",
    "threads": 4,
    "memory_mb": 16384,
    "region": "us-east-1",
    "draining": false,
    "sessions": []
   },
   "expect": {
    "committed_cap_millis": 3200,
    "committed_millis": 0,
    "activation_cap_millis": 3600,
    "activation_millis": 0,
    "memory_cap_mb": 13107,
    "memory_used_mb": 0,
    "sessions": 0,
    "occupied_room": 4,
    "warm_room": 4
   }
  },
