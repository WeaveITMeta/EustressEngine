# Logs
*.log
# Engine stderr captures from the measurement rig. `*.log` above does not
# match these: the extension is `.err`, not `.log`.
*.log.err

# Profiler output written to the workspace root by the measurement rig. Two of
# these were committed once and removed; the rule stops them coming back.
eustress/eustress_profile*.txt
eustress/eustress_profile*.svg

# Editor/tool backup copies. A `.bak` beside a source file is a working
# artifact, never the version anything should build from.
*.bak

# Blender source files and their autosave siblings. The rigged bodies are
# authored in Blender and exported to the tracked .glb beside them; the .blend
# is the editable source, rewrites in full on every save (tens of MB each), and
# this repo has no LFS. Keep it locally or in the Voltec workspace.
*.blend
*.blend1
*.blend@

# QA output from the character pipeline: detail renders, pose bounds, build and
# validation logs. Generated by the scripts under assets/characters/scripts/.
eustress/crates/common/assets/characters/voltec_review/

# Mirror of the runtime avatar assets for the website, written in full by
# assets/characters/scripts/sync_web_avatars.py (the GLBs and rigs.json). A
# second copy of a 40 MB model has no business in history; run the sync at
# build time instead.
eustress/crates/web/assets/characters/
logs/

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# Tauri
src-tauri/target/

# WASM
*.wasm
pkg/

