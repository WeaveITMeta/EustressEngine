incremental/
**/incremental/

# Debug artifacts
**/debug/
**/deps/*.d
**/deps/*.rlib
**/deps/*.rmeta
infrastructure/cloudflare/api/.wrangler/
# Miniflare local state (R2/KV/D1 emulation) written wherever wrangler is run
# from, not only under the api worker. SQLite plus its -shm/-wal siblings.
.wrangler/
**/.wrangler/

# Local-only: founder/ops planning + one-off recovery tooling.
# This repo is PUBLIC — these must never be pushed.
LAUNCH_PLAN.md
WEEK_PLAN.md
recover_trashed_spaces.ps1

# Accidental in-tree wgpu clone. It has its own .git, so git recorded it
# as a phantom gitlink (mode 160000) with no matching .gitmodules entry —
# that is the CI "fatal: No url found for submodule path
# 'eustress/.patches/wgpu-fresh'" / git exit-128 checkout annotation. It
# is NOT referenced by any [patch] (only gpu-allocator-fresh is). Ignored
# so the untracked local copy never re-enters the index after we drop the
# gitlink.
eustress/.patches/wgpu-fresh/

# Claude Code session state (worktrees, scheduled-task locks). Contains
# full stale repo copies — must never be published to the public repo.
.claude/
.default_universe
.trunk-web-target/
target-verify/
**/target-verify/

# Cargo target tree used by the data-platform test harness. Same class as the
# `target-*` siblings above: a build directory that was never listed, so it
# surfaced as untracked build output at commit time.
.data-test-target/
**/.data-test-target/

# LSP/type-check target tree. Two of its files were committed before this rule
# existed; they are removed in the same commit that adds it.
target-lsp-check/
**/target-lsp-check/

# Published Claude Design canvas bundles. The artboards (`*.dc.html`) and
# `canvas.json` beside them ARE the source and are tracked; this is the
# self-contained export with the whole editor inlined, ~2.3 MB per publish and
# regenerable from the artboards. Keeping it out of history avoids permanent
# repo bloat on every redeploy.
design/*-flow.html
.export-demo/
