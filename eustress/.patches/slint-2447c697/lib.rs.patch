 type PhysicalRect = euclid::Rect<i16, PhysicalPx>;
 type PhysicalSize = euclid::Size2D<i16, PhysicalPx>;
 type PhysicalPoint = euclid::Point2D<i16, PhysicalPx>;
+
+// EUSTRESS PATCH (.patches/slint-2447c697/PATCH.md): whether a value or a
+// rectangle survives the conversion to the i16 pixel space above. NaN does not.
+fn fits_i16(v: f32) -> bool {
+    v > i16::MIN as f32 && v < i16::MAX as f32
+}
+
+fn fits_i16_rect(r: &euclid::Rect<f32, PhysicalPx>) -> bool {
+    fits_i16(r.min_x())
+        && fits_i16(r.min_y())
+        && fits_i16(r.max_x())
+        && fits_i16(r.max_y())
+        && fits_i16(r.width())
+        && fits_i16(r.height())
+}
