# Cloudflare Pages response headers for eustress.dev
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), payment=(self), usb=(), interest-cohort=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.eustress.dev https://api-staging.eustress.dev https://downloads.eustress.dev https://simulations.eustress.dev https://witness.eustress.dev https://1.1.1.1; worker-src 'self' blob:; manifest-src 'self'

# The Economics page is unlisted: it stays out of search results until it is listed.
/economics
  X-Robots-Tag: noindex, nofollow

# The internal draft model (built only with the `economics-draft` feature) is never listed.
/economics-draft
  X-Robots-Tag: noindex, nofollow

# The legal act pages stay out of search results until McKale approves their text.
/legal/*
  X-Robots-Tag: noindex, nofollow

# A case's status and a person's case history are nobody's search result.
/cases/*
  X-Robots-Tag: noindex, nofollow
/account/cases
  X-Robots-Tag: noindex, nofollow

# The page that verifies one signed-in account is nobody's search result.
/verify-account
  X-Robots-Tag: noindex, nofollow
