// ============================================================================
// Eustress Engine - Forge Connect Dialog
// Connect to Forge cloud infrastructure
//
// Chrome: DialogScrim > DialogCard > DialogFooter (DRAFTING_UX.md Law 1).
// Status and errors are KitNotices (Law 6). Escape, the close button, Cancel
// and an outside click all close it.
// ============================================================================

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSwitch, KitSectionLabel, KitNotice, SettingsGroup, SettingRow } from "dialog_kit.slint";

// A labelled text field with a hint under it.
component ForgeField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint: "";
    in-out property <string> text;
    in property <bool> password: false;

    spacing: 4px;

    HorizontalLayout {
        spacing: 12px;
        Text {
            width: 84px;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            background: Theme.input-background;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: edit.has-focus ? Theme.accent-cyan : Theme.input-border;

            edit := LineEdit {
                width: 100%;
                height: 100%;
                text <=> root.text;
                input-type: root.password ? InputType.password : InputType.text;
            }
        }
    }

    if root.hint != "": HorizontalLayout {
        padding-left: 96px;
        Text {
            text: root.hint;
            color: Theme.text-disabled;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
    }
}

export component ForgeConnectDialog inherits Rectangle {
    in-out property <string> server-url: "https://forge.eustress.dev";
    in-out property <string> api-key: "";
    in-out property <bool> remember-credentials: true;
    in property <bool> connecting: false;
    in property <string> status-message: "";
    in property <string> error-message: "";

    callback on-connect();
    callback on-close();

    width: 100%;
    height: 100%;
    background: transparent;

    // Escape closes. Other keys pass through as before.
    keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.on-close();
                return accept;
            }
            return reject;
        }

        DialogScrim {
            dismiss => { root.on-close(); }

            DialogCard {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 480px;
                height: min(body.preferred-height + footer.preferred-height + 45px, parent.height - 40px);
                icon: @image-url("../../assets/icons/ui/server.svg");
                title: "Connect to Forge";
                subtitle: "Hosting and autoscaling for multiplayer servers";
                close => { root.on-close(); }

                // ── Content ──
                body := VerticalLayout {
                    vertical-stretch: 1;
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            padding-left: 2px;
                            KitSectionLabel { text: "CONNECTION"; }
                        }

                        ForgeField {
                            label: "Server URL";
                            text <=> root.server-url;
                            hint: "The Forge server that hosts and scales your multiplayer sessions.";
                        }

                        ForgeField {
                            label: "API key";
                            text <=> root.api-key;
                            password: true;
                            hint: "Sent only to the Forge server above.";
                        }
                    }

                    SettingsGroup {
                        title: "OPTIONS";

                        SettingRow {
                            label: "Remember credentials";
                            description: "Keep the URL and key on this computer for next time";
                            divider: false;
                            KitSwitch { checked <=> root.remember-credentials; }
                        }
                    }

                    // Status
                    if root.status-message != "": KitNotice {
                        kind: "info";
                        text: root.status-message;
                    }

                    // Error
                    if root.error-message != "": KitNotice {
                        kind: "error";
                        text: root.error-message;
                    }
                }

                // ── Footer ──
                footer := DialogFooter {
                    KitButton {
                        text: "Cancel";
                        clicked => { root.on-close(); }
                    }

                    KitButton {
                        text: root.connecting ? "Connecting..." : "Connect";
                        kind: "primary";
                        enabled: !root.connecting;
                        clicked => { root.on-connect(); }
                    }
                }
            }
        }
    }
}
