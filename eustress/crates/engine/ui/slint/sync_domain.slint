// ============================================================================
// Eustress Engine Studio - Sync Domain Modal
// Sync domain data to object types
// ============================================================================
//
// CONTRACT (read this before binding the dialog in main.slint)
//
//   Seeds (`in`)      the caller pushes the starting state in:
//                     `available-domains`, `available-fields`,
//                     `initial-spacing-x/y/z`, `preview-status`, `busy`.
//   Live state (`out` / `in-out`)
//                     the caller reads the user's answers back out when a
//                     callback fires: `selected-domain`, `target-class`,
//                     `layout`, `spacing-x/y/z`, `name-field`, `color-field`,
//                     `show-billboard`, `billboard-field`.
//   Callbacks         `on-preview()`, `on-sync()`, `on-close()`. All three
//                     are argument-free on purpose: the handler reads the
//                     live properties off `self`, exactly the way the
//                     StressTestDialog block already does.
//
// Spacing deserves a note, because getting it wrong is what broke this dialog
// before. `spacing-x/y/z` are DERIVED out-properties: each one parses the text
// currently sitting in its LineEdit. That means
//   * a typed value is live the instant it is typed; there is no commit step,
//     so clicking Sync straight after typing cannot lose the keystrokes, and
//   * nothing ever writes back into the LineEdit while the user types, so the
//     caret never jumps mid-entry.
// To seed a different starting spacing, set `initial-spacing-x/y/z`; those are
// plain `in` properties and re-seeding them replaces whatever is in the field.
//
// Chrome is the shared dialog kit (DRAFTING_UX.md Law 1): DialogScrim >
// DialogCard > DialogFooter, with the form in SettingsGroups.
// ============================================================================

import { LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSwitch, KitSectionLabel, SettingsGroup, SettingRow, KitNotice } from "dialog_kit.slint";

// One spacing axis. The LineEdit's text is the single source of truth: the
// parent reads `value` (a live parse of that text) rather than pushing a
// number back in, which is what keeps the caret still while typing.
component SpacingField inherits Rectangle {
    in property <string> axis: "X";
    in property <color> axis-color: Theme.text-secondary;
    in property <float> seed: 0.0;

    // Live parse of whatever the user has typed. `to-float()` yields 0 for a
    // blank field, which is why `blank` below is surfaced separately instead
    // of letting an empty box masquerade as a deliberate zero.
    out property <float> value: edit.text.to-float();
    out property <bool> blank: edit.text == "";
    out property <bool> editing: edit.has-focus;

    // No `changed()` callback on purpose: `value` re-derives from the
    // LineEdit on every keystroke, so there is nothing for a listener to do
    // that reading `value` does not already do.

    height: 28px;

    HorizontalLayout {
        spacing: 6px;

        Text {
            width: 10px;
            text: root.axis;
            color: root.axis-color;
            font-size: Theme.font-sm;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 64px;
            height: 28px;
            background: Theme.input-background;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            // A blank axis blocks Sync, so it is an error and reads red.
            border-color: root.blank ? Theme.border-error
                        : edit.has-focus ? Theme.accent-cyan
                        : Theme.input-border;
            animate border-color { duration: Theme.panel-anim-duration-fast * Theme.motion-scale; }

            edit := LineEdit {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                // `decimal` keeps letters out of a field the parent parses as
                // a number, so the only invalid state left is "empty".
                input-type: decimal;
                text: root.seed;
            }
        }
    }
}

export component SyncDomainDialog inherits Rectangle {
    // ── Seeds ────────────────────────────────────────────────────────────
    in property <[string]> available-domains: [];
    in property <[string]> available-fields: [];
    in property <float> initial-spacing-x: 2.0;
    in property <float> initial-spacing-y: 0.0;
    in property <float> initial-spacing-z: 2.0;
    // Result of the last `on-preview()`, shown in the footer. Empty hides the
    // line, so a caller that never previews sees no dead UI.
    in property <string> preview-status: "";
    // True while the caller is mid-sync or mid-preview; greys the action row
    // so the same job cannot be fired twice.
    in property <bool> busy: false;

    // ── Live state the caller reads back ─────────────────────────────────
    in-out property <string> selected-domain: "";
    in-out property <string> target-class: "Part";
    in-out property <string> layout: "Grid";
    in-out property <string> name-field: "";
    in-out property <string> color-field: "";
    in-out property <bool> show-billboard: false;
    in-out property <string> billboard-field: "";

    // Derived from the spacing fields — see the header note.
    out property <float> spacing-x: sx.value;
    out property <float> spacing-y: sy.value;
    out property <float> spacing-z: sz.value;

    // A domain is the one genuinely required answer; everything else has a
    // usable default. Exposed so the caller can mirror the gate if it wants.
    out property <bool> can-sync: root.selected-domain != ""
        && !sx.blank && !sy.blank && !sz.blank
        && !root.busy;
    out property <bool> has-domains: root.available-domains.length > 0;

    // True while the caret sits in one of the spacing fields. The caller must
    // suppress the viewport Delete/Backspace shortcut while this is set, or
    // erasing a digit deletes the selected part instead of a character.
    out property <bool> text-input-focused: sx.editing || sy.editing || sz.editing;

    // ── Callbacks ────────────────────────────────────────────────────────
    // Fired when the user asks for a dry run. The handler should read the
    // live properties off `self`, place a throwaway preview in the scene, and
    // push a one-line summary back through `preview-status`.
    callback on-preview();
    // Fired on Sync. Same read-off-`self` contract as `on-preview`.
    callback on-sync();
    // Fired by the × button, the Cancel button, a click on the backdrop, and
    // Escape. The handler is expected to hide the dialog and clear any
    // preview it put in the scene.
    callback on-close();

    property <bool> has-fields: root.available-fields.length > 0;

    width: 100%;
    height: 100%;

    // Swallows keys so they cannot reach the Explorer or the viewport behind
    // the modal, and turns Escape into a close. Child inputs take focus when
    // clicked and keep receiving keys normally.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.on-close(); return accept; }
            return accept;
        }
        key-released(event) => { return accept; }
    }

    DialogScrim {
        dismiss => { root.on-close(); }

        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 550px;
            height: min(parent.height - 80px, 560px);
            icon: @image-url("../../assets/icons/ui/refresh.svg");
            title: "Sync domain to objects";
            subtitle: "Place one object in the scene for every record";
            close => { root.on-close(); }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;

                    // ── Source ──
                    // With no domains loaded there is nothing to choose, so
                    // say why rather than show an empty dropdown.
                    if !root.has-domains: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            padding-left: 2px;
                            KitSectionLabel { text: "Source"; }
                        }
                        KitNotice {
                            kind: "info";
                            text: "No domains yet. Import a dataset or connect a data source first.";
                        }
                    }

                    if root.has-domains: SettingsGroup {
                        title: "Source";

                        SettingRow {
                            label: "Domain";
                            description: "The records to place";
                            divider: false;
                            ComboBox {
                                width: 240px;
                                model: root.available-domains;
                                current-value <=> root.selected-domain;
                            }
                        }
                    }

                    // ── Target ──
                    SettingsGroup {
                        title: "Target";

                        SettingRow {
                            label: "Class";
                            description: "What each record becomes";
                            divider: false;
                            ComboBox {
                                width: 240px;
                                model: ["Part", "SpherePart", "CylinderPart", "Model"];
                                current-value <=> root.target-class;
                            }
                        }

                        SettingRow {
                            label: "Layout";
                            description: "How the objects are arranged";
                            ComboBox {
                                width: 240px;
                                model: ["Grid", "Line", "Circle", "Random"];
                                current-value <=> root.layout;
                            }
                        }

                        SettingRow {
                            label: "Spacing";
                            description: "Gap between neighbours on each axis";

                            sx := SpacingField {
                                axis: "X";
                                axis-color: Theme.gizmo-x;
                                seed: root.initial-spacing-x;
                            }

                            sy := SpacingField {
                                axis: "Y";
                                axis-color: Theme.gizmo-y;
                                seed: root.initial-spacing-y;
                            }

                            sz := SpacingField {
                                axis: "Z";
                                axis-color: Theme.gizmo-z;
                                seed: root.initial-spacing-z;
                            }
                        }
                    }

                    if sx.blank || sy.blank || sz.blank: KitNotice {
                        kind: "error";
                        text: "Spacing needs a number on every axis.";
                    }

                    // ── Field mappings ──
                    SettingsGroup {
                        title: "Field mappings";

                        if root.has-fields: SettingRow {
                            label: "Name field";
                            description: "Names each object";
                            divider: false;
                            ComboBox {
                                width: 240px;
                                model: root.available-fields;
                                current-value <=> root.name-field;
                            }
                        }

                        if root.has-fields: SettingRow {
                            label: "Color field";
                            description: "Tints each object";
                            ComboBox {
                                width: 240px;
                                model: root.available-fields;
                                current-value <=> root.color-field;
                            }
                        }

                        SettingRow {
                            label: "Billboard labels";
                            description: root.has-fields ? "Float a label over each object" : "Needs a domain with fields";
                            divider: root.has-fields;
                            KitSwitch {
                                checked <=> root.show-billboard;
                                enabled: root.has-fields;
                            }
                        }

                        if root.show-billboard && root.has-fields: SettingRow {
                            label: "Label field";
                            description: "The text each label shows";
                            ComboBox {
                                width: 240px;
                                model: root.available-fields;
                                current-value <=> root.billboard-field;
                            }
                        }
                    }

                    if !root.has-fields: KitNotice {
                        kind: "info";
                        text: "The selected domain has no fields to map.";
                    }
                }
            }

            // Where the answer from `on-preview()` lands, pinned above the
            // footer so it is visible without scrolling. Without it the
            // Preview button would have nowhere to report to.
            if root.preview-status != "": HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 4px;
                padding-bottom: 10px;
                KitNotice {
                    kind: "info";
                    text: root.preview-status;
                }
            }

            // ── Footer ──
            DialogFooter {
                KitButton {
                    text: "Preview";
                    has-icon: true;
                    icon: @image-url("../../assets/icons/ui/eye.svg");
                    enabled: root.can-sync;
                    clicked => { root.on-preview(); }
                }

                KitButton {
                    text: "Cancel";
                    clicked => { root.on-close(); }
                }

                KitButton {
                    kind: "primary";
                    text: root.busy ? "Syncing…" : "Sync";
                    has-icon: true;
                    icon: @image-url("../../assets/icons/ui/refresh.svg");
                    enabled: root.can-sync;
                    clicked => { root.on-sync(); }
                }
            }
        }
    }
}
