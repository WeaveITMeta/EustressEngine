// ============================================================================
// Eustress Engine Studio - Asset Manager Panel
// Browse Universe-level and Space-level assets in a hierarchy tree
//
// A docked panel in the left tab strip, not a modal. Its controls follow the
// dialog kit: KitButton for Import, a segmented category switch in the
// KitSegmented style, and the selection cyan for the selected row
// (DRAFTING_UX.md Law 3).
// ============================================================================

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { KitButton, KitDivider } from "dialog_kit.slint";

// A node in the asset tree (section headers, folders, and individual files)
export struct AssetNode {
    id: int,
    name: string,
    icon: image,
    asset-type: string,  // "section" | "folder" | "mesh" | "texture" | "audio" | "material" | "script" | "font"
    depth: int,
    expandable: bool,
    expanded: bool,
    selected: bool,
    size: string,
    path: string,
}

// One category in the segmented switch, drawn like a KitSegmented option.
// Driven by the category name Rust pushes, so a change from Rust always
// shows.
component CategoryTab inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 1;
    border-radius: Theme.radius-sm - 1px;
    min-width: tab-text.preferred-width + 12px;
    background: root.active ? Theme.accent-cyan.with-alpha(0.2)
        : tab-touch.has-hover ? Theme.button-hover : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.accent-cyan.with-alpha(0.6);

    tab-text := Text {
        text: root.label;
        color: root.active ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-sm;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Single row in the asset tree
component AssetTreeRow inherits Rectangle {
    in property <string> name: "";
    in property <image> icon;
    in property <string> asset-type: "";
    in property <int> depth: 0;
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    in property <bool> selected: false;
    in property <string> size: "";

    callback clicked();
    callback toggle-expand();
    callback context-menu();
    // Double-click on a leaf (non-expandable) row: the host decides what to do
    // based on asset-type (media opens the radial import chooser, a script the editor).
    callback double-clicked();

    property <bool> section: root.asset-type == "section";

    height: root.section ? 28px : 24px;
    background: root.selected ? Theme.accent-cyan.with-alpha(0.14) :
                row-touch.has-hover ? Theme.explorer-item-hover : transparent;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => {
            if root.expandable {
                root.toggle-expand();
            } else {
                root.double-clicked();
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                root.context-menu();
            }
        }
    }

    // The selection bar on the left edge.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent-cyan;
    }

    HorizontalLayout {
        padding-left: 8px + root.depth * 16px;
        padding-right: 10px;
        spacing: 5px;

        // Expand/collapse arrow
        if root.expandable: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                background: expand-touch.has-hover ? Theme.button-hover : transparent;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    source: root.expanded ? @image-url("../../assets/icons/ui/chevron-down.svg") : @image-url("../../assets/icons/ui/chevron-right.svg");
                    image-fit: contain;
                    colorize: Theme.text-secondary;
                }

                expand-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-expand(); }
                }
            }
        }
        if !root.expandable: Rectangle {
            width: 14px;
        }

        // Icon
        VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                image-fit: contain;
            }
        }

        // Name
        Text {
            text: root.name;
            color: root.section ? Theme.text-primary :
                   root.selected ? Theme.text-primary : Theme.text-primary.with-alpha(0.88);
            font-size: root.section ? 12px : 11px;
            font-weight: root.section ? 700 : root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Size badge (right-aligned)
        if root.size != "": Text {
            text: root.size;
            color: Theme.text-disabled;
            font-size: Theme.font-xs;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component AssetManager inherits Rectangle {
    // Tree data — populated by Rust backend
    in property <[AssetNode]> asset-nodes: [];
    in property <string> current-category: "All";
    in-out property <string> search-text: "";
    in property <int> universe-asset-count: 0;
    in property <int> space-asset-count: 0;

    // Callbacks
    callback on-select-asset(int);
    callback on-expand-asset(int);
    callback on-import-asset(string);
    callback on-search-changed(string);
    callback on-category-changed(string);
    callback on-open-asset(int);
    // Double-click on a leaf asset: (id, asset-type, universe-relative path).
    // Rust routes image/video → radial import chooser.
    callback on-open-media(int, string, string);

    background: Theme.panel-background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Toolbar: Search + Import
        Rectangle {
            height: 40px;
            clip: true;
            background: Theme.header-background;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 14px;
                        height: 14px;
                        source: @image-url("../../assets/icons/ui/search.svg");
                        image-fit: contain;
                        colorize: Theme.text-secondary;
                    }
                }

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Search assets";
                    text <=> root.search-text;
                    edited(text) => { root.on-search-changed(text); }
                }

                KitButton {
                    text: "Import";
                    kind: "primary";
                    has-icon: true;
                    icon: @image-url("../../assets/icons/ui/import.svg");
                    clicked => { root.on-import-asset(""); }
                }
            }
        }

        // Category filter: one segmented switch
        Rectangle {
            height: 36px;
            background: Theme.background-secondary;

            Rectangle {
                x: 8px;
                y: 5px;
                width: parent.width - 16px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: Theme.input-background;
                border-width: 1px;
                border-color: Theme.input-border;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    CategoryTab { label: "All"; active: root.current-category == "All"; clicked => { root.on-category-changed("All"); } }
                    CategoryTab { label: "Meshes"; active: root.current-category == "Meshes"; clicked => { root.on-category-changed("Meshes"); } }
                    CategoryTab { label: "Textures"; active: root.current-category == "Textures"; clicked => { root.on-category-changed("Textures"); } }
                    CategoryTab { label: "Audio"; active: root.current-category == "Audio"; clicked => { root.on-category-changed("Audio"); } }
                    CategoryTab { label: "Scripts"; active: root.current-category == "Scripts"; clicked => { root.on-category-changed("Scripts"); } }
                }
            }
        }

        // Summary bar
        Rectangle {
            height: 24px;
            background: Theme.background-secondary;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 14px;
                alignment: start;

                Text {
                    text: "Universe " + root.universe-asset-count;
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                Text {
                    text: "Space " + root.space-asset-count;
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }
        }

        KitDivider { }

        // Asset tree or empty state
        if root.asset-nodes.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 6px;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        width: 40px;
                        height: 40px;
                        source: @image-url("../../assets/icons/ui/package.svg");
                        image-fit: contain;
                        colorize: Theme.text-disabled;
                    }
                }

                Text {
                    text: "No assets found";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Import assets or open a Space";
                    color: Theme.text-disabled;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                }
            }
        }

        if root.asset-nodes.length > 0: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 0px;

                for node[index] in root.asset-nodes: AssetTreeRow {
                    name: node.name;
                    icon: node.icon;
                    asset-type: node.asset-type;
                    depth: node.depth;
                    expandable: node.expandable;
                    expanded: node.expanded;
                    selected: node.selected;
                    size: node.size;
                    clicked => { root.on-select-asset(node.id); }
                    toggle-expand => { root.on-expand-asset(node.id); }
                    double-clicked => { root.on-open-media(node.id, node.asset-type, node.path); }
                    context-menu => { }
                }
            }
        }
    }
}
