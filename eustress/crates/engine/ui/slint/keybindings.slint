// ============================================================================
// Eustress Engine - Keyboard Shortcuts Dialog
//
// The row list is data-driven from Rust (`slint_ui::sync_keybindings_to_slint`
// builds it straight off the live `KeyBindings` resource), so what the dialog
// shows is what the engine will actually do; a hand-written row list drifts
// from the real bindings the moment anything is remapped.
//
// Clicking a row arms capture; the next chord replaces the binding. Esc backs
// out of capture without changing anything, and closes the dialog when
// nothing is being captured. Built on the shared dialog chrome
// (dialog_kit.slint): a capture in progress is the selection cyan.
// ============================================================================

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSegmented, KeyCap, KitNotice, KitSectionLabel, KitDivider } from "dialog_kit.slint";

/// One row of the dialog. Section headers and action rows share the model so
/// Rust owns the ordering and the Slint side is a straight `for`.
export struct ShortcutEntry {
    /// Stable id handed back on rebind — the Rust `Action::name()` string.
    /// Empty for section headers.
    action-id: string,
    /// Row label (action name) or, for a header row, the section title.
    label: string,
    /// Current chord, e.g. "Ctrl+Shift+S". Empty means unbound.
    chord: string,
    /// True for a section header row: no key cell, not clickable.
    is-section: bool,
}

component ShortcutRow inherits Rectangle {
    in property <string> action: "";
    in property <string> shortcut: "";
    /// This row is waiting for a chord: its keycap shows a prompt, outlined
    /// in the selection cyan, instead of the current binding.
    in property <bool> capturing: false;
    callback rebind-requested();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: root.capturing ? Theme.accent-cyan.with-alpha(0.08)
        : row-touch.has-hover ? Theme.explorer-item-hover : transparent;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.rebind-requested(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 12px;

        Text {
            horizontal-stretch: 1;
            text: root.action;
            color: Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.capturing: VerticalLayout {
            alignment: center;
            KeyCap {
                chord: "Press keys...";
                live: true;
            }
        }
        if !root.capturing && root.shortcut != "": VerticalLayout {
            alignment: center;
            KeyCap {
                chord: root.shortcut;
            }
        }
        if !root.capturing && root.shortcut == "": Text {
            text: "Not set";
            color: Theme.text-disabled;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
}

export component KeybindingsDialog inherits Rectangle {
    /// Every row, in render order. Built Rust-side from `KeyBindings`.
    in property <[ShortcutEntry]> entries: [];
    /// `action-id` of the row currently capturing a chord, "" when idle.
    /// In-out because the row click and the Esc key both set it locally, and
    /// Rust clears it once a rebind lands.
    in-out property <string> capturing-action: "";
    /// Rust-supplied error for the last rejected rebind — names the action
    /// that already owns the chord. Cleared on the next successful rebind.
    in property <string> conflict-message: "";
    /// "eustress", "roblox", or "custom" once any chord was rebound by hand.
    in property <string> active-preset: "";

    callback on-close();
    /// (action-id, chord) — chord is the human form, e.g. "Ctrl+Shift+K".
    /// Rust parses it back into a `KeyBinding` and validates for conflicts.
    callback on-rebind(string, string);
    /// Preset id from the preset row; Rust swaps the whole map and saves it.
    callback on-apply-preset(string);

    // Slint encodes special keys as private-use codepoints (`Key.F1`,
    // `Key.Delete`, …) that mean nothing outside Slint. Spell them out here
    // so the string crossing into Rust is one the chord parser can read;
    // ordinary characters pass through untouched.
    pure function key-token(t: string) -> string {
        return t == Key.F1 ? "F1"
             : t == Key.F2 ? "F2"
             : t == Key.F3 ? "F3"
             : t == Key.F4 ? "F4"
             : t == Key.F5 ? "F5"
             : t == Key.F6 ? "F6"
             : t == Key.F7 ? "F7"
             : t == Key.F8 ? "F8"
             : t == Key.F9 ? "F9"
             : t == Key.F10 ? "F10"
             : t == Key.F11 ? "F11"
             : t == Key.F12 ? "F12"
             : t == Key.Space ? "Space"
             : t == Key.Delete ? "Delete"
             : t == Key.Backspace ? "Backspace"
             : t == Key.Tab ? "Tab"
             // Shift+Tab arrives as its own code (0x19), which the Rust parser
             // would otherwise fold to "Ctrl+Y".
             : t == Key.Backtab ? "Tab"
             : t == Key.Return ? "Enter"
             : t == Key.UpArrow ? "Up"
             : t == Key.DownArrow ? "Down"
             : t == Key.LeftArrow ? "Left"
             : t == Key.RightArrow ? "Right"
             : t;
    }

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-close(); }

        DialogCard {
            width: min(parent.width - 48px, 600px);
            height: min(parent.height - 64px, 640px);
            icon: @image-url("../../assets/icons/ui/keyboard.svg");
            title: "Keyboard shortcuts";
            subtitle: "Click a shortcut, then press the new keys";
            close => { root.on-close(); }

            // One FocusScope wraps the whole body: whichever row armed
            // capture, the chord is caught here, so there is no per-row focus
            // juggling and no way for a keystroke to land on a row that is no
            // longer armed.
            capture := FocusScope {
                vertical-stretch: 1;
                key-pressed(event) => {
                    if (root.capturing-action == "") {
                        // Nothing armed: Esc closes, as in every dialog.
                        if (event.text == Key.Escape) {
                            root.on-close();
                            return accept;
                        }
                        return reject;
                    }
                    // A bare modifier is the first half of a chord — keep
                    // waiting for the key it modifies rather than binding
                    // "Ctrl" alone.
                    //
                    // The RIGHT-hand variants and the lock keys matter as much
                    // as the left ones: Slint reports every one of them as a
                    // C0 control character (ShiftR = 0x15, ControlR = 0x16,
                    // MetaR = 0x18, AltGr = 0x13, CapsLock = 0x14), and the Rust
                    // chord parser folds 0x01..0x1A back to A..Z on the
                    // assumption that a control character means Ctrl+letter.
                    // Letting them through would silently rebind the row to
                    // "Ctrl+U" / "Ctrl+V" / "Ctrl+T" the moment the user
                    // brushed right-Shift.
                    if (event.text == Key.Control || event.text == Key.Alt
                        || event.text == Key.Shift || event.text == Key.Meta
                        || event.text == Key.ControlR || event.text == Key.ShiftR
                        || event.text == Key.MetaR || event.text == Key.AltGr
                        || event.text == Key.CapsLock) {
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.capturing-action = "";
                        return accept;
                    }
                    root.on-rebind(root.capturing-action,
                        (event.modifiers.control ? "Ctrl+" : "")
                        + (event.modifiers.alt ? "Alt+" : "")
                        + (event.modifiers.shift ? "Shift+" : "")
                        + root.key-token(event.text));
                    return accept;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    // ── Preset: one click swaps the whole map ──
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 10px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            KitSectionLabel {
                                text: "PRESET";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            KitSegmented {
                                options: ["Eustress", "Mainstream"];
                                // Rust reports the preset back, "custom" included.
                                managed: true;
                                current-index: root.active-preset == "eustress" ? 0
                                    : root.active-preset == "roblox" ? 1 : -1;
                                selected(i) => {
                                    root.on-apply-preset(i == 0 ? "eustress" : "roblox");
                                }
                            }
                        }
                        if root.active-preset == "custom": VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Custom: edited by hand";
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    // ── Conflict: a rejected rebind names the action that
                    //    already owns the chord, right where the user looks ──
                    if root.conflict-message != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 10px;
                        KitNotice {
                            kind: "error";
                            text: root.conflict-message;
                        }
                    }

                    KitDivider { }

                    // ── The bindings ──
                    list := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: list.visible-width;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 12px;
                            spacing: 1px;
                            alignment: start;

                            for entry in root.entries: VerticalLayout {
                                spacing: 0;
                                if entry.is-section: HorizontalLayout {
                                    padding-left: 10px;
                                    padding-top: 14px;
                                    padding-bottom: 6px;
                                    KitSectionLabel {
                                        text: entry.label;
                                    }
                                }
                                if !entry.is-section: ShortcutRow {
                                    action: entry.label;
                                    shortcut: entry.chord;
                                    capturing: root.capturing-action == entry.action-id;
                                    rebind-requested => {
                                        root.capturing-action = entry.action-id;
                                        capture.focus();
                                    }
                                }
                            }
                        }
                    }

                    DialogFooter {
                        pack-end: false;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.capturing-action == ""
                                    ? "Changes save as you make them."
                                    : "Press the new keys, or Esc to keep the old ones.";
                                color: root.capturing-action == "" ? Theme.text-disabled : Theme.accent-cyan;
                                font-size: Theme.font-sm;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        KitButton {
                            text: "Done";
                            kind: "primary";
                            clicked => { root.on-close(); }
                        }
                    }
                }
            }
        }
    }
}
