// ============================================================================
// New Space Dialog: two-step creation, step 2
// Ask the user for the Space folder name (after the Universe is created).
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Enter creates, Escape cancels; Create waits for a name.
// ============================================================================

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton } from "dialog_kit.slint";

export component NewSpaceDialog inherits Rectangle {
    in property <string> universe-name: "";
    in-out property <string> space-name: "";

    callback on-create(/* space-name */ string);
    callback on-cancel();

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(400px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/new-file.svg");
            title: "New Space";
            subtitle: root.universe-name != "" ? "Step 2 of 2: first Space in " + root.universe-name : "Step 2 of 2";
            close => { root.on-cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.on-cancel();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Space name";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: 600;
                        }

                        input-field := LineEdit {
                            text <=> root.space-name;
                            placeholder-text: "My first Space";
                            init => { self.focus(); }
                            accepted(t) => { if t != "" { root.on-create(t); } }
                        }

                        Text {
                            text: "You can add more Spaces to this Universe later.";
                            color: Theme.text-disabled;
                            font-size: Theme.font-xs;
                            wrap: word-wrap;
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-cancel(); }
                        }
                        KitButton {
                            text: "Create";
                            kind: "primary";
                            enabled: root.space-name != "";
                            clicked => { root.on-create(root.space-name); }
                        }
                    }
                }
            }
        }
    }
}
