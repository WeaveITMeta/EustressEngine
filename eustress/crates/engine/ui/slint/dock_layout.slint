// ============================================================================
// Dock Layout System - Containerized Panel Management
// Features: Layout Presets, Advanced Tabs, Floating Panels, Context-Aware Docking,
//           Theme/Accessibility, Performance Feedback
// ============================================================================

import { Theme } from "theme.slint";
import { KitDivider, KitButton, KitSwitch, DialogFooter, SettingsGroup, SettingRow } from "dialog_kit.slint";

// ============================================================================
// Layout Preset Definition
// ============================================================================

export struct LayoutPreset {
    name: string,
    description: string,
    icon: image,
    // Panel visibility
    show-explorer: bool,
    show-properties: bool,
    show-output: bool,
    show-toolbox: bool,
    show-assets: bool,
    show-history: bool,
    show-soul-panel: bool,
    // Panel sizes
    left-panel-width: float,
    right-panel-width: float,
    output-height: float,
    // Tab indices
    left-tab-index: int,
    right-tab-index: int,
}

// ============================================================================
// Layout Preset Selector Component
// ============================================================================

export component LayoutPresetSelector inherits Rectangle {
    in-out property <[LayoutPreset]> presets: [
        {
            name: "Default",
            description: "Standard studio layout",
            icon: @image-url("../../assets/icons/ui/layout-default.svg"),
            show-explorer: true,
            show-properties: true,
            show-output: true,
            show-toolbox: true,
            show-assets: false,
            show-history: false,
            show-soul-panel: false,
            left-panel-width: 280.0,
            right-panel-width: 420.0,
            output-height: 150.0,
            left-tab-index: 0,
            right-tab-index: 0,
        },
        {
            name: "Scripting",
            description: "Focus on code and output",
            icon: @image-url("../../assets/icons/ui/layout-scripting.svg"),
            show-explorer: true,
            show-properties: false,
            show-output: true,
            show-toolbox: false,
            show-assets: false,
            show-history: false,
            show-soul-panel: true,
            left-panel-width: 250.0,
            right-panel-width: 400.0,
            output-height: 250.0,
            left-tab-index: 0,
            right-tab-index: 2,
        },
        {
            name: "Building",
            description: "Focus on 3D viewport",
            icon: @image-url("../../assets/icons/ui/layout-building.svg"),
            show-explorer: true,
            show-properties: true,
            show-output: false,
            show-toolbox: true,
            show-assets: true,
            show-history: false,
            show-soul-panel: false,
            left-panel-width: 220.0,
            right-panel-width: 280.0,
            output-height: 100.0,
            left-tab-index: 1,
            right-tab-index: 0,
        },
        {
            name: "Minimal",
            description: "Maximum viewport space",
            icon: @image-url("../../assets/icons/ui/layout-minimal.svg"),
            show-explorer: false,
            show-properties: false,
            show-output: false,
            show-toolbox: false,
            show-assets: false,
            show-history: false,
            show-soul-panel: false,
            left-panel-width: 0.0,
            right-panel-width: 0.0,
            output-height: 0.0,
            left-tab-index: 0,
            right-tab-index: 0,
        },
        {
            name: "Wide Panels",
            description: "Extra wide side panels",
            icon: @image-url("../../assets/icons/ui/layout-wide.svg"),
            show-explorer: true,
            show-properties: true,
            show-output: true,
            show-toolbox: true,
            show-assets: true,
            show-history: true,
            show-soul-panel: false,
            left-panel-width: 350.0,
            right-panel-width: 400.0,
            output-height: 200.0,
            left-tab-index: 0,
            right-tab-index: 0,
        },
    ];
    
    in-out property <int> current-preset-index: 0;
    in-out property <bool> dropdown-open: false;

    callback request-open-dropdown(/* x */ float, /* y */ float);

    width: 160px;
    height: 28px;
    // The popup surface in small: glass, `radius-md`, one border, the top
    // hairline. Open (the dropdown is showing) is the armed state, ringed in
    // the selection cyan.
    background: root.dropdown-open || btn-touch.has-hover ? Theme.explorer-item-hover : Theme.panel-glass;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.dropdown-open ? Theme.accent-cyan.with-alpha(0.6) : Theme.border-color;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow-float;
    animate background { duration: 100ms; }

    Rectangle {
        x: Theme.radius-md;
        y: 0;
        width: parent.width - 2 * Theme.radius-md;
        height: 1px;
        background: Theme.border-highlight;
    }

    // Current preset button
    btn-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.dropdown-open {
                root.dropdown-open = false;
            } else {
                root.request-open-dropdown(
                    root.absolute-position.x / 1px,
                    (root.absolute-position.y + root.height) / 1px + 2
                );
            }
        }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 7px;

        VerticalLayout {
            alignment: center;
            Image {
                width: 14px;
                height: 14px;
                source: root.presets[root.current-preset-index].icon;
                image-fit: contain;
                colorize: root.dropdown-open ? Theme.accent-cyan : Theme.text-secondary;
            }
        }
        Text {
            text: root.presets[root.current-preset-index].name;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Image {
                width: 10px;
                height: 10px;
                source: root.dropdown-open ? @image-url("../../assets/icons/ui/chevron-up.svg") :
                        @image-url("../../assets/icons/ui/chevron-down.svg");
                image-fit: contain;
                colorize: root.dropdown-open ? Theme.accent-cyan : Theme.text-secondary;
            }
        }
    }
}

// ── Menu parts (private) ────────────────────────────────────────────────────

/// A menu separator: a KitDivider inset from the menu's edges.
component DockMenuSeparator inherits Rectangle {
    height: 9px;
    KitDivider {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
    }
}

/// A 28px menu action row: icon and label. `danger` paints it in the red
/// accent for a destructive action.
component DockMenuAction inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.button-pressed
        : touch.has-hover ? Theme.explorer-item-hover : transparent;
    animate background { duration: 80ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: root.icon;
        image-fit: contain;
        colorize: root.danger ? Theme.accent-red
            : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
    }

    Text {
        x: 34px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 44px;
        text: root.text;
        color: root.danger ? Theme.accent-red : Theme.text-primary;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Floating layout dropdown menu — rendered at root level above all panels
export component LayoutDropdownMenu inherits Rectangle {
    in property <[LayoutPreset]> presets: [
        {
            name: "Default",
            description: "Standard studio layout",
            icon: @image-url("../../assets/icons/ui/layout-default.svg"),
            show-explorer: true, show-properties: true, show-output: true,
            show-toolbox: true, show-assets: false, show-history: false, show-soul-panel: false,
            left-panel-width: 280.0, right-panel-width: 420.0, output-height: 150.0,
            left-tab-index: 0, right-tab-index: 0,
        },
        {
            name: "Scripting",
            description: "Focus on code and output",
            icon: @image-url("../../assets/icons/ui/layout-scripting.svg"),
            show-explorer: true, show-properties: false, show-output: true,
            show-toolbox: false, show-assets: false, show-history: false, show-soul-panel: true,
            left-panel-width: 250.0, right-panel-width: 400.0, output-height: 250.0,
            left-tab-index: 0, right-tab-index: 2,
        },
        {
            name: "Building",
            description: "Focus on 3D viewport",
            icon: @image-url("../../assets/icons/ui/layout-building.svg"),
            show-explorer: true, show-properties: true, show-output: false,
            show-toolbox: true, show-assets: true, show-history: false, show-soul-panel: false,
            left-panel-width: 220.0, right-panel-width: 280.0, output-height: 100.0,
            left-tab-index: 1, right-tab-index: 0,
        },
        {
            name: "Minimal",
            description: "Maximum viewport space",
            icon: @image-url("../../assets/icons/ui/layout-minimal.svg"),
            show-explorer: false, show-properties: false, show-output: false,
            show-toolbox: false, show-assets: false, show-history: false, show-soul-panel: false,
            left-panel-width: 0.0, right-panel-width: 0.0, output-height: 0.0,
            left-tab-index: 0, right-tab-index: 0,
        },
        {
            name: "Wide Panels",
            description: "Extra wide side panels",
            icon: @image-url("../../assets/icons/ui/layout-wide.svg"),
            show-explorer: true, show-properties: true, show-output: true,
            show-toolbox: true, show-assets: true, show-history: true, show-soul-panel: false,
            left-panel-width: 350.0, right-panel-width: 400.0, output-height: 200.0,
            left-tab-index: 0, right-tab-index: 0,
        },
    ];
    in-out property <int> current-preset-index: 0;

    callback preset-selected(int, LayoutPreset);
    callback load-layout-from-file();
    callback save-layout-to-file();
    callback close();

    width: 220px;
    // Hug the content. The old fixed `presets * 44px + 72px` was 31px short
    // of the rows it holds, so "Reset to default" hung below the card.
    height: body.min-height;
    background: Theme.panel-glass;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-color;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow-float;

    // Absorb clicks on menu body
    TouchArea {}

    Rectangle {
        x: Theme.radius-md;
        y: 0;
        width: parent.width - 2 * Theme.radius-md;
        height: 1px;
        background: Theme.border-highlight;
    }

    body := VerticalLayout {
        padding: 5px;
        spacing: 1px;

        // Preset list. The current preset is marked with the cyan check
        // and a cyan icon.
        for preset[index] in root.presets: Rectangle {
            height: 38px;
            border-radius: Theme.radius-sm;
            background: item-touch.pressed ? Theme.button-pressed
                : item-touch.has-hover ? Theme.explorer-item-hover : transparent;
            animate background { duration: 80ms; easing: ease-out; }

            item-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current-preset-index = index;
                    root.preset-selected(index, preset);
                    root.close();
                }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: preset.icon;
                        image-fit: contain;
                        colorize: index == root.current-preset-index ? Theme.accent-cyan
                            : item-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }
                }

                // Name + description
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: preset.name;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: index == root.current-preset-index ? 600 : 500;
                        overflow: elide;
                    }
                    Text {
                        text: preset.description;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 12px;
                        height: 12px;
                        source: @image-url("../../assets/icons/ui/check.svg");
                        image-fit: contain;
                        colorize: Theme.accent-cyan;
                        opacity: index == root.current-preset-index ? 1.0 : 0.0;
                    }
                }
            }
        }

        DockMenuSeparator { }

        DockMenuAction {
            icon: @image-url("../../assets/icons/ui/save.svg");
            text: "Save layout...";
            clicked => {
                root.save-layout-to-file();
                root.close();
            }
        }

        DockMenuAction {
            icon: @image-url("../../assets/icons/ui/import.svg");
            text: "Import layout...";
            clicked => {
                root.load-layout-from-file();
                root.close();
            }
        }

        // Reset applies the Default preset in full: panels, widths and
        // tabs, exactly as picking it from the list does.
        DockMenuAction {
            icon: @image-url("../../assets/icons/ui/reset.svg");
            text: "Reset to default";
            clicked => {
                root.preset-selected(0, root.presets[0]);
                root.close();
            }
        }
    }
}

// ============================================================================
// Performance Overlay (FPS, Memory, Auto-hide inactive)
// ============================================================================

export component PerformanceOverlay inherits Rectangle {
    in-out property <float> fps: 60.0;
    in-out property <float> frame-time-ms: 16.67;
    in-out property <int> entity-count: 0;
    in-out property <bool> show-detailed: false;

    // Green at 55 and up, amber from 30, red below.
    property <color> tone: root.fps >= 55 ? Theme.text-success : root.fps >= 30 ? Theme.text-warning : Theme.text-error;

    width: root.show-detailed ? 200px : 80px;
    height: root.show-detailed ? 112px : 28px;
    background: touch.has-hover ? Theme.explorer-item-hover : Theme.panel-glass;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-color;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow-float;
    animate background { duration: 100ms; }

    Rectangle {
        x: Theme.radius-md;
        y: 0;
        width: parent.width - 2 * Theme.radius-md;
        height: 1px;
        background: Theme.border-highlight;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show-detailed = !root.show-detailed; }
    }

    if !root.show-detailed: HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone;
            }
        }
        Text {
            text: Math.round(root.fps) + " FPS";
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    if root.show-detailed: VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.tone;
                }
            }
            Text {
                text: "PERFORMANCE";
                color: Theme.text-disabled;
                font-size: Theme.font-xs;
                font-weight: 700;
                letter-spacing: 0.6px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        KitDivider { }

        HorizontalLayout {
            Text { text: "Frame rate"; color: Theme.text-secondary; horizontal-stretch: 1; font-size: 12px; vertical-alignment: center; }
            Text {
                text: Math.round(root.fps * 10) / 10 + " FPS";
                color: root.tone;
                font-weight: 600;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            Text { text: "Frame time"; color: Theme.text-secondary; horizontal-stretch: 1; font-size: 12px; vertical-alignment: center; }
            Text {
                text: Math.round(root.frame-time-ms * 100) / 100 + " ms";
                color: Theme.text-primary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            Text { text: "Entities"; color: Theme.text-secondary; horizontal-stretch: 1; font-size: 12px; vertical-alignment: center; }
            Text {
                text: root.entity-count;
                color: Theme.text-primary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

// ============================================================================
// Theme Editor Panel
// ============================================================================

/// One UI-scale choice: a segment in the KitSegmented style, selected in
/// the selection cyan. Private, so it reads the scale straight from the
/// editor instead of holding an index that a click would unbind.
component ScaleChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 24px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm - 1px;
    background: root.selected ? Theme.accent-cyan.with-alpha(0.2)
        : chip-touch.has-hover ? Theme.button-hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent-cyan.with-alpha(0.6);

    Text {
        text: root.text;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: 11px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The body of the floating Theme settings panel. The panel's title bar and
// drag handle belong to its host in main.slint, so this draws the settings
// and the footer only.
export component ThemeEditor inherits Rectangle {
    in-out property <bool> dark-mode: true;
    in-out property <bool> high-contrast: false;
    in-out property <float> ui-scale: 1.0;
    in-out property <color> accent-color: Theme.accent-blue;

    callback theme-changed();
    callback apply-theme();

    background: transparent;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            vertical-stretch: 1;

            SettingsGroup {
                title: "APPEARANCE";

                SettingRow {
                    label: "Dark mode";
                    divider: false;
                    KitSwitch {
                        checked <=> root.dark-mode;
                        toggled(v) => { root.theme-changed(); }
                    }
                }

                SettingRow {
                    label: "High contrast";
                    KitSwitch {
                        checked <=> root.high-contrast;
                        toggled(v) => { root.theme-changed(); }
                    }
                }

                KitDivider { }

                VerticalLayout {
                    padding-top: 9px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: "UI scale";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Math.round(root.ui-scale * 100) + "%";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: Theme.input-background;
                        border-width: 1px;
                        border-color: Theme.input-border;

                        HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            ScaleChip {
                                text: "90%";
                                selected: root.ui-scale < 0.95;
                                clicked => { root.ui-scale = 0.9; root.theme-changed(); }
                            }
                            ScaleChip {
                                text: "100%";
                                selected: root.ui-scale >= 0.95 && root.ui-scale < 1.05;
                                clicked => { root.ui-scale = 1.0; root.theme-changed(); }
                            }
                            ScaleChip {
                                text: "110%";
                                selected: root.ui-scale >= 1.05 && root.ui-scale < 1.175;
                                clicked => { root.ui-scale = 1.1; root.theme-changed(); }
                            }
                            ScaleChip {
                                text: "125%";
                                selected: root.ui-scale >= 1.175;
                                clicked => { root.ui-scale = 1.25; root.theme-changed(); }
                            }
                        }
                    }
                }
            }
        }

        DialogFooter {
            KitButton {
                text: "Apply theme";
                kind: "primary";
                clicked => { root.apply-theme(); }
            }
        }
    }
}
