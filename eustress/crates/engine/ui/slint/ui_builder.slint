// ============================================================================
// UI Builder: a whole game UI from one line
// ============================================================================
// A floating panel over the left of the viewport, on the shared chrome every
// floating panel carries (glass surface, hairline, header, close button).
//
// - Create: describe the game, write the design brief, generate. Frames
//   preview in the viewport; Variation, Regenerate and Undo; Recent.
// - Design: style, HUD kit (restyles every HUD element at once), palette.
// - Structure: every HUD element and screen, with its fields.
// - Export: insert into the Space as ScreenGuis and scripts (one undo
//   step), the checklist of what the game still wires, hook scripts, and
//   the blueprints saved in this Space.
//
// All state lives in the `UiBuilderUi` global; Rust (`ui_builder/mod.rs`)
// fills it when something changes and receives every click through
// `action(id, arg)` and every field edit through `field-edited(key, value)`.

import { Theme } from "theme.slint";
import { ScrollView, LineEdit, TextEdit, ComboBox } from "std-widgets.slint";

export struct UbChip {
    id: string,
    label: string,
    icon: string,
    selected: bool,
}

export struct UbExample {
    id: string,
    title: string,
    detail: string,
    icon: string,
}

export struct UbKV {
    key: string,
    value: string,
}

export struct UbSection {
    index: int,
    title: string,
    body: string,
    open: bool,
}

export struct UbRecent {
    id: string,
    title: string,
    meta: string,
    icon: string,
    current: bool,
}

export struct UbKit {
    id: string,
    label: string,
    selected: bool,
    plate: color,
    ink: color,
    line: color,
    line-width: float,
    radius: float,
    shadow: bool,
}

export struct UbPalette {
    id: string,
    label: string,
    selected: bool,
    c1: color,
    c2: color,
    c3: color,
    c4: color,
    c5: color,
}

export struct UbRow {
    // "e:3" for HUD element 3, "s:1" for screen 1
    id: string,
    title: string,
    detail: string,
    icon: string,
    visible: bool,
    selected: bool,
}

export struct UbField {
    key: string,
    label: string,
    value: string,
    hint: string,
    // Non-empty: a choice box instead of a text field.
    options: [string],
    // A text area, one entry per line.
    multiline: bool,
}

export struct UbExportRow {
    title: string,
    path: string,
    badge: string,
}

export struct UbCheck {
    label: string,
    count: int,
    // error | warn | info
    level: string,
    detail: string,
}

export global UiBuilderUi {
    in-out property <bool> open: false;
    in-out property <string> tab: "create";
    in-out property <string> prompt: "";
    in property <bool> ai-mode: false;
    in property <bool> has-key: false;
    in property <string> status: "Offline";
    in property <bool> busy: false;
    in property <[UbExample]> examples;
    in-out property <bool> examples-open: false;

    // The design brief
    in property <bool> has-brief: false;
    in property <string> brief-meta: "";
    in property <bool> brief-stale: false;
    in property <[UbKV]> glance;
    in property <[color]> glance-swatches;
    in property <[UbSection]> brief;

    // The result
    in property <bool> has-result: false;
    in property <string> result-title: "";
    in property <string> result-meta: "";
    in property <string> result-source: "Offline";
    in property <[UbChip]> frames;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <[UbRecent]> recent;

    // Design
    in property <[UbChip]> styles;
    in property <string> style-about: "";
    in property <[UbKit]> kits;
    in property <string> kit-about: "";
    in property <int> kit-overrides: 0;
    in property <[UbPalette]> palettes;
    in property <[color]> current-swatches;

    // Structure
    in property <[UbRow]> elements;
    in property <[UbRow]> screens;
    in property <string> selected-title: "";
    in property <[UbField]> fields;
    in property <[string]> add-kinds;
    in-out property <string> filter: "";

    // Export
    in-out property <string> export-name: "";
    in-out property <bool> server-script: false;
    in property <[UbExportRow]> export-rows;
    in property <string> insert-label: "Insert into game";
    in property <bool> inserted: false;
    in property <string> inserted-title: "";
    in property <string> inserted-meta: "";
    in property <[UbCheck]> checklist;
    in property <int> todo-count: 0;
    in property <int> note-count: 0;
    in property <[UbExportRow]> script-rows;
    in property <[UbRecent]> saved;
    in property <string> saved-meta: "";
    in property <string> usage: "";

    // Preview
    in-out property <bool> preview: false;
    in property <[string]> preview-frames;
    in-out property <int> preview-index: 0;

    in property <string> toast: "";
    // ok | warn | error
    in property <string> toast-kind: "ok";

    callback action(string, string);
    callback field-edited(string, string);
}

// ── Icons ───────────────────────────────────────────────────────────────────

export global UbIcons {
    public pure function get(name: string) -> image {
        if name == "sparkle" { return @image-url("../../assets/icons/ui/sparkle.svg"); }
        if name == "palette" { return @image-url("../../assets/icons/ui/palette.svg"); }
        if name == "tree" { return @image-url("../../assets/icons/ui/tree.svg"); }
        if name == "export" { return @image-url("../../assets/icons/ui/export.svg"); }
        if name == "undo" { return @image-url("../../assets/icons/ui/undo.svg"); }
        if name == "redo" { return @image-url("../../assets/icons/ui/redo.svg"); }
        if name == "close" { return @image-url("../../assets/icons/ui/close.svg"); }
        if name == "check" { return @image-url("../../assets/icons/ui/check.svg"); }
        if name == "plus" { return @image-url("../../assets/icons/ui/plus.svg"); }
        if name == "eye" { return @image-url("../../assets/icons/ui/eye.svg"); }
        if name == "search" { return @image-url("../../assets/icons/ui/search.svg"); }
        if name == "refresh" { return @image-url("../../assets/icons/ui/refresh.svg"); }
        if name == "settings" { return @image-url("../../assets/icons/ui/settings.svg"); }
        if name == "history" { return @image-url("../../assets/icons/ui/history.svg"); }
        if name == "play" { return @image-url("../../assets/icons/ui/play.svg"); }
        if name == "screen" { return @image-url("../../assets/icons/ui/screen.svg"); }
        if name == "layout-default" { return @image-url("../../assets/icons/ui/layout-default.svg"); }
        if name == "coin" { return @image-url("../../assets/icons/ui/coin.svg"); }
        if name == "sigma" { return @image-url("../../assets/icons/ui/sigma.svg"); }
        if name == "flag" { return @image-url("../../assets/icons/ui/flag.svg"); }
        if name == "gauge" { return @image-url("../../assets/icons/ui/gauge.svg"); }
        if name == "clock" { return @image-url("../../assets/icons/ui/clock.svg"); }
        if name == "array-linear" { return @image-url("../../assets/icons/ui/array-linear.svg"); }
        if name == "array-grid" { return @image-url("../../assets/icons/ui/array-grid.svg"); }
        if name == "trophy" { return @image-url("../../assets/icons/ui/trophy.svg"); }
        if name == "map" { return @image-url("../../assets/icons/ui/map.svg"); }
        if name == "button" { return @image-url("../../assets/icons/ui/button.svg"); }
        if name == "list" { return @image-url("../../assets/icons/ui/list.svg"); }
        if name == "checklist" { return @image-url("../../assets/icons/ui/checklist.svg"); }
        if name == "keyboard" { return @image-url("../../assets/icons/ui/keyboard.svg"); }
        if name == "megaphone" { return @image-url("../../assets/icons/ui/megaphone.svg"); }
        if name == "certificate" { return @image-url("../../assets/icons/ui/certificate.svg"); }
        if name == "chart-bar" { return @image-url("../../assets/icons/ui/chart-bar.svg"); }
        if name == "book" { return @image-url("../../assets/icons/ui/book.svg"); }
        if name == "key" { return @image-url("../../assets/icons/ui/key.svg"); }
        if name == "factory" { return @image-url("../../assets/icons/ui/factory.svg"); }
        if name == "vehicle" { return @image-url("../../assets/icons/ui/vehicle.svg"); }
        if name == "shield" { return @image-url("../../assets/icons/ui/shield.svg"); }
        if name == "crosshair" { return @image-url("../../assets/icons/ui/crosshair.svg"); }
        if name == "flashlight" { return @image-url("../../assets/icons/ui/flashlight.svg"); }
        if name == "users" { return @image-url("../../assets/icons/ui/users.svg"); }
        if name == "fire" { return @image-url("../../assets/icons/ui/fire.svg"); }
        if name == "chevron-down" { return @image-url("../../assets/icons/ui/chevron-down.svg"); }
        if name == "chevron-right" { return @image-url("../../assets/icons/ui/chevron-right.svg"); }
        if name == "chevron-up" { return @image-url("../../assets/icons/ui/chevron-up.svg"); }
        if name == "delete" { return @image-url("../../assets/icons/ui/delete.svg"); }
        if name == "image" { return @image-url("../../assets/icons/ui/image.svg"); }
        if name == "warning" { return @image-url("../../assets/icons/ui/warning.svg"); }
        if name == "info" { return @image-url("../../assets/icons/ui/info.svg"); }
        if name == "error" { return @image-url("../../assets/icons/ui/error.svg"); }
        if name == "save" { return @image-url("../../assets/icons/ui/save.svg"); }
        if name == "pen" { return @image-url("../../assets/icons/ui/pen.svg"); }
        if name == "lightning" { return @image-url("../../assets/icons/ui/lightning.svg"); }
        if name == "brain" { return @image-url("../../assets/icons/ui/brain.svg"); }
        if name == "terminal" { return @image-url("../../assets/icons/ui/terminal.svg"); }
        if name == "document" { return @image-url("../../assets/icons/ui/document.svg"); }
        if name == "folder-open" { return @image-url("../../assets/icons/ui/folder-open.svg"); }
