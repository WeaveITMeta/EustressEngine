// ============================================================================
// Eustress Studio: Publish dialog (two panels)
// Universe and Space publishing, with the file tree that will upload.
//
// Shape (DRAFTING_UX.md Law 1): DialogScrim > DialogCard, the file tree on
// the left, SettingsGroup cards on the right, a DialogFooter with Publish
// rightmost. Esc closes.
// ============================================================================

import { LineEdit, TextEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    DialogScrim, DialogCard, DialogFooter, KitDivider, KitButton, KitSwitch,
    SettingsGroup, SettingRow, KitNotice, KitSectionLabel,
} from "dialog_kit.slint";
import { ListingStatusRow, ListingReason } from "listing_status.slint";

// Tree node for hierarchy panel
export struct PublishTreeNode {
    name: string,
    depth: int,
    is-folder: bool,
    is-primary: bool,
    file-count: int,
    icon-hint: string, // "universe", "space", "service", "file", "excluded"
}

// Tree item row in the hierarchy panel
component TreeRow inherits Rectangle {
    in property <string> name: "";
    in property <int> depth: 0;
    in property <bool> is-folder: true;
    in property <bool> is-primary: false;
    in property <int> file-count: 0;
    in property <string> icon-hint: "file";

    property <bool> excluded: root.icon-hint == "excluded";

    height: 24px;
    border-radius: Theme.radius-sm;
    background: root.is-primary ? Theme.accent-cyan.with-alpha(0.08) : transparent;

    HorizontalLayout {
        padding-left: 8px + root.depth * 14px;
        padding-right: 6px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Image {
                width: 13px;
                height: 13px;
                image-fit: contain;
                source: !root.is-folder ? @image-url("../../assets/icons/ui/document.svg")
                    : root.icon-hint == "universe" ? @image-url("../../assets/icons/ui/globe.svg")
                    : root.icon-hint == "space" ? @image-url("../../assets/icons/ui/layers.svg")
                    : root.icon-hint == "service" ? @image-url("../../assets/icons/ui/gears.svg")
                    : @image-url("../../assets/icons/ui/folder-open.svg");
                colorize: root.excluded ? Theme.text-disabled
                    : root.is-primary ? Theme.accent-cyan
                    : Theme.text-secondary;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: root.excluded ? Theme.text-disabled
                : root.is-primary ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px;
            font-weight: root.is-primary ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        // File count
        if root.is-folder && root.file-count > 0: Text {
            text: root.file-count;
            color: Theme.text-disabled;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }

        // Primary badge
        if root.is-primary: VerticalLayout {
            alignment: center;
            Rectangle {
                width: badge-text.preferred-width + 12px;
                height: 16px;
                border-radius: Theme.radius-sm;
                background: Theme.accent-cyan.with-alpha(0.14);
                border-width: 1px;
                border-color: Theme.accent-cyan.with-alpha(0.4);

                badge-text := Text {
                    text: "Primary";
                    color: Theme.accent-cyan;
                    font-size: 9px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component PublishDialog inherits Rectangle {
    in-out property <string> experience-name: "";
    in-out property <string> description: "";
    in-out property <string> genre: "All";
    in-out property <bool> is-public: true;
    in-out property <bool> open_source: false;
    in-out property <bool> studio-editable: false;
    in property <[string]> spaces: [];
    in property <[PublishTreeNode]> tree-nodes: [];
    in property <string> publish-target: "Cloudflare R2";
    in property <string> sync-status: "Cloud sync ready";
    in property <string> pak-size-estimate: "";
    in property <bool> is-publishing: false;
    in property <string> error-message: "";
    in property <bool> is-update: false;
    in property <string> publish-mode: "universe";

    callback on-publish(string, string, string, bool, bool, bool, bool);
    callback on-close();

    // Where the Universe stands in the gallery's review (listing_status.slint).
    in property <string> listing-status: "";
    in property <string> listing-headline: "";
    in property <string> listing-rating: "";
    in property <string> listing-updated: "";
    in property <[ListingReason]> listing-reasons: [];
    in property <string> listing-suggested-edit: "";
    in property <bool> listing-can-appeal: false;
    in property <bool> listing-appeal-busy: false;
    in property <string> listing-appeal-error: "";
    callback on-listing-appeal(string);
    callback on-listing-open-review();

    property <bool> can-publish: !root.is-publishing && root.experience-name != "";

    width: 100%;
    height: 100%;
    background: transparent;

    DialogScrim {
        dismiss => { root.on-close(); }

        keys := FocusScope {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(780px, parent.width - 48px);
            height: min(parent.height - 60px, 560px);

            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.on-close();
                    return accept;
                }
                reject
            }

            DialogCard {
                width: 100%;
                height: 100%;
                icon: @image-url("../../assets/icons/ui/rocket.svg");
                title: root.publish-mode == "space"
                    ? (root.is-update ? "Update Space" : "Publish Space")
                    : (root.is-update ? "Update Universe" : "Publish Universe");
                subtitle: "Target: " + root.publish-target + "  ·  " + root.sync-status;
                close => { root.on-close(); }

                HorizontalLayout {
                    vertical-stretch: 1;
                    padding: 0;
                    spacing: 0;

                    // ── Left: the files that upload ──
                    Rectangle {
                        width: 260px;
                        background: Theme.background-primary.with-alpha(0.35);

                        VerticalLayout {
                            padding: 0;
                            spacing: 0;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 12px;
                                padding-bottom: 8px;
                                KitSectionLabel { text: "FILES"; }
                            }

                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-bottom: 6px;
                                    spacing: 1px;
                                    alignment: start;

                                    for node[idx] in root.tree-nodes: TreeRow {
                                        name: node.name;
                                        depth: node.depth;
                                        is-folder: node.is-folder;
                                        is-primary: node.is-primary;
                                        file-count: node.file-count;
                                        icon-hint: node.icon-hint;
                                    }
                                }
                            }

                            KitDivider { }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                Text {
                                    text: root.pak-size-estimate != ""
                                        ? "Estimated upload: " + root.pak-size-estimate
                                        : "Only changed chunks upload; hidden folders stay local";
                                    color: Theme.text-disabled;
                                    font-size: Theme.font-xs;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: Theme.ribbon-separator; }

                    // ── Right: the form ──
                    ScrollView {
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 16px;
                            alignment: start;

                            SettingsGroup {
                                title: "LISTING";
                                HorizontalLayout {
                                    padding: 12px;
                                    ListingStatusRow {
                                        status: root.listing-status;
                                        headline: root.listing-headline;
                                        rating: root.listing-rating;
                                        updated: root.listing-updated;
                                        reasons: root.listing-reasons;
                                        suggested-edit: root.listing-suggested-edit;
                                        can-appeal: root.listing-can-appeal;
                                        appeal-busy: root.listing-appeal-busy;
                                        appeal-error: root.listing-appeal-error;
                                        appeal(text) => { root.on-listing-appeal(text); }
                                        open-review => { root.on-listing-open-review(); }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "DETAILS";

                                SettingRow {
                                    label: "Name";
                                    description: "Shown on the gallery page.";
                                    divider: false;
                                    LineEdit {
                                        width: 260px;
                                        placeholder-text: "Simulation name";
                                        text <=> root.experience-name;
                                    }
                                }

                                KitDivider { }
                                VerticalLayout {
                                    padding-top: 9px;
                                    padding-bottom: 10px;
                                    spacing: 6px;

                                    Text {
                                        text: "Description";
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 500;
                                    }
                                    TextEdit {
                                        height: 80px;
                                        text <=> root.description;
                                    }
                                }

                                SettingRow {
                                    label: "Genre";
                                    ComboBox {
                                        width: 200px;
                                        model: ["All", "Adventure", "Building", "Comedy", "Fighting", "FPS", "Horror", "Medieval", "Military", "Naval", "RPG", "Sci-Fi", "Sports", "Town and City", "Western"];
                                        current-value <=> root.genre;
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "VISIBILITY";

                                SettingRow {
                                    label: "Public";
                                    description: root.is-public ? "Anyone can play" : "Only you can access";
                                    divider: false;
                                    KitSwitch { checked <=> root.is-public; }
                                }
                                SettingRow {
                                    label: "Share source";
                                    description: "Allow source access and reuse";
                                    KitSwitch { checked <=> root.open_source; }
                                }
                            }

                            if root.error-message != "": KitNotice {
                                kind: "error";
                                text: root.error-message;
                            }
                        }
                    }
                }

                // ── Footer ──
                DialogFooter {
                    KitButton {
                        text: "Cancel";
                        clicked => { root.on-close(); }
                    }
                    KitButton {
                        text: root.is-publishing ? "Publishing..." : root.is-update ? "Update" : "Publish";
                        kind: "primary";
                        has-icon: true;
                        icon: @image-url("../../assets/icons/ui/rocket.svg");
                        enabled: root.can-publish;
                        clicked => {
                            root.on-publish(
                                root.experience-name,
                                root.description,
                                root.genre,
                                root.is-public,
                                root.open_source,
                                // The stored value from the Space's publish manifest
                                // (Rust loads it into studio-editable): republishing
                                // keeps it instead of resetting it to false.
                                root.studio-editable,
                                root.publish-mode == "space",
                            );
                        }
                    }
                }
            }
        }
    }
}
