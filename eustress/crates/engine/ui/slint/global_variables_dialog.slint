// ============================================================================
// Eustress Engine Studio - Global Variables Dialog
//
// The surface behind the "Global Variables..." menu item. Lists every globally
// scoped key/value pair the running universe exposes to scripts, bindings and
// simulation values, and lets the user filter, add, retype, edit inline and
// delete them.
//
// Design notes worth knowing before editing this file:
//
//   * FILTERING IS DONE IN RUST. Slint has no substring test (there is no
//     `contains` on `string`), so `variables` is expected to arrive ALREADY
//     filtered. The dialog owns the query text and reports every keystroke
//     through `on-filter-changed`. It tells "nothing exists yet" apart from
//     "nothing matched" purely from `filter-text` being non-empty, so it stays
//     correct without the host supplying an unfiltered total.
//
//   * DUPLICATE-KEY VALIDATION IS DONE IN RUST for the same reason: the model
//     cannot be searched from Slint. The dialog enforces the one rule it can
//     see on its own (an empty key) and renders whatever `add-error` /
//     `edit-error` the host pushes back in answer to `on-new-key-edited` /
//     `on-edit-key-edited`. Both feed ONE message per form, so a host that
//     never wires those callbacks still gets working empty-key feedback instead
//     of a dead validation slot.
//
//   * NOTHING IS DESTROYED BY ITS OWN CLICK. The inline editor, the delete
//     confirmation and the empty states are visibility-gated, not `if`-gated,
//     and the add form's Cancel / Add live in the footer (whose buttons change
//     meaning with `adding`) rather than inside the `if root.adding` block.
//     A button that clears the very state that spawned it, under an `if`,
//     deletes the element from inside its own click handler: the Slint
//     "Recursion detected" crash class documented in add_attribute_dialog.slint.
//     Because a `visible: false` child still occupies space in a layout, every
//     gated group sits inside a fixed-size Rectangle (not a layout slot) and
//     the row height carries the swap.
//
//   * The type selector is a segmented control rather than a dropdown. With
//     three options a popup buys nothing and would clip against the fixed row
//     height inside the ScrollView.
//
// Chrome is the shared dialog kit (DRAFTING_UX.md Law 1). Colors, radii,
// spacing and font sizes come from Theme tokens only.
// ============================================================================

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitDivider, KitButton, KitSectionLabel, SettingsGroup, SettingRow, KitNotice } from "dialog_kit.slint";

// One global variable as the host sees it.
//
// `var-type` is the lowercase type tag and must be one of `type-options`
// (default: "string", "number", "bool"). `value` is always the DISPLAY string:
// numbers arrive pre-formatted and bools arrive as "true" / "false", so this
// dialog never has to parse or round-trip a typed value.
export struct GlobalVariableEntry {
    id: int,
    key: string,
    value: string,
    var-type: string,
}

// Segmented single-choice control, drawn like the kit's KitSegmented (the
// selection cyan marks the current choice). Kept private because it speaks in
// the option string, not an index. Used for the variable type, and again as
// the true/false editor a boolean variable gets instead of a text field.
component GVSegmented inherits Rectangle {
    in property <[string]> options: [];
    in property <string> current: "";
    in property <bool> enabled: true;

    callback changed(string);

    height: 28px;
    background: Theme.input-background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.input-border;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for opt in root.options: Rectangle {
            border-radius: Theme.radius-sm - 1px;
            border-width: opt == root.current ? 1px : 0px;
            border-color: Theme.accent-cyan.with-alpha(0.6);
            background: opt == root.current ? Theme.accent-cyan.with-alpha(0.2)
                : !root.enabled ? transparent
                : seg-ta.pressed ? Theme.button-pressed
                : seg-ta.has-hover ? Theme.button-hover : transparent;

            seg-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    root.changed(opt);
                }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: opt;
                color: opt == root.current ? Theme.text-primary : Theme.text-secondary;
                font-size: 11px;
                font-weight: opt == root.current ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Text field wrapped so the focus ring is the selection cyan rather than the
// std-widgets default. `invalid` swaps that ring to the error border so a bad
// key is visible without reading.
component GVField inherits Rectangle {
    in property <string> placeholder: "";
    in property <bool> numeric: false;
    in property <bool> invalid: false;
    in-out property <string> text: "";

    callback edited(string);
    callback accepted(string);

    height: 28px;
    background: Theme.input-background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.invalid ? Theme.border-error
        : field.has-focus ? Theme.accent-cyan : Theme.input-border;
    animate border-color { duration: Theme.panel-anim-duration-fast * Theme.motion-scale; }

    field := LineEdit {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        placeholder-text: root.placeholder;
        input-type: root.numeric ? InputType.decimal : InputType.text;
        text <=> root.text;
        edited(t) => {
            root.edited(t);
        }
        accepted(t) => {
            root.accepted(t);
        }
    }
}

// Square icon-only button: the row's delete, and the filter's clear. `danger`
// turns it red on hover.
component GVIconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.danger && ta.has-hover ? Theme.accent-red.with-alpha(0.6) : Theme.border-color;
    background: root.danger
        ? (ta.pressed ? Theme.accent-red.with-alpha(0.35) : ta.has-hover ? Theme.accent-red.with-alpha(0.22) : Theme.button-background)
        : (ta.pressed ? Theme.button-pressed : ta.has-hover ? Theme.button-hover : Theme.button-background);
    animate background { duration: 100ms; easing: ease-out; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: root.icon;
        image-fit: contain;
        colorize: root.danger && ta.has-hover ? Theme.accent-red
            : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component GlobalVariablesDialog inherits Rectangle {
    // ── Data ─────────────────────────────────────────────────────────────
    /// The rows to render. Expected to be ALREADY filtered by `filter-text`
    /// (see the header note). Safe to leave empty.
    in property <[GlobalVariableEntry]> variables: [];
    /// Allowed type tags, in the order the segmented selector shows them.
    in property <[string]> type-options: ["string", "number", "bool"];

    // ── Filter ───────────────────────────────────────────────────────────
    in-out property <string> filter-text: "";

    // ── Add form ─────────────────────────────────────────────────────────
    in-out property <bool> adding: false;
    in-out property <string> new-key: "";
    in-out property <string> new-value: "";
    in-out property <string> new-type: "string";
    /// Host-supplied validation message for the add form, e.g. a duplicate key
    /// or a reserved name. Empty means valid. The empty-key rule is checked
    /// locally and does not need to be reported here.
    in property <string> add-error: "";

    // ── Inline edit ──────────────────────────────────────────────────────
    /// Id of the row being edited, or -1 when no row is in edit mode.
    in-out property <int> editing-id: -1;
    in-out property <string> edit-key: "";
    in-out property <string> edit-value: "";
    in-out property <string> edit-type: "string";
    /// Host-supplied validation message for the inline editor. Empty = valid.
    in property <string> edit-error: "";

    // ── Selection ────────────────────────────────────────────────────────
    in-out property <int> selected-id: -1;

    // ── Callbacks ────────────────────────────────────────────────────────
    callback on-filter-changed(/* query */ string);
    callback on-clear-filter();

    callback on-begin-add();
    callback on-cancel-add();
    /// Fired on every keystroke in the add form's key field so the host can
    /// answer with `add-error` (duplicate key, reserved name, bad identifier).
    callback on-new-key-edited(/* key */ string);
    callback on-add-variable(/* key */ string, /* value */ string, /* type */ string);

    callback on-begin-edit(/* id */ int);
    callback on-cancel-edit();
    /// Same live-validation contract as `on-new-key-edited`, for the row editor.
    callback on-edit-key-edited(/* id */ int, /* key */ string);
    callback on-commit-edit(/* id */ int, /* key */ string, /* value */ string, /* type */ string);

    callback on-select-variable(/* id */ int);
    callback on-delete-variable(/* id */ int);

    callback on-close();

    // ── Local state ──────────────────────────────────────────────────────
    // Delete arming is deliberately local: it is a confirmation affordance, not
    // application state, and keeping it here means the host cannot strand a row
    // in "confirm" by forgetting to reset a property.
    property <int> arm-delete-id: -1;
    // Hold back the empty-key complaint until the user has actually typed, so a
    // freshly opened form is not red before it has been used.
    property <bool> new-key-touched: false;
    property <bool> edit-key-touched: false;

    property <bool> add-key-empty: root.new-key == "";
    property <bool> add-blocked: root.add-key-empty || root.add-error != "";
    property <string> add-message: (root.new-key-touched && root.add-key-empty)
        ? "Key cannot be empty." : root.add-error;

    property <bool> edit-key-empty: root.edit-key == "";
    property <bool> edit-blocked: root.edit-key-empty || root.edit-error != "";
    property <string> edit-message: (root.edit-key-touched && root.edit-key-empty)
        ? "Key cannot be empty." : root.edit-error;

    property <bool> filtering: root.filter-text != "";
    property <bool> empty: root.variables.length == 0;

    // Row geometry. The edit face is taller than the display face and the row
    // height switches between them; see the header note on visibility gating.
    // The edit face grows by one notice when it has a message to show.
    property <length> row-display-height: 46px;
    property <length> row-edit-height: root.edit-message != "" ? 122px : 84px;

    // Clears every transient piece of dialog state, so a later reopen never
    // inherits a stale complaint or a half-armed delete.
    function clear-transient() {
        root.arm-delete-id = -1;
        root.new-key-touched = false;
        root.edit-key-touched = false;
    }

    function close-dialog() {
        root.clear-transient();
        root.on-close();
    }

    function clear-filter() {
        root.filter-text = "";
        root.on-clear-filter();
        root.on-filter-changed("");
    }

    function begin-add() {
        root.arm-delete-id = -1;
        root.new-key-touched = false;
        root.adding = true;
        root.on-begin-add();
    }

    function cancel-add() {
        root.adding = false;
        root.new-key-touched = false;
        root.on-cancel-add();
    }

    width: 100%;
    height: 100%;

    // Backdrop: click dismisses, scroll is absorbed so it never reaches the 3D
    // viewport behind the modal.
    DialogScrim {
        dismiss => {
            root.close-dialog();
        }

        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 660px;
            height: min(parent.height - 80px, 560px);
            icon: @image-url("../../assets/icons/ui/globe.svg");
            title: "Global variables";
            subtitle: "Values every script and binding in this universe can read";
            close => {
                root.close-dialog();
            }

            // One FocusScope for the whole card body. Escape unwinds the
            // innermost open thing first (armed delete, then row editor, then
            // add form, then the dialog), which is what a user expects from a
            // stacked modal. Keys are swallowed either way so nothing leaks to
            // the Explorer or the viewport.
            keys := FocusScope {
                vertical-stretch: 1;

                init => {
                    self.focus();
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        if (root.arm-delete-id != -1) {
                            root.arm-delete-id = -1;
                        } else if (root.editing-id != -1) {
                            root.editing-id = -1;
                            root.edit-key-touched = false;
                            root.on-cancel-edit();
                        } else if (root.adding) {
                            root.adding = false;
                            root.new-key-touched = false;
                            root.on-cancel-add();
                        } else {
                            root.close-dialog();
                        }
                        return accept;
                    }
                    return accept;
                }

                key-released(event) => {
                    return accept;
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // ── Filter bar ───────────────────────────────────────
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../assets/icons/ui/search.svg");
                                image-fit: contain;
                                colorize: root.filtering ? Theme.accent-cyan : Theme.text-secondary;
                            }
                        }

                        GVField {
                            horizontal-stretch: 1;
                            placeholder: "Filter by key or value";
                            text <=> root.filter-text;
                            edited(t) => {
                                root.on-filter-changed(t);
                            }
                        }

                        // Clear-filter affordance. Kept in a fixed-width slot so
                        // the field does not resize as the user types.
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            GVIconButton {
                                visible: root.filtering;
                                enabled: root.filtering;
                                icon: @image-url("../../assets/icons/ui/close.svg");
                                clicked => {
                                    root.clear-filter();
                                }
                            }
                        }
                    }

                    KitDivider { }

                    // ── Content ──────────────────────────────────────────
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            alignment: start;

                            // ── Add form ─────────────────────────────────
                            // Its Cancel and Add are the footer buttons, so
                            // nothing in here removes this block when clicked.
                            if root.adding: VerticalLayout {
                                spacing: 8px;

                                SettingsGroup {
                                    title: "New variable";

                                    SettingRow {
                                        label: "Key";
                                        description: "The name scripts read it by";
                                        divider: false;
                                        GVField {
                                            width: 300px;
                                            placeholder: "e.g. RoundDuration";
                                            invalid: root.new-key-touched && root.add-blocked;
                                            text <=> root.new-key;
                                            edited(t) => {
                                                root.new-key-touched = true;
                                                root.on-new-key-edited(t);
                                            }
                                        }
                                    }

                                    SettingRow {
                                        label: "Type";
                                        GVSegmented {
                                            width: 300px;
                                            options: root.type-options;
                                            current: root.new-type;
                                            changed(t) => {
                                                root.new-type = t;
                                                // Keep the value coherent with
                                                // the new type instead of
                                                // carrying "hello" over into a
                                                // boolean.
                                                if (t == "bool" && root.new-value != "true" && root.new-value != "false") {
                                                    root.new-value = "false";
                                                }
                                            }
                                        }
                                    }

                                    SettingRow {
                                        label: "Value";
                                        // Booleans get a two-state control;
                                        // every other type gets a text field,
                                        // numeric-gated when the type is
                                        // "number". Safe to swap with `if`: the
                                        // control that triggers the swap lives
                                        // in the Type row above, not in here.
                                        if root.new-type == "bool": GVSegmented {
                                            width: 300px;
                                            options: ["false", "true"];
                                            current: root.new-value;
                                            changed(v) => {
                                                root.new-value = v;
                                            }
                                        }

                                        if root.new-type != "bool": GVField {
                                            width: 300px;
                                            placeholder: root.new-type == "number" ? "0" : "Value";
                                            numeric: root.new-type == "number";
                                            text <=> root.new-value;
                                            accepted(v) => {
                                                if (!root.add-blocked) {
                                                    root.on-add-variable(root.new-key, v, root.new-type);
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.add-message != "": KitNotice {
                                    kind: "error";
                                    text: root.add-message;
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;

                                HorizontalLayout {
                                    padding-left: 2px;
                                    KitSectionLabel {
                                        text: root.filtering ? "Matching variables" : "Defined variables";
                                    }
                                }

                                Rectangle {
                                    background: Theme.background-secondary.with-alpha(0.6);
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-color;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;

                                        // ── Empty states ─────────────────
                                        // Two cases: nothing defined at all,
                                        // versus a filter that excluded
                                        // everything. Different wording,
                                        // different recovery action. One
                                        // visibility-gated block, because
                                        // "Clear filter" changes the state
                                        // that decides whether it shows.
                                        Rectangle {
                                            height: root.empty ? 132px : 0px;
                                            visible: root.empty;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: 22px;
                                                        height: 22px;
                                                        source: root.filtering
                                                            ? @image-url("../../assets/icons/ui/search.svg")
                                                            : @image-url("../../assets/icons/ui/globe.svg");
                                                        image-fit: contain;
                                                        colorize: Theme.text-disabled;
                                                    }
                                                }

                                                Text {
                                                    text: root.filtering
                                                        ? "No variables match \"\{root.filter-text}\""
                                                        : "No global variables yet";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-md;
                                                    horizontal-alignment: center;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: root.filtering
                                                        ? "Try a shorter query, or clear the filter."
                                                        : "Global variables are readable from every script and binding in this universe.";
                                                    color: Theme.text-disabled;
                                                    font-size: Theme.font-xs;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }

                                                HorizontalLayout {
                                                    alignment: center;
                                                    padding-top: 4px;

                                                    KitButton {
                                                        text: root.filtering ? "Clear filter" : "Add variable";
                                                        has-icon: true;
                                                        icon: root.filtering
                                                            ? @image-url("../../assets/icons/ui/close.svg")
                                                            : @image-url("../../assets/icons/ui/plus.svg");
                                                        enabled: root.filtering || !root.adding;
                                                        clicked => {
                                                            if (root.filtering) {
                                                                root.clear-filter();
                                                            } else {
                                                                root.begin-add();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // ── Variable rows ────────────────
                                        for entry[idx] in root.variables: row := Rectangle {
                                            property <bool> editing: root.editing-id == entry.id;
                                            property <bool> armed: root.arm-delete-id == entry.id;
                                            property <bool> selected: entry.id == root.selected-id;
                                            property <color> tint: entry.var-type == "number" ? Theme.cat-constraint
                                                : entry.var-type == "bool" ? Theme.cat-modify
                                                : Theme.cat-parts;

                                            height: row.editing ? root.row-edit-height : root.row-display-height;
                                            border-radius: Theme.radius-sm;
                                            border-width: row.editing ? 1px : 0px;
                                            border-color: Theme.accent-cyan.with-alpha(0.6);
                                            background: row.editing ? Theme.background-tertiary
                                                : row.selected ? Theme.accent-cyan.with-alpha(0.14)
                                                : row-ta.has-hover ? Theme.explorer-item-hover
                                                : transparent;
                                            animate background { duration: Theme.panel-anim-duration-fast * Theme.motion-scale; }

                                            // ── Display face ─────────────
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: 100%;
                                                height: root.row-display-height;
                                                visible: !row.editing;

                                                row-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.selected-id = entry.id;
                                                        root.arm-delete-id = -1;
                                                        root.on-select-variable(entry.id);
                                                    }
                                                }

                                                // The selection bar on the left edge.
                                                Rectangle {
                                                    x: 0;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 3px;
                                                    height: row.selected ? 18px : 0px;
                                                    border-radius: 1.5px;
                                                    background: Theme.accent-cyan;
                                                    animate height { duration: 120ms; easing: ease-out; }
                                                }

                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 8px;
                                                    padding-top: 9px;
                                                    padding-bottom: 9px;
                                                    spacing: 10px;

                                                    // Type pill
                                                    Rectangle {
                                                        width: 56px;
                                                        border-radius: Theme.radius-sm;
                                                        border-width: 1px;
                                                        border-color: row.tint.with-alpha(0.45);
                                                        background: row.tint.with-alpha(0.12);

                                                        Text {
                                                            width: parent.width;
                                                            height: parent.height;
                                                            text: entry.var-type;
                                                            color: row.tint;
                                                            font-size: Theme.font-xs;
                                                            font-weight: 600;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }

                                                    Text {
                                                        width: 150px;
                                                        text: entry.key;
                                                        color: Theme.text-primary;
                                                        font-size: 12px;
                                                        font-weight: row.selected ? 600 : 500;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }

                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: entry.value;
                                                        color: Theme.text-secondary;
                                                        font-size: Theme.font-sm;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }

                                                    // Action well. A plain Rectangle,
                                                    // NOT a layout slot, so the hidden
                                                    // group of the idle/armed pair
                                                    // costs no width.
                                                    Rectangle {
                                                        width: 222px;

                                                        // Idle actions
                                                        Rectangle {
                                                            x: parent.width - self.width;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 106px;
                                                            height: 28px;
                                                            visible: !row.armed;

                                                            HorizontalLayout {
                                                                spacing: 6px;

                                                                KitButton {
                                                                    text: "Edit";
                                                                    has-icon: true;
                                                                    icon: @image-url("../../assets/icons/ui/pen.svg");
                                                                    clicked => {
                                                                        // Seed the editor locally
                                                                        // as well as notifying the
                                                                        // host, so the dialog works
                                                                        // even before the host
                                                                        // populates the buffers.
                                                                        root.edit-key = entry.key;
                                                                        root.edit-value = entry.value;
                                                                        root.edit-type = entry.var-type;
                                                                        root.edit-key-touched = false;
                                                                        root.arm-delete-id = -1;
                                                                        root.editing-id = entry.id;
                                                                        root.on-begin-edit(entry.id);
                                                                    }
                                                                }

                                                                GVIconButton {
                                                                    icon: @image-url("../../assets/icons/ui/delete.svg");
                                                                    danger: true;
                                                                    clicked => {
                                                                        root.arm-delete-id = entry.id;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        // Armed-delete confirmation.
                                                        // Removing a global variable
                                                        // silently breaks every script
                                                        // that reads it, so it takes
                                                        // two clicks and says which way
                                                        // is which.
                                                        Rectangle {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 100%;
                                                            height: 28px;
                                                            visible: row.armed;

                                                            HorizontalLayout {
                                                                spacing: 6px;
                                                                alignment: end;

                                                                Text {
                                                                    text: "Delete?";
                                                                    color: Theme.text-warning;
                                                                    font-size: Theme.font-sm;
                                                                    vertical-alignment: center;
                                                                    overflow: elide;
                                                                }

                                                                KitButton {
                                                                    text: "Cancel";
                                                                    clicked => {
                                                                        root.arm-delete-id = -1;
                                                                    }
                                                                }

                                                                KitButton {
                                                                    text: "Delete";
                                                                    kind: "danger";
                                                                    has-icon: true;
                                                                    icon: @image-url("../../assets/icons/ui/delete.svg");
                                                                    clicked => {
                                                                        root.arm-delete-id = -1;
                                                                        root.on-delete-variable(entry.id);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // ── Edit face ────────────────
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: 100%;
                                                height: root.row-edit-height;
                                                visible: row.editing;

                                                VerticalLayout {
                                                    padding: 10px;
                                                    spacing: 8px;
                                                    alignment: start;

                                                    HorizontalLayout {
                                                        spacing: 8px;

                                                        GVField {
                                                            horizontal-stretch: 3;
                                                            placeholder: "Key";
                                                            invalid: root.edit-key-touched && root.edit-blocked;
                                                            text <=> root.edit-key;
                                                            edited(t) => {
                                                                root.edit-key-touched = true;
                                                                root.on-edit-key-edited(entry.id, t);
                                                            }
                                                        }

                                                        GVSegmented {
                                                            horizontal-stretch: 4;
                                                            options: root.type-options;
                                                            current: root.edit-type;
                                                            changed(t) => {
                                                                root.edit-type = t;
                                                                if (t == "bool" && root.edit-value != "true" && root.edit-value != "false") {
                                                                    root.edit-value = "false";
                                                                }
                                                            }
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        spacing: 8px;

                                                        if root.edit-type == "bool": GVSegmented {
                                                            horizontal-stretch: 1;
                                                            options: ["false", "true"];
                                                            current: root.edit-value;
                                                            changed(v) => {
                                                                root.edit-value = v;
                                                            }
                                                        }

                                                        if root.edit-type != "bool": GVField {
                                                            horizontal-stretch: 1;
                                                            placeholder: root.edit-type == "number" ? "0" : "Value";
                                                            numeric: root.edit-type == "number";
                                                            text <=> root.edit-value;
                                                            accepted(v) => {
                                                                if (!root.edit-blocked) {
                                                                    root.on-commit-edit(entry.id, root.edit-key, v, root.edit-type);
                                                                }
                                                            }
                                                        }

                                                        KitButton {
                                                            horizontal-stretch: 0;
                                                            text: "Cancel";
                                                            clicked => {
                                                                root.editing-id = -1;
                                                                root.edit-key-touched = false;
                                                                root.on-cancel-edit();
                                                            }
                                                        }

                                                        KitButton {
                                                            horizontal-stretch: 0;
                                                            text: "Save";
                                                            kind: "primary";
                                                            has-icon: true;
                                                            icon: @image-url("../../assets/icons/ui/check.svg");
                                                            enabled: !root.edit-blocked;
                                                            clicked => {
                                                                root.on-commit-edit(entry.id, root.edit-key, root.edit-value, root.edit-type);
                                                            }
                                                        }
                                                    }

                                                    if row.editing && root.edit-message != "": KitNotice {
                                                        kind: "error";
                                                        text: root.edit-message;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Footer ───────────────────────────────────────────
                    // Both buttons stay mounted and switch meaning with the add
                    // form, so neither is destroyed by its own click.
                    DialogFooter {
                        Text {
                            text: root.filtering
                                ? "\{root.variables.length} shown"
                                : (root.variables.length == 1
                                    ? "1 variable"
                                    : "\{root.variables.length} variables");
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }

                        KitButton {
                            text: root.adding ? "Cancel" : "Close";
                            clicked => {
                                if (root.adding) {
                                    root.cancel-add();
                                } else {
                                    root.close-dialog();
                                }
                            }
                        }

                        KitButton {
                            kind: "primary";
                            text: root.adding ? "Add" : "Add variable";
                            has-icon: true;
                            icon: @image-url("../../assets/icons/ui/plus.svg");
                            enabled: root.adding ? !root.add-blocked : true;
                            clicked => {
                                if (root.adding) {
                                    root.on-add-variable(root.new-key, root.new-value, root.new-type);
                                } else {
                                    root.begin-add();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
