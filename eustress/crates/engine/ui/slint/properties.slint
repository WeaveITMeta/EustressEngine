// ============================================================================
// Eustress Engine Studio - Properties Panel
// Dynamic property editor for selected entities
//
// One row grammar, set by PropStyle: every row is a help gutter, a label
// column and a value column, 24px tall, and every value column starts at the
// same x whatever the row's type. Fields are 20px; focus and selection are
// the selection cyan; red is for deleting and errors only.
// ============================================================================

import { VerticalBox, HorizontalBox, LineEdit, ScrollView, CheckBox, Slider, ComboBox, SpinBox, GridBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TagsEditor, TagChip, TagSuggestion } from "tags_editor.slint";
import { KitField } from "dialog_kit.slint";

// One categorical-picker swatch as fed from Rust: a display name plus the
// 0-255 sRGB channels. Shared between the Properties panel and the ribbon's
// status-bar color widget (both render it through `ColorSwatchCell`).
export struct ColorEntry {
    name: string,
    r: int,
    g: int,
    b: int,
}

// One cell of a BrickColor wheel's 127-cell hexagon honeycomb. Pushed from
// Rust (`eustress_common::color_wheels::wheel_honeycomb`) into the Properties
// BrickColor picker. `x`/`y` are precomputed px offsets inside the 286x264
// honeycomb box so the layout lives in the data, not in a Slint expression.
export struct HoneycombCell {
    name: string,
    r: int,
    g: int,
    b: int,
    x: float,
    y: float,
}

// Property data structure
export struct PropertyData {
    name: string,
    value: string,
    property-type: string, // "string", "float", "int", "bool", "vec3", "color", "enum"
    category: string,
    editable: bool,
    options: [string], // For enum types
    // Section header flag: if true, this entry is a category header (not a property)
    is-header: bool,
    // When true, this property's section is collapsed and the row should be hidden
    section-collapsed: bool,
    // Vec3 parsed values (populated by Rust for vec3 types)
    x-value: string,
    y-value: string,
    z-value: string,
    // UDim2 parsed values (populated by Rust for udim2 types).
    // Order matches the on-disk canonical 4-tuple
    // `[scale_x, offset_x, scale_y, offset_y]`.
    x-scale: string,
    x-offset: string,
    y-scale: string,
    y-offset: string,
    // Color preview swatch — populated by Rust for color rows. Slint
    // can't parse the "r, g, b" string at runtime, so we pre-compute a
    // typed `color` here for the chip background.
    color-value: color,
    // Help tooltip text from TOML description field (empty = no icon shown)
    description: string,
    // URL path for the /learn documentation link (e.g. "/learn/atmosphere#density")
    learn-url: string,
    // Custom-attribute UX: when true this row is a user [attributes] entry and
    // gets the Roblox-style gear (change type) + red trash (delete) controls.
    is-attribute: bool,
    // AttributeValue type name for an attribute row (e.g. "String", "Number",
    // "Vector3", "Color3"). Shown as a small badge and used to prefill the
    // edit dialog's type dropdown.
    attribute-type: string,
    // Parameter rows only: where the value comes from. "" or "local" (the
    // instance owns it), "sourced" (read from a Connector), "published",
    // "relay" (read in and forwarded), or "faulted" (the last read failed).
    // Drawn as a dot beside the type badge; the row's help text says more.
    binding-state: string,
    // The label a row shows, when it differs from `name` (the key edits and
    // callbacks use). A Parameter in a named domain shows only its key, under
    // that domain's group row. Empty shows `name`.
    display-name: string,
    // Range for `property-type == "slider"`, read from the schema's min/max.
    slider-min: float,
    slider-max: float,
    // Text shown beside a slider instead of the raw number, so a value with a
    // domain the user does not think in (hours past 6am) can read as a clock.
    slider-display: string,
}

// The panel's metrics. Every row reads these, so the columns line up.
global PropStyle {
    out property <length> row-height: 24px;
    out property <length> field-height: 20px;
    // The row's vertical inset: (row-height - field-height) / 2.
    out property <length> row-inset: 2px;
    out property <length> pad-left: 6px;
    out property <length> pad-right: 8px;
    // Between the label column and the value column.
    out property <length> gap: 6px;
    // The help gutter, kept on every row so every label starts at one x.
    out property <length> help-width: 16px;
    out property <length> font: 11px;
    // Where text starts inside a field. Read-only values use the same inset,
    // so they line up with editable ones.
    out property <length> text-inset: 7px;

    // The label column: 36% of the row, between 80 and 128 px, which leaves
    // a three-field vector room at the narrowest docks.
    public pure function label-width(row: length) -> length {
        return max(80px, min(128px, row * 0.36));
    }
}

// Help icon button — shown left of property label when description is present.
// Displays a tooltip on hover; on click opens the /learn documentation page.
// A ring in the disabled grey; with a learn-url, hovering fills it cyan.
export component HelpIcon inherits Rectangle {
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;
    // Keep the gutter on a row without help, so its label lines up with the
    // rows that have it. The Properties rows set it; other callers keep the
    // old behaviour (no help, no gutter).
    in property <bool> reserve-space: false;
    // Keep the gutter but draw no icon (Attribute and Parameter rows show
    // their note on the binding dot instead).
    in property <bool> suppressed: false;
    // The gutter's width.
    in property <length> slot-width: 18px;

    callback open-learn-url(string);

    property <bool> shown: root.show-help-icons && root.description != "" && !root.suppressed;

    width: root.shown || (root.show-help-icons && root.reserve-space) ? root.slot-width : 0px;
    // Fills the row's height, with the circle centered in it. A fixed height
    // would sit at the top of the row's layout, above the label's midline.
    min-height: 14px;

    // Tooltip popup — uses PopupWindow so it renders above all panels
    help-popup := PopupWindow {
        x: 20px;
        y: -6px;
        width: min(300px, max(120px, root.description.character-count * 6.5px + 20px));
        height: tip-text.preferred-height + 12px;

        Rectangle {
            background: Theme.panel-background;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-color;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-float;

            tip-text := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                text: root.description;
                color: Theme.text-primary;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    if root.shown: tip-area := TouchArea {
        mouse-cursor: root.learn-url != "" ? pointer : default;
        clicked => {
            if root.learn-url != "" {
                root.open-learn-url(root.learn-url);
            }
        }
        moved => {
            if self.has-hover {
                help-popup.show();
            }
        }

        Rectangle {
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: tip-area.has-hover && root.learn-url != "" ? Theme.accent-cyan
                : tip-area.has-hover ? Theme.button-hover
                : transparent;
            border-width: 1px;
            border-color: tip-area.has-hover && root.learn-url != "" ? Theme.accent-cyan : Theme.text-disabled;

            Text {
                text: "?";
                color: tip-area.has-hover && root.learn-url != "" ? Theme.panel-background : Theme.text-secondary;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// The left half of every row: the help gutter and the label column. With
// `copyable`, a copy button sits at the right end of the label column, inside
// it, so the value column still starts where every other row's does.
component PropLabel inherits HorizontalLayout {
    in property <string> text;
    in property <string> description;
    in property <string> learn-url;
    in property <bool> show-help-icons: true;
    in property <bool> help-suppressed: false;
    // The label column's width: PropStyle.label-width less any indent.
    in property <length> column-width;
    in property <bool> copyable: false;
    callback open-learn-url(string);
    callback copy();

    spacing: 2px;

    HelpIcon {
        description: root.description;
        learn-url: root.learn-url;
        show-help-icons: root.show-help-icons;
        reserve-space: true;
        suppressed: root.help-suppressed;
        slot-width: PropStyle.help-width;
        open-learn-url(url) => { root.open-learn-url(url); }
    }
    Text {
        width: root.column-width - (root.copyable ? 18px : 0px);
        text: root.text;
        color: Theme.text-secondary;
        font-size: PropStyle.font;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.copyable: Rectangle {
        width: 18px;
        border-radius: 3px;
        background: copy-ta.has-hover ? Theme.button-hover : transparent;

        copy-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.copy(); }
        }
        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 11px;
            height: 11px;
            source: @image-url("../../assets/icons/ui/copy.svg");
            image-fit: contain;
            colorize: copy-ta.has-hover ? Theme.text-primary : Theme.text-disabled;
        }
    }
}

// An axis letter before a vector field, in the axis's gizmo colour.
component AxisTag inherits Text {
    width: 9px;
    font-size: 9px;
    font-weight: 700;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// A small up/down pair at the end of a rotation field: one degree a click.
component Stepper inherits Rectangle {
    callback up();
    callback down();

    width: 11px;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            border-radius: 2px;
            background: up-ta.has-hover ? Theme.button-hover : transparent;
            up-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.up(); }
            }
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                source: @image-url("../../assets/icons/ui/chevron-up.svg");
                image-fit: contain;
                colorize: up-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }
        Rectangle {
            border-radius: 2px;
            background: down-ta.has-hover ? Theme.button-hover : transparent;
            down-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.down(); }
            }
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                source: @image-url("../../assets/icons/ui/chevron-down.svg");
                image-fit: contain;
                colorize: down-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }
    }
}

// A category band: chevron, title and, on Attributes and Parameters, a "+".
// The chevron sits in the help gutter, so titles start where labels do.
component SectionHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> category: "";
    in-out property <bool> expanded: true;

    // Fired when chevron is clicked so parent can update model state
    callback clicked();
    // Fired when the "+" add button (Attributes and Parameters sections) is clicked
    callback add-clicked();

    height: PropStyle.row-height;
    background: header-ta.has-hover ? Theme.button-hover : Theme.header-background;

    // Bottom hairline
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border-color;
    }

    header-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // Do NOT toggle root.expanded locally — Rust is the single source of truth.
            // The callback fires on-section-toggle → Rust toggles collapsed_sections →
            // next sync pushes updated section-collapsed → expanded binding updates.
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: 4px;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: 0px;

        Rectangle {
            width: PropStyle.help-width;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 9px;
                height: 9px;
                source: root.expanded ? @image-url("../../assets/icons/ui/chevron-down.svg")
                    : @image-url("../../assets/icons/ui/chevron-right.svg");
                image-fit: contain;
                colorize: Theme.text-secondary;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.text-primary;
            font-size: PropStyle.font;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        // "+" add button on the Attributes and Parameters sections. Each
        // opens its own modal: an Attribute takes a name, type and value; a
        // Parameter also takes a domain and, optionally, a Connector to read.
        if root.category == "Attributes" || root.category == "Parameters": Rectangle {
            width: 20px;
            border-radius: 3px;
            background: add-ta.has-hover ? Theme.button-background : transparent;

            add-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.add-clicked(); }
            }
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                source: @image-url("../../assets/icons/ui/plus.svg");
                image-fit: contain;
                colorize: add-ta.has-hover ? Theme.accent-cyan : Theme.text-secondary;
            }
        }
    }
}

// Searchable material dropdown with scroll — shows all MaterialService options.
// Supports keyboard navigation: arrow keys move highlight, Enter confirms,
// letter keys jump to the first option starting with that letter (type-ahead).
// No visible text input — keys are consumed silently for fast selection.
component MaterialDropdown inherits Rectangle {
    in property <string> label: "Material";
    in property <string> value: "Plastic";
    in property <[string]> options: [];
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);
    // Type-ahead callback — Rust side finds matching option index.
    // Arguments: (pressed-key, current-highlight-index) -> new-index
    callback find-material-by-key(string, int) -> int;

    property <bool> dropdown-open: false;
    // Keyboard-highlighted option index (-1 = none)
    property <int> highlight-index: -1;

    height: PropStyle.row-height;

    // Focused while the list is open: the Bevy keybind gate
    // (`text_input_focused`) keeps Delete/Backspace and WASD for the list,
    // and the Properties sync waits. A CLOSED dropdown is not focused, even
    // though its scope keeps keyboard focus after a pick: counting that held
    // `any-input-has-focus` true, which froze the whole panel on its old
    // values until the user clicked another field ("the pick did not
    // apply", build 13).
    out property <bool> has-focus: root.dropdown-open;
    changed has-focus => { root.focus-changed(self.has-focus); }

    // The value just picked, shown at once until the rebuilt row brings the
    // applied value (a rebuild recreates the row, which clears it; a pick
    // that did not apply therefore shows its real value again).
    property <string> picked: "";
    property <string> shown: root.picked != "" ? root.picked : root.value;
    changed value => { root.picked = ""; }

    mat-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.DownArrow && root.dropdown-open {
                if root.highlight-index < root.options.length - 1 { root.highlight-index += 1; }
                else { root.highlight-index = 0; }
                return accept;
            }
            if event.text == Key.UpArrow && root.dropdown-open {
                if root.highlight-index > 0 { root.highlight-index -= 1; }
                else { root.highlight-index = root.options.length - 1; }
                return accept;
            }
            if event.text == Key.Return {
                if root.dropdown-open {
                    if root.highlight-index >= 0 && root.highlight-index < root.options.length {
                        root.picked = root.options[root.highlight-index];
                        root.value-changed(root.options[root.highlight-index]);
                    }
                    root.dropdown-open = false;
                    root.highlight-index = -1;
                    dropdown-popup.close();
                } else {
                    root.dropdown-open = true;
                    root.highlight-index = 0;
                    dropdown-popup.show();
                }
                return accept;
            }
            if event.text == Key.Escape && root.dropdown-open {
                root.dropdown-open = false;
                root.highlight-index = -1;
                dropdown-popup.close();
                return accept;
            }
            // Type-ahead: any other key calls Rust to find matching option
            if root.dropdown-open {
                if event.text == Key.Shift { return reject; }
                if event.text == Key.Control { return reject; }
                if event.text == Key.Alt { return reject; }
                root.highlight-index = root.find-material-by-key(event.text, root.highlight-index);
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            padding-left: PropStyle.pad-left;
            padding-right: PropStyle.pad-right;
            padding-top: PropStyle.row-inset;
            padding-bottom: PropStyle.row-inset;
            spacing: PropStyle.gap;

            PropLabel {
                text: root.label;
                description: root.description;
                learn-url: root.learn-url;
                show-help-icons: root.show-help-icons;
                column-width: PropStyle.label-width(root.width);
                open-learn-url(url) => { root.open-learn-url(url); }
            }

            // Dropdown button: the value, and a chevron that says it opens.
            mat-btn := Rectangle {
                horizontal-stretch: 1;
                background: mat-btn-touch.has-hover ? Theme.explorer-item-hover : Theme.input-background;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.dropdown-open || mat-focus.has-focus ? Theme.accent-cyan : Theme.input-border;

                mat-btn-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        mat-focus.focus();
                        root.dropdown-open = !root.dropdown-open;
                        if root.dropdown-open {
                            root.highlight-index = 0;
                            dropdown-popup.show();
                        } else {
                            root.highlight-index = -1;
                            dropdown-popup.close();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: PropStyle.text-inset - 1px;
                    padding-right: 6px;
                    spacing: 4px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.shown;
                        color: Theme.text-primary;
                        font-size: PropStyle.font;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Image {
                        width: 9px;
                        source: @image-url("../../assets/icons/ui/chevron-down.svg");
                        image-fit: contain;
                        colorize: Theme.text-secondary;
                    }
                }
            }
        }
    } // close FocusScope

    // Dropdown popup — uses PopupWindow to render above all other content.
    // Opens under the button, as wide as the button.
    dropdown-popup := PopupWindow {
        x: mat-btn.x;
        y: parent.height;
        width: mat-btn.width;
        height: min(320px, root.options.length * 23px + 8px);

        Rectangle {
            background: Theme.dialog-background;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-color;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow-float;
            width: 100%;
            height: 100%;

            // Prevent clicks from going through to viewport
            TouchArea { }

            VerticalLayout {
                padding: 4px;

                // Scrollable option list
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 1px;

                        for option[idx] in root.options: Rectangle {
                            height: 22px;
                            // Highlight keyboard-navigated row, hover row, or selected row
                            background: idx == root.highlight-index ? Theme.selection-background
                                : opt-touch.has-hover ? Theme.button-hover
                                : transparent;
                            border-radius: 3px;

                            opt-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.picked = option;
                                    root.value-changed(option);
                                    root.dropdown-open = false;
                                    root.highlight-index = -1;
                                    dropdown-popup.close();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                spacing: 6px;

                                // The current value's check, in the selection cyan.
                                Rectangle {
                                    width: 12px;
                                    if option == root.shown: Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 10px;
                                        height: 10px;
                                        source: @image-url("../../assets/icons/ui/check.svg");
                                        image-fit: contain;
                                        colorize: Theme.accent-cyan;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: option;
                                    color: Theme.text-primary;
                                    font-size: PropStyle.font;
                                    font-weight: option == root.shown ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        } // close inner Rectangle
    } // close PopupWindow

    // Close dropdown when clicking outside
    if root.dropdown-open: Rectangle {
        x: -1000px;
        y: -1000px;
        width: 10000px;
        height: 10000px;

        // This overlay behind the dropdown catches clicks outside
        TouchArea {
            clicked => {
                root.dropdown-open = false;
                root.highlight-index = -1;
            }
        }
    }
}

// A numeric property shown as a drag slider with a formatted readout.
//
// Used where the underlying number has a domain the user does not naturally
// think in — the time-of-day slider runs 6..30 hours so that a day reads left
// to right from dawn, and `display-text` renders it back as a clock.
component SliderRow inherits Rectangle {
    in property <string> label: "";
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    // Pre-formatted readout from Rust. Empty falls back to the rounded number,
    // so the row is still usable for a plain range.
    in property <string> display-text: "";
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    callback value-changed(string);
    callback open-learn-url(string);

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            open-learn-url(url) => { root.open-learn-url(url); }
        }

        slider := Slider {
            horizontal-stretch: 1;
            enabled: root.editable;
            minimum: root.minimum;
            maximum: root.maximum;
            value: root.value;
            // Fires continuously while dragging, so the sun moves under the
            // cursor rather than only on release.
            changed(v) => { root.value-changed(v); }
        }

        // Readout. Fixed width so the slider does not resize as the text
        // changes width while dragging.
        Text {
            width: 52px;
            text: root.display-text == "" ? round(slider.value) : root.display-text;
            color: Theme.text-primary;
            font-size: PropStyle.font;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A Parameter's binding state as a small dot: green while read from a source,
// blue when published, red when the last read failed. Hovering shows the
// binding's note (its source, how often it is read, and the last failure).
component StateDot inherits Rectangle {
    in property <string> state;
    in property <string> note;

    width: 12px;

    // Below and to the left: the dot sits near the panel's right edge.
    tip := PopupWindow {
        x: -236px;
        y: 16px;
        width: 248px;
        height: dot-tip-text.preferred-height + 12px;
        Rectangle {
            background: Theme.panel-background;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: root.state == "faulted" ? Theme.error-surface-border : Theme.border-color;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-float;
            dot-tip-text := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                text: root.note;
                color: Theme.text-primary;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
    dot-ta := TouchArea {
        changed has-hover => {
            if self.has-hover && root.note != "" {
                tip.show();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.state == "faulted" ? Theme.text-error
                    : root.state == "published" ? Theme.accent-blue
                    : Theme.text-success;
            }
        }
    }
}

// A value a Connector feeds: read-only, boxed like an editable value so values
// line up, with the binding's state dot inside. Hovering anywhere on it shows
// the binding's note.
component BoundValue inherits Rectangle {
    in property <string> value;
    in property <string> state;
    in property <string> note;

    background: Theme.background-tertiary;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.state == "faulted" ? Theme.error-surface-border : Theme.input-border;

    tip := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 220px);
        height: bound-tip-text.preferred-height + 12px;
        Rectangle {
            background: Theme.panel-background;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: root.state == "faulted" ? Theme.error-surface-border : Theme.border-color;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-float;
            bound-tip-text := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                text: root.note;
                color: Theme.text-primary;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
    bound-ta := TouchArea {
        changed has-hover => {
            if self.has-hover && root.note != "" {
                tip.show();
            }
        }
    }
    HorizontalLayout {
        padding-left: PropStyle.text-inset - 1px;
        padding-right: 6px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.state == "faulted" ? Theme.text-error
                    : root.state == "published" ? Theme.accent-blue
                    : Theme.text-success;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: root.state == "faulted" ? Theme.text-secondary : Theme.text-primary;
            font-size: PropStyle.font;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A domain's group row inside Parameters: the domain's name and a rule. The
// Parameters under it show only their keys. Starts where labels start.
component ParamGroupRow inherits Rectangle {
    in property <string> domain;
    height: PropStyle.row-height;
    HorizontalLayout {
        padding-left: PropStyle.pad-left + PropStyle.help-width;
        padding-right: PropStyle.pad-right;
        spacing: 8px;
        Text {
            text: root.domain;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.4px;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: Theme.border-color;
            }
        }
    }
}

// A muted line under an empty section, saying what the section is for and how
// to add the first entry. Starts where labels start.
component SectionHint inherits Rectangle {
    in property <string> text;
    height: section-hint-text.preferred-height + 10px;
    section-hint-text := Text {
        x: PropStyle.pad-left + PropStyle.help-width;
        y: 5px;
        width: parent.width - self.x - PropStyle.pad-right;
        text: root.text;
        color: Theme.text-disabled;
        font-size: 10px;
        wrap: word-wrap;
    }
}

component PropRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> prop-type: "string";
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;
    // Roblox-style custom-attribute controls: when true, render a type badge,
    // a gear (change type / edit) icon, and a red trash (delete) icon.
    in property <bool> is-attribute: false;
    in property <string> attribute-type: "";
    // Parameter rows: "" / "local", "sourced", "published", "relay" or
    // "faulted". Anything but local draws a coloured dot before the badge.
    in property <string> binding-state: "";
    // Shown instead of `label` when set (a Parameter's key under its domain's
    // group row); callbacks still carry `label`.
    in property <string> display-label: "";
    // Extra left inset, for a row under a group row. The value column stays
    // aligned because the label column narrows by the same amount.
    in property <length> indent: 0px;

    // Expose focus state so parent can aggregate across all rows
    out property <bool> has-focus: input-edit.has-focus;

    // Fire focus-changed immediately on click-in / tab-out so the
    // Delete key doesn't delete the selected part while the user is
    // typing (the `edited(text)` callback below reports focus too, but
    // only once a first keystroke has landed).
    //
    // This is also where a value COMMITS on focus-loss. `edited` no longer
    // commits per keystroke, so leaving the field is one of the two ways an
    // edit lands (the other is Enter, via `accepted`). Guarded on an actual
    // difference so tabbing through untouched rows sprays no no-op writes.
    changed has-focus => {
        root.focus-changed(self.has-focus);
        if (!self.has-focus && input-edit.text != root.value) {
            root.value-changed(input-edit.text);
        }
    }

    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);
    // Attribute row: gear clicked → open edit dialog (passes name, type, value).
    callback gear-clicked(string, string, string);
    // Attribute row: trash clicked → delete this attribute (passes name).
    callback trash-clicked(string);

    // Hidden focus sink used by `accepted()` handlers to move focus away
    // from the field on Enter. Without this, pressing Enter commits the
    // value but the input keeps its focused-state highlight until the user
    // clicks elsewhere. Sized 0×0 so it's invisible; sits outside the layout
    // so it doesn't claim space.
    focus_sink := FocusScope { width: 0px; height: 0px; }

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left + root.indent;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        // Attribute and Parameter rows show their note on the state dot
        // instead of a help icon; the gutter stays so labels line up.
        PropLabel {
            text: root.display-label != "" ? root.display-label : root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            help-suppressed: root.is-attribute;
            column-width: PropStyle.label-width(root.width) - root.indent;
            open-learn-url(url) => { root.open-learn-url(url); }
        }

        // The value slot: an editable field, a value a Connector feeds, or
        // plain text. One slot whichever it holds, so every value starts at
        // the same x (and a read-only Attribute or Parameter value lines up
        // with editable ones).
        // A small minimum, so a narrow dock never pushes the row past the
        // panel edge.
        Rectangle {
            horizontal-stretch: 1;
            min-width: 32px;

            input-edit := KitField {
                width: 100%;
                height: 100%;
                visible: root.editable;
                enabled: root.editable;
                font-size: PropStyle.font;
                text: root.value;
                // Report focus only — do NOT commit per keystroke.
                //
                // Committing on every keystroke wrote the part's TOML and
                // rebuilt the whole property model once per character, and the
                // rebuild re-bound this field's `text` mid-typing, which is
                // what made the panel feel unresponsive. It also applied
                // meaningless intermediates: typing "0,120,215" set the part to
                // 0,120,2 (a green) on the way through.
                //
                // Commit now happens on Enter (`accepted`, below) and on
                // focus-loss (`changed has-focus` on the row), which is the
                // same contract the rest of the panel's fields already use.
                edited(text) => {
                    root.focus-changed(true);
                }
                accepted(text) => {
                    root.value-changed(self.text);
                    // Drop the field's focused state so the row no
                    // longer shows the active-input highlight.
                    focus_sink.focus();
                }
            }

            // A read-only Attribute or Parameter value: a Connector feeds it.
            if !root.editable && root.is-attribute: BoundValue {
                width: 100%;
                height: 100%;
                value: root.value;
                state: root.binding-state;
                note: root.description;
            }

            // Any other read-only value: plain text at the field's text inset.
            if !root.editable && !root.is-attribute: Text {
                x: PropStyle.text-inset;
                width: parent.width - PropStyle.text-inset;
                height: 100%;
                text: root.value;
                color: Theme.text-primary;
                font-size: PropStyle.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ── Attribute controls (type badge + gear + trash) ──
        if root.is-attribute: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 2px;

            // Binding state of an editable Parameter (published): a dot whose
            // hover shows the note. A read-only one carries its dot inside
            // its value box.
            if root.editable && root.binding-state != "" && root.binding-state != "local": StateDot {
                state: root.binding-state;
                note: root.description;
            }

            // Type badge, as wide as its text
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                Rectangle {
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.background-tertiary;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.attribute-type;
                            color: Theme.text-secondary;
                            font-size: 9px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Gear (change type / edit) icon
            Rectangle {
                width: 20px;
                border-radius: 3px;
                background: gear-ta.has-hover ? Theme.button-hover : transparent;
                gear-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.gear-clicked(root.label, root.attribute-type, root.value); }
                }
                Image {
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../assets/icons/ui/settings.svg");
                    image-fit: contain;
                    colorize: gear-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }

            // Trash (delete) icon — red on hover
            Rectangle {
                width: 20px;
                border-radius: 3px;
                background: trash-ta.has-hover ? Theme.error-surface-hover : transparent;
                trash-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.trash-clicked(root.label); }
                }
                Image {
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../assets/icons/ui/delete.svg");
                    image-fit: contain;
                    colorize: trash-ta.has-hover ? Theme.text-error : Theme.text-secondary;
                }
            }
        }
    }
}

// Vec3 property row: an axis letter and a field for each of X, Y and Z.
// Value format: "x, y, z" (comma-separated). The copy button sits at the end
// of the label column.
component Vec3Row inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "0, 0, 0"; // "x, y, z" format
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    // Parsed values (split from value string)
    in property <string> x-value: "0";
    in property <string> y-value: "0";
    in property <string> z-value: "0";

    // Expose focus state so parent can aggregate across all rows
    out property <bool> has-focus: x-edit.has-focus || y-edit.has-focus || z-edit.has-focus;

    // Fire focus-changed the INSTANT any of the three fields gains
    // or loses focus — not just on the first keystroke. Without this
    // binding the `edited(text)` callback below only fires after the
    // user types, leaving a window where the field is focused but
    // Bevy thinks no input is active and the Delete key deletes the
    // selected part instead of a character.
    changed has-focus => { root.focus-changed(self.has-focus); }

    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);
    // Fired when the user clicks the copy icon. The argument is the full
    // "x, y, z" triple so the parent can push it to the OS clipboard without
    // re-parsing the field state.
    callback copy-vector(string);
    // Paste has no button: the fields are plain text, so a Ctrl+V of
    // "5, 10, 20" keeps its commas, and on Enter the Rust handler reads the
    // three parts and applies them together. Kept for callers.
    callback paste-vector();

    // Hidden focus sink — see PropRow for rationale. Pressing Enter in
    // any of the three fields hops focus here so the field defocuses
    // visually.
    focus_sink := FocusScope { width: 0px; height: 0px; }

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            copyable: true;
            open-learn-url(url) => { root.open-learn-url(url); }
            copy => { root.copy-vector(x-edit.text + ", " + y-edit.text + ", " + z-edit.text); }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            AxisTag { text: "X"; color: Theme.gizmo-x; }
            x-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.x-value;
                // A plain text field (not decimal-only), so Ctrl+V of a pasted
                // triple like "5, 10, 20" keeps its commas: the Rust
                // value-changed handler reads three or more comma parts and
                // applies them to X, Y and Z together.
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                }
                accepted(t) => {
                    root.value-changed(self.text + ", " + y-edit.text + ", " + z-edit.text);
                    focus_sink.focus();
                }
            }

            AxisTag { text: "Y"; color: Theme.gizmo-y; }
            y-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.y-value;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                }
                accepted(t) => {
                    root.value-changed(x-edit.text + ", " + self.text + ", " + z-edit.text);
                    focus_sink.focus();
                }
            }

            AxisTag { text: "Z"; color: Theme.gizmo-z; }
            z-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.z-value;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                }
                accepted(t) => {
                    root.value-changed(x-edit.text + ", " + y-edit.text + ", " + self.text);
                    focus_sink.focus();
                }
            }
        }
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Vec2Row — Vector2 of pixel values (e.g. `BillboardGui.SizeOffset`,
// `Frame.AnchorPoint`). Vec3Row without the Z field. Roblox-style Vector2 is
// pure pixels (no Scale column), so neither field carries a "Pixels"
// sub-label; the row's name already says what it is.
// ────────────────────────────────────────────────────────────────────────────
component Vec2Row inherits Rectangle {
    in property <string> label: "";
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;
    in property <string> x-value: "0";
    in property <string> y-value: "0";

    out property <bool> has-focus: x-edit.has-focus || y-edit.has-focus;
    changed has-focus => { root.focus-changed(self.has-focus); }
    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);
    callback copy-vector(string);

    focus_sink := FocusScope { width: 0px; height: 0px; }

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            copyable: true;
            open-learn-url(url) => { root.open-learn-url(url); }
            copy => { root.copy-vector(x-edit.text + ", " + y-edit.text); }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            AxisTag { text: "X"; color: Theme.gizmo-x; }
            x-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.x-value;
                enabled: root.editable;
                edited(t) => { root.focus-changed(true); }
                accepted(t) => {
                    root.value-changed(self.text + ", " + y-edit.text);
                    focus_sink.focus();
                }
            }

            AxisTag { text: "Y"; color: Theme.gizmo-y; }
            y-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.y-value;
                enabled: root.editable;
                edited(t) => { root.focus-changed(true); }
                accepted(t) => {
                    root.value-changed(x-edit.text + ", " + self.text);
                    focus_sink.focus();
                }
            }
        }
    }
}

// ────────────────────────────────────────────────────────────────────────────
// UDim2Row — Roblox-parity 2D layout coordinate (Position / Size).
// A label line with the copy button, then one line per axis with its Scale
// and Pixels fields (the Roblox `UDim` Offset component is shown as "Pixels":
// "Offset" is ambiguous next to a position/size widget).
//
//   Size                                   [copy]
//     X  Scale [ 0   ]   Pixels [ 200 ]
//     Y  Scale [ 0   ]   Pixels [ 50  ]
//
// Roblox-parity semantics:
//   final_pixels = Scale * parent_resolved_pixels + Pixels
// So `Scale = 1, Pixels = 0` fills the parent; `Scale = 0, Pixels = 200`
// is a fixed 200-px region. (For `BillboardGui.Size` specifically, the
// "parent" is the world stud-to-pixel reference rather than a UI parent
// — Scale is interpreted as studs.)
// ────────────────────────────────────────────────────────────────────────────
component UDim2Row inherits Rectangle {
    in property <string> label: "";
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    in property <string> x-scale: "0";
    in property <string> x-offset: "0";
    in property <string> y-scale: "0";
    in property <string> y-offset: "0";

    out property <bool> has-focus:
        xs.has-focus || xo.has-focus || ys.has-focus || yo.has-focus;
    changed has-focus => { root.focus-changed(self.has-focus); }

    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);
    callback copy-vector(string);

    // Hidden focus sink — see PropRow for rationale.
    focus_sink := FocusScope { width: 0px; height: 0px; }

    // Three 20px lines, 2px apart, inside the row's 2px insets. Explicit,
    // because Slint's `preferred-height` doesn't propagate through a
    // `for prop[i]` loop and the host layout sizes the row from this.
    height: 3 * PropStyle.field-height + 2 * 2px + 2 * PropStyle.row-inset;

    VerticalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: 2px;

        // ── Label line: label + copy button ────────────────────────────
        HorizontalLayout {
            height: PropStyle.field-height;
            PropLabel {
                text: root.label;
                description: root.description;
                learn-url: root.learn-url;
                show-help-icons: root.show-help-icons;
                column-width: PropStyle.label-width(root.width);
                copyable: true;
                open-learn-url(url) => { root.open-learn-url(url); }
                copy => {
                    root.copy-vector(xs.text + ", " + xo.text + ", " + ys.text + ", " + yo.text);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // ── X-axis line: Scale | Pixels ────────────────────────────────
        HorizontalLayout {
            height: PropStyle.field-height;
            padding-left: PropStyle.help-width;
            spacing: 4px;
            AxisTag { text: "X"; color: Theme.gizmo-x; }
            Text {
                width: 30px;
                text: "Scale";
                color: Theme.text-disabled;
                font-size: 10px;
                vertical-alignment: center;
            }
            xs := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.x-scale;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                    root.value-changed(t + ", " + xo.text + ", " + ys.text + ", " + yo.text);
                }
                accepted(t) => {
                    root.value-changed(t + ", " + xo.text + ", " + ys.text + ", " + yo.text);
                    focus_sink.focus();
                }
            }
            Text {
                width: 34px;
                text: "Pixels";
                color: Theme.text-disabled;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            xo := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.x-offset;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                    root.value-changed(xs.text + ", " + t + ", " + ys.text + ", " + yo.text);
                }
                accepted(t) => {
                    root.value-changed(xs.text + ", " + t + ", " + ys.text + ", " + yo.text);
                    focus_sink.focus();
                }
            }
        }

        // ── Y-axis line: Scale | Pixels ────────────────────────────────
        HorizontalLayout {
            height: PropStyle.field-height;
            padding-left: PropStyle.help-width;
            spacing: 4px;
            AxisTag { text: "Y"; color: Theme.gizmo-y; }
            Text {
                width: 30px;
                text: "Scale";
                color: Theme.text-disabled;
                font-size: 10px;
                vertical-alignment: center;
            }
            ys := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.y-scale;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                    root.value-changed(xs.text + ", " + xo.text + ", " + t + ", " + yo.text);
                }
                accepted(t) => {
                    root.value-changed(xs.text + ", " + xo.text + ", " + t + ", " + yo.text);
                    focus_sink.focus();
                }
            }
            Text {
                width: 34px;
                text: "Pixels";
                color: Theme.text-disabled;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            yo := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.y-offset;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                    root.value-changed(xs.text + ", " + xo.text + ", " + ys.text + ", " + t);
                }
                accepted(t) => {
                    root.value-changed(xs.text + ", " + xo.text + ", " + ys.text + ", " + t);
                    focus_sink.focus();
                }
            }
        }
    }
}

// Rotation row: degrees, negatives allowed, with a one-degree stepper at the
// end of each field when the dock is wide enough to hold them. A stepper click sends "step:<axis>:±1:<x>,<y>,<z>", which
// Rust's on-property-changed applies to the current value; a typed edit sends
// "x, y, z" as usual.
component RotationVec3Row inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "0, 0, 0";
    in property <bool> editable: true;
    in property <string> x-value: "0";
    in property <string> y-value: "0";
    in property <string> z-value: "0";
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    // Expose focus state so parent can aggregate across all rows
    out property <bool> has-focus: rx-edit.has-focus || ry-edit.has-focus || rz-edit.has-focus;

    // Fire focus-changed on actual focus transitions — see Vec3Row
    // for the Delete-key-deletes-selected-part rationale.
    changed has-focus => { root.focus-changed(self.has-focus); }

    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);
    // Matches `Vec3Row` — copy pushes the current triple; paste asks
    // the parent/Rust to read the clipboard and drive a value-changed.
    callback copy-vector(string);
    callback paste-vector();

    // Hidden focus sink — see PropRow for rationale.
    focus_sink := FocusScope { width: 0px; height: 0px; }

    // The steppers need room: on a narrow dock the three fields keep it
    // instead, and the value is typed.
    property <bool> show-steppers: root.width >= 360px;

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            copyable: true;
            open-learn-url(url) => { root.open-learn-url(url); }
            copy => { root.copy-vector(rx-edit.text + ", " + ry-edit.text + ", " + rz-edit.text); }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            AxisTag { text: "X"; color: Theme.gizmo-x; }
            rx-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.x-value;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                }
                accepted(t) => {
                    root.value-changed(self.text + ", " + ry-edit.text + ", " + rz-edit.text);
                    focus_sink.focus();
                }
            }
            if root.show-steppers: Stepper {
                up => { root.value-changed("step:x:+1:" + rx-edit.text + "," + ry-edit.text + "," + rz-edit.text); }
                down => { root.value-changed("step:x:-1:" + rx-edit.text + "," + ry-edit.text + "," + rz-edit.text); }
            }

            AxisTag { text: "Y"; color: Theme.gizmo-y; }
            ry-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.y-value;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                }
                accepted(t) => {
                    root.value-changed(rx-edit.text + ", " + self.text + ", " + rz-edit.text);
                    focus_sink.focus();
                }
            }
            if root.show-steppers: Stepper {
                up => { root.value-changed("step:y:+1:" + rx-edit.text + "," + ry-edit.text + "," + rz-edit.text); }
                down => { root.value-changed("step:y:-1:" + rx-edit.text + "," + ry-edit.text + "," + rz-edit.text); }
            }

            AxisTag { text: "Z"; color: Theme.gizmo-z; }
            rz-edit := KitField {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: PropStyle.font;
                text: root.z-value;
                enabled: root.editable;
                edited(t) => {
                    root.focus-changed(true);
                }
                accepted(t) => {
                    root.value-changed(rx-edit.text + ", " + ry-edit.text + ", " + self.text);
                    focus_sink.focus();
                }
            }
            if root.show-steppers: Stepper {
                up => { root.value-changed("step:z:+1:" + rx-edit.text + "," + ry-edit.text + "," + rz-edit.text); }
                down => { root.value-changed("step:z:-1:" + rx-edit.text + "," + ry-edit.text + "," + rz-edit.text); }
            }
        }
    }
}

// One tile in the 127-swatch ColorPickerPopup honeycomb. The chip is
// rendered as a real hexagon (Slint Path) so the wheel reads as a
// proper hex tessellation rather than a circle grid; tightly-packed
// flat-top hexes nest perfectly against one another. Hover shows a
// floating name tag above the chip — pixel real-estate is too tight
// for inline labels at this density.
//
// Cell box is 22×19 px; the hex chip occupies 18×16 of that, leaving
// a 2-px gutter so adjacent cells read as discrete clickable targets
// rather than a single mottled blob.
export component ColorSwatchCell inherits Rectangle {
    in property <string> swatch-name: "";
    in property <int> r: 128;
    in property <int> g: 128;
    in property <int> b: 128;
    callback swatch-clicked();

    width: 22px;
    height: 19px;

    // Flat-top regular hexagon. For a hex of width 18 px and height
    // 16 px, the six vertices are at:
    //   left mid, top-left, top-right, right mid, bottom-right, bottom-left
    // Stroke + fill driven by hover state so the active swatch reads
    // visibly against its neighbours.
    chip := Path {
        x: 2px;
        y: 1.5px;
        width: 18px;
        height: 16px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 18;
        viewbox-height: 16;
        fill: rgb(root.r, root.g, root.b);
        stroke: touch.has-hover ? Theme.accent-cyan : #20202080;  // theme-exempt: semi-transparent swatch outline, no alpha border token
        stroke-width: touch.has-hover ? 1.5px : 0.5px;
        commands: "M 0 8 L 4.5 0 L 13.5 0 L 18 8 L 13.5 16 L 4.5 16 Z";
        animate stroke-width { duration: 80ms; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.swatch-clicked(); }
    }

    // Hover-only floating name. Sits ABOVE the chip so it doesn't
    // collide with the hex packing of neighbouring cells.
    if touch.has-hover: Rectangle {
        x: -40px;
        y: -22px;
        width: 100px;
        height: 18px;
        background: Theme.dialog-background;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-color;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.shadow-float;
        Text {
            text: root.swatch-name;
            color: Theme.text-primary;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}

// Colors committed from any ColorRow picker this Studio session, newest
// first. A global, so every color row shares one list and the list outlives
// the rows the Properties panel rebuilds on each refresh. Eight fixed slots;
// `count` says how many are filled.
global ColorPickerRecents {
    in-out property <[color]> colors: [
        Colors.transparent, Colors.transparent, Colors.transparent, Colors.transparent,
        Colors.transparent, Colors.transparent, Colors.transparent, Colors.transparent
    ];
    in-out property <int> count: 0;
}

// One captioned field in the ColorRow picker (Hex, R, G, B, H, S, V).
//
// The text follows `display` until the user types. Typed text is a draft,
// reported through `accepted` on Enter or when the field loses focus (Tab, a
// click into another field), then replaced by `display` as it landed (clamped,
// normalised). Bumping `reset-epoch` drops a draft: the picker does that when a
// drag or a swatch changes the color, so a half-typed number can never land
// on top of that change.
component ColorPickerField inherits Rectangle {
    in property <string> caption;
    in property <color> caption-color: Theme.text-secondary;
    in property <length> caption-width: 10px;
    in property <string> display;
    in property <string> unit: "";
    in property <int> reset-epoch: 0;
    callback accepted(string);
    callback edited();

    property <bool> dirty: false;

    changed display => {
        if !root.dirty {
            input.text = root.display;
        }
    }
    changed reset-epoch => {
        root.dirty = false;
        input.text = root.display;
    }

    height: 22px;

    HorizontalLayout {
        spacing: 4px;

        Text {
            width: root.caption-width;
            text: root.caption;
            color: root.caption-color;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.input-background;
            border-radius: 3px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent-cyan : Theme.input-border;

            input := TextInput {
                x: 5px;
                width: parent.width - 10px - (root.unit != "" ? 8px : 0px);
                height: 100%;
                text: root.display;
                color: Theme.text-primary;
                font-size: 11px;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.dirty = true;
                    root.edited();
                }
                accepted => {
                    root.dirty = false;
                    root.accepted(self.text);
                    self.text = root.display;
                }
                changed has-focus => {
                    if !self.has-focus && root.dirty {
                        root.dirty = false;
                        root.accepted(self.text);
                        self.text = root.display;
                    }
                }
            }

            if root.unit != "": Text {
                x: parent.width - self.width - 5px;
                height: 100%;
                text: root.unit;
                color: Theme.text-disabled;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
}

// Color property row: a swatch that opens the picker, and a text field that
// takes "r, g, b" or hex.
//
// The picker edits a local color while it is open: a saturation/value square
// over a hue strip, Hex, RGB and HSV fields, an old/new swatch, preset
// swatches and this session's recent colors. It commits through
// `value-changed` only when a gesture ends (pointer released, field entered,
// swatch clicked), so a drag writes the instance file once instead of once per
// frame. While the picker is open the row reports focus, which pauses the
// panel sync; without that, the first commit would rebuild this row and close
// the picker under the pointer.
component ColorRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "#808080";
    // Live preview color, populated by Rust from the same RGB the
    // `value` string represents. Used for the swatch chip: Slint can't
    // parse the "r, g, b" string into a typed color at runtime so the
    // parsing has to happen Rust-side.
    in property <color> preview-color: #808080;  // theme-exempt: neutral placeholder, runtime-overridden by Rust color-value
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    // Expose focus state so parent can aggregate across all rows
    out property <bool> has-focus: color-edit.has-focus;

    callback value-changed(string);
    callback open-learn-url(string);
    callback focus-changed(bool);

    // Hidden focus sink (see PropRow for rationale).
    focus_sink := FocusScope { width: 0px; height: 0px; }

    // The picker's working color as 0-255 channels. Seeded from
    // `preview-color` when the picker opens (a `color` exposes typed
    // .red/.green/.blue channels, the "r, g, b" string does not), and kept in
    // step with the HSV state below by `set-hsv` and `set-rgb`.
    in-out property <float> r-val: 128;
    in-out property <float> g-val: 128;
    in-out property <float> b-val: 128;

    // ── Hex helpers ─────────────────────────────────────────────────────
    // Slint has no integer formatting, so the two nibbles are spelled out.
    // Kept here rather than pushed from Rust so the fields track a drag
    // live, without a round-trip on every frame.
    pure function hex-nibble(v: int) -> string {
        v == 0  ? "0" : v == 1  ? "1" : v == 2  ? "2" : v == 3  ? "3" :
        v == 4  ? "4" : v == 5  ? "5" : v == 6  ? "6" : v == 7  ? "7" :
        v == 8  ? "8" : v == 9  ? "9" : v == 10 ? "A" : v == 11 ? "B" :
        v == 12 ? "C" : v == 13 ? "D" : v == 14 ? "E" : "F"
    }
    pure function hex-byte(v: float) -> string {
        hex-nibble(Math.floor(Math.clamp(Math.round(v), 0, 255) / 16))
            + hex-nibble(Math.mod(Math.clamp(Math.round(v), 0, 255), 16))
    }
    // `#RRGGBB` for the current channel values.
    out property <string> hex-text:
        "#" + root.hex-byte(root.r-val) + root.hex-byte(root.g-val) + root.hex-byte(root.b-val);

    // ── Picker state ────────────────────────────────────────────────────
    // HSV is what the square and the strip draw. Hue survives greys and
    // saturation survives black (RGB carries neither), so the handles stay
    // where they were when the color passes through those.
    property <float> hsv-h: 0;      // degrees, 0-360
    property <float> hsv-s: 0;      // 0-1
    property <float> hsv-v: 0.5;    // 0-1
    property <color> picked: rgb(Math.round(root.r-val), Math.round(root.g-val), Math.round(root.b-val));
    property <string> rgb-text: Math.round(root.r-val) + ", " + Math.round(root.g-val) + ", " + Math.round(root.b-val);
    // The color the picker opened on: the "old" half of the old/new swatch.
    property <color> original-color: #808080;  // theme-exempt: neutral placeholder, set from preview-color when the picker opens
    // Last value sent through `value-changed`, so a release that moved
    // nothing writes nothing.
    property <string> committed-text: "";
    // Whether this opening of the picker already holds a recent-colors slot.
    property <bool> recent-claimed: false;
    // Bumped when a drag or a swatch changes the color; the fields drop any
    // half-typed draft (see ColorPickerField).
    property <int> draft-epoch: 0;
    // Name and hex of the swatch under the pointer, shown in the header.
    property <string> hover-caption: "";

    // Focus is reported while the text field is focused OR the picker is
    // open. It pauses the panel sync (and keeps keys away from the viewport);
    // closing the picker, however it closes, hands the panel back.
    property <bool> editing: color-edit.has-focus || color-picker-popup.is-open;
    changed editing => {
        root.focus-changed(self.editing);
    }

    // ── Color math ──────────────────────────────────────────────────────
    // Move to an HSV point; the channels follow (Slint's `hsv()` rounds to
    // 8 bits, which is exactly the 0-255 the property stores).
    function set-hsv(h: float, s: float, v: float) {
        root.hsv-h = Math.clamp(h, 0, 360);
        root.hsv-s = Math.clamp(s, 0, 1);
        root.hsv-v = Math.clamp(v, 0, 1);
        let from-hsv = hsv(root.hsv-h, root.hsv-s, root.hsv-v);
        root.r-val = from-hsv.red;
        root.g-val = from-hsv.green;
        root.b-val = from-hsv.blue;
    }

    // Set the channels; HSV follows, keeping the hue of a grey and the
    // saturation of black.
    function set-rgb(r: float, g: float, b: float) {
        root.r-val = Math.clamp(Math.round(r), 0, 255);
        root.g-val = Math.clamp(Math.round(g), 0, 255);
        root.b-val = Math.clamp(Math.round(b), 0, 255);
        let as-hsv = rgb(root.r-val, root.g-val, root.b-val).to-hsv();
        if as-hsv.saturation > 0 {
            root.hsv-h = as-hsv.hue;
        }
        if as-hsv.value > 0 {
            root.hsv-s = as-hsv.saturation;
        }
        root.hsv-v = as-hsv.value;
    }

    pure function hex-of(c: color) -> string {
        "#" + root.hex-byte(c.red) + root.hex-byte(c.green) + root.hex-byte(c.blue)
    }

    // ── Hex parsing ─────────────────────────────────────────────────────
    // Slint strings have no indexing, but they do compare. Uppercase hex
    // spellings of one length sort exactly like the numbers they spell ('0'-'9'
    // sort before 'A'-'F'), so halving the range 24 times finds the largest
    // value whose "#RRGGBB" sorts at or before the text. When the text IS a
    // color, that value spells it back exactly; anything else does not.
    pure function hex24(v: float) -> string {
        "#" + root.hex-byte(Math.floor(v / 65536))
            + root.hex-byte(Math.mod(Math.floor(v / 256), 256))
            + root.hex-byte(Math.mod(v, 256))
    }
    pure function hex12(v: float) -> string {
        "#" + root.hex-nibble(Math.floor(v / 256))
            + root.hex-nibble(Math.mod(Math.floor(v / 16), 16))
            + root.hex-nibble(Math.mod(v, 16))
    }
    pure function hex6-floor(s: string) -> float {
        let f23 = root.hex24(8388608) <= s ? 8388608 : 0;
        let f22 = f23 + (root.hex24(f23 + 4194304) <= s ? 4194304 : 0);
        let f21 = f22 + (root.hex24(f22 + 2097152) <= s ? 2097152 : 0);
        let f20 = f21 + (root.hex24(f21 + 1048576) <= s ? 1048576 : 0);
        let f19 = f20 + (root.hex24(f20 + 524288) <= s ? 524288 : 0);
        let f18 = f19 + (root.hex24(f19 + 262144) <= s ? 262144 : 0);
        let f17 = f18 + (root.hex24(f18 + 131072) <= s ? 131072 : 0);
        let f16 = f17 + (root.hex24(f17 + 65536) <= s ? 65536 : 0);
        let f15 = f16 + (root.hex24(f16 + 32768) <= s ? 32768 : 0);
        let f14 = f15 + (root.hex24(f15 + 16384) <= s ? 16384 : 0);
        let f13 = f14 + (root.hex24(f14 + 8192) <= s ? 8192 : 0);
        let f12 = f13 + (root.hex24(f13 + 4096) <= s ? 4096 : 0);
        let f11 = f12 + (root.hex24(f12 + 2048) <= s ? 2048 : 0);
        let f10 = f11 + (root.hex24(f11 + 1024) <= s ? 1024 : 0);
        let f9 = f10 + (root.hex24(f10 + 512) <= s ? 512 : 0);
        let f8 = f9 + (root.hex24(f9 + 256) <= s ? 256 : 0);
        let f7 = f8 + (root.hex24(f8 + 128) <= s ? 128 : 0);
        let f6 = f7 + (root.hex24(f7 + 64) <= s ? 64 : 0);
        let f5 = f6 + (root.hex24(f6 + 32) <= s ? 32 : 0);
        let f4 = f5 + (root.hex24(f5 + 16) <= s ? 16 : 0);
        let f3 = f4 + (root.hex24(f4 + 8) <= s ? 8 : 0);
        let f2 = f3 + (root.hex24(f3 + 4) <= s ? 4 : 0);
        let f1 = f2 + (root.hex24(f2 + 2) <= s ? 2 : 0);
        let f0 = f1 + (root.hex24(f1 + 1) <= s ? 1 : 0);
        f0
    }
    pure function hex3-floor(s: string) -> float {
        let t11 = root.hex12(2048) <= s ? 2048 : 0;
        let t10 = t11 + (root.hex12(t11 + 1024) <= s ? 1024 : 0);
        let t9 = t10 + (root.hex12(t10 + 512) <= s ? 512 : 0);
        let t8 = t9 + (root.hex12(t9 + 256) <= s ? 256 : 0);
        let t7 = t8 + (root.hex12(t8 + 128) <= s ? 128 : 0);
        let t6 = t7 + (root.hex12(t7 + 64) <= s ? 64 : 0);
        let t5 = t6 + (root.hex12(t6 + 32) <= s ? 32 : 0);
        let t4 = t5 + (root.hex12(t5 + 16) <= s ? 16 : 0);
        let t3 = t4 + (root.hex12(t4 + 8) <= s ? 8 : 0);
        let t2 = t3 + (root.hex12(t3 + 4) <= s ? 4 : 0);
        let t1 = t2 + (root.hex12(t2 + 2) <= s ? 2 : 0);
        let t0 = t1 + (root.hex12(t1 + 1) <= s ? 1 : 0);
        t0
    }
    // "#" in front of `upper` unless it already starts with one. Every string
    // that starts with '#' sorts from "#" up to, but not including, "$" (the
    // next character).
    pure function spell-hex(upper: string) -> string {
        upper >= "#" && upper < "$" ? upper : "#" + upper
    }
    // The 24-bit value of "#RRGGBB", "RRGGBB", "#RGB" or "RGB" (any case), or
    // -1 when the text is not hex.
    pure function hex-value(t: string) -> float {
        root.hex-value-spelled(root.spell-hex(t.to-uppercase()))
    }
    // `hex-value` for text already uppercase and starting with "#".
    //
    // The text is a parameter, never a `let` local, on purpose: Slint's Rust
    // code clones a parameter at every use but moves a string local into the
    // first function it is passed to, so a local passed to two functions
    // does not compile (E0382 in build 8).
    pure function hex-value-spelled(s: string) -> float {
        let six = root.hex6-floor(s);
        let three = root.hex3-floor(s);
        s.character-count == 7 && root.hex24(six) == s ? six
            : s.character-count == 4 && root.hex12(three) == s
                ? Math.floor(three / 256) * 17 * 65536
                    + Math.mod(Math.floor(three / 16), 16) * 17 * 256
                    + Math.mod(three, 16) * 17
                : -1
    }

    // ── Recent colors ───────────────────────────────────────────────────
    pure function recent-at(i: int) -> color {
        i >= 0 && i < ColorPickerRecents.count ? ColorPickerRecents.colors[i] : transparent
    }

    // Put `c` at the front of the recent colors, without duplicates. One slot
    // per opening of the picker: later commits in the same opening replace
    // it, so fine-tuning with several drags leaves one color, not eight.
    function remember(c: color) {
        let skip = (root.recent-claimed && ColorPickerRecents.count > 0) ? 1 : 0;
        let kept = ColorPickerRecents.count - skip;
        // Where `c` already sits among the kept entries, or `kept` when new.
        let at = root.recent-at(skip + 0) == c ? 0
            : root.recent-at(skip + 1) == c ? 1
            : root.recent-at(skip + 2) == c ? 2
            : root.recent-at(skip + 3) == c ? 3
            : root.recent-at(skip + 4) == c ? 4
            : root.recent-at(skip + 5) == c ? 5
            : root.recent-at(skip + 6) == c ? 6
            : root.recent-at(skip + 7) == c ? 7
            : kept;
        ColorPickerRecents.colors = [
            c,
            root.recent-at(skip + (0 < at ? 0 : 1)),
            root.recent-at(skip + (1 < at ? 1 : 2)),
            root.recent-at(skip + (2 < at ? 2 : 3)),
            root.recent-at(skip + (3 < at ? 3 : 4)),
            root.recent-at(skip + (4 < at ? 4 : 5)),
            root.recent-at(skip + (5 < at ? 5 : 6)),
            root.recent-at(skip + (6 < at ? 6 : 7))
        ];
        ColorPickerRecents.count = Math.min(8, 1 + kept - (at < kept ? 1 : 0));
        root.recent-claimed = true;
    }

    // ── Commit and open ─────────────────────────────────────────────────
    // Send the working color through the normal property pipeline (the same
    // path as typing into the row), once per actual change.
    function commit-rgb() {
        if root.rgb-text != root.committed-text {
            root.committed-text = root.rgb-text;
            root.value-changed(root.rgb-text);
            root.remember(root.picked);
        }
    }

    // A swatch, a recent color or the "old" half: jump there and commit.
    function pick(c: color) {
        root.draft-epoch += 1;
        root.set-rgb(c.red, c.green, c.blue);
        root.commit-rgb();
    }

    function open-picker() {
        root.set-rgb(root.preview-color.red, root.preview-color.green, root.preview-color.blue);
        root.original-color = root.picked;
        root.committed-text = root.rgb-text;
        root.recent-claimed = false;
        root.hover-caption = "";
        color-picker-popup.show();
    }

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            open-learn-url(url) => { root.open-learn-url(url); }
        }

        // Color swatch: the row's color (the picker's working color while
        // the picker is open). Click to open the picker.
        row-swatch := Rectangle {
            width: 24px;
            background: color-picker-popup.is-open ? root.picked : root.preview-color;
            border-radius: 3px;
            border-width: 1px;
            border-color: swatch-touch.has-hover || color-picker-popup.is-open ? Theme.accent-cyan : Theme.border-color;

            swatch-touch := TouchArea {
                mouse-cursor: root.editable ? pointer : default;
                clicked => {
                    if root.editable {
                        root.open-picker();
                    }
                }
            }
        }

        // The value: a text input ("r, g, b" or hex), or plain text when the
        // row is read-only. One slot either way, so the value starts at the
        // same x as every other row's.
        Rectangle {
            horizontal-stretch: 1;
            min-width: 32px;

            color-edit := KitField {
                width: 100%;
                height: 100%;
                visible: root.editable;
                enabled: root.editable;
                font-size: PropStyle.font;
                text: root.value;
                edited(text) => {
                    root.focus-changed(true);
                }
                accepted(text) => {
                    root.value-changed(self.text);
                    // Drop the field's focused state on Enter (see
                    // PropRow for rationale).
                    focus_sink.focus();
                }
            }

            if !root.editable: Text {
                x: PropStyle.text-inset;
                width: parent.width - PropStyle.text-inset;
                height: 100%;
                text: root.value;
                color: Theme.text-primary;
                font-size: PropStyle.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // The picker. Sibling of the HorizontalLayout so the PopupWindow gets
    // root-level placement (Slint requirement).
    color-picker-popup := PopupWindow {
        // Under the swatch, shifted left when the panel is too narrow to
        // hold it there, so it stays inside the panel.
        x: Math.max(0px, Math.min(row-swatch.x, root.width - self.width - 4px));
        y: parent.height;
        width: 292px;
        // 12 pad + 22 header + 8 + 136 square + 8 + 16 hue strip + 8
        //   + 78 fields (3 x 22 + 2 x 6) + 8 + 1 rule + 8
        //   + 42 swatches (2 x 18 + 6) + 12 pad = 363
        height: 363px;
        // Only a click OUTSIDE closes it. Slint's default closes on any click,
        // which would dismiss the picker as soon as the square was pressed.
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.dialog-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-color;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow-float;

            // Takes keyboard focus as the picker opens, so Escape closes it
            // before any field is touched; the capture sees Escape even while
            // a field has focus.
            FocusScope {
                init => {
                    self.focus();
                }
                capture-key-pressed(event) => {
                    if event.text == Key.Escape {
                        color-picker-popup.close();
                        return accept;
                    }
                    reject
                }

                // Swallow clicks so they don't bubble to the viewport.
                TouchArea { }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // ── Header: title, old/new swatch, close ──
                    HorizontalLayout {
                        height: 22px;
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: root.hover-caption != "" ? root.hover-caption
                                : old-touch.has-hover ? "Restore original"
                                : root.label;
                            color: root.hover-caption != "" || old-touch.has-hover ? Theme.text-secondary : Theme.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Old (left, click to restore) and new (right).
                        Rectangle {
                            width: 60px;

                            Rectangle {
                                x: 0px;
                                width: parent.width / 2;
                                background: root.original-color;
                                border-top-left-radius: 4px;
                                border-bottom-left-radius: 4px;

                                old-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick(root.original-color); }
                                }
                            }
                            Rectangle {
                                x: parent.width / 2;
                                width: parent.width / 2;
                                background: root.picked;
                                border-top-right-radius: 4px;
                                border-bottom-right-radius: 4px;
                            }
                            Rectangle {
                                x: parent.width / 2;
                                width: 1px;
                                background: Theme.dialog-background;
                            }
                            Rectangle {
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: old-touch.has-hover ? Theme.accent-cyan : Theme.text-disabled;
                            }
                        }

                        // Close
                        Rectangle {
                            width: 22px;
                            border-radius: 4px;
                            background: close-touch.has-hover ? Theme.button-hover : transparent;

                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 8;
                                viewbox-height: 8;
                                commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                                stroke: close-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                stroke-width: 1.5px;
                            }

                            close-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { color-picker-popup.close(); }
                            }
                        }
                    }

                    // ── Saturation (left to right) / value (top to bottom) ──
                    // The pure hue, washed toward white on the left and toward
                    // black at the bottom: the classic HSV square.
                    //
                    // The software renderer draws gradients with square
                    // corners whatever their radius (and `clip` does not round
                    // them), so the ramps are square and four small masks in
                    // the popup's own color round the corners.
                    Rectangle {
                        height: 136px;

                        Rectangle {
                            background: hsv(root.hsv-h, 1, 1);
                        }
                        Rectangle {
                            background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);  // theme-exempt: saturation ramp is color math, not chrome
                        }
                        Rectangle {
                            background: @linear-gradient(180deg, #00000000 0%, #000000 100%);  // theme-exempt: value ramp is color math, not chrome
                        }
                        for corner in [
                            { x: 0, y: 0, d: "M 0 0 L 4 0 A 4 4 0 0 0 0 4 Z" },
                            { x: 1, y: 0, d: "M 4 0 L 4 4 A 4 4 0 0 0 0 0 Z" },
                            { x: 1, y: 1, d: "M 4 4 L 0 4 A 4 4 0 0 0 4 0 Z" },
                            { x: 0, y: 1, d: "M 0 4 L 0 0 A 4 4 0 0 0 4 4 Z" },
                        ]: Path {
                            x: corner.x * (parent.width - self.width);
                            y: corner.y * (parent.height - self.height);
                            width: 4px;
                            height: 4px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 4;
                            viewbox-height: 4;
                            commands: corner.d;
                            fill: Theme.dialog-background;
                        }
                        Rectangle {
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                        }

                        sv-touch := TouchArea {
                            mouse-cursor: crosshair;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.draft-epoch += 1;
                                    root.set-hsv(root.hsv-h, self.mouse-x / self.width, 1 - self.mouse-y / self.height);
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left)
                                    || event.kind == PointerEventKind.cancel {
                                    root.commit-rgb();
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.set-hsv(root.hsv-h, self.mouse-x / self.width, 1 - self.mouse-y / self.height);
                                }
                            }
                        }

                        // Handle: a dark outer ring and a light inner ring,
                        // so it reads on white, black and everything between.
                        Rectangle {
                            x: root.hsv-s * parent.width - self.width / 2;
                            y: (1 - root.hsv-v) * parent.height - self.height / 2;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            border-width: 1px;
                            border-color: #00000099;  // theme-exempt: dark contrast ring, must read on light colors on every theme

                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                border-width: 2px;
                                border-color: #ffffff;  // theme-exempt: light contrast ring, must read on dark colors on every theme
                                background: root.picked;
                            }
                        }
                    }

                    // ── Hue strip ──
                    // A pill: the spectrum runs between two solid red end caps
                    // (solid fills keep their radius in the software renderer,
                    // gradients do not). Hue 0-360 maps onto the spectrum's
                    // own span, `cap` in from either end.
                    hue-strip := Rectangle {
                        property <length> cap: 5px;
                        height: 16px;

                        Rectangle {
                            x: 0px;
                            y: 3px;
                            width: 2 * hue-strip.cap;
                            height: 10px;
                            border-radius: hue-strip.cap;
                            background: #ff0000;  // theme-exempt: hue 0 end cap, part of the spectrum
                        }
                        Rectangle {
                            x: parent.width - 2 * hue-strip.cap;
                            y: 3px;
                            width: 2 * hue-strip.cap;
                            height: 10px;
                            border-radius: hue-strip.cap;
                            background: #ff0000;  // theme-exempt: hue 360 end cap, part of the spectrum
                        }
                        Rectangle {
                            x: hue-strip.cap;
                            y: 3px;
                            width: parent.width - 2 * hue-strip.cap;
                            height: 10px;
                            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.667%, #00ff00 33.333%, #00ffff 50%, #0000ff 66.667%, #ff00ff 83.333%, #ff0000 100%);  // theme-exempt: the hue spectrum is color math, not chrome
                        }
                        Rectangle {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            height: 10px;
                            border-radius: hue-strip.cap;
                            border-width: 1px;
                            border-color: Theme.border-color;
                        }

                        hue-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.draft-epoch += 1;
                                    root.set-hsv((self.mouse-x - hue-strip.cap) / (self.width - 2 * hue-strip.cap) * 360, root.hsv-s, root.hsv-v);
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left)
                                    || event.kind == PointerEventKind.cancel {
                                    root.commit-rgb();
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.set-hsv((self.mouse-x - hue-strip.cap) / (self.width - 2 * hue-strip.cap) * 360, root.hsv-s, root.hsv-v);
                                }
                            }
                        }

                        Rectangle {
                            x: hue-strip.cap + root.hsv-h / 360 * (parent.width - 2 * hue-strip.cap) - self.width / 2;
                            y: 0px;
                            width: 10px;
                            height: 16px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #00000099;  // theme-exempt: dark contrast ring, must read on light hues on every theme

                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: 8px;
                                height: 14px;
                                border-radius: 3px;
                                border-width: 2px;
                                border-color: #ffffff;  // theme-exempt: light contrast ring, must read on dark hues on every theme
                                background: hsv(root.hsv-h, 1, 1);
                            }
                        }
                    }

                    // ── Fields ──
                    // Enter (or leaving a field) applies what was typed and
                    // commits it; every field follows the square and strip.
                    VerticalLayout {
                        spacing: 6px;

                        // Hex takes "#RRGGBB", "RRGGBB" and the 3-digit
                        // shorthand, parsed here so the square follows. Other
                        // text ("r, g, b") goes to Rust as before.
                        ColorPickerField {
                            caption: "Hex";
                            caption-width: 22px;
                            display: root.hex-text;
                            reset-epoch: root.draft-epoch;
                            edited => { root.focus-changed(true); }
                            accepted(text) => {
                                let hex-v = root.hex-value(text);
                                if hex-v >= 0 {
                                    root.set-rgb(Math.floor(hex-v / 65536), Math.mod(Math.floor(hex-v / 256), 256), Math.mod(hex-v, 256));
                                    root.commit-rgb();
                                } else {
                                    root.value-changed(text);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            ColorPickerField {
                                caption: "R";
                                caption-color: Theme.accent-red;
                                display: Math.round(root.r-val) + "";
                                reset-epoch: root.draft-epoch;
                                edited => { root.focus-changed(true); }
                                accepted(text) => {
                                    if text.is-float() {
                                        root.set-rgb(text.to-float(), root.g-val, root.b-val);
                                        root.commit-rgb();
                                    }
                                }
                            }
                            ColorPickerField {
                                caption: "G";
                                caption-color: Theme.accent-green;
                                display: Math.round(root.g-val) + "";
                                reset-epoch: root.draft-epoch;
                                edited => { root.focus-changed(true); }
                                accepted(text) => {
                                    if text.is-float() {
                                        root.set-rgb(root.r-val, text.to-float(), root.b-val);
                                        root.commit-rgb();
                                    }
                                }
                            }
                            ColorPickerField {
                                caption: "B";
                                caption-color: Theme.accent-blue;
                                display: Math.round(root.b-val) + "";
                                reset-epoch: root.draft-epoch;
                                edited => { root.focus-changed(true); }
                                accepted(text) => {
                                    if text.is-float() {
                                        root.set-rgb(root.r-val, root.g-val, text.to-float());
                                        root.commit-rgb();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            ColorPickerField {
                                caption: "H";
                                unit: "°";
                                display: Math.round(root.hsv-h) + "";
                                reset-epoch: root.draft-epoch;
                                edited => { root.focus-changed(true); }
                                accepted(text) => {
                                    if text.is-float() {
                                        root.set-hsv(text.to-float(), root.hsv-s, root.hsv-v);
                                        root.commit-rgb();
                                    }
                                }
                            }
                            ColorPickerField {
                                caption: "S";
                                unit: "%";
                                display: Math.round(root.hsv-s * 100) + "";
                                reset-epoch: root.draft-epoch;
                                edited => { root.focus-changed(true); }
                                accepted(text) => {
                                    if text.is-float() {
                                        root.set-hsv(root.hsv-h, text.to-float() / 100, root.hsv-v);
                                        root.commit-rgb();
                                    }
                                }
                            }
                            ColorPickerField {
                                caption: "V";
                                unit: "%";
                                display: Math.round(root.hsv-v * 100) + "";
                                reset-epoch: root.draft-epoch;
                                edited => { root.focus-changed(true); }
                                accepted(text) => {
                                    if text.is-float() {
                                        root.set-hsv(root.hsv-h, root.hsv-s, text.to-float() / 100);
                                        root.commit-rgb();
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-color;
                    }

                    // ── Swatches and recent colors ──
                    // Both rows share one 13-column grid, so they line up.
                    VerticalLayout {
                        spacing: 6px;

                        Rectangle {
                            height: 18px;

                            // theme-exempt: preset swatches are colors to pick, not chrome
                            for swatch[idx] in [
                                { name: "White",      c: #ffffff },
                                { name: "Light gray", c: #c0c0c0 },
                                { name: "Gray",       c: #808080 },
                                { name: "Dark gray",  c: #404040 },
                                { name: "Black",      c: #000000 },
                                { name: "Red",        c: #e53935 },
                                { name: "Orange",     c: #fb8c00 },
                                { name: "Yellow",     c: #fdd835 },
                                { name: "Green",      c: #43a047 },
                                { name: "Cyan",       c: #00bcd4 },
                                { name: "Blue",       c: #1e88e5 },
                                { name: "Purple",     c: #8e24aa },
                                { name: "Pink",       c: #ec407a },
                            ]: Rectangle {
                                x: idx * (parent.width - self.width) / 12;
                                y: 0px;
                                width: 18px;
                                height: 18px;
                                background: swatch.c;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: preset-touch.has-hover ? Theme.accent-cyan : Theme.text-disabled;

                                // Ring around the swatch that matches the
                                // working color (a border alone vanishes on a
                                // cyan or blue swatch).
                                if swatch.c == root.picked: Rectangle {
                                    x: -3px;
                                    y: -3px;
                                    width: parent.width + 6px;
                                    height: parent.height + 6px;
                                    border-radius: 6px;
                                    border-width: 1.5px;
                                    border-color: Theme.accent-cyan;
                                }

                                preset-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick(swatch.c); }
                                    changed has-hover => {
                                        if self.has-hover {
                                            root.hover-caption = swatch.name + "  " + root.hex-of(swatch.c);
                                        } else if root.hover-caption == swatch.name + "  " + root.hex-of(swatch.c) {
                                            root.hover-caption = "";
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 18px;

                            Text {
                                x: 0px;
                                height: 100%;
                                text: "Recent";
                                color: Theme.text-secondary;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            // Columns 5-12 of the swatch grid, newest first.
                            for slot in 8: slot-box := Rectangle {
                                property <bool> filled: slot < ColorPickerRecents.count;
                                property <color> slot-color: root.recent-at(slot);
                                x: (5 + slot) * (parent.width - self.width) / 12;
                                y: 0px;
                                width: 18px;
                                height: 18px;
                                background: self.filled ? self.slot-color : Theme.input-background;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: self.filled && recent-touch.has-hover ? Theme.accent-cyan
                                    : self.filled ? Theme.text-disabled : Theme.border-color;

                                if slot-box.filled && slot-box.slot-color == root.picked: Rectangle {
                                    x: -3px;
                                    y: -3px;
                                    width: parent.width + 6px;
                                    height: parent.height + 6px;
                                    border-radius: 6px;
                                    border-width: 1.5px;
                                    border-color: Theme.accent-cyan;
                                }

                                recent-touch := TouchArea {
                                    enabled: parent.filled;
                                    mouse-cursor: parent.filled ? pointer : default;
                                    clicked => { root.pick(parent.slot-color); }
                                    changed has-hover => {
                                        if self.has-hover && parent.filled {
                                            root.hover-caption = "Recent  " + root.hex-of(parent.slot-color);
                                        } else if root.hover-caption == "Recent  " + root.hex-of(parent.slot-color) {
                                            root.hover-caption = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// BrickColor property row — a preview swatch that opens a 2-step wheel
// picker. Step 1 lists the seven color wheels (each with a one-line
// descriptor); clicking one sets the LOCAL `active-wheel-id` so the drill is
// instant (no Rust round-trip). Step 2 shows that wheel's 127-cell honeycomb
// (all seven are pushed in from Rust once). Clicking a cell writes its
// "r, g, b" through `value-changed` (same path as ColorRow) so the selected
// part recolors, then closes the popup.
component BrickColorRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "128, 128, 128";
    in property <color> preview-color: #808080;  // theme-exempt: neutral placeholder, runtime-overridden by Rust color-value
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    // All seven wheels' 127-cell honeycombs, pushed once from Rust. The drill
    // is entirely local: clicking a wheel sets `active-wheel-id` directly.
    in property <[HoneycombCell]> aether-honeycomb: [];
    in property <[HoneycombCell]> halo-honeycomb: [];
    in property <[HoneycombCell]> verdure-honeycomb: [];
    in property <[HoneycombCell]> stone-honeycomb: [];
    in property <[HoneycombCell]> char-honeycomb: [];
    in property <[HoneycombCell]> hex-honeycomb: [];
    in property <[HoneycombCell]> umbra-honeycomb: [];
    // LOCAL drill state: "" = step 1 wheel list, else step 2 for that wheel.
    property <string> active-wheel-id: "";

    callback value-changed(string);
    callback open-learn-url(string);

    height: PropStyle.row-height;

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            open-learn-url(url) => { root.open-learn-url(url); }
        }

        // Preview swatch — opens the wheel picker on click.
        bc-swatch := Rectangle {
            width: 24px;
            background: root.preview-color;
            border-radius: 3px;
            border-width: 1px;
            border-color: bc-swatch-touch.has-hover ? Theme.accent-cyan : Theme.border-color;

            bc-swatch-touch := TouchArea {
                mouse-cursor: root.editable ? pointer : default;
                clicked => {
                    if root.editable {
                        // Always (re)open at step 1, the wheel list.
                        root.active-wheel-id = "";
                        brick-color-popup.show();
                    }
                }
            }
        }

        // Read-only text of the current value.
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text-primary;
            font-size: PropStyle.font;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    brick-color-popup := PopupWindow {
        // Under the swatch, shifted left when the panel is too narrow to
        // hold it there.
        x: Math.max(0px, Math.min(bc-swatch.x, root.width - self.width - 4px));
        y: parent.height;
        // Wide enough for the 286px honeycomb plus the 12px padding either
        // side, with a little breathing room.
        width: 330px;
        // Each step gets the height its own content needs, so neither is
        // cramped nor padded with dead space:
        //   step 1  12 + 20 title + 4 + (7 rows x 42) + (6 gaps x 4) + 12 = 366
        //   step 2  12 + 24 back  + 6 + 247 honeycomb + 12               = 301
        height: root.active-wheel-id == "" ? 366px : 301px;
        // Slint defaults to `close-on-click`, which dismisses the popup on ANY
        // click inside it — so picking a wheel closed the picker instead of
        // drilling into that wheel. The drill is a two-step flow inside ONE
        // popup, so only a click OUTSIDE may close it.
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.dialog-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-color;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow-float;

            // Swallow clicks so they don't bubble to the viewport.
            TouchArea { }

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                // ── STEP 1: wheel list ──
                if root.active-wheel-id == "": VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Color Wheels";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    // Each row carries its themed glyph, its position on the
                    // two axes, and the lexicon its 127 swatches are named from.
                    // `tint` is the wheel's own character color, so the list
                    // reads as the axis diagram it stands for: good at the top,
                    // evil at the bottom, neutral Stone in the middle.
                    for w in [
                        { id: "aether",  name: "Aether",  axis: "abstract · good",  scheme: "virtues, radiant concepts", icon: @image-url("../../assets/icons/ui/sparkle.svg"), tint: #3ce6dc },
                        { id: "halo",    name: "Halo",    axis: "light · good",     scheme: "the 72 angels",             icon: @image-url("../../assets/icons/ui/sun.svg"),     tint: #e2e2e2 },
                        { id: "verdure", name: "Verdure", axis: "realistic · good", scheme: "flora and growth",          icon: @image-url("../../assets/icons/ui/leaf.svg"),    tint: #6fae32 },
                        { id: "stone",   name: "Stone",   axis: "neutral centre",   scheme: "minerals and materials",    icon: @image-url("../../assets/icons/ui/block.svg"),   tint: #b6b6b6 },
                        { id: "char",    name: "Char",    axis: "realistic · evil", scheme: "scars and ash",             icon: @image-url("../../assets/icons/ui/fire.svg"),    tint: #6d5a4c },
                        { id: "hex",     name: "Hex",     axis: "abstract · evil",  scheme: "curses and afflictions",    icon: @image-url("../../assets/icons/ui/flask.svg"),   tint: #a02fd8 },
                        { id: "umbra",   name: "Umbra",   axis: "dark · evil",      scheme: "the 72 demons",             icon: @image-url("../../assets/icons/ui/eye.svg"),     tint: #7d7d7d },
                    ]: Rectangle {
                        height: 42px;
                        background: wheel-touch.has-hover ? Theme.button-hover : transparent;
                        border-radius: 5px;

                        wheel-touch := TouchArea {
                            mouse-cursor: pointer;
                            // Local drill — straight to the wheel's colors, no
                            // Rust round-trip (and no popup re-open).
                            clicked => { root.active-wheel-id = w.id; }
                        }

                        // Absolute placement, not a HorizontalLayout: the layout
                        // cross-stretched the glyph over the full row height, so
                        // icons sat above their text instead of centred on it.
                        Rectangle {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: w.tint.with-alpha(0.18);
                            border-width: 1px;
                            border-color: w.tint.with-alpha(0.45);

                            Image {
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: w.icon;
                                image-fit: contain;
                                colorize: w.tint;
                            }
                        }

                        Text {
                            x: 42px;
                            y: 7px;
                            text: w.name;
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            x: 42px;
                            y: 23px;
                            text: w.axis + "  ·  " + w.scheme;
                            color: Theme.text-secondary;
                            font-size: 9px;
                        }

                        Image {
                            x: parent.width - self.width - 12px;
                            y: (parent.height - self.height) / 2;
                            width: 9px;
                            height: 9px;
                            source: @image-url("../../assets/icons/ui/chevron-right.svg");
                            image-fit: contain;
                            colorize: Theme.text-secondary;
                        }
                    }
                }

                // ── STEP 2: one wheel's honeycomb ──
                if root.active-wheel-id != "": VerticalLayout {
                    spacing: 6px;

                    // Back row → return to the wheel list.
                    Rectangle {
                        height: 24px;
                        background: bc-back-touch.has-hover ? Theme.button-hover : transparent;
                        border-radius: 4px;

                        bc-back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active-wheel-id = ""; }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 6px;
                            alignment: start;
                            Image {
                                width: 9px;
                                source: @image-url("../../assets/icons/ui/arrow-left.svg");
                                image-fit: contain;
                                colorize: Theme.text-primary;
                            }
                            Text {
                                text: "Back";
                                color: Theme.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 127-cell honeycomb for the active wheel. All seven are
                    // pushed from Rust; we render only the active one via a
                    // guarded `for` per wheel. Cells carry their own
                    // precomputed (x, y) offset inside the 286×264 box.
                    // Outer host stretches to the popup's content width; `hive`
                    // is the exact honeycomb bounds, centred inside it.
                    //
                    // The box was declared 286x264, but the 127 cells span
                    // x 0..264 and y 0..228, and a cell is 22x19 — so the real
                    // content is 286 x 247. The extra 17px of height was dead
                    // space that pushed the wheel visibly high in the frame.
                    Rectangle {
                        height: 247px;
                        background: transparent;

                        hive := Rectangle {
                        width: 286px;
                        height: 247px;
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        background: transparent;

                        if root.active-wheel-id == "aether": Rectangle {
                            for cell in root.aether-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        if root.active-wheel-id == "halo": Rectangle {
                            for cell in root.halo-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        if root.active-wheel-id == "verdure": Rectangle {
                            for cell in root.verdure-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        if root.active-wheel-id == "stone": Rectangle {
                            for cell in root.stone-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        if root.active-wheel-id == "char": Rectangle {
                            for cell in root.char-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        if root.active-wheel-id == "hex": Rectangle {
                            for cell in root.hex-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        if root.active-wheel-id == "umbra": Rectangle {
                            for cell in root.umbra-honeycomb: ColorSwatchCell {
                                x: cell.x * 1px;
                                y: cell.y * 1px;
                                r: cell.r;
                                g: cell.g;
                                b: cell.b;
                                swatch-name: cell.name;
                                swatch-clicked => {
                                    root.value-changed(root.active-wheel-id + "|" + cell.name + "|" + cell.r + ", " + cell.g + ", " + cell.b);
                                    brick-color-popup.close();
                                }
                            }
                        }
                        }
                    }
                }
            }
        }
    }
}

// Bool property row: a checkbox in the value column. A click anywhere on the
// row toggles it.
component BoolRow inherits Rectangle {
    in property <string> label: "";
    in-out property <string> value: "false";
    in property <bool> editable: true;
    in property <string> description: "";
    in property <string> learn-url: "";
    in property <bool> show-help-icons: true;

    callback value-changed(string);
    callback open-learn-url(string);

    // Derived: is the value currently "true"?
    property <bool> checked: root.value == "true";

    height: PropStyle.row-height;

    touch := TouchArea {
        mouse-cursor: root.editable ? pointer : default;
        clicked => {
            if root.editable {
                // Toggle immediately so UI updates without waiting for Rust sync
                root.value = root.checked ? "false" : "true";
                root.value-changed(root.value);
            }
        }
    }

    HorizontalLayout {
        padding-left: PropStyle.pad-left;
        padding-right: PropStyle.pad-right;
        padding-top: PropStyle.row-inset;
        padding-bottom: PropStyle.row-inset;
        spacing: PropStyle.gap;

        PropLabel {
            text: root.label;
            description: root.description;
            learn-url: root.learn-url;
            show-help-icons: root.show-help-icons;
            column-width: PropStyle.label-width(root.width);
            open-learn-url(url) => { root.open-learn-url(url); }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 3px;
                    background: root.checked ? Theme.accent-cyan : Theme.input-background;
                    border-width: 1px;
                    border-color: root.checked || (touch.has-hover && root.editable) ? Theme.accent-cyan : Theme.input-border;
                    opacity: root.editable ? 1.0 : 0.5;

                    if root.checked: Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 10px;
                        source: @image-url("../../assets/icons/ui/check.svg");
                        image-fit: contain;
                        colorize: Theme.panel-background;
                    }
                }
            }
        }
    }
}

export component PropertiesPanel inherits Rectangle {
    // Properties
    in property <int> selected-count: 0;
    in property <string> selected-class: "";
    in property <image> selected-icon;   // SVG icon for the selected class
    in property <[PropertyData]> properties: [];
    // Show help (?) icons next to properties that have a description field
    in property <bool> show-help-icons: true;
    // Whether help icon clicks open in the tabbed viewer (true) or system browser (false)
    in property <bool> help-opens-in-tab: false;

    // BrickColor wheel picker. Rust pushes ALL seven wheels' 127-cell
    // honeycombs ONCE at startup; the two-step drill (wheel list → that
    // wheel's swatches) is entirely local to BrickColorRow with no Rust
    // round-trip, so picking a wheel goes straight to its colors. Panel-level
    // (not per-row) because only one BrickColor row is ever visible at a time.
    in property <[HoneycombCell]> aether-honeycomb: [];
    in property <[HoneycombCell]> halo-honeycomb: [];
    in property <[HoneycombCell]> verdure-honeycomb: [];
    in property <[HoneycombCell]> stone-honeycomb: [];
    in property <[HoneycombCell]> char-honeycomb: [];
    in property <[HoneycombCell]> hex-honeycomb: [];
    in property <[HoneycombCell]> umbra-honeycomb: [];

    // Callbacks
    callback on-property-changed(string, string);
    // Fired when a section header chevron is clicked — Rust toggles collapsed state
    callback on-section-toggle(string);
    // Fired when a help icon with a learn-url is clicked
    callback on-open-learn-url(string);
    // Fired when any input field gains or loses focus — Rust uses this to pause property sync
    callback on-input-focus-changed(bool);
    // Type-ahead callback for material dropdown keyboard navigation.
    // Rust scans material options and returns the index of the first match.
    // Arguments: (pressed-key, current-highlight-index) -> new-highlight-index
    callback on-find-material-by-key(string, int) -> int;
    // Fired when the copy icon on a Vec3 / Rotation row is clicked —
    // Rust pushes the `"x, y, z"` triple to the OS clipboard.
    callback on-copy-property-vector(string, string);
    // Fired when the paste icon on a Vec3 / Rotation row is clicked —
    // Rust reads the clipboard, parses whichever format the user
    // copied (`"x, y, z"`, `(x, y, z)`, `x y z`, `Vector3.new(x, y, z)`
    // are all accepted) and synthesises a matching
    // `on-property-changed(name, "x, y, z")` call.
    callback on-paste-property-vector(string);
    // Attributes UX. `on-add-attribute` opens the Add-Attribute modal (empty).
    // `on-attribute-edit` opens it prefilled for type/value change (name, type,
    // value). `on-attribute-delete` removes the attribute (name).
    callback on-add-attribute();
    callback on-attribute-edit(string, string, string);
    callback on-attribute-delete(string);
    // Parameters UX. The "+" asks Rust to open the Add-Parameter modal (Rust
    // fills the Domain and Connector lists); the gear asks Rust to open it
    // prefilled (the row does not carry the binding); the trash removes the
    // Parameter. Each passes the row's label (`key` or `domain.key`).
    callback on-add-parameter();
    callback on-parameter-edit(string);
    callback on-parameter-delete(string);
    // Tag system (chips). entity-tags = assigned (with color + count);
    // tag-suggestions = project registry tags not on this entity.
    in property <[TagChip]> entity-tags: [];
    // Flow-wrap rows. Rust splits entity-tags into ≤ 4 rows so each
    // HorizontalLayout sizes its chips naturally (no absolute positioning,
    // which breaks Slint TouchArea hit testing for the Explorer).
    in property <[TagChip]> entity-tag-row-0: [];
    in property <[TagChip]> entity-tag-row-1: [];
    in property <[TagChip]> entity-tag-row-2: [];
    in property <[TagChip]> entity-tag-row-3: [];
    in property <[TagSuggestion]> tag-suggestions: [];
    in-out property <string> tag-input-text: "";
    // Collapse state for the Tags section (shared collapsed_sections mechanism).
    in property <bool> tags-collapsed: false;
    callback on-tag-add(string);
    callback on-tag-remove(string);
    callback on-tag-select-tagged(string);
    callback on-tag-rename-request(string);   // open the rename modal for this tag

    // Property filter. The typed query lives here (two-way bound to the root
    // window) and the actual filtering happens Rust-side in
    // `sync_properties_to_slint`, so a category header whose every child was
    // filtered out disappears with it — a header floating above nothing reads
    // as a broken panel. `on-search-changed` only tells Rust to rebuild; the
    // query itself is read back off this property.
    in-out property <string> search-query: "";
    // Bumped by the Filter Properties shortcut; each change puts the
    // keyboard in the filter box.
    in property <int> focus-pulse: 0;
    callback on-search-changed(string);
    // Deliberately NOT `on-input-focus-changed`: that one pauses the whole
    // properties sync while an editor has focus, which would freeze the very
    // rebuild the filter is asking for. This one only tells the engine to stop
    // treating keystrokes as viewport shortcuts.
    callback on-search-focus-changed(bool);

    background: Theme.panel-background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header: what is selected. The class icon and name, or how many.
        Rectangle {
            height: 30px;
            background: Theme.header-background;

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-color;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                if root.selected-count > 0: VerticalLayout {
                    width: 16px;
                    alignment: center;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: root.selected-icon;
                        image-fit: contain;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.selected-count == 0 ? "Properties"
                        : root.selected-count == 1 ? root.selected-class
                        : root.selected-count + " selected";
                    color: root.selected-count == 0 ? Theme.text-secondary : Theme.text-primary;
                    font-weight: 600;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Property filter bar. Only shown with a live selection — there is
        // nothing to filter on the empty state, and an inert search box there
        // just looks broken. Same layout as the Explorer's search bar so the
        // two panels read as one system.
        if root.selected-count > 0: Rectangle {
            height: 30px;
            background: Theme.header-background;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-color;
            }

            // Escape clears the filter. The field's text input rejects
            // Escape, so it bubbles to this ancestor scope.
            //
            // Explicit 100% sizing: the parent is a Rectangle, not a layout, so
            // a bare FocusScope would shrink to its content's preferred width
            // and the field would stop short of the panel edge.
            FocusScope {
                width: 100%;
                height: 100%;

                key-pressed(event) => {
                    if event.text == Key.Escape && root.search-query != "" {
                        root.search-query = "";
                        root.on-search-changed("");
                        return accept;
                    }
                    return reject;
                }

                HorizontalLayout {
                    padding-left: PropStyle.pad-left;
                    padding-right: PropStyle.pad-right;
                    padding-top: 4px;
                    padding-bottom: 5px;
                    spacing: 4px;

                    Rectangle {
                        width: PropStyle.help-width;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            source: @image-url("../../assets/icons/ui/search.svg");
                            image-fit: contain;
                            colorize: Theme.text-secondary;
                        }
                    }

                    filter-edit := KitField {
                        // The field lives inside a conditional, so it takes
                        // the focus pulse through its own property.
                        property <int> pulse: root.focus-pulse;
                        changed pulse => { self.focus(); }
                        horizontal-stretch: 1;
                        min-width: 0px;
                        font-size: PropStyle.font;
                        placeholder-text: "Filter properties";
                        text <=> root.search-query;
                        edited(text) => { root.on-search-changed(text); }
                        changed has-focus => { root.on-search-focus-changed(self.has-focus); }
                    }

                    if root.search-query != "": Rectangle {
                        width: 20px;
                        border-radius: 3px;
                        background: prop-search-clear.has-hover ? Theme.button-hover : transparent;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 10px;
                            height: 10px;
                            source: @image-url("../../assets/icons/ui/close.svg");
                            image-fit: contain;
                            colorize: Theme.text-secondary;
                        }

                        prop-search-clear := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.search-query = "";
                                root.on-search-changed("");
                            }
                        }
                    }
                }
            }
        }

        // Empty state
        if root.selected-count == 0: Rectangle {
            vertical-stretch: 1;
            background: Theme.panel-background;

            VerticalLayout {
                alignment: center;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.background-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-color;

                        Text {
                            text: "◇";
                            color: Theme.text-secondary;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Nothing selected";
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Select something in the viewport or the Explorer to see its properties.";
                    color: Theme.text-secondary;
                    font-size: PropStyle.font;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Dynamic property list — fully driven by Rust binding. The rows are
        // bound to the viewport's width, so nothing runs past the right edge.
        if root.selected-count > 0: list := ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                width: list.visible-width;
                padding: 0px;
                padding-bottom: 8px;
                spacing: 0px;
                alignment: start;

                // First-class Tag system — uses the standard SectionHeader for
                // visual + collapse parity with Appearance / Attributes / etc.
                SectionHeader {
                    title: "Tags";
                    category: "Tags";
                    expanded: !root.tags-collapsed;
                    clicked => { root.on-section-toggle("Tags"); }
                }
                if !root.tags-collapsed: TagsEditor {
                    tags: root.entity-tags;
                    tag-row-0: root.entity-tag-row-0;
                    tag-row-1: root.entity-tag-row-1;
                    tag-row-2: root.entity-tag-row-2;
                    tag-row-3: root.entity-tag-row-3;
                    suggestions: root.tag-suggestions;
                    input-text <=> root.tag-input-text;
                    add-tag(name) => { root.on-tag-add(name); }
                    remove-tag(name) => { root.on-tag-remove(name); }
                    select-tagged(name) => { root.on-tag-select-tagged(name); }
                    rename-requested(name) => { root.on-tag-rename-request(name); }
                    input-focus-changed(f) => { root.on-input-focus-changed(f); }
                }

                for prop in root.properties: VerticalLayout {
                    spacing: 0px;
                    // Hide collapsed rows (height 0 + invisible)
                    visible: prop.is-header || !prop.section-collapsed;
                    height: (prop.is-header || !prop.section-collapsed) ? self.preferred-height : 0px;

                    // Category header — fires on-section-toggle so Rust updates section-collapsed
                    if prop.is-header: SectionHeader {
                        title: prop.category;
                        category: prop.category;
                        expanded: !prop.section-collapsed;
                        clicked => { root.on-section-toggle(prop.category); }
                        add-clicked => {
                            if prop.category == "Parameters" {
                                root.on-add-parameter();
                            } else {
                                root.on-add-attribute();
                            }
                        }
                    }

                    // UDim2 property (Roblox-parity 2D layout: Position / Size)
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "udim2": UDim2Row {
                        label: prop.name;
                        x-scale: prop.x-scale;
                        x-offset: prop.x-offset;
                        y-scale: prop.y-scale;
                        y-offset: prop.y-offset;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        copy-vector(val) => { root.on-copy-property-vector(prop.name, val); }
                    }

                    // Vec2 property — pure-pixel Vector2 (AnchorPoint, SizeOffset, …).
                    // Uses the same X/Y accent-bar layout as Vec3Row, just
                    // without the Z field, so SizeOffset no longer falls
                    // through to PropRow's ugly comma-string text input.
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "vec2": Vec2Row {
                        label: prop.name;
                        x-value: prop.x-value;
                        y-value: prop.y-value;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        copy-vector(val) => { root.on-copy-property-vector(prop.name, val); }
                    }

                    // Vec3 property (position, scale)
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "vec3": Vec3Row {
                        label: prop.name;
                        value: prop.value;
                        x-value: prop.x-value;
                        y-value: prop.y-value;
                        z-value: prop.z-value;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        copy-vector(val) => { root.on-copy-property-vector(prop.name, val); }
                        paste-vector() => { root.on-paste-property-vector(prop.name); }
                    }

                    // Rotation property — degrees with +/- buttons, supports negatives
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "rotation": RotationVec3Row {
                        label: prop.name;
                        value: prop.value;
                        x-value: prop.x-value;
                        y-value: prop.y-value;
                        z-value: prop.z-value;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        copy-vector(val) => { root.on-copy-property-vector(prop.name, val); }
                        paste-vector() => { root.on-paste-property-vector(prop.name); }
                    }
                    
                    // Color property
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "color": ColorRow {
                        label: prop.name;
                        value: prop.value;
                        preview-color: prop.color-value;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                    }

                    // BrickColor property — 7-wheel hexagon picker. All seven
                    // honeycombs come from the panel-level props (Rust pushes
                    // them once); the two-step drill is local to BrickColorRow.
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "brickcolor": BrickColorRow {
                        label: prop.name;
                        value: prop.value;
                        preview-color: prop.color-value;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        aether-honeycomb: root.aether-honeycomb;
                        halo-honeycomb: root.halo-honeycomb;
                        verdure-honeycomb: root.verdure-honeycomb;
                        stone-honeycomb: root.stone-honeycomb;
                        char-honeycomb: root.char-honeycomb;
                        hex-honeycomb: root.hex-honeycomb;
                        umbra-honeycomb: root.umbra-honeycomb;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                    }

                    // Bool property
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "bool": BoolRow {
                        label: prop.name;
                        value: prop.value;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                    }
                    
                    // Material — searchable dropdown with all MaterialService options
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "material": MaterialDropdown {
                        label: prop.name;
                        value: prop.value;
                        options: prop.options;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        find-material-by-key(key, current-idx) => { root.on-find-material-by-key(key, current-idx) }
                    }

                    // Unit — same generic dropdown component as Material,
                    // populated with the 6 canonical unit symbols. The
                    // writer reinterprets existing dimensional values
                    // when this changes (see `apply_property_to_toml_value`).
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "unit": MaterialDropdown {
                        label: prop.name;
                        value: prop.value;
                        options: prop.options;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        find-material-by-key(key, current-idx) => { root.on-find-material-by-key(key, current-idx) }
                    }

                    // Choice — the same dropdown, fed the class's own option
                    // list (e.g. ParticleSimulation boundaries, particle
                    // presets). No type-ahead: the material lookup does not
                    // know these names, so arrows and clicks pick.
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "choice": MaterialDropdown {
                        label: prop.name;
                        value: prop.value;
                        options: prop.options;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        find-material-by-key(key, current-idx) => { current-idx }
                    }

                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "slider": SliderRow {
                        label: prop.name;
                        value: prop.value.to-float();
                        minimum: prop.slider-min;
                        maximum: prop.slider-max;
                        display-text: prop.slider-display;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        value-changed(val) => { root.on-property-changed(prop.name, val); }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                    }

                    // A domain's group row inside Parameters.
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "parameter-group": ParamGroupRow {
                        domain: prop.name;
                    }

                    // An empty section's hint (Attributes, Parameters).
                    if !prop.is-header && !prop.section-collapsed && prop.property-type == "hint": SectionHint {
                        text: prop.value;
                    }

                    // String / float / int / enum — generic row
                    if !prop.is-header && !prop.section-collapsed && prop.property-type != "vec2" && prop.property-type != "vec3" && prop.property-type != "rotation" && prop.property-type != "color" && prop.property-type != "brickcolor" && prop.property-type != "bool" && prop.property-type != "material" && prop.property-type != "unit" && prop.property-type != "choice" && prop.property-type != "udim2" && prop.property-type != "slider" && prop.property-type != "parameter-group" && prop.property-type != "hint": PropRow {
                        label: prop.name;
                        display-label: prop.display-name;
                        indent: prop.display-name != "" ? 10px : 0px;
                        value: prop.value;
                        prop-type: prop.property-type;
                        editable: prop.editable;
                        description: prop.description;
                        learn-url: prop.learn-url;
                        show-help-icons: root.show-help-icons;
                        is-attribute: prop.is-attribute;
                        attribute-type: prop.attribute-type;
                        binding-state: prop.binding-state;
                        // A Parameter row's edit is sent as `Parameter:<label>`,
                        // so a Parameter and an Attribute sharing a name never
                        // edit each other.
                        value-changed(val) => {
                            root.on-property-changed(prop.category == "Parameters" ? "Parameter:" + prop.name : prop.name, val);
                        }
                        open-learn-url(url) => { root.on-open-learn-url(url); }
                        focus-changed(focused) => { root.on-input-focus-changed(focused); }
                        gear-clicked(n, t, v) => {
                            if prop.category == "Parameters" {
                                root.on-parameter-edit(n);
                            } else {
                                root.on-attribute-edit(n, t, v);
                            }
                        }
                        trash-clicked(n) => {
                            if prop.category == "Parameters" {
                                root.on-parameter-delete(n);
                            } else {
                                root.on-attribute-delete(n);
                            }
                        }
                    }
                }
            }
        }
    }
}
