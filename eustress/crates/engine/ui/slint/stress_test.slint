// ============================================================================
// Eustress Engine - Stress Test Dialog
// Synthetic players against the local server: they join the way the Player
// does, move and interact through the real lanes, and the host reports what
// it cost. The harness is the Multiplayer session's (network_benchmark.rs,
// docs/networking/STRESS_TEST.md); this file is only the dialog.
//
// Chrome: DialogScrim > DialogCard > DialogFooter (DRAFTING_UX.md Law 1).
// Escape, the close button and an outside click all close it.
// ============================================================================

import { Slider, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSwitch, SettingsGroup, SettingRow, KitSectionLabel } from "dialog_kit.slint";

// A slider and its current value, for a SettingRow.
component SliderControl inherits HorizontalLayout {
    in property <float> minimum;
    in property <float> maximum;
    in property <int> value;
    in property <string> unit: "";
    callback changed(int);

    spacing: 10px;
    Slider {
        width: 170px;
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        changed(v) => { root.changed(round(v)); }
    }
    Text {
        width: 44px;
        text: root.unit == "" ? root.value : root.value + " " + root.unit;
        color: Theme.text-primary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// One result figure: the number and what it counts.
component StatTile inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <bool> alert: false;

    // Equal columns: every tile asks for the same width, whatever its text.
    horizontal-stretch: 1;
    preferred-width: 100px;
    min-width: 60px;
    background: Theme.background-secondary.with-alpha(0.6);
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.alert ? Theme.text-error.with-alpha(0.35) : Theme.border-color;

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: root.value;
            color: root.alert ? Theme.text-error : Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            overflow: elide;
        }
    }
}

// A labelled row of result tiles.
component ResultRow inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    KitSectionLabel { text: root.title; }
    HorizontalLayout {
        spacing: 8px;
        @children
    }
}

export component StressTestDialog inherits Rectangle {
    in-out property <int> client-count: 1;
    // Avatar updates each bot sends per second; 20 is the Player's rate.
    in-out property <int> message-rate: 20;
    in-out property <int> duration-seconds: 60;
    in-out property <bool> simulate-movement: true;
    in-out property <bool> simulate-interactions: false;
    // Bots download the Space before playing, as real players do.
    in-out property <bool> download-world: true;
    // The most bots this machine can drive (MachineCapabilities).
    in property <int> max-clients: 50;
    in property <bool> running: false;
    in property <float> progress: 0;
    in property <string> status: "";
    // Relay frames received, relay latency (ms), and all failures.
    in property <int> total-messages: 0;
    in property <float> avg-latency: 0;
    in property <int> errors: 0;

    // Join
    in property <int> joined: 0;
    in property <int> join-failures: 0;
    in property <int> disconnects: 0;
    in property <float> join-p95-ms: 0;
    // Relay: one bot's movement reaching the others through the host.
    in property <float> relay-p50-ms: 0;
    in property <float> relay-p95-ms: 0;
    in property <float> relay-loss: 0; // 0..1
    // Round trips
    in property <float> invoke-p95-ms: 0; // RemoteFunction
    in property <float> rtt-ms: 0; // QUIC
    // Host
    in property <float> host-frame-p95-ms: 0;
    in property <float> host-net-ms: 0; // network work per frame
    in property <float> host-budget: 0; // 0..1 of the 16.7 ms frame
    // Traffic per bot
    in property <float> down-kbps: 0;
    in property <float> up-kbps: 0;
    // CPU the bots themselves kept busy, in cores (they run inside Studio).
    in property <float> bot-cores: 0;
    // The end-of-run summary, selectable so it can be copied.
    in property <string> report: "";

    callback on-start();
    callback on-stop();
    callback on-close();

    // One decimal place.
    pure function d1(v: float) -> string {
        return round(v * 10) / 10;
    }

    property <bool> has-results: root.total-messages > 0 || root.joined > 0 || root.join-failures > 0 || root.report != "";

    width: 100%;
    height: 100%;
    background: transparent;

    // Escape closes. Other keys pass through as before.
    keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.on-close();
                return accept;
            }
            return reject;
        }

        DialogScrim {
            dismiss => { root.on-close(); }

            DialogCard {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(600px, parent.width - 40px);
                height: min(body.preferred-height + footer.preferred-height + 45px, parent.height - 40px);
                icon: @image-url("../../assets/icons/ui/stress.svg");
                title: "Stress test";
                subtitle: "Synthetic players join the local server the way the Player does";
                close => { root.on-close(); }

                body-scroll := ScrollView {
                    vertical-stretch: 1;

                    body := VerticalLayout {
                        width: body-scroll.visible-width;
                        padding: 16px;
                        spacing: 14px;
                        alignment: start;

                        SettingsGroup {
                            title: "LOAD";
                            note: "Start hosts the local server first when Studio is not already hosting.";

                            SettingRow {
                                label: "Players";
                                description: "Synthetic players that join. This machine can drive \{root.max-clients}.";
                                divider: false;
                                SliderControl {
                                    minimum: 1;
                                    maximum: max(root.max-clients, 1);
                                    value: root.client-count;
                                    changed(v) => { root.client-count = v; }
                                }
                            }

                            SettingRow {
                                label: "Avatar updates per second";
                                description: "Sent by each player. The Player sends 20.";
                                SliderControl {
                                    minimum: 1;
                                    maximum: 60;
                                    value: root.message-rate;
                                    changed(v) => { root.message-rate = v; }
                                }
                            }

                            SettingRow {
                                label: "Duration";
                                description: "How long the test runs";
                                SliderControl {
                                    minimum: 10;
                                    maximum: 300;
                                    value: root.duration-seconds;
                                    unit: "s";
                                    changed(v) => { root.duration-seconds = v; }
                                }
                            }
                        }

                        SettingsGroup {
                            title: "BEHAVIOUR";

                            SettingRow {
                                label: "Move";
                                description: "Players walk, so their movement relays to the others.";
                                divider: false;
                                KitSwitch { checked <=> root.simulate-movement; }
                            }

                            SettingRow {
                                label: "Interact";
                                description: "Players chat, jump, fire remotes and call RemoteFunctions.";
                                KitSwitch { checked <=> root.simulate-interactions; }
                            }

                            SettingRow {
                                label: "Download the world";
                                description: "Players download the Space before playing, as real players do. Off measures steady play alone.";
                                KitSwitch { checked <=> root.download-world; }
                            }
                        }

                        // Progress (while running)
                        if root.running: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.status;
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                overflow: elide;
                            }
                            Rectangle {
                                height: 6px;
                                background: Theme.background-tertiary;
                                border-radius: 3px;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    width: parent.width * clamp(root.progress, 0, 1);
                                    height: 100%;
                                    background: Theme.accent-cyan;
                                    border-radius: 3px;
                                }
                            }
                        }

                        // Results
                        if root.has-results: VerticalLayout {
                            spacing: 12px;

                            ResultRow {
                                title: "JOIN";
                                StatTile { value: root.joined; label: "Joined"; }
                                StatTile { value: root.join-failures; label: "Failed to join"; alert: root.join-failures > 0; }
                                StatTile { value: root.disconnects; label: "Disconnects"; alert: root.disconnects > 0; }
                                StatTile { value: d1(root.join-p95-ms) + " ms"; label: "Join time p95"; }
                            }

                            ResultRow {
                                title: "RELAY";
                                StatTile { value: root.total-messages; label: "Frames received"; }
                                StatTile { value: d1(root.relay-p50-ms) + " ms"; label: "Latency p50"; }
                                StatTile { value: d1(root.relay-p95-ms) + " ms"; label: "Latency p95"; }
                                StatTile { value: d1(root.relay-loss * 100) + "%"; label: "Loss"; alert: root.relay-loss > 0.01; }
                            }

                            ResultRow {
                                title: "ROUND TRIPS AND FAILURES";
                                StatTile { value: d1(root.avg-latency) + " ms"; label: "Relay latency, mean"; }
                                StatTile { value: d1(root.invoke-p95-ms) + " ms"; label: "RemoteFunction p95"; }
                                StatTile { value: d1(root.rtt-ms) + " ms"; label: "Network round trip"; }
                                StatTile { value: root.errors; label: "Errors"; alert: root.errors > 0; }
                            }

                            ResultRow {
                                title: "HOST";
                                StatTile { value: d1(root.host-frame-p95-ms) + " ms"; label: "Host frame p95"; alert: root.host-frame-p95-ms > 16.7; }
                                StatTile { value: round(root.host-budget * 100) + "%"; label: "Of the frame budget"; alert: root.host-budget > 0.8; }
                                StatTile { value: d1(root.host-net-ms) + " ms"; label: "Network work per frame"; }
                                // The bots run inside Studio, on threads of their own.
                                StatTile { value: d1(root.bot-cores) + " cores"; label: "The bots' own CPU"; }
                            }

                            ResultRow {
                                title: "TRAFFIC PER PLAYER";
                                StatTile { value: d1(root.down-kbps) + " kbps"; label: "Down"; }
                                StatTile { value: d1(root.up-kbps) + " kbps"; label: "Up"; }
                            }

                            if root.report != "": VerticalLayout {
                                spacing: 6px;
                                KitSectionLabel { text: "REPORT"; }
                                TextEdit {
                                    height: 120px;
                                    read-only: true;
                                    text: root.report;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Select the report and press Ctrl+C to copy it.";
                                    color: Theme.text-disabled;
                                    font-size: Theme.font-xs;
                                }
                            }
                        }
                    }
                }

                // ── Footer ──
                footer := DialogFooter {
                    KitButton {
                        text: "Close";
                        clicked => { root.on-close(); }
                    }

                    // Start test, or Stop while a test runs.
                    KitButton {
                        text: root.running ? "Stop" : "Start test";
                        kind: root.running ? "danger" : "primary";
                        clicked => {
                            if (root.running) {
                                root.on-stop();
                            } else {
                                root.on-start();
                            }
                        }
                    }
                }
            }
        }
    }
}
