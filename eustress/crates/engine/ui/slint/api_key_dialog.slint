// ============================================================================
// API key dialog — Public Sector ▸ Capture ▸ Sources ▸ API Key.
//
// SAM.gov needs a free API key; Grants.gov needs none. The key must not go in
// a Space folder, because that folder is what an auditor reads and what gets
// committed, so the Connector stores only the credential's NAME and the value
// is saved to %LOCALAPPDATA%\Eustress\credentials.toml.
//
// The masked-status line is the point of the whole dialog: pasting a key and
// then having no way to tell whether it took is the failure this replaces.
// ============================================================================

import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ApiKeyDialog inherits Rectangle {
    // Credential name, e.g. "SAM_API_KEY". Shown, never editable here: it is
    // the Connector's `secret_ref` and changing it in two places would drift.
    in property <string> key-name: "SAM_API_KEY";
    // "SAM_API_KEY is saved (••••••••3f9a)" or "… is not set".
    in property <string> status-line: "";
    in property <bool> present: false;
    // True when the value came from an environment variable, which Remove
    // cannot clear. Says so rather than offering a button that does nothing.
    in property <bool> from-environment: false;

    in-out property <string> key-text: "";

    callback save(string /* key-name */, string /* value */);
    callback remove(string /* key-name */);
    callback cancel();

    background: Theme.modal-backdrop;

    // Swallow clicks behind the card; backdrop click cancels.
    TouchArea { clicked => { root.cancel(); } }

    Rectangle {
        width: 480px;
        height: 336px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.dialog-background;
        border-width: 1px;
        border-color: Theme.border-color;
        border-radius: 10px;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.shadow-color;

        TouchArea { } // block backdrop-cancel inside the card

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: "SAM.gov API key";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text-primary;
            }

            Text {
                text: "Free from your SAM.gov account: sign in, open Account Details, "
                    + "enter your password, and generate a Public API Key. Copy it before "
                    + "you navigate away, because it is shown only once.";
                font-size: 12px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            Rectangle {
                height: 30px;
                background: Theme.input-background;
                border-radius: 5px;
                border-width: 1px;
                border-color: root.present ? Theme.success-surface-border : Theme.border-color;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: root.status-line;
                        font-size: 12px;
                        color: root.present ? Theme.text-success : Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            input := LineEdit {
                placeholder-text: root.present ? "Paste a new key to replace it" : "Paste your key here";
                // Masked as typed. The status line above is how a user confirms
                // the save, not by reading back the value.
                input-type: password;
                text <=> root.key-text;
            }

            Text {
                text: root.from-environment
                    ? "This value comes from the " + root.key-name + " environment variable. "
                      + "Saving here replaces it for this app; Remove cannot clear an "
                      + "environment variable."
                    : "Saved to your local app data, never inside a Space, so it stays out of "
                      + "audit folders and commits. Takes effect on the next sync, no restart.";
                font-size: 10px;
                color: Theme.text-disabled;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Remove";
                    enabled: root.present && !root.from-environment;
                    clicked => { root.remove(root.key-name); }
                }
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                Button {
                    text: "Save";
                    primary: true;
                    enabled: root.key-text != "";
                    clicked => { root.save(root.key-name, root.key-text); }
                }
            }
        }
    }
}
