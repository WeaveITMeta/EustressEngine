// ============================================================================
// Eustress Studio: Simulation settings dialog
// Initial conditions, stepping, recording, and result bindings.
//
// Shape (DRAFTING_UX.md Law 1): DialogScrim > DialogCard, a left sidebar of
// NavItems for the four sections, each section a column of SettingsGroup
// cards, and a DialogFooter with Save rightmost. Esc closes.
// ============================================================================

import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    DialogScrim, DialogCard, DialogFooter, KitDivider, KitButton, KitSwitch,
    SettingsGroup, SettingRow, NavItem, KitNotice, KitSectionLabel,
} from "dialog_kit.slint";

// ── Private parts ────────────────────────────────────────────────────────────

// A text field with an optional unit after it, for the right side of a
// SettingRow. Two-way on `value`.
component SimField inherits HorizontalLayout {
    in-out property <string> value: "";
    in property <string> unit: "";
    in property <string> placeholder: "";
    in property <length> field-width: 120px;

    spacing: 8px;

    LineEdit {
        width: root.field-width;
        text <=> root.value;
        placeholder-text: root.placeholder;
    }

    Text {
        width: 36px;
        text: root.unit;
        color: Theme.text-disabled;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }
}

// A small square icon button for removing a row. Red marks it destructive,
// and only on hover.
component RemoveButton inherits Rectangle {
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: Theme.radius-sm;
    background: rm-touch.has-hover ? Theme.accent-red.with-alpha(0.16) : transparent;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        source: @image-url("../../assets/icons/ui/delete.svg");
        image-fit: contain;
        colorize: rm-touch.has-hover ? Theme.accent-red : Theme.text-secondary;
    }

    rm-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A unit or format chip in a list row.
component MonoChip inherits Rectangle {
    in property <string> text;

    height: 20px;
    min-width: max(chip-text.preferred-width + 12px, 36px);
    border-radius: Theme.radius-sm;
    background: Theme.background-tertiary;
    border-width: 1px;
    border-color: Theme.border-color;

    chip-text := Text {
        text: root.text;
        color: Theme.text-accent;
        font-size: Theme.font-sm;
        font-family: "Consolas";
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Column headings above a list inside a SettingsGroup.
component ColumnHead inherits Text {
    color: Theme.text-disabled;
    font-size: Theme.font-xs;
    font-weight: 700;
    letter-spacing: 0.5px;
    vertical-alignment: center;
}

// One watchpoint in the Recording list.
component WatchpointRow inherits VerticalLayout {
    in property <string> name: "";
    in property <string> label: "";
    in property <string> unit: "";
    in property <bool> divider: true;
    callback remove();

    if root.divider: KitDivider { }

    Rectangle {
        height: 36px;
        HorizontalLayout {
            spacing: 10px;

            Text {
                width: 140px;
                text: root.name;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                font-family: "Consolas";
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: root.label;
                color: Theme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                width: 64px;
                HorizontalLayout {
                    alignment: start;
                    MonoChip { text: root.unit; }
                }
            }
            VerticalLayout {
                alignment: center;
                RemoveButton { clicked => { root.remove(); } }
            }
        }
    }
}

// One result binding in the Results list.
component BindingRow inherits VerticalLayout {
    in property <string> instance-name: "";
    in property <string> property-name: "";
    in property <string> watchpoint: "";
    in property <string> format: "";
    in property <bool> divider: true;
    callback remove();

    if root.divider: KitDivider { }

    Rectangle {
        height: 36px;
        HorizontalLayout {
            spacing: 10px;

            Text {
                width: 140px;
                text: root.instance-name;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                width: 90px;
                text: root.property-name;
                color: Theme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                width: 110px;
                text: root.watchpoint;
                color: Theme.text-primary;
                font-size: 12px;
                font-family: "Consolas";
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                HorizontalLayout {
                    alignment: start;
                    MonoChip { text: root.format; }
                }
            }
            VerticalLayout {
                alignment: center;
                RemoveButton { clicked => { root.remove(); } }
            }
        }
    }
}

// The quiet line shown in an empty list.
component EmptyLine inherits Rectangle {
    in property <string> text;

    height: 52px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.text-disabled;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// ── Watchpoint data struct ────────────────────────────────────────────────────
export struct WatchpointData {
    name: string,
    label: string,
    unit: string,
    interval: int,
    enabled: bool,
}

// ── Result output data struct ─────────────────────────────────────────────────
export struct SimOutputBinding {
    instance-name: string,
    property-name: string,
    watchpoint: string,
    format: string,
}

// ── Main dialog ───────────────────────────────────────────────────────────────
export component SimulationSettingsDialog inherits Rectangle {
    // ── Display state ──
    in-out property <int> active-tab: 0;  // 0=Conditions, 1=Step, 2=Recording, 3=Results

    // ── Initial Conditions ──
    in-out property <string> time-scale-preset: "Realtime";
    in-out property <string> custom-time-scale: "1.0";
    in-out property <string> tick-rate: "60";
    in-out property <string> max-ticks-per-frame: "10";
    in-out property <bool> auto-start: false;

    // ── Step Settings ──
    in-out property <string> step-duration: "1.0";
    in-out property <string> run-until-time: "";
    in-out property <string> run-until-tick: "";

    // ── Recording ──
    in-out property <bool> recording-enabled: true;
    in-out property <string> output-dir: "recordings";
    in-out property <string> export-format: "JSON + CSV";
    in-out property <bool> auto-export: true;
    in-out property <[WatchpointData]> watchpoints: [];
    in-out property <string> new-wp-name: "";
    in-out property <string> new-wp-label: "";
    in-out property <string> new-wp-unit: "";

    // ── UI Results Bindings ──
    in-out property <[SimOutputBinding]> output-bindings: [];
    in-out property <string> new-bind-instance: "";
    in-out property <string> new-bind-property: "Text";
    in-out property <string> new-bind-watchpoint: "";
    in-out property <string> new-bind-format: "{:.2}";

    // ── Callbacks ──
    callback on-close();
    callback on-save();               // Save to simulation.toml (also applies)
    callback on-add-watchpoint();
    callback on-remove-watchpoint(int);
    callback on-add-output-binding();
    callback on-remove-output-binding(int);

    // The preset strings are matched verbatim by the host's Save handler
    // (slint_ui.rs, SaveSimulationSettings), so they must not change.
    property <[string]> preset-options: [
        "Realtime (1×)",
        "1 min / sec (60×)",
        "1 hr / sec (3,600×)",
        "1 day / sec (86,400×)",
        "1 week / sec (604,800×)",
        "1 month / sec (2.63M×)",
        "1 year / sec (31.5M×)",
        "Custom",
    ];
    property <[string]> format-options: ["JSON", "CSV", "JSON + CSV", "Binary (.simdata)"];

    // The combo index for a stored preset. The host treats any string it
    // does not know as Custom, so an unknown value shows Custom here too;
    // the bare "Realtime" default is realtime.
    pure function preset-index(v: string) -> int {
        if (v == "Realtime (1×)" || v == "Realtime") { return 0; }
        if (v == "1 min / sec (60×)") { return 1; }
        if (v == "1 hr / sec (3,600×)") { return 2; }
        if (v == "1 day / sec (86,400×)") { return 3; }
        if (v == "1 week / sec (604,800×)") { return 4; }
        if (v == "1 month / sec (2.63M×)") { return 5; }
        if (v == "1 year / sec (31.5M×)") { return 6; }
        return 7;
    }

    pure function format-index(v: string) -> int {
        if (v == "JSON") { return 0; }
        if (v == "CSV") { return 1; }
        if (v == "Binary (.simdata)") { return 3; }
        return 2;
    }

    width: 100%;
    height: 100%;
    background: transparent;

    DialogScrim {
        dismiss => { root.on-close(); }

        keys := FocusScope {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(780px, parent.width - 48px);
            height: min(600px, parent.height - 48px);

            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.on-close();
                    return accept;
                }
                reject
            }

            DialogCard {
                width: 100%;
                height: 100%;
                icon: @image-url("../../assets/icons/ui/sim-settings.svg");
                title: "Simulation settings";
                subtitle: "Time, stepping, recording and result bindings";
                close => { root.on-close(); }

                HorizontalLayout {
                    vertical-stretch: 1;
                    padding: 0;
                    spacing: 0;

                    // ── Sidebar ──
                    Rectangle {
                        width: 176px;
                        background: Theme.background-primary.with-alpha(0.35);

                        VerticalLayout {
                            padding: 10px;
                            spacing: 2px;
                            alignment: start;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-top: 4px;
                                padding-bottom: 6px;
                                KitSectionLabel { text: "SIMULATION"; }
                            }

                            NavItem {
                                icon: @image-url("../../assets/icons/ui/clock.svg");
                                text: "Conditions";
                                selected: root.active-tab == 0;
                                clicked => { root.active-tab = 0; }
                            }
                            NavItem {
                                icon: @image-url("../../assets/icons/ui/play.svg");
                                text: "Step";
                                selected: root.active-tab == 1;
                                clicked => { root.active-tab = 1; }
                            }
                            NavItem {
                                icon: @image-url("../../assets/icons/ui/database.svg");
                                text: "Recording";
                                selected: root.active-tab == 2;
                                clicked => { root.active-tab = 2; }
                            }
                            NavItem {
                                icon: @image-url("../../assets/icons/ui/chart-line.svg");
                                text: "Results";
                                selected: root.active-tab == 3;
                                clicked => { root.active-tab = 3; }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: Theme.ribbon-separator; }

                    // ── Content ──
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        // ════ Section 0: initial conditions ════
                        if root.active-tab == 0: ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;
                                alignment: start;

                                SettingsGroup {
                                    title: "TIME COMPRESSION";

                                    SettingRow {
                                        label: "Preset";
                                        description: "How much simulated time passes per real second.";
                                        divider: false;
                                        ComboBox {
                                            width: 210px;
                                            model: root.preset-options;
                                            current-index: root.preset-index(root.time-scale-preset);
                                            selected(v) => { root.time-scale-preset = v; }
                                        }
                                    }
                                    SettingRow {
                                        label: "Custom time scale";
                                        description: "Used when the preset is Custom.";
                                        SimField { value <=> root.custom-time-scale; unit: "×"; }
                                    }
                                }

                                SettingsGroup {
                                    title: "ENGINE";

                                    SettingRow {
                                        label: "Tick rate";
                                        description: "Simulation ticks per real second. Higher is more accurate and costs more CPU.";
                                        divider: false;
                                        SimField { value <=> root.tick-rate; unit: "Hz"; }
                                    }
                                    SettingRow {
                                        label: "Max ticks per frame";
                                        description: "Caps the ticks run in one rendered frame, so a slow frame cannot snowball.";
                                        SimField { value <=> root.max-ticks-per-frame; unit: "ticks"; }
                                    }
                                }

                                SettingsGroup {
                                    title: "STARTUP";

                                    SettingRow {
                                        label: "Auto-start on Play";
                                        description: "Start the simulation as soon as Play begins. Off: start it with the Run button or sim.start() in Rune.";
                                        divider: false;
                                        KitSwitch { checked <=> root.auto-start; }
                                    }
                                }
                            }
                        }

                        // ════ Section 1: stepping ════
                        if root.active-tab == 1: ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;
                                alignment: start;

                                SettingsGroup {
                                    title: "MANUAL STEP";

                                    SettingRow {
                                        label: "Step duration";
                                        description: "Simulated seconds per sim.step() call or Step press.";
                                        divider: false;
                                        SimField { value <=> root.step-duration; unit: "sim-s"; }
                                    }
                                }

                                SettingsGroup {
                                    title: "AUTO-STOP";
                                    note: "Leave a field blank to run with no limit.";

                                    SettingRow {
                                        label: "Run until sim time";
                                        description: "Stop when simulated time reaches this value.";
                                        divider: false;
                                        SimField { value <=> root.run-until-time; unit: "sim-s"; placeholder: "No limit"; }
                                    }
                                    SettingRow {
                                        label: "Run until tick";
                                        description: "Stop after this many simulation ticks.";
                                        SimField { value <=> root.run-until-tick; unit: "ticks"; placeholder: "No limit"; }
                                    }
                                }

                                SettingsGroup {
                                    title: "RUNE API";

                                    VerticalLayout {
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 4px;

                                        Text {
                                            text: "sim.set_time_scale(3600.0);   // 1 hr per real second";
                                            color: Theme.text-accent; font-size: 11px; font-family: "Consolas";
                                        }
                                        Text {
                                            text: "sim.run_until_time(86400.0);  // stop at 24 h";
                                            color: Theme.text-accent; font-size: 11px; font-family: "Consolas";
                                        }
                                        Text {
                                            text: "sim.step_n(100);              // advance 100 ticks";
                                            color: Theme.text-accent; font-size: 11px; font-family: "Consolas";
                                        }
                                        Text {
                                            text: "sim.run_hours(24.0);          // run 24 simulated hours";
                                            color: Theme.text-accent; font-size: 11px; font-family: "Consolas";
                                        }
                                    }
                                }
                            }
                        }

                        // ════ Section 2: recording ════
                        if root.active-tab == 2: ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;
                                alignment: start;

                                SettingsGroup {
                                    title: "OUTPUT";

                                    SettingRow {
                                        label: "Enable recording";
                                        description: "Record watchpoint values while the simulation runs.";
                                        divider: false;
                                        KitSwitch { checked <=> root.recording-enabled; }
                                    }
                                    SettingRow {
                                        label: "Output folder";
                                        description: "Where recordings are written, relative to the Space.";
                                        SimField { value <=> root.output-dir; field-width: 180px; }
                                    }
                                    SettingRow {
                                        label: "Export format";
                                        ComboBox {
                                            width: 180px;
                                            model: root.format-options;
                                            current-index: root.format-index(root.export-format);
                                            selected(v) => { root.export-format = v; }
                                        }
                                    }
                                    SettingRow {
                                        label: "Export on Stop";
                                        description: "Write the recording out when the simulation stops.";
                                        KitSwitch { checked <=> root.auto-export; }
                                    }
                                }

                                SettingsGroup {
                                    title: "WATCHPOINTS";
                                    note: "A watchpoint records one script variable by name.";

                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 10px;
                                        ColumnHead { width: 140px; text: "NAME"; }
                                        ColumnHead { horizontal-stretch: 1; text: "LABEL"; }
                                        ColumnHead { width: 64px; text: "UNIT"; }
                                        Rectangle { width: 26px; }
                                    }

                                    for wp[i] in root.watchpoints: WatchpointRow {
                                        name: wp.name;
                                        label: wp.label;
                                        unit: wp.unit;
                                        remove => { root.on-remove-watchpoint(i); }
                                    }

                                    if root.watchpoints.length == 0: VerticalLayout {
                                        KitDivider { }
                                        EmptyLine { text: "No watchpoints yet. Add a variable below to record it."; }
                                    }

                                    KitDivider { }
                                    HorizontalLayout {
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 8px;

                                        LineEdit {
                                            width: 140px;
                                            placeholder-text: "variable_name";
                                            text <=> root.new-wp-name;
                                        }
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            placeholder-text: "Display label";
                                            text <=> root.new-wp-label;
                                        }
                                        LineEdit {
                                            width: 72px;
                                            placeholder-text: "Unit";
                                            text <=> root.new-wp-unit;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            KitButton {
                                                text: "Add";
                                                has-icon: true;
                                                icon: @image-url("../../assets/icons/ui/plus.svg");
                                                clicked => { root.on-add-watchpoint(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ════ Section 3: result bindings ════
                        if root.active-tab == 3: ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;
                                alignment: start;

                                KitNotice {
                                    kind: "info";
                                    text: "Bind a watchpoint to a UI instance property. The value updates every sim tick through the Rune on_tick() hook.";
                                }

                                SettingsGroup {
                                    title: "BINDINGS";

                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 10px;
                                        ColumnHead { width: 140px; text: "INSTANCE"; }
                                        ColumnHead { width: 90px; text: "PROPERTY"; }
                                        ColumnHead { width: 110px; text: "WATCHPOINT"; }
                                        ColumnHead { horizontal-stretch: 1; text: "FORMAT"; }
                                        Rectangle { width: 26px; }
                                    }

                                    for bind[i] in root.output-bindings: BindingRow {
                                        instance-name: bind.instance-name;
                                        property-name: bind.property-name;
                                        watchpoint: bind.watchpoint;
                                        format: bind.format;
                                        remove => { root.on-remove-output-binding(i); }
                                    }

                                    if root.output-bindings.length == 0: VerticalLayout {
                                        KitDivider { }
                                        EmptyLine { text: "No bindings yet. Use the row below to bind a watchpoint to a property."; }
                                    }

                                    KitDivider { }
                                    HorizontalLayout {
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 8px;

                                        LineEdit {
                                            horizontal-stretch: 1;
                                            placeholder-text: "Instance name";
                                            text <=> root.new-bind-instance;
                                        }
                                        LineEdit {
                                            width: 84px;
                                            placeholder-text: "Property";
                                            text <=> root.new-bind-property;
                                        }
                                        LineEdit {
                                            width: 100px;
                                            placeholder-text: "Watchpoint";
                                            text <=> root.new-bind-watchpoint;
                                        }
                                        LineEdit {
                                            width: 70px;
                                            placeholder-text: "{:.2}";
                                            text <=> root.new-bind-format;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            KitButton {
                                                text: "Bind";
                                                has-icon: true;
                                                icon: @image-url("../../assets/icons/ui/link.svg");
                                                clicked => { root.on-add-output-binding(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Footer: Save applies and writes simulation.toml ──
                DialogFooter {
                    KitButton {
                        text: "Close";
                        clicked => { root.on-close(); }
                    }
                    KitButton {
                        text: "Save";
                        kind: "primary";
                        clicked => { root.on-save(); }
                    }
                }
            }
        }
    }
}
