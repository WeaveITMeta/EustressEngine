// ============================================================================
// Eustress Engine Studio - Theme Definition
// Professional dark/light theme with modern aesthetics
// ============================================================================

import { HorizontalBox, VerticalBox, LineEdit, ScrollView, Button, CheckBox, ComboBox, Slider, SpinBox, TextEdit } from "std-widgets.slint";

// ============================================================================
// ThemeData — the full swappable visual palette.
//
// Every aesthetic token (color + themeable radius/glow length) lives here as
// one struct so Rust can swap the WHOLE palette atomically with a single
// `Theme.data = ...` (`set_data(...)`) call — no per-token setters. Because a
// Rust struct literal must fill every field, a token added here that Rust
// forgets to populate becomes a COMPILE ERROR, not a silent no-op. This is the
// backbone of the TOML-driven theme engine: a parsed `theme.toml` is turned
// into one of these structs and pushed in.
//
// Layout/motion tokens (spacing-*, font-*, panel-anim-*, reduce-motion) are
// deliberately NOT here — they are structural, not palette, and stay static on
// the Theme global below.
// ============================================================================
export struct ThemeData {
    // Primary / panel / viewport surfaces
    background-primary: color,
    background-secondary: color,
    background-tertiary: color,
    panel-background: color,
    header-background: color,
    viewport-background: color,
    // Tabs
    tab-active: color,
    tab-inactive: color,
    tab-hover: color,
    // Text
    text-primary: color,
    text-secondary: color,
    text-disabled: color,
    text-accent: color,
    text-error: color,
    text-warning: color,
    text-success: color,
    // Borders
    border-color: color,
    border-focus: color,
    border-error: color,
    // Status "surface" tints — dark tinted backgrounds for success/danger
    // affordances (a Save-and-Connect button, an error panel) that need more
    // than a foreground accent color. Discovered as a real recurring gap
    // during the hex-token audit (soul_settings.slint, forge_connect.slint).
    success-surface: color,
    success-surface-hover: color,
    success-surface-border: color,
    success-surface-text-hover: color,
    error-surface: color,
    error-surface-hover: color,
    error-surface-border: color,
    // Buttons
    button-background: color,
    button-hover: color,
    button-pressed: color,
    button-primary: color,
    button-primary-hover: color,
    // Inputs
    input-background: color,
    input-border: color,
    input-focus: color,
    // Selection
    selection-background: color,
    selection-border: color,
    // Overlays / dialogs
    overlay-background: color,
    dialog-background: color,
    modal-backdrop: color,
    dialog-titlebar-background: color,
    // Accents
    accent-blue: color,
    accent-cyan: color,
    accent-eustress: color,
    accent-green: color,
    accent-green-bright: color,
    accent-orange: color,
    accent-purple: color,
    accent-red: color,
    accent-yellow: color,
    // Semantic ribbon-tint categories
    cat-parts: color,
    cat-structure: color,
    cat-constraint: color,
    cat-modify: color,
    cat-data: color,
    // Floating-overlay surface treatments
    panel-glass: color,
    border-highlight: color,
    shadow-float: color,
    border-glow-color: color,
    // Ribbon
    ribbon-background: color,
    ribbon-tab-active: color,
    ribbon-tab-inactive: color,
    ribbon-separator: color,
    // Explorer
    explorer-item-hover: color,
    explorer-item-selected: color,
    explorer-folder: color,
    explorer-file: color,
    // Output console
    output-info: color,
    output-warning: color,
    output-error: color,
    output-debug: color,
    // Gizmo
    gizmo-x: color,
    gizmo-y: color,
    gizmo-z: color,
    // Shadow
    shadow-color: color,
    // Themeable lengths
    accent-glow-blur: length,
    backdrop-blur-lg: length,
    radius-sm: length,
    radius-md: length,
    radius-lg: length,
    radius-xl: length,
}

// Global theme colors - dark mode by default
export global Theme {
    // ── Built-in palettes ────────────────────────────────────────────────
    // The two shipped palettes as compile-time constants (values migrated
    // 1:1 from the former `modern ? A : B` literals). Rust picks one and
    // pushes it into `data`. In Phase B these become TOML-sourced — the
    // Rust loader will build a `ThemeData` from a parsed `theme.toml` and
    // these two constants become the fallback/default only.
    out property <ThemeData> preset-classic: {
        background-primary: #0e0e0e,
        background-secondary: #121212,
        background-tertiary: #1a1a1a,
        panel-background: #121212,
        header-background: #1a1a1a,
        viewport-background: #0a0a0a,
        tab-active: #121212,
        tab-inactive: #181818,
        tab-hover: #222222,
        text-primary: #d4d4d4,
        text-secondary: #808080,
        text-disabled: #4a4a4a,
        text-accent: #4fc1ff,
        text-error: #f14c4c,
        text-warning: #cca700,
        text-success: #4ec9b0,
        border-color: #222222,
        border-focus: #3cba54,
        border-error: #f14c4c,
        success-surface: #152a1e,
        success-surface-hover: #1a4a2a,
        success-surface-border: #2a5a32,
        success-surface-text-hover: #a5d6a7,
        error-surface: #2a1515,
        error-surface-hover: #3d1515,
        error-surface-border: #4a2020,
        button-background: #252525,
        button-hover: #303030,
        button-pressed: #1a1a1a,
        button-primary: #0078d4,
        button-primary-hover: #1a8ae8,
        input-background: #161616,
        input-border: #2a2a2a,
        input-focus: #3cba54,
        selection-background: #14301c,
        selection-border: #3cba54,
        overlay-background: #121212e8,
        dialog-background: #1a1a1a,
        modal-backdrop: #000000a0,
        dialog-titlebar-background: #13131f,
        accent-blue: #0078d4,
        accent-cyan: #00bcd4,
        accent-eustress: #3cba54,
        accent-green: #3cba54,
        accent-green-bright: #00e676,
        accent-orange: #e8912d,
        accent-purple: #b180d7,
        accent-red: #e74856,
        accent-yellow: #f9c74f,
        cat-parts: #64b5f6,
        cat-structure: #81c784,
        cat-constraint: #ffb74d,
        cat-modify: #ba68c8,
        cat-data: #4dd0e1,
        panel-glass: #121212e8,
        border-highlight: #ffffff10,
        shadow-float: #00000060,
        border-glow-color: #00000000,
        ribbon-background: #101010,
        ribbon-tab-active: #121212,
        ribbon-tab-inactive: #1a1a1a,
        ribbon-separator: #222222,
        explorer-item-hover: #1a1a1a,
        explorer-item-selected: #0a2e48,
        explorer-folder: #e8b84a,
        explorer-file: #c8c8c8,
        output-info: #3794ff,
        output-warning: #cca700,
        output-error: #f14c4c,
        output-debug: #858585,
        gizmo-x: #f14c4c,
        gizmo-y: #4ec9b0,
        gizmo-z: #569cd6,
        shadow-color: #00000080,
        accent-glow-blur: 0px,
        backdrop-blur-lg: 12px,
        radius-sm: 2px,
        radius-md: 4px,
        radius-lg: 8px,
        radius-xl: 12px,
    };
    out property <ThemeData> preset-modern: {
        background-primary: #0a0f18,
        background-secondary: #0d1320,
        background-tertiary: #131b2b,
        panel-background: #0c1220,
        header-background: #101a2c,
        viewport-background: #04070d,
        tab-active: #122034,
        tab-inactive: #0b1322,
        tab-hover: #172a42,
        text-primary: #e8ecf3,
        text-secondary: #8b95a7,
        text-disabled: #4b5568,
        text-accent: #4fd6ff,
        text-error: #ff6b6b,
        text-warning: #ffcc55,
        text-success: #3ce0b0,
        border-color: #0a84ff26,
        border-focus: #0a84ff,
        border-error: #ff5470,
        success-surface: #0d2419,
        success-surface-hover: #123320,
        success-surface-border: #1f5c3a,
        success-surface-text-hover: #8ce6b8,
        error-surface: #2a0f14,
        error-surface-hover: #3d1219,
        error-surface-border: #7a2030,
        button-background: #111a2a,
        button-hover: #1a2740,
        button-pressed: #0b1322,
        button-primary: #0a84ff,
        button-primary-hover: #3aa0ff,
        input-background: #0a1120,
        input-border: #0a84ff38,
        input-focus: #0a84ff,
        selection-background: #0a84ff26,
        selection-border: #0a84ff,
        overlay-background: #060a12e8,
        dialog-background: #0d1526,
        modal-backdrop: #000000cc,
        dialog-titlebar-background: #0a1322,
        accent-blue: #0a84ff,
        accent-cyan: #22d3ee,
        accent-eustress: #0a84ff,
        accent-green: #34d399,
        accent-green-bright: #00ffa3,
        accent-orange: #ff9f45,
        accent-purple: #c084fc,
        accent-red: #ff5470,
        accent-yellow: #ffd166,
        cat-parts: #60a5fa,
        cat-structure: #4ade80,
        cat-constraint: #fbbf24,
        cat-modify: #c084fc,
        cat-data: #22d3ee,
        panel-glass: #0a1120cc,
        border-highlight: #0a84ff22,
        shadow-float: #000000a6,
        border-glow-color: #0a84ff7a,
        ribbon-background: #080d18,
        ribbon-tab-active: #122034,
        ribbon-tab-inactive: #0b1322,
        ribbon-separator: #0a84ff26,
        explorer-item-hover: #111a2a,
        explorer-item-selected: #0a3a4a,
        explorer-folder: #f0c04a,
        explorer-file: #c8d0dc,
        output-info: #4fd6ff,
        output-warning: #ffcc55,
        output-error: #ff6b6b,
        output-debug: #8b95a7,
        gizmo-x: #f14c4c,
        gizmo-y: #4ec9b0,
        gizmo-z: #569cd6,
        shadow-color: #000000a0,
        accent-glow-blur: 12px,
        backdrop-blur-lg: 14px,
        radius-sm: 5px,
        radius-md: 9px,
        radius-lg: 16px,
        radius-xl: 22px,
    };

    // ── The live palette ─────────────────────────────────────────────────
    // Swapped atomically by Rust (`set_data`). Default = Classic to match the
    // pre-first-frame boot look; `init_theme_to_slint` immediately pushes the
    // persisted choice on the first frame.
    in-out property <ThemeData> data: root.preset-classic;

    // UI-state mirror ONLY — no longer drives any color (colors come from
    // `data`). Kept so the Settings > Theme swatch pair can highlight the
    // active choice; Rust sets it alongside `set_data`. Phase B removes it
    // when the swatch pair becomes a data-driven theme list.
    in-out property <bool> modern: false;

    // ── Alias tokens ─────────────────────────────────────────────────────
    // Every consumer's `Theme.background-primary` (across ~42 files) keeps
    // working unchanged — the tokens now read through the swappable struct.
    out property <color> background-primary: root.data.background-primary;
    out property <color> background-secondary: root.data.background-secondary;
    out property <color> background-tertiary: root.data.background-tertiary;
    out property <color> panel-background: root.data.panel-background;
    out property <color> header-background: root.data.header-background;
    out property <color> viewport-background: root.data.viewport-background;
    out property <color> tab-active: root.data.tab-active;
    out property <color> tab-inactive: root.data.tab-inactive;
    out property <color> tab-hover: root.data.tab-hover;
    out property <color> text-primary: root.data.text-primary;
    out property <color> text-secondary: root.data.text-secondary;
    out property <color> text-disabled: root.data.text-disabled;
    out property <color> text-accent: root.data.text-accent;
    out property <color> text-error: root.data.text-error;
    out property <color> text-warning: root.data.text-warning;
    out property <color> text-success: root.data.text-success;
    out property <color> border-color: root.data.border-color;
    out property <color> border-focus: root.data.border-focus;
    out property <color> border-error: root.data.border-error;
    out property <color> success-surface: root.data.success-surface;
    out property <color> success-surface-hover: root.data.success-surface-hover;
    out property <color> success-surface-border: root.data.success-surface-border;
    out property <color> success-surface-text-hover: root.data.success-surface-text-hover;
    out property <color> error-surface: root.data.error-surface;
    out property <color> error-surface-hover: root.data.error-surface-hover;
    out property <color> error-surface-border: root.data.error-surface-border;
    out property <color> button-background: root.data.button-background;
    out property <color> button-hover: root.data.button-hover;
    out property <color> button-pressed: root.data.button-pressed;
    out property <color> button-primary: root.data.button-primary;
    out property <color> button-primary-hover: root.data.button-primary-hover;
    out property <color> input-background: root.data.input-background;
    out property <color> input-border: root.data.input-border;
    out property <color> input-focus: root.data.input-focus;
    out property <color> selection-background: root.data.selection-background;
    out property <color> selection-border: root.data.selection-border;
    out property <color> overlay-background: root.data.overlay-background;
    out property <color> dialog-background: root.data.dialog-background;
    out property <color> modal-backdrop: root.data.modal-backdrop;
    out property <color> dialog-titlebar-background: root.data.dialog-titlebar-background;
    // `accent-eustress` is the ONE token a Mode manifest may override
    // (ModeTheme.accent) — applied as a theme⊕overlay recomposition in Rust,
    // never mutating the base palette.
    out property <color> accent-blue: root.data.accent-blue;
    out property <color> accent-cyan: root.data.accent-cyan;
    out property <color> accent-eustress: root.data.accent-eustress;
    out property <color> accent-green: root.data.accent-green;
    out property <color> accent-green-bright: root.data.accent-green-bright;
    out property <color> accent-orange: root.data.accent-orange;
    out property <color> accent-purple: root.data.accent-purple;
    out property <color> accent-red: root.data.accent-red;
    out property <color> accent-yellow: root.data.accent-yellow;
    out property <color> cat-parts: root.data.cat-parts;
    out property <color> cat-structure: root.data.cat-structure;
    out property <color> cat-constraint: root.data.cat-constraint;
    out property <color> cat-modify: root.data.cat-modify;
    out property <color> cat-data: root.data.cat-data;
    out property <color> panel-glass: root.data.panel-glass;
    out property <color> border-highlight: root.data.border-highlight;
    out property <color> shadow-float: root.data.shadow-float;
    out property <color> border-glow-color: root.data.border-glow-color;
    out property <color> ribbon-background: root.data.ribbon-background;
    out property <color> ribbon-tab-active: root.data.ribbon-tab-active;
    out property <color> ribbon-tab-inactive: root.data.ribbon-tab-inactive;
    out property <color> ribbon-separator: root.data.ribbon-separator;
    out property <color> explorer-item-hover: root.data.explorer-item-hover;
    out property <color> explorer-item-selected: root.data.explorer-item-selected;
    out property <color> explorer-folder: root.data.explorer-folder;
    out property <color> explorer-file: root.data.explorer-file;
    out property <color> output-info: root.data.output-info;
    out property <color> output-warning: root.data.output-warning;
    out property <color> output-error: root.data.output-error;
    out property <color> output-debug: root.data.output-debug;
    out property <color> gizmo-x: root.data.gizmo-x;
    out property <color> gizmo-y: root.data.gizmo-y;
    out property <color> gizmo-z: root.data.gizmo-z;
    out property <color> shadow-color: root.data.shadow-color;
    out property <length> accent-glow-blur: root.data.accent-glow-blur;
    out property <length> backdrop-blur-lg: root.data.backdrop-blur-lg;
    out property <length> radius-sm: root.data.radius-sm;
    out property <length> radius-md: root.data.radius-md;
    out property <length> radius-lg: root.data.radius-lg;
    out property <length> radius-xl: root.data.radius-xl;

    // ── Static layout / motion tokens (NOT palette) ──────────────────────
    // Panel enter/exit motion — 180ms slide+fade per TOOLSET_UX.md §2.4.
    // Prefers-reduced-motion gate collapses this to 30ms at runtime
    // via `reduce-motion` input; components multiply the duration by
    // `motion-scale` to honor it.
    out property <duration> panel-anim-duration: 180ms;
    out property <duration> panel-anim-duration-fast: 120ms; // hover
    out property <duration> panel-anim-duration-flash: 150ms; // commit flash

    /// When true, pulses / tweens clamp to a short static duration —
    /// set from the OS `prefers-reduced-motion` flag. Slint bindings
    /// that care multiply their animation by `motion-scale`.
    in property <bool>  reduce-motion: false;
    out property <float> motion-scale: root.reduce-motion ? 0.15 : 1.0;

    // Spacing
    out property <length> spacing-xs: 2px;
    out property <length> spacing-sm: 4px;
    out property <length> spacing-md: 8px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 24px;

    // Font sizes
    out property <length> font-xs: 10px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 18px;
    out property <length> font-xxl: 24px;
}

// Icon button component for consistent styling with hover tooltip and label.
// Shortcut (when present) renders as a dim subtitle below the label so users
// learn the keyboard accelerator without hovering for the tooltip. The
// shortcut string is driven by the Keybindings resource so remapping in
// File > Settings > Keybindings propagates live.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <string> shortcut: ""; // e.g. "Alt+Z", "Ctrl+S" — empty hides subtitle
    in property <string> tooltip: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> tint: #d4d4d4; // Tint color for SVG icon (default matches base icon grey)

    callback clicked();
    callback right-clicked();
    callback long-pressed();

    property <bool> is-pressing: false;
    property <bool> tooltip-visible: false;

    width: root.label != "" ? (label-measure.preferred-width > 34px ? label-measure.preferred-width + 10px : 44px) : 36px;
    // Grow the button vertically by 10px when a shortcut is shown, so the
    // subtitle has room without clipping the icon or squeezing the label.
    height: root.label != "" ? (root.shortcut != "" ? 62px : 52px) : 36px;
    
    // Hidden text for width measurement — positioned absolutely so it doesn't affect layout
    label-measure := Text {
        visible: false;
        x: 0px; y: 0px;
        width: 0px; height: 0px;
        text: root.label;
        font-size: 10px;
    }
    border-radius: Theme.radius-md;
    // Selected = the currently-active tool. Brand-teal halo with a subtle
    // tinted fill (not a full blue block like before) — matches the
    // active-tool ring convention in TOOLSET_UX.md §5.2.
    background: self.selected ? Theme.accent-eustress.with-alpha(0.08) :
                touch.has-hover ? Theme.button-hover : transparent;
    border-width: self.selected ? 1px : 0px;
    border-color: self.selected ? Theme.accent-eustress : transparent;
    drop-shadow-blur: self.selected ? 8px : 0px;
    drop-shadow-color: self.selected ? Theme.accent-eustress.with-alpha(0.25) : transparent;

    opacity: self.enabled ? 1.0 : 0.5;
    clip: false;
    
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.is-pressing = false;
            root.clicked();
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.right-clicked();
            } else if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.is-pressing = true;
                    long-press-timer.restart();
                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    root.is-pressing = false;
                }
            }
        }
    }
    
    // Tooltip hover timer - show after brief delay when hovering
    tooltip-timer := Timer {
        interval: 300ms;
        running: touch.has-hover && root.tooltip != "" && !root.tooltip-visible;
        triggered => {
            root.tooltip-visible = true;
            tooltip-popup.show();
        }
    }
    
    // Hide tooltip timer - close when not hovering
    hide-tooltip-timer := Timer {
        interval: 50ms;
        running: !touch.has-hover && root.tooltip-visible;
        triggered => {
            root.tooltip-visible = false;
            tooltip-popup.close();
        }
    }
    
    // Long-press timer - triggers after 500ms of holding
    long-press-timer := Timer {
        interval: 500ms;
        triggered => {
            if root.is-pressing {
                root.is-pressing = false;
                root.long-pressed();
            }
        }
    }
    
    // Unified icon-over-label layout. Every child is horizontally
    // centered within the button's full width; the VerticalLayout centers
    // the whole stack on the button's cross-axis. Previously the Image
    // drifted off-center because the VerticalLayout had no horizontal
    // alignment rule and Slint defaulted to stretch+left.
    VerticalLayout {
        padding-top: root.label != "" ? 4px : 7px;
        padding-bottom: root.label != "" ? 4px : 7px;
        spacing: 2px;
        alignment: center;

        // Icon row — HorizontalLayout centers horizontally within the full button width.
        HorizontalLayout {
            alignment: center;
            Image {
                width: 22px;
                height: 22px;
                source: root.icon;
                image-fit: contain;
                // Selected state tints to Eustress brand teal — matches the
                // active-tool ring elsewhere in the UI for visual continuity.
                colorize: root.selected ? Theme.accent-eustress :
                          (root.tint != transparent ? root.tint : transparent);
            }
        }

        if root.label != "": btn-label := Text {
            text: root.label;
            color: root.selected ? Theme.accent-eustress : Theme.text-secondary;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
        }

        if root.label != "" && root.shortcut != "": Text {
            text: root.shortcut;
            color: Theme.text-disabled;
            font-size: 9px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    
    // Tooltip popup — uses PopupWindow for correct z-ordering above all panels
    tooltip-popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        
        Rectangle {
            background: Theme.dialog-background;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.border-color;
            drop-shadow-blur: 4px;
            drop-shadow-color: Theme.shadow-float;

            HorizontalBox {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;

                Text {
                    text: root.tooltip;
                    color: Theme.text-primary;
                    font-size: 11px;
                }
            }
        }
    }
}

// Toolbar separator
export component ToolbarSeparator inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Theme.ribbon-separator;
}

// Unified side-panel header — matches the Properties panel's top bar
// so every right-hand panel (History, Soul, Workshop, Problems) shares
// the same 36px gradient, bold title, and optional count badge. New
// side panels should use this rather than hand-rolling a title row.
export component SidePanelHeader inherits Rectangle {
    in property <string> title: "";
    // Optional icon — pass `@image-url(...)` from the caller. Empty
    // SharedString / null image renders without an icon slot.
    in property <image> icon;
    in property <bool> show-icon: false;
    // Optional right-aligned badge (e.g. message count, pending
    // problems count). `0` hides it; any non-zero value shows the
    // blue pill with the number.
    in property <int> count: 0;

    height: 36px;
    background: @linear-gradient(180deg, Theme.header-background 0%, Theme.tab-inactive 100%);

    // 1px bottom separator — matches Properties panel treatment
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border-color;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: start;

        if root.show-icon: VerticalLayout {
            width: 16px;
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                image-fit: contain;
            }
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.3px;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // Badge sits in its own VerticalLayout slot so it can vertically
        // center inside the 36px header. Text inside the pill fills the
        // pill's full width/height so horizontal/vertical-alignment apply.
        if root.count > 0: VerticalLayout {
            width: 24px;
            alignment: center;
            Rectangle {
                width: 24px;
                height: 18px;
                border-radius: 9px;
                background: Theme.accent-blue;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.count;
                    color: white;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Panel header component
export component PanelHeader inherits Rectangle {
    in property <string> title: "";
    in property <bool> collapsible: false;
    in-out property <bool> collapsed: false;
    
    callback toggle-collapsed();
    
    height: 28px;
    background: Theme.header-background;
    
    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        
        if root.collapsible: TouchArea {
            width: 16px;
            clicked => { 
                root.collapsed = !root.collapsed;
                root.toggle-collapsed();
            }
            
            Image {
                width: 12px;
                height: 12px;
                source: root.collapsed ? @image-url("../../assets/icons/ui/chevron-right.svg") :
                        @image-url("../../assets/icons/ui/chevron-down.svg");
                image-fit: contain;
                vertical-alignment: center;
            }
        }
        
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-weight: 500;
            vertical-alignment: center;
        }
        
        Rectangle { horizontal-stretch: 1; }
    }
}

// Property row component for properties panel
export component PropertyRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> editable: true;
    
    callback value-changed(string);
    
    height: 24px;
    background: transparent;
    
    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        
        Text {
            width: 100px;
            text: root.label;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        
        if root.editable: LineEdit {
            horizontal-stretch: 1;
            text: root.value;
            edited(text) => { root.value-changed(text); }
        }
        
        if !root.editable: Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

// Tree item component for explorer
export component TreeItem inherits Rectangle {
    in property <int> depth: 0;
    in property <image> icon;
    in property <string> label: "";
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    in property <bool> selected: false;
    in property <bool> show: true;
    in property <int> node-id: -1;
    // Drop target highlight — set by parent when this row is the drop target
    in property <bool> drop-target: false;

    callback clicked(/* ctrl */ bool, /* shift */ bool);
    callback double-clicked();
    callback toggle-expanded();
    callback context-menu(length, length);
    // Drag callbacks — parent ExplorerPanel handles state
    callback drag-started(int, length, length);  // node-id, initial abs-x, abs-y
    callback drag-moved(length, length);         // abs-x, abs-y
    callback drag-ended();

    // Inline rename — toggled from ExplorerPanel via renaming property
    in property <bool> renaming: false;
    callback rename-committed(string);
    callback rename-cancelled();

    // Internal: latched from pointer-event on mouse-down, read by clicked
    property <bool> pe-ctrl: false;
    property <bool> pe-shift: false;

    height: root.show ? 22px : 0px;
    visible: root.show;
    background: root.drop-target ? Theme.selection-background :
                self.selected ? Theme.explorer-item-selected :
                row-touch.has-hover ? Theme.explorer-item-hover : transparent;

    property <bool> drag-started-flag: false;
    property <bool> left-pressed: false;
    property <length> press-y: 0px;

    // Full-row touch area for selection, context menu, and drag-and-drop
    row-touch := TouchArea {
        clicked => {
            if !root.drag-started-flag {
                root.clicked(root.pe-ctrl, root.pe-shift);
            }
            root.pe-ctrl = false;
            root.pe-shift = false;
        }
        double-clicked => { root.double-clicked(); }
        moved => {
            if root.left-pressed {
                if !root.drag-started-flag && abs(self.mouse-y - root.press-y) > 5px {
                    root.drag-started-flag = true;
                    root.drag-started(root.node-id,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
                if root.drag-started-flag {
                    root.drag-moved(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                }
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pe-ctrl = event.modifiers.control;
                root.pe-shift = event.modifiers.shift;
                root.press-y = self.mouse-y;
                root.left-pressed = true;
                root.drag-started-flag = false;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.left-pressed = false;
                if root.drag-started-flag {
                    root.drag-ended();
                    root.drag-started-flag = false;
                }
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        scroll-event(e) => { return reject; }
    }

    // Drop target indicator — blue line at top of row
    if root.drop-target: Rectangle {
        y: 0px;
        width: 100%;
        height: 2px;
        background: Theme.accent-blue;
    }
    
    // Expand/collapse arrow
    if root.expandable: TouchArea {
        x: 4px + root.depth * 16px;
        y: 0px;
        width: 16px;
        height: 22px;
        mouse-cursor: pointer;
        clicked => { root.toggle-expanded(); }
        scroll-event(e) => { return reject; }
    }
    
    if root.expandable: Image {
        x: 4px + root.depth * 16px;
        y: 3px;
        width: 16px;
        height: 16px;
        source: root.expanded ? @image-url("../../assets/icons/ui/chevron-down.svg") :
                @image-url("../../assets/icons/ui/chevron-right.svg");
        image-fit: contain;
    }
    
    // SVG icon — pixel-perfect centered
    Image {
        x: 4px + root.depth * 16px + 16px;
        y: 3px;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
    }
    
    // Label — static text when not renaming
    if !root.renaming: Text {
        x: 4px + root.depth * 16px + 16px + 20px;
        y: 0px;
        width: root.width - (4px + root.depth * 16px + 16px + 20px + 4px);
        height: 22px;
        text: root.label;
        color: Theme.text-primary;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    // Inline rename TextInput — shown when renaming == true.
    // Auto-selects all text and grabs focus on creation so the user
    // can immediately type the new name without clicking first.
    if root.renaming: rename-input := TextInput {
        x: 4px + root.depth * 16px + 16px + 20px - 2px;
        y: 3px;
        width: root.width - (4px + root.depth * 16px + 16px + 20px - 2px + 6px);
        height: 16px;
        text: root.label;
        font-size: 12px;
        color: Theme.text-primary;
        selection-background-color: Theme.accent-blue;
        single-line: true;

        init => {
            self.select-all();
            self.focus();
        }

        key-pressed(event) => {
            if event.text == Key.Return {
                root.rename-committed(self.text);
                return accept;
            }
            if event.text == Key.Escape {
                root.rename-cancelled();
                return accept;
            }
            return reject;
        }
    }
}

// Log entry component for output console
export component LogEntry inherits Rectangle {
    in property <string> level: "info";
    in property <string> timestamp: "";
    in property <string> message: "";

    callback ctrl-clicked(string);

    height: 20px;
    background: log-touch.has-hover ? Theme.tab-hover : transparent;

    log-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && event.modifiers.control {
                root.ctrl-clicked(root.message);
            }
        }
    }
    
    // Level indicator SVG icon
    Image {
        x: 8px;
        y: 2px;
        width: 16px;
        height: 16px;
        source: root.level == "error" ? @image-url("../../assets/icons/ui/error.svg") :
                root.level == "warning" ? @image-url("../../assets/icons/ui/warning.svg") :
                root.level == "debug" ? @image-url("../../assets/icons/ui/debug.svg") :
                @image-url("../../assets/icons/ui/info.svg");
        image-fit: contain;
    }
    
    // Timestamp — read-only selectable
    TextInput {
        x: 28px;
        y: 2px;
        width: 70px;
        height: 16px;
        text: root.timestamp;
        color: Theme.text-secondary;
        font-size: 10px;
        read-only: true;
        single-line: true;
        wrap: no-wrap;
        selection-background-color: Theme.selection-background;
        selection-foreground-color: Theme.text-primary;
    }

    // Message — read-only selectable so users can copy log lines
    TextInput {
        x: 102px;
        y: 2px;
        width: root.width - 110px;
        height: 16px;
        text: root.message;
        color: root.level == "error" ? Theme.output-error :
               root.level == "warning" ? Theme.output-warning :
               root.level == "debug" ? Theme.output-debug : Theme.output-info;
        font-size: 12px;
        read-only: true;
        single-line: true;
        wrap: no-wrap;
        selection-background-color: Theme.selection-background;
        selection-foreground-color: Theme.text-primary;
    }
}
