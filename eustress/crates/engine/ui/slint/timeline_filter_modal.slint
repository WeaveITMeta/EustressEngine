// ============================================================================
// TimelineFilterModal: a list of switches for choosing which tag tracks are
// visible on the Timeline panel.
// ============================================================================
//
// Opened by the Filter button in the Timeline panel title bar.
// Shows every distinct tag in the current timeline with a switch and its
// event count, plus Select all / Deselect all shortcuts. Closes on a backdrop
// click, the close button, Done, or Escape.
//
// Chrome: DialogScrim > DialogCard > DialogFooter (DRAFTING_UX.md Law 1).
// A row's switch shows the state Rust pushes in `rows`; a click anywhere on
// the row asks Rust to flip it (`row-toggled`), so the switch is `managed`.

import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSwitch, KitDivider } from "dialog_kit.slint";

export struct TimelineTagRow {
    tag: string,
    visible: bool,
    count: int,
}

export component TimelineFilterModal inherits Rectangle {
    in property <[TimelineTagRow]> rows;
    in property <bool>             visible-when: false;

    callback row-toggled(string);  // tag name
    callback select-all();
    callback deselect-all();
    callback close-clicked();

    // One row's height; the list shows up to ten before it scrolls.
    property <length> row-height: 34px;

    visible: root.visible-when;
    background: transparent;
    width: 100%;
    height: 100%;

    // Escape closes. Other keys pass through as before.
    keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-clicked();
                return accept;
            }
            return reject;
        }

        // Click on the backdrop (outside the dialog) dismisses.
        DialogScrim {
            dismiss => { root.close-clicked(); }

            // The dialog itself.
            DialogCard {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 360px;
                height: min(body.preferred-height + footer.preferred-height + 45px, parent.height - 40px);
                icon: @image-url("../../assets/icons/ui/filter.svg");
                title: "Timeline filter";
                subtitle: "Choose which tag tracks the Timeline shows";
                close => { root.close-clicked(); }

                body := VerticalLayout {
                    padding: 14px;
                    vertical-stretch: 1;

                    // The tag list, one row per tag.
                    Rectangle {
                        vertical-stretch: 1;
                        preferred-height: root.rows.length == 0
                            ? 64px
                            : min(root.rows.length * root.row-height + 4px, 10 * root.row-height + 4px);
                        min-height: min(root.rows.length, 3) * root.row-height + 4px;
                        background: Theme.background-secondary.with-alpha(0.6);
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-color;
                        clip: true;

                        if root.rows.length == 0: Text {
                            width: parent.width;
                            height: parent.height;
                            text: "No tags on the timeline yet";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Flickable {
                            x: 0; y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewport-height: root.rows.length * root.row-height + 4px;
                            VerticalLayout {
                                x: 0; y: 2px;
                                width: parent.width;
                                spacing: 0px;

                                for row[i] in root.rows: Rectangle {
                                    height: root.row-height;
                                    background: row-touch.has-hover ? Theme.button-hover.with-alpha(0.5) : transparent;

                                    row-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.row-toggled(row.tag); }
                                    }

                                    if i > 0: KitDivider {
                                        x: 12px;
                                        y: 0;
                                        width: parent.width - 24px;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        // Tag name.
                                        Text {
                                            text: row.tag;
                                            color: row.visible ? Theme.text-primary : Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: row.visible ? 500 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        // Event count.
                                        Text {
                                            text: row.count == 1 ? "1 event" : row.count + " events";
                                            color: Theme.text-disabled;
                                            font-size: Theme.font-xs;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            KitSwitch {
                                                checked: row.visible;
                                                managed: true;
                                                toggled(v) => { root.row-toggled(row.tag); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                footer := DialogFooter {
                    pack-end: false;
                    KitButton {
                        text: "Select all";
                        kind: "ghost";
                        clicked => { root.select-all(); }
                    }
                    KitButton {
                        text: "Deselect all";
                        kind: "ghost";
                        clicked => { root.deselect-all(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    KitButton {
                        text: "Done";
                        kind: "primary";
                        clicked => { root.close-clicked(); }
                    }
                }
            }
        }
    }
}
