// ============================================================================
// Eustress Engine Studio - Terrain Panel
// Paint material picker, terrain properties, chunk list, and import/export.
// Brush tools and settings live in the Terrain ribbon tab toolbar; the Paint
// brush settings there show the same material picker as a swatch grid.
// ============================================================================

import { VerticalBox, HorizontalBox, ScrollView, Slider, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme, PanelHeader } from "theme.slint";

// One terrain material slot for the pickers, pushed from Rust
// (`sync_terrain_materials_to_slint`) off `TerrainMaterialSlots`: the slot
// id the Paint brush lays down, its display name, the colour it reads as
// from a distance, and whether the Space defines it (slots 23 and up).
export struct TerrainMaterialSlotData {
    slot-id: int,
    name: string,
    swatch: color,
    custom: bool,
}

// Collapsible section header with chevron
component SectionRow inherits Rectangle {
    in property <string> label: "";
    in property <bool> expanded: true;
    callback clicked();
    
    height: 24px;
    background: touch.has-hover ? Theme.button-hover : transparent;
    
    touch := TouchArea { clicked => { root.clicked(); } }
    
    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        
        Text {
            text: root.expanded ? "▼" : "▶";
            color: Theme.text-secondary;
            font-size: 9px;
            width: 12px;
            vertical-alignment: center;
        }
        
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            letter-spacing: 0.3px;
        }
    }
}

// Read-only property row: label + value
component PropertyRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    
    height: 24px;
    
    HorizontalBox {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 8px;
        
        Text {
            min-width: 110px;
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
        
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text-primary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Chunk list item row
export component ChunkRow inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();
    
    height: 24px;
    background: root.selected ? Theme.selection-background : 
                chunk-touch.has-hover ? Theme.button-hover : transparent;
    
    chunk-touch := TouchArea { clicked => { root.clicked(); } }
    
    HorizontalBox {
        padding-left: 24px;
        padding-right: 8px;
        spacing: 6px;
        
        Rectangle {
            width: 12px;
            height: 12px;
            background: Theme.accent-green;
            border-radius: 2px;
        }
        
        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// Material picker row: swatch, name, and a "Custom" tag for Space slots
component MaterialRow inherits Rectangle {
    in property <string> label: "";
    in property <color> swatch;
    in property <bool> custom: false;
    in property <bool> selected: false;
    callback clicked();

    height: 24px;
    background: root.selected ? Theme.selection-background :
                row-touch.has-hover ? Theme.button-hover : transparent;

    row-touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalBox {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 14px;
            height: 14px;
            background: root.swatch;
            border-radius: 3px;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Theme.accent-eustress : Theme.border-color;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.custom: Text {
            text: "Custom";
            color: Theme.text-secondary;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

// Terrain layer insert button: the class's Explorer icon and a short name
component LayerButton inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    callback clicked();

    height: 28px;
    horizontal-stretch: 1;
    background: layer-touch.has-hover ? Theme.button-hover : Theme.button-background;
    border-radius: 4px;

    layer-touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        Image {
            width: 14px;
            height: 14px;
            source: root.icon;
            image-fit: contain;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text-primary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component TerrainEditor inherits Rectangle {
    // Properties
    in property <bool> has-terrain: false;
    in property <bool> edit-mode: false;
    in property <string> current-brush: "raise";

    // Paint material picker: every material slot, the slot the Paint brush
    // lays down (shown selected) and its name.
    in property <[TerrainMaterialSlotData]> materials: [];
    in property <int> paint-material: 0;
    in property <string> paint-material-name: "Grass";
    // The built-in material the picked slot starts from. "Add material"
    // copies only this base, not the slot's own tint, tiling or textures.
    in property <string> paint-material-base: "Grass";
    in-out property <string> new-material-name: "";

    // Terrain global properties (from _terrain.toml)
    in property <string> terrain-size: "512";
    in property <string> terrain-chunk-size: "64";
    in property <string> terrain-resolution: "256";
    in property <string> terrain-height-scale: "1.0";
    in property <string> terrain-lod-levels: "5";
    in property <string> terrain-chunk-count: "0";
    in property <string> terrain-material: "Default";

    // Generate World (worldgen pipeline) state
    in-out property <string> worldgen-seed: "42";
    in-out property <string> worldgen-preset: "medium"; // small=2x2, medium=3x3, large=4x4 regions @ 1024 m
    in property <bool> worldgen-busy: false;
    in property <string> worldgen-progress: "";

    // Section expand states
    in-out property <bool> section-materials-expanded: true;
    in-out property <bool> section-layers-expanded: true;
    in-out property <bool> section-properties-expanded: true;
    in-out property <bool> section-chunks-expanded: true;
    in-out property <bool> section-import-export-expanded: true;
    in-out property <bool> section-worldgen-expanded: true;
    
    // Selected chunk index (-1 = none)
    in-out property <int> selected-chunk: -1;
    
    // Callbacks
    callback on-toggle-edit-mode();
    callback on-generate-terrain(string);
    callback on-import-heightmap();
    callback on-export-heightmap();
    callback on-select-chunk(int);
    callback on-generate-world(string, string); // seed, preset
    callback on-set-paint-material(int); // slot id
    callback on-add-material(string); // name, empty lets Rust pick one
    callback on-insert-layer(string); // layer class name, e.g. "TerrainStamp"

    background: Theme.panel-background;
    
    VerticalBox {
        padding: 0px;
        spacing: 0px;
        
        PanelHeader {
            title: "Terrain";
        }
        
        // ── No terrain state ──────────────────────────────────────────
        if !root.has-terrain: Rectangle {
            vertical-stretch: 1;
            
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                alignment: center;
                
                HorizontalBox {
                    alignment: center;
                    Image {
                        width: 48px;
                        height: 48px;
                        source: @image-url("../../assets/icons/ui/terrain.svg");
                        image-fit: contain;
                    }
                }
                
                Text {
                    text: "No terrain in scene";
                    color: Theme.text-primary;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Generate a terrain to start sculpting";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                
                Rectangle { height: 8px; }
                
                // ── Flat baseplate ──
                // These three write a dead-level plate straight to disk and
                // load it in the same frame; the Generate World control below
                // is the slow full worldgen pipeline. The dig and raise
                // depths are the height band `flat_preset` writes.
                Text {
                    text: "Flat baseplate: instant, dig 32 m, raise 96 m";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    
                    Rectangle {
                        width: 80px;
                        height: 32px;
                        background: Theme.button-background;
                        border-radius: 4px;
                        
                        TouchArea {
                            enabled: !root.worldgen-busy;
                            clicked => { root.on-generate-terrain("flat-small"); }
                        }
                        
                        Text {
                            text: "320 m";
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    
                    Rectangle {
                        width: 80px;
                        height: 32px;
                        background: Theme.button-primary;
                        border-radius: 4px;
                        
                        TouchArea {
                            enabled: !root.worldgen-busy;
                            clicked => { root.on-generate-terrain("flat"); }
                        }
                        
                        Text {
                            text: "576 m";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    
                    Rectangle {
                        width: 80px;
                        height: 32px;
                        background: Theme.button-background;
                        border-radius: 4px;
                        
                        TouchArea {
                            enabled: !root.worldgen-busy;
                            clicked => { root.on-generate-terrain("flat-large"); }
                        }
                        
                        Text {
                            text: "1.1 km";
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                
                Rectangle { height: 8px; }

                // ── Generate World (worldgen pipeline) ──
                Text {
                    text: "Or generate a full world (rivers, climate, materials): takes a while";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;

                    LineEdit {
                        width: 80px;
                        height: 28px;
                        placeholder-text: "Seed";
                        text <=> root.worldgen-seed;
                        enabled: !root.worldgen-busy;
                    }

                    ComboBox {
                        width: 100px;
                        height: 28px;
                        model: ["small", "medium", "large"];
                        current-value <=> root.worldgen-preset;
                        enabled: !root.worldgen-busy;
                    }

                    Rectangle {
                        width: 110px;
                        height: 28px;
                        background: root.worldgen-busy ? Theme.button-background : Theme.button-primary;
                        border-radius: 4px;

                        TouchArea {
                            enabled: !root.worldgen-busy;
                            clicked => { root.on-generate-world(root.worldgen-seed, root.worldgen-preset); }
                        }

                        Text {
                            text: root.worldgen-busy ? "Generating…" : "Generate World";
                            color: root.worldgen-busy ? Theme.text-secondary : white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.worldgen-progress != "": Text {
                    text: root.worldgen-progress;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                }

                Rectangle { height: 8px; }

                HorizontalBox {
                    alignment: center;
                    Rectangle {
                        width: 160px;
                        height: 32px;
                        background: Theme.button-background;
                        border-radius: 4px;

                        TouchArea {
                            clicked => { root.on-import-heightmap(); }
                        }

                        Text {
                            text: "Import Heightmap...";
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        
        // ── Terrain exists — properties, chunks, import/export ────────
        if root.has-terrain: ScrollView {
            vertical-stretch: 1;
            min-width: 240px;
            
            VerticalBox {
                padding: 0px;
                spacing: 0px;
                min-width: 240px;
                
                // ── Edit mode toggle ──
                Rectangle {
                    height: 40px;
                    
                    HorizontalBox {
                        padding: 8px;
                        
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 200px;
                            height: 28px;
                            background: root.edit-mode ? Theme.accent-blue : Theme.button-background;
                            border-radius: 4px;
                            
                            TouchArea {
                                clicked => { root.on-toggle-edit-mode(); }
                            }
                            
                            HorizontalBox {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                
                                if root.edit-mode: Image {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../../assets/icons/ui/check.svg");
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                if !root.edit-mode: Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    border-width: 1.5px;
                                    border-color: Theme.text-secondary;
                                }
                                
                                Text {
                                    text: root.edit-mode ? "Editing (T)" : "Edit Mode (T)";
                                    color: root.edit-mode ? white : Theme.text-primary;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                
                                if root.edit-mode: Text {
                                    // The 3D brushes carry internal ids; show the ribbon's names.
                                    text: root.current-brush == "voxeladd" ? "ADD"
                                        : (root.current-brush == "voxelremove" ? "SUBTRACT"
                                        : (root.current-brush == "voxelsmooth" ? "SMOOTH 3D"
                                        : root.current-brush.to-uppercase()));
                                    color: #ffffff80;  // theme-exempt: translucent white label on accent-blue button
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    min-width: 40px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
                
                // ── Paint material section ──
                // Picking a material also arms the Paint brush (Rust side),
                // so the next stroke lays it down.
                SectionRow {
                    label: "PAINT MATERIAL";
                    expanded: root.section-materials-expanded;
                    clicked => { root.section-materials-expanded = !root.section-materials-expanded; }
                }

                if root.section-materials-expanded: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    for mat in root.materials: MaterialRow {
                        label: mat.name;
                        swatch: mat.swatch;
                        custom: mat.custom;
                        selected: mat.slot-id == root.paint-material;
                        clicked => { root.on-set-paint-material(mat.slot-id); }
                    }

                    // Add material: a new Space slot that starts as the
                    // material picked above.
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;

                            LineEdit {
                                horizontal-stretch: 1;
                                height: 28px;
                                placeholder-text: "New material name";
                                text <=> root.new-material-name;
                                accepted(text) => {
                                    root.on-add-material(text);
                                    root.new-material-name = "";
                                }
                            }

                            Rectangle {
                                width: 56px;
                                height: 28px;
                                background: add-material-touch.has-hover ? Theme.button-hover : Theme.button-background;
                                border-radius: 4px;

                                add-material-touch := TouchArea {
                                    clicked => {
                                        root.on-add-material(root.new-material-name);
                                        root.new-material-name = "";
                                    }
                                }

                                Text {
                                    text: "Add";
                                    color: Theme.text-primary;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Starts as the built-in " + root.paint-material-base + ". Edit its .mat.toml to change it.";
                            color: Theme.text-secondary;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-color;
                }

                // ── Layers section ──
                // Each button inserts a layer instance where the view meets
                // the ground, through the Insert menu's own action (Rust:
                // `terrain_layers::plan_insert`). The new layer is selected,
                // and Properties edits it like any other instance.
                SectionRow {
                    label: "LAYERS";
                    expanded: root.section-layers-expanded;
                    clicked => { root.section-layers-expanded = !root.section-layers-expanded; }
                }

                if root.section-layers-expanded: VerticalBox {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;

                        LayerButton {
                            label: "Spline";
                            icon: @image-url("../../assets/icons/terrainspline.svg");
                            clicked => { root.on-insert-layer("TerrainSpline"); }
                        }
                        LayerButton {
                            label: "Stamp";
                            icon: @image-url("../../assets/icons/terrainstamp.svg");
                            clicked => { root.on-insert-layer("TerrainStamp"); }
                        }
                    }

                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;

                        LayerButton {
                            label: "Flatten Pad";
                            icon: @image-url("../../assets/icons/terrainflattenpad.svg");
                            clicked => { root.on-insert-layer("TerrainFlattenPad"); }
                        }
                        LayerButton {
                            label: "Noise";
                            icon: @image-url("../../assets/icons/terrainnoise.svg");
                            clicked => { root.on-insert-layer("TerrainNoise"); }
                        }
                    }

                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;

                        LayerButton {
                            label: "Material Fill";
                            icon: @image-url("../../assets/icons/terrainmaterialfill.svg");
                            clicked => { root.on-insert-layer("TerrainMaterialFill"); }
                        }
                        LayerButton {
                            label: "Spline Point";
                            icon: @image-url("../../assets/icons/terrainsplinepoint.svg");
                            clicked => { root.on-insert-layer("TerrainSplinePoint"); }
                        }
                    }

                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;

                        LayerButton {
                            label: "Scatter";
                            icon: @image-url("../../assets/icons/terrainscatter.svg");
                            clicked => { root.on-insert-layer("TerrainScatter"); }
                        }
                        LayerButton {
                            label: "Water Body";
                            icon: @image-url("../../assets/icons/terrainwaterbody.svg");
                            clicked => { root.on-insert-layer("TerrainWaterBody"); }
                        }
                    }

                    Text {
                        text: "Adds a layer on the ground in view. Scatter covers the whole terrain until it is given a size. Spline Point extends the selected spline.";
                        color: Theme.text-secondary;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }

                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-color;
                }

                // ── Properties section ──
                SectionRow {
                    label: "PROPERTIES";
                    expanded: root.section-properties-expanded;
                    clicked => { root.section-properties-expanded = !root.section-properties-expanded; }
                }
                
                if root.section-properties-expanded: VerticalBox {
                    padding: 0px;
                    spacing: 0px;
                    
                    PropertyRow { label: "Size"; value: root.terrain-size + " m"; }
                    PropertyRow { label: "Chunk Size"; value: root.terrain-chunk-size + " m"; }
                    PropertyRow { label: "Resolution"; value: root.terrain-resolution; }
                    PropertyRow { label: "Height Scale"; value: root.terrain-height-scale; }
                    PropertyRow { label: "LOD Levels"; value: root.terrain-lod-levels; }
                    PropertyRow { label: "Materials"; value: root.terrain-material; }
                    
                    Rectangle { height: 4px; }
                }
                
                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-color;
                }
                
                // ── Chunks section ──
                SectionRow {
                    label: "CHUNKS (" + root.terrain-chunk-count + ")";
                    expanded: root.section-chunks-expanded;
                    clicked => { root.section-chunks-expanded = !root.section-chunks-expanded; }
                    min-width: 240px;
                }
                
                if root.section-chunks-expanded: VerticalBox {
                    padding: 0px;
                    spacing: 0px;
                    
                    // Chunk count hint when empty
                    if root.terrain-chunk-count == "0": Text {
                        text: "  No chunks loaded";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        height: 24px;
                        vertical-alignment: center;
                    }
                    
                    Rectangle { height: 4px; }
                }
                
                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-color;
                }
                
                // ── Import / Export section ──
                SectionRow {
                    label: "IMPORT / EXPORT";
                    expanded: root.section-import-export-expanded;
                    clicked => { root.section-import-export-expanded = !root.section-import-export-expanded; }
                }
                
                if root.section-import-export-expanded: VerticalBox {
                    padding: 8px;
                    spacing: 8px;
                    
                    HorizontalBox {
                        spacing: 8px;
                        
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            background: Theme.button-background;
                            border-radius: 4px;
                            
                            TouchArea {
                                clicked => { root.on-import-heightmap(); }
                            }
                            
                            Text {
                                text: "Import";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            background: Theme.button-background;
                            border-radius: 4px;
                            
                            TouchArea {
                                clicked => { root.on-export-heightmap(); }
                            }
                            
                            Text {
                                text: "Export";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    
                    Text {
                        text: "Supports: R16, PNG, RAW, HGT, ASC, TIFF";
                        color: Theme.text-secondary;
                        font-size: 10px;
                    }
                }

                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-color;
                }

                // ── Generate World section ──
                SectionRow {
                    label: "GENERATE WORLD";
                    expanded: root.section-worldgen-expanded;
                    clicked => { root.section-worldgen-expanded = !root.section-worldgen-expanded; }
                }

                if root.section-worldgen-expanded: VerticalBox {
                    padding: 8px;
                    spacing: 8px;

                    HorizontalBox {
                        spacing: 8px;

                        LineEdit {
                            horizontal-stretch: 1;
                            height: 28px;
                            placeholder-text: "Seed";
                            text <=> root.worldgen-seed;
                            enabled: !root.worldgen-busy;
                        }

                        ComboBox {
                            horizontal-stretch: 1;
                            height: 28px;
                            model: ["small", "medium", "large"];
                            current-value <=> root.worldgen-preset;
                            enabled: !root.worldgen-busy;
                        }
                    }

                    Rectangle {
                        height: 28px;
                        background: root.worldgen-busy ? Theme.button-background : Theme.button-primary;
                        border-radius: 4px;

                        TouchArea {
                            enabled: !root.worldgen-busy;
                            clicked => { root.on-generate-world(root.worldgen-seed, root.worldgen-preset); }
                        }

                        Text {
                            text: root.worldgen-busy ? "Generating…" : "Generate World";
                            color: root.worldgen-busy ? Theme.text-secondary : white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.worldgen-progress != "": Text {
                        text: root.worldgen-progress;
                        color: Theme.text-secondary;
                        font-size: 10px;
                    }

                    Text {
                        text: "Replaces current terrain. Seed + size are deterministic.";
                        color: Theme.text-secondary;
                        font-size: 10px;
                    }
                }
            }
        }
    }
}
