// ============================================================================
// Add / Edit Parameter Dialog: the Parameters twin of AddAttributeDialog.
//
// A Parameter names a value on an instance, places it in a domain, and can
// take the value from a Connector. The dialog reads top to bottom in that
// order: the name (and its domain, beside it), the type as one click on a chip,
// the value, then, when "Read the value from a Connector" is switched on, the
// Connector, the field and how often to read it. A preview line shows the row
// label the Parameter will have in Properties.
//
// Rust opens it (it fills the Domain and Connector lists and, for an edit, the
// binding the row does not carry), validates on confirm, and keeps it open with
// `error` set when something is wrong, so a mistake is fixed in place rather
// than retyped. Enter confirms from any text field; Escape cancels.
//
// Lists are inline and in-card: they match the theme, never overflow the card,
// and capture their own scrolling.
//
// Chrome: DialogScrim > DialogCard > DialogFooter (DRAFTING_UX.md Law 1).
// Selection, focus and "on" are the selection cyan (Law 3).
// ============================================================================

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSwitch, KitDivider, KitNotice } from "dialog_kit.slint";

// A label on the left and the row's controls on the right. The label sits
// level with the controls' first line (`label-height` tall), so it stays put
// beside controls that wrap onto a second line.
component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-height: 30px;
    spacing: 12px;
    VerticalLayout {
        alignment: start;
        Text {
            height: root.label-height;
            width: 72px;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }
    @children
}

// The chevron that says whether a list is open.
component Chevron inherits Image {
    in property <bool> open;
    width: 12px;
    height: 12px;
    source: root.open ? @image-url("../../assets/icons/ui/chevron-up.svg") : @image-url("../../assets/icons/ui/chevron-down.svg");
    image-fit: contain;
    colorize: root.open ? Theme.accent-cyan : Theme.text-secondary;
}

// A single-line text input with a placeholder. Enter fires `accepted`.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    public function focus-now() {
        input.focus();
    }

    height: 30px;
    background: Theme.input-background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-cyan : Theme.input-border;

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        clip: true;
        if root.text == "": Text {
            width: 100%;
            height: 100%;
            text: root.placeholder;
            color: Theme.text-disabled;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            width: 100%;
            height: 100%;
            text <=> root.text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text-primary;
            font-size: 12px;
            selection-background-color: Theme.selection-background;
            accepted => { root.accepted(); }
        }
    }
}

// A text input with a list button inside it: type a new value or pick one.
component ComboField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> open;
    callback toggle();
    callback accepted();

    height: 30px;
    background: Theme.input-background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus || root.open ? Theme.accent-cyan : Theme.input-border;

    Rectangle {
        x: 10px;
        width: parent.width - 40px;
        height: parent.height;
        clip: true;
        if root.text == "": Text {
            width: 100%;
            height: 100%;
            text: root.placeholder;
            color: Theme.text-disabled;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            width: 100%;
            height: 100%;
            text <=> root.text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text-primary;
            font-size: 12px;
            selection-background-color: Theme.selection-background;
            accepted => { root.accepted(); }
        }
    }
    Rectangle {
        x: parent.width - 29px;
        y: 1px;
        width: 28px;
        height: parent.height - 2px;
        border-radius: Theme.radius-sm - 1px;
        background: chevron-ta.has-hover ? Theme.button-hover : transparent;
        Chevron {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            open: root.open;
        }
        chevron-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle(); }
        }
    }
}

// A field whose value comes only from a list.
component PickField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> open;
    callback toggle();

    height: 30px;
    background: pick-ta.has-hover && !root.open ? Theme.button-hover : Theme.input-background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.open ? Theme.accent-cyan : Theme.input-border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 8px;
        Text {
            text: root.value != "" ? root.value : root.placeholder;
            color: root.value != "" ? Theme.text-primary : Theme.text-disabled;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Chevron { open: root.open; }
        }
    }
    pick-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

// An inline, scroll-captured list of choices under a field. Kept in the tree
// and zero-height when closed rather than created with `if`, so a row's click
// (which closes the list) never destroys the element handling it (the Slint
// "Recursion detected" crash class). Its 4px gap from the field is inside its
// own height, so a closed list adds no space to the form.
component ChoiceList inherits Rectangle {
    in property <[string]> options;
    in property <string> current;
    in property <bool> open;
    in property <string> empty-hint: "";
    callback chosen(string);

    property <length> list-height: root.options.length == 0 ? 36px : min(28px * root.options.length + 6px, 146px);
    visible: root.open;
    height: root.open ? root.list-height + 4px : 0px;

    Rectangle {
        y: 4px;
        height: root.list-height;
        background: Theme.background-tertiary;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.input-border;
        clip: true;

        if root.options.length == 0: Text {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text: root.empty-hint;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        ScrollView {
            visible: root.options.length > 0;
            VerticalLayout {
                padding: 3px;
                for option in root.options: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm - 1px;
                    background: option == root.current ? Theme.accent-cyan.with-alpha(0.14)
                              : option-ta.has-hover ? Theme.button-hover : transparent;
                    // The selection bar on the left edge, as in NavItem.
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 3px;
                        height: option == root.current ? 14px : 0px;
                        border-radius: 1.5px;
                        background: Theme.accent-cyan;
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: option == root.current ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    option-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.chosen(option); }
                    }
                }
            }
        }
    }
}

// One choice among a few, shown as a button. Selected is the selection cyan,
// as in KitSegmented.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 26px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-cyan.with-alpha(0.2)
              : chip-ta.has-hover ? Theme.button-hover : Theme.input-background;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-cyan.with-alpha(0.6) : Theme.input-border;
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    chip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Chips in rows of `columns`, every chip one width.
component ChipGrid inherits Rectangle {
    in property <[string]> options;
    in property <string> current;
    in property <int> columns: 4;
    callback chosen(string);

    property <length> gap: 6px;
    property <length> chip-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    height: root.options.length == 0 ? 0px
        : Math.ceil(root.options.length / root.columns) * (26px + root.gap) - root.gap;

    for option[i] in root.options: Chip {
        x: Math.mod(i, root.columns) * (root.chip-width + root.gap);
        y: Math.floor(i / root.columns) * (26px + root.gap);
        width: root.chip-width;
        label: option;
        selected: option == root.current;
        clicked => { root.chosen(option); }
    }
}

export component AddParameterDialog inherits Rectangle {
    in property <bool> is-edit: false;
    // The instance the Parameter goes on, for the subtitle. Empty hides it.
    in property <string> target: "";
    in-out property <string> domain: "instance";
    in-out property <string> param-name: "";
    in-out property <string> param-type: "String";
    in-out property <string> param-value: "";
    in-out property <bool> bound: false;
    in-out property <string> connector: "";
    in-out property <string> field: "";
    in-out property <string> refresh: "";
    in property <string> error: "";
    in property <[string]> type-options: [];
    in property <[string]> domain-options: [];
    in property <[string]> connector-options: [];

    callback on-confirm();
    callback on-cancel();

    property <bool> domain-open: false;
    property <bool> connector-open: false;
    // The label the Parameter will carry in Properties.
    property <string> label-preview: root.domain == "" || root.domain == "instance"
        ? root.param-name : root.domain + "." + root.param-name;
    // Enough to try: Rust still checks every field and says why in `error`.
    property <bool> can-confirm: root.param-name != ""
        && (!root.bound || (root.connector != "" && root.field != ""));
    property <string> value-hint:
        root.bound ? "Shown until the first read"
        : root.param-type == "Vector3" ? "x, y, z"
        : root.param-type == "Color" ? "r, g, b, a (each 0 to 1)"
        : root.param-type == "Int" ? "A whole number"
        : root.param-type == "Float" ? "A number"
        : root.param-type == "EntityRef" ? "An entity id, or blank for none"
        : root.param-type == "Json" ? "JSON text"
        : "Text";
    // The refresh presets, and which one `refresh` currently is. Any other
    // number of seconds is Custom, which shows the seconds field.
    property <[string]> refresh-options: ["Once", "5 s", "30 s", "1 min", "5 min", "Custom"];
    property <bool> custom-refresh: false;
    property <string> refresh-choice: root.custom-refresh ? "Custom"
        : root.refresh == "" ? "Once"
        : root.refresh == "5" ? "5 s"
        : root.refresh == "30" ? "30 s"
        : root.refresh == "60" ? "1 min"
        : root.refresh == "300" ? "5 min"
        : "Custom";
    // The shared header is 44px plus its 1px divider.
    property <length> header-height: 45px;

    function confirm() {
        if root.can-confirm {
            root.on-confirm();
        }
    }

    init => {
        name-field.focus-now();
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop: click closes, scroll absorbed (never reaches the 3D viewport).
    DialogScrim {
        dismiss => { root.on-cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: min(root.header-height + body.preferred-height + button-bar.preferred-height, parent.height - 40px);
            icon: @image-url("../../assets/icons/ui/database.svg");
            title: root.is-edit ? "Edit parameter" : "Add parameter";
            subtitle: root.target;
            close => { root.on-cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.on-cancel();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // ── Body ──
                    ScrollView {
                        height: card.height - root.header-height - button-bar.preferred-height;
                        body := VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 18px;
                            padding-bottom: 16px;
                            spacing: 14px;

                            // Name, in its domain.
                            VerticalLayout {
                                spacing: 0px;
                                FieldRow {
                                    label: "Name";
                                    name-field := Field {
                                        horizontal-stretch: 1;
                                        text <=> root.param-name;
                                        placeholder: "e.g. setpoint";
                                        accepted => { root.confirm(); }
                                    }
                                    Text {
                                        text: "in";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-sm;
                                        vertical-alignment: center;
                                    }
                                    ComboField {
                                        width: 150px;
                                        text <=> root.domain;
                                        placeholder: "instance";
                                        open: root.domain-open;
                                        toggle => {
                                            root.domain-open = !root.domain-open;
                                            root.connector-open = false;
                                        }
                                        accepted => { root.confirm(); }
                                    }
                                }
                                ChoiceList {
                                    options: root.domain-options;
                                    current: root.domain;
                                    open: root.domain-open;
                                    chosen(d) => {
                                        root.domain = d;
                                        root.domain-open = false;
                                    }
                                }
                                // The label the row will show, domain included.
                                HorizontalLayout {
                                    padding-top: 6px;
                                    padding-left: 84px;
                                    spacing: 4px;
                                    Text {
                                        text: root.param-name == "" ? "A domain groups Parameters; the default is instance." : "Shows in Properties as";
                                        color: Theme.text-disabled;
                                        font-size: Theme.font-xs;
                                        vertical-alignment: center;
                                    }
                                    if root.param-name != "": Text {
                                        text: root.label-preview;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            FieldRow {
                                label: "Type";
                                label-height: 26px;
                                ChipGrid {
                                    horizontal-stretch: 1;
                                    options: root.type-options;
                                    current: root.param-type;
                                    columns: 4;
                                    chosen(t) => { root.param-type = t; }
                                }
                            }

                            FieldRow {
                                label: root.bound ? "Initial value" : "Value";
                                label-height: root.param-type == "Bool" ? 26px : 30px;
                                if root.param-type == "Bool": ChipGrid {
                                    horizontal-stretch: 1;
                                    options: ["true", "false"];
                                    current: root.param-value;
                                    columns: 2;
                                    chosen(v) => { root.param-value = v; }
                                }
                                if root.param-type != "Bool": Field {
                                    horizontal-stretch: 1;
                                    text <=> root.param-value;
                                    placeholder: root.value-hint;
                                    accepted => { root.confirm(); }
                                }
                            }

                            // ── Binding ──
                            KitDivider { }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "Read the value from a Connector";
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 500;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "Keeps the value in step with a live data source";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-sm;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    KitSwitch {
                                        checked <=> root.bound;
                                    }
                                }
                            }

                            if root.bound: Rectangle {
                                background: Theme.background-secondary.with-alpha(0.6);
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-color;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        spacing: 0px;
                                        FieldRow {
                                            label: "Connector";
                                            PickField {
                                                horizontal-stretch: 1;
                                                value: root.connector;
                                                placeholder: "Choose a Connector";
                                                open: root.connector-open;
                                                toggle => {
                                                    root.connector-open = !root.connector-open;
                                                    root.domain-open = false;
                                                }
                                            }
                                        }
                                        ChoiceList {
                                            options: root.connector-options;
                                            current: root.connector;
                                            open: root.connector-open;
                                            empty-hint: "This Space has no Connectors yet. Add one from the Data menu, then come back.";
                                            chosen(c) => {
                                                root.connector = c;
                                                root.connector-open = false;
                                            }
                                        }
                                    }
                                    FieldRow {
                                        label: "Field";
                                        Field {
                                            horizontal-stretch: 1;
                                            text <=> root.field;
                                            placeholder: "The column to read, such as temp_c";
                                            accepted => { root.confirm(); }
                                        }
                                    }
                                    FieldRow {
                                        label: "Read";
                                        label-height: 26px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            ChipGrid {
                                                options: root.refresh-options;
                                                current: root.refresh-choice;
                                                columns: 6;
                                                chosen(c) => {
                                                    if c == "Custom" {
                                                        root.custom-refresh = true;
                                                    } else {
                                                        root.custom-refresh = false;
                                                        root.refresh = c == "Once" ? ""
                                                            : c == "5 s" ? "5"
                                                            : c == "30 s" ? "30"
                                                            : c == "1 min" ? "60"
                                                            : "300";
                                                    }
                                                }
                                            }
                                            if root.refresh-choice == "Custom": Field {
                                                text <=> root.refresh;
                                                placeholder: "Seconds between reads, 5 or more";
                                                accepted => { root.confirm(); }
                                            }
                                        }
                                    }
                                    Text {
                                        text: "The field's latest value is read while the Connector is enabled. The row is read-only and shows the last read, or why it failed.";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.error != "": KitNotice {
                                kind: "error";
                                text: root.error;
                            }
                        }
                    }

                    // ── Button bar ──
                    button-bar := DialogFooter {
                        pack-end: false;
                        Text {
                            text: "Enter to " + (root.is-edit ? "save" : "add") + ", Esc to cancel";
                            color: Theme.text-disabled;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-cancel(); }
                        }
                        KitButton {
                            text: root.is-edit ? "Save" : "Add";
                            kind: "primary";
                            enabled: root.can-confirm;
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}
