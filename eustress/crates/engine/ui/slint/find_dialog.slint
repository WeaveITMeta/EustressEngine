// ============================================================================
// Eustress Engine Studio - Find Dialog
// Search and replace in scene
//
// A floating panel at the top right of the window, not a modal: the scene
// stays usable while it is open, so there is no scrim. It wears the shared
// DialogCard surface and header (DRAFTING_UX.md Law 1). The search field takes
// focus when the panel opens; Escape closes it.
// ============================================================================

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogCard, KitButton, KitSwitch } from "dialog_kit.slint";

// Search result data
export struct SearchResultData {
    entity-id: int,
    name: string,
    class-name: string,
    path: string,
}

// A square icon button for the previous / next arrows.
component IconButton inherits Rectangle {
    in property <image> icon;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.button-pressed : touch.has-hover ? Theme.button-hover : Theme.button-background;
    border-width: 1px;
    border-color: Theme.border-color;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        source: root.icon;
        image-fit: contain;
        colorize: Theme.text-primary;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A themed text field: the frame is the wrapper, the LineEdit fills it.
component FindField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback edited(string);
    callback accepted(string);

    public function focus-field() { edit.focus(); }

    height: 30px;
    background: Theme.input-background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.accent-cyan : Theme.input-border;

    HorizontalLayout {
        padding-left: root.has-icon ? 8px : 0px;
        spacing: 2px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                width: 13px;
                height: 13px;
                source: root.icon;
                image-fit: contain;
                colorize: Theme.text-secondary;
            }
        }
        edit := LineEdit {
            horizontal-stretch: 1;
            text <=> root.text;
            placeholder-text: root.placeholder;
            edited(t) => { root.edited(t); }
            accepted(t) => { root.accepted(t); }
        }
    }
}

// A search option: its label and a switch.
component OptionSwitch inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);

    spacing: 6px;
    Text {
        text: root.label;
        color: root.checked ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        KitSwitch {
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

export component FindDialog inherits Rectangle {
    // Properties
    in-out property <string> search-text: "";
    in-out property <string> replace-text: "";
    in-out property <bool> case-sensitive: false;
    in-out property <bool> whole-word: false;
    in-out property <bool> use-regex: false;
    in property <[SearchResultData]> results: [];
    in property <int> current-result: -1;
    in property <int> total-results: 0;

    // Callbacks
    callback on-search();
    callback on-find-next();
    callback on-find-previous();
    callback on-replace();
    callback on-replace-all();
    callback on-select-result(int);
    callback on-close();

    width: 100%;
    height: 100%;
    background: transparent;

    // Position at top-right. The key scope is exactly the panel's size, so
    // the rest of the window stays clickable. Escape that the focused field
    // does not use reaches it and closes the panel.
    keys := FocusScope {
        x: parent.width - self.width - 20px;
        y: 60px;
        width: 400px;
        height: root.results.length > 0
            ? min(380px, parent.height - 80px)
            : min(body.preferred-height + 45px, parent.height - 80px);
        init => { search-field.focus-field(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.on-close();
                return accept;
            }
            return reject;
        }

        DialogCard {
            width: 100%;
            height: 100%;
            icon: @image-url("../../assets/icons/ui/search.svg");
            title: "Find and replace";
            subtitle: root.total-results > 0
                ? (root.current-result + 1) + " of " + root.total-results
                : "No results";
            close => { root.on-close(); }

            body := VerticalLayout {
                padding: 12px;
                spacing: 8px;

                // Search input
                HorizontalLayout {
                    spacing: 6px;

                    search-field := FindField {
                        horizontal-stretch: 1;
                        text <=> root.search-text;
                        placeholder: "Find by name";
                        edited(t) => { root.on-search(); }
                        accepted(t) => { root.on-find-next(); }
                    }

                    IconButton {
                        icon: @image-url("../../assets/icons/ui/chevron-up.svg");
                        clicked => { root.on-find-previous(); }
                    }

                    IconButton {
                        icon: @image-url("../../assets/icons/ui/chevron-down.svg");
                        clicked => { root.on-find-next(); }
                    }
                }

                // Replace input
                HorizontalLayout {
                    spacing: 6px;

                    FindField {
                        horizontal-stretch: 1;
                        text <=> root.replace-text;
                        placeholder: "Replace with";
                        accepted(t) => { root.on-replace(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        KitButton {
                            text: "Replace";
                            clicked => { root.on-replace(); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        KitButton {
                            text: "Replace all";
                            clicked => { root.on-replace-all(); }
                        }
                    }
                }

                // Options
                HorizontalLayout {
                    padding-top: 2px;
                    spacing: 18px;

                    OptionSwitch {
                        label: "Match case";
                        checked <=> root.case-sensitive;
                        toggled(v) => { root.on-search(); }
                    }

                    OptionSwitch {
                        label: "Whole word";
                        checked <=> root.whole-word;
                        toggled(v) => { root.on-search(); }
                    }

                    OptionSwitch {
                        label: "Regex";
                        checked <=> root.use-regex;
                        toggled(v) => { root.on-search(); }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                // Results list (scrolls past about five rows)
                if root.results.length > 0: Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background-secondary.with-alpha(0.6);
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-color;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            for result[idx] in root.results: Rectangle {
                                height: 30px;
                                background: idx == root.current-result ? Theme.accent-cyan.with-alpha(0.14) :
                                            result-touch.has-hover ? Theme.button-hover : transparent;
                                border-radius: Theme.radius-sm;

                                // The current match's bar on the left edge.
                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: 3px;
                                    height: idx == root.current-result ? 16px : 0px;
                                    border-radius: 1.5px;
                                    background: Theme.accent-cyan;
                                }

                                result-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    // The row index: the host keeps the matches in list order.
                                    clicked => { root.on-select-result(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 8px;

                                    Text {
                                        text: result.name;
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: idx == root.current-result ? 600 : 400;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: result.path != "" ? result.class-name + " in " + result.path : result.class-name;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-sm;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
