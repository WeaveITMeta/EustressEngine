// ============================================================================
// Eustress Engine Studio - Notifications
// Toast notification system
// ============================================================================

import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Notification data
export struct NotificationData {
    id: int,
    level: string, // "info", "success", "warning", "error"
    title: string,
    message: string,
    duration-ms: int,
    dismissible: bool,
}

component NotificationToast inherits Rectangle {
    in property <string> level: "info";
    in property <string> title: "";
    in property <string> message: "";
    in property <bool> dismissible: true;
    
    callback dismissed();
    
    width: 300px;
    // Grow to fit the wrapped message instead of pinning 72px. The body Text
    // word-wraps, so a longer notice (the telemetry one runs to three lines)
    // painted OUTSIDE the border, over whatever panel sat behind the toast.
    // `Rectangle` does not size itself from its children, so the height is
    // taken from the content layout's preferred height, floored at the
    // original 72px so short toasts look exactly as before.
    //
    // This cannot hit the property recursion the `Notifications` parent warns
    // about: `width` is fixed at 300px, so the wrap height is fully determined
    // without anything consulting `height` on the way back.
    height: max(72px, content.preferred-height);
    background: Theme.dialog-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.level == "error" ? Theme.accent-red :
                  root.level == "warning" ? Theme.accent-yellow :
                  root.level == "success" ? Theme.accent-green :
                  Theme.accent-blue;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.shadow-color;
    
    content := HorizontalBox {
        padding: 12px;
        spacing: 12px;

        // Icon
        Rectangle {
            width: 32px;
            height: 32px;
            background: root.level == "error" ? Theme.accent-red :
                        root.level == "warning" ? Theme.accent-yellow :
                        root.level == "success" ? Theme.accent-green :
                        Theme.accent-blue;
            border-radius: 16px;
            
            Image {
                width: 16px;
                height: 16px;
                source: root.level == "error" ? @image-url("../../assets/icons/ui/close.svg") :
                        root.level == "warning" ? @image-url("../../assets/icons/ui/warning.svg") :
                        root.level == "success" ? @image-url("../../assets/icons/ui/check.svg") :
                        @image-url("../../assets/icons/ui/info.svg");
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        
        // Content
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 4px;
            
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-weight: 600;
                overflow: elide;
            }
            
            Text {
                text: root.message;
                color: Theme.text-secondary;
                font-size: 12px;
                // `wrap` only, no `elide`: the two contradict each other —
                // eliding truncates the very message the toast exists to
                // deliver, and now that the toast grows to fit there is
                // nothing to truncate.
                wrap: word-wrap;
            }
        }
        
        // Dismiss button
        if root.dismissible: Rectangle {
            width: 24px;
            height: 24px;
            background: dismiss-touch.has-hover ? Theme.button-hover : transparent;
            border-radius: 4px;
            
            dismiss-touch := TouchArea {
                clicked => { root.dismissed(); }
            }
            
            Image {
                width: 12px;
                height: 12px;
                source: @image-url("../../assets/icons/ui/close.svg");
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    
    // Progress bar for auto-dismiss
    Rectangle {
        y: parent.height - 3px;
        width: parent.width;
        height: 3px;
        background: transparent;
        border-bottom-left-radius: 8px;
        border-bottom-right-radius: 8px;
        clip: true;
        
        Rectangle {
            width: 100%;
            height: 100%;
            background: root.level == "error" ? Theme.accent-red :
                        root.level == "warning" ? Theme.accent-yellow :
                        root.level == "success" ? Theme.accent-green :
                        Theme.accent-blue;
            // Animation would be controlled from Rust
        }
    }
}

export component Notifications inherits Rectangle {
    in property <[NotificationData]> notifications: [];
    callback on-dismiss(int);

    width: 320px;
    // Height is set by the parent (main.slint fills the available vertical
    // strip). Never bind height here to a derived expression — letting the
    // parent compute y from (self.height) created a property-recursion
    // crash in Slint.
    background: transparent;

    VerticalLayout {
        padding: 0px;
        spacing: 8px;
        alignment: end;

        for notification in root.notifications: NotificationToast {
            level: notification.level;
            title: notification.title;
            message: notification.message;
            dismissible: notification.dismissible;

            dismissed => { root.on-dismiss(notification.id); }
        }
    }
}
