// ============================================================================
// Eustress Engine Studio - Notifications
// Toast notification system
// ============================================================================

import { Theme } from "theme.slint";

// Notification data
export struct NotificationData {
    id: int,
    level: string, // "info", "success", "warning", "error"
    title: string,
    message: string,
    duration-ms: int,
    dismissible: bool,
}

component NotificationToast inherits Rectangle {
    in property <string> level: "info";
    in property <string> title: "";
    in property <string> message: "";
    in property <bool> dismissible: true;
    
    callback dismissed();

    // The level's one colour: the left bar and the icon.
    property <color> tone: root.level == "error" ? Theme.text-error
        : root.level == "warning" ? Theme.text-warning
        : root.level == "success" ? Theme.text-success
        : Theme.accent-cyan;
    
    width: 300px;
    // Grow to fit the wrapped message instead of pinning a height. The body
    // Text word-wraps, so a longer notice (the telemetry one runs to three
    // lines) would otherwise paint OUTSIDE the card. `Rectangle` does not
    // size itself from its children, so the height is taken from the
    // content layout's preferred height, with a floor for one-line toasts.
    //
    // This cannot hit the property recursion the `Notifications` parent warns
    // about: `width` is fixed at 300px, so the wrap height is fully determined
    // without anything consulting `height` on the way back.
    height: max(56px, content.preferred-height);
    background: Theme.panel-glass;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-color;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow-float;
    clip: true;

    // The level bar down the left edge.
    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: root.tone;
    }

    // The 1px top hairline every floating surface carries.
    Rectangle {
        x: 3px;
        y: 0;
        width: parent.width - 3px;
        height: 1px;
        background: Theme.border-highlight;
    }
    
    content := HorizontalLayout {
        padding-left: 15px;
        padding-right: 8px;
        padding-top: 11px;
        padding-bottom: 12px;
        spacing: 10px;

        // Level badge on the title's line: a tinted disc with a line glyph
        // (check or cross from the icon set, or an ASCII i / !), all in the
        // level colour. The status SVGs are filled discs, which a colorize
        // flattens into a blank dot, so the glyph is drawn here instead.
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.tone.with-alpha(0.16);
                border-width: 1px;
                border-color: root.tone.with-alpha(0.45);

                if root.level == "success" || root.level == "error": Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    source: root.level == "success" ? @image-url("../../assets/icons/ui/check.svg")
                        : @image-url("../../assets/icons/ui/close.svg");
                    image-fit: contain;
                    colorize: root.tone;
                }
                if root.level != "success" && root.level != "error": Text {
                    width: 100%;
                    height: 100%;
                    text: root.level == "warning" ? "!" : "i";
                    color: root.tone;
                    font-size: 12px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        
        // Content
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            padding-top: 2px;
            spacing: 3px;
            
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            
            if root.message != "": Text {
                text: root.message;
                color: Theme.text-secondary;
                font-size: 12px;
                // `wrap` only, no `elide`: eliding would truncate the very
                // message the toast exists to deliver, and the toast grows
                // to fit, so there is nothing to truncate.
                wrap: word-wrap;
            }
        }
        
        // Dismiss control, top-right.
        if root.dismissible: VerticalLayout {
            alignment: start;
            Rectangle {
                width: 24px;
                height: 24px;
                background: dismiss-touch.pressed ? Theme.button-pressed
                    : dismiss-touch.has-hover ? Theme.button-hover : transparent;
                border-radius: Theme.radius-sm;

                dismiss-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.dismissed(); }
                }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    source: @image-url("../../assets/icons/ui/close.svg");
                    image-fit: contain;
                    colorize: dismiss-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }
        }
    }
}

export component Notifications inherits Rectangle {
    in property <[NotificationData]> notifications: [];
    callback on-dismiss(int);

    width: 320px;
    // Height is set by the parent (main.slint fills the available vertical
    // strip). Never bind height here to a derived expression — letting the
    // parent compute y from (self.height) created a property-recursion
    // crash in Slint.
    background: transparent;

    VerticalLayout {
        padding: 0px;
        spacing: 8px;
        alignment: end;

        for notification in root.notifications: NotificationToast {
            level: notification.level;
            title: notification.title;
            message: notification.message;
            dismissible: notification.dismissible;

            dismissed => { root.on-dismiss(notification.id); }
        }
    }
}
