// ============================================================================
// Feedback dialog: Help > Send Feedback.
//
// The comment half of the usage-telemetry loop: dream-button clicks are
// counted automatically; this is where a user says WHAT they expected the
// tool to do. Posts to /api/telemetry/comment via the Rust side (anonymous
// install id, never the account). Pre-fills "about" with the last dream
// tool clicked this session, clearable to send general feedback.
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Escape cancels; Send waits for some text.
// ============================================================================

import { TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitNotice } from "dialog_kit.slint";

export component FeedbackDialog inherits Rectangle {
    in property <string> about-tool: "";
    in-out property <string> feedback-text: "";
    callback send(string /* about-tool */, string /* text */);
    callback cancel();

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(460px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/megaphone.svg");
            title: "Send feedback";
            subtitle: root.about-tool == "" ? "General feedback" : "About " + root.about-tool;
            close => { root.cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.cancel();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: root.about-tool == ""
                                ? "Tell us what you'd want a tool to do, or what's missing."
                                : "What did you expect " + root.about-tool + " to do?";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        input := TextEdit {
                            height: 120px;
                            text <=> root.feedback-text;
                            wrap: word-wrap;
                            placeholder-text: "Your feedback";
                            init => { self.focus(); }
                        }

                        KitNotice {
                            kind: "info";
                            text: "Sent anonymously with your random install id. Never your account, files or scene.";
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.cancel(); }
                        }
                        KitButton {
                            text: "Send";
                            kind: "primary";
                            has-icon: true;
                            icon: @image-url("../../assets/icons/ui/send.svg");
                            enabled: root.feedback-text != "";
                            clicked => { root.send(root.about-tool, root.feedback-text); }
                        }
                    }
                }
            }
        }
    }
}
