        return @image-url("../../assets/icons/ui/settings.svg");
    }

    // True when `ribbon-tab` is one of the 9 built-in ids — a plain boolean
    // expression (Slint bindings can't loop/search a list), so the custom-tab
    // content block below can gate on "not a built-in" without needing to
    // know which specific custom tab is active.
    property <bool> ribbon-tab-is-builtin:
        root.ribbon-tab == "home" || root.ribbon-tab == "model" || root.ribbon-tab == "cad" ||
        root.ribbon-tab == "data" || root.ribbon-tab == "ui" || root.ribbon-tab == "terrain" ||
        root.ribbon-tab == "test" || root.ribbon-tab == "mindspace" || root.ribbon-tab == "plugins";
    // Whenever Rust re-pushes the filtered tab set (startup, or a Mode
    // switch), jump to its first tab. Simpler than "only reset if the
    // current tab is now hidden" and gives the same guarantee — the active
    // tab is always a member of the currently-visible set.
    changed ribbon-tabs => {
        root.ribbon-tab = root.ribbon-tabs.length > 0 ? root.ribbon-tabs[0].id : "home";
    }

    height: 118px;
    background: Theme.ribbon-background;
    
    // Bottom edge separator
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border-color;
    }
    
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        
        // ── Menu bar row ──
        Rectangle {
            height: 24px;
            background: Theme.ribbon-background;
            
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 8px;
                spacing: 0px;

                // ── EUSTRESS MODES ── (first item, ahead of File — window-
                // chrome-level dropdown that reconfigures the whole Studio
                // for a kind of work: ribbon-tab subset + default Layout +
                // optional accent). Icon reflects the active mode.
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: modes-label.preferred-width + modes-icon.width + 18px;
                    background: modes-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;

                    modes-touch := TouchArea { clicked => { modes-popup.show(); } }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 5px;
                        alignment: center;

                        // Icon wrapped in a VerticalLayout so it centers on the
                        // row's cross-axis instead of top-aligning.
                        VerticalLayout {
                            alignment: center;
                            modes-icon := Image {
                                width: 13px;
                                height: 13px;
                                source: root.mode-icon(root.active-mode-icon-id);
                                colorize: root.active-mode-menu-color;
                                image-fit: contain;
                            }
                        }
                        modes-label := Text { text: root.active-mode-name; color: root.active-mode-menu-color; font-size: 12px; vertical-alignment: center; }
                    }

                    modes-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        // Wide enough for most mode/submode names on one
                        // line (e.g. Civil's "Construction Engineering &
                        // Management") — the submode Text below also wraps
                        // as a fallback so nothing is ever clipped
                        // regardless of length.
                        width: 260px;
                        // Default close-on-click closes the popup on ANY click,
                        // including the submode expand arrow — so submodes could
                        // never appear. Close only on click OUTSIDE; inside
                        // clicks (expand arrow, mode row, submode) are handled
                        // explicitly and close the popup themselves when a
                        // final selection is made.
                        close-policy: close-on-click-outside;

                        Rectangle {
                            width: 260px;
                            background: Theme.dialog-background;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: Theme.shadow-color;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 0px;

                                for m in root.available-modes: VerticalLayout {
                                    // Main mode row. The select-touch area is
                                    // narrowed to leave room for the expand
                                    // arrow (when present) so the two never
                                    // spatially overlap — avoids relying on
                                    // TouchArea z-order tie-breaking.
                                    Rectangle {
                                        height: 30px;
                                        background: mode-row-touch.has-hover ? Theme.button-hover : transparent;
                                        border-radius: 3px;

                                        mode-row-touch := TouchArea {
                                            x: 0px;
                                            width: parent.width - (m.has-submodes ? 22px : 0px);
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if (m.has-submodes) {
                                                    // Submode-only modes (Justice,
                                                    // Military) aren't directly
                                                    // selectable — the parent row
                                                    // just expands/collapses its
                                                    // submenu. Only clicking a
                                                    // submode row (below) actually
                                                    // activates the mode.
                                                    root.expanded-mode-id = root.expanded-mode-id == m.id ? "" : m.id;
                                                } else {
                                                    root.active-mode-id = m.id;
                                                    root.active-submode-id = "";
                                                    root.select-mode(m.id);
                                                    modes-popup.close();
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    width: 14px; height: 14px;
                                                    source: root.mode-icon(m.icon-id);
                                                    // Mode identity color (Roblox BrickColor) when set,
                                                    // else the active/default styling.
                                                    colorize: m.has-menu-color ? m.menu-color
                                                        : (m.id == root.active-mode-id ? Theme.accent-eustress : Theme.text-secondary);
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: m.name;
                                                color: m.has-menu-color ? m.menu-color
                                                    : (m.id == root.active-mode-id ? Theme.accent-eustress : Theme.text-primary);
                                                font-size: 12px;
                                                font-weight: m.id == root.active-mode-id ? 600 : 400;
                                                vertical-alignment: center;
                                            }
                                        }

                                        if m.has-submodes: Rectangle {
                                            x: parent.width - 20px;
                                            y: 0px;
                                            width: 20px;
                                            height: 30px;

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.expanded-mode-id = root.expanded-mode-id == m.id ? "" : m.id;
                                                }
                                            }
                                            Text {
                                                width: 100%; height: 100%;
                                                text: root.expanded-mode-id == m.id ? "\u{25BE}" : "\u{25B8}";
                                                color: Theme.text-secondary;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Submode rows — indented, shown only
                                    // while this mode's row is expanded.
                                    if m.has-submodes && root.expanded-mode-id == m.id: VerticalLayout {
                                        for sm in root.available-submodes: Rectangle {
                                            property <bool> in-this-mode: sm.mode-id == m.id;
                                            visible: in-this-mode;
                                            // Grows to fit wrapped text (e.g. Civil's
                                            // "Construction Engineering & Management")
                                            // instead of clipping it at a fixed height.
                                            height: in-this-mode ? max(24px, sm-text.preferred-height + 8px) : 0px;
                                            background: sm-touch.has-hover ? Theme.button-hover : transparent;
                                            border-radius: 3px;

                                            sm-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.active-mode-id = m.id;
                                                    root.active-submode-id = sm.id;
                                                    root.select-submode(m.id, sm.id);
                                                    modes-popup.close();
                                                }
                                            }
                                            // Discipline glyph — sits in the
                                            // indent gutter left of the label.
                                            if sm.icon-id != "": Image {
                                                x: 15px;
                                                y: (parent.height - 12px) / 2;
                                                width: 12px;
                                                height: 12px;
                                                source: root.tool-icon(sm.icon-id);
                                                colorize: (m.id == root.active-mode-id && sm.id == root.active-submode-id)
                                                    ? Theme.accent-eustress : Theme.text-secondary;
                                                image-fit: contain;
                                            }
                                            sm-text := Text {
                                                x: 34px;
                                                width: parent.width - 34px - 10px;
                                                wrap: word-wrap;
                                                text: sm.name;
                                                color: sm.has-submode-color ? sm.submode-color
                                                    : ((m.id == root.active-mode-id && sm.id == root.active-submode-id) ?
                                                        Theme.accent-eustress : Theme.text-secondary);
                                                font-weight: (m.id == root.active-mode-id && sm.id == root.active-submode-id) ? 600 : 400;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── FILE ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: file-label.preferred-width + 12px;
                    background: file-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;

                    file-touch := TouchArea { clicked => { file-popup.show(); } }
                    file-label := Text { text: "File"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    file-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 240px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 240px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownItem { label: "New Universe..."; shortcut: root.shortcut-new-universe; clicked => { root.on-new-universe(); } }
                                DropdownItem { label: "New Space"; shortcut: root.shortcut-new; clicked => { root.on-new-scene(); } }
                                DropdownItem { label: "Open File..."; shortcut: root.shortcut-open; clicked => { root.on-open-scene(); } }
                                DropdownItem { label: "Import Roblox Place..."; clicked => { root.on-import-roblox-place(); } }
                                DropdownItem { label: "Save Space"; shortcut: root.shortcut-save; clicked => { root.on-save-scene(); } }
                                DropdownItem { label: "Save Space As..."; shortcut: root.shortcut-save-as; clicked => { root.on-save-scene-as(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Publish Universe"; shortcut: root.shortcut-publish-universe; clicked => { root.on-publish-universe(); } }
                                DropdownItem { label: "Publish Space"; shortcut: root.shortcut-publish-space; clicked => { root.on-publish-space(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Keyboard Shortcuts..."; clicked => { root.on-show-keybindings(); } }
                                DropdownItem { label: "Soul Settings..."; clicked => { root.on-show-soul-settings(); } }
                                DropdownItem { label: "Settings..."; clicked => { root.on-show-settings(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Exit"; clicked => { root.on-exit(); } }
                            }
                        }
                    }
                }
                
                // ── EDIT ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: edit-label.preferred-width + 12px;
                    background: edit-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    edit-touch := TouchArea { clicked => { edit-popup.show(); } }
                    edit-label := Text { text: "Edit"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    edit-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 220px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 220px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownItem { label: "Undo"; shortcut: "Ctrl+Z"; clicked => { root.on-undo(); } }
                                DropdownItem { label: "Redo"; shortcut: "Ctrl+Y"; clicked => { root.on-redo(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Copy"; shortcut: "Ctrl+C"; clicked => { root.on-copy(); } }
                                DropdownItem { label: "Cut"; shortcut: "Ctrl+X"; clicked => { root.on-cut(); } }
                                DropdownItem { label: "Paste"; shortcut: "Ctrl+V"; clicked => { root.on-paste(); } }
                                DropdownItem { label: "Duplicate"; shortcut: "Ctrl+D"; clicked => { root.on-duplicate(); } }
                                DropdownItem { label: "Delete"; shortcut: "Del"; clicked => { root.on-delete(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Select All"; shortcut: "Ctrl+A"; clicked => { root.on-select-all(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Group"; shortcut: "Ctrl+G"; clicked => { root.on-group(); } }
                                DropdownItem { label: "Ungroup"; shortcut: "Ctrl+U"; clicked => { root.on-ungroup(); } }
                            }
                        }
                    }
                }
                
                // ── VIEW ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: view-label.preferred-width + 12px;
                    background: view-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    view-touch := TouchArea { clicked => { view-popup.show(); } }
                    view-label := Text { text: "View"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    view-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 220px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 220px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownHeader { label: "PANELS"; }
                                DropdownItem { label: root.show-explorer ? "Explorer  [on]" : "Explorer  [off]"; shortcut: "Ctrl+1"; clicked => { root.show-explorer = !root.show-explorer; } }
                                DropdownItem { label: root.show-properties ? "Properties  [on]" : "Properties  [off]"; shortcut: "Ctrl+2"; clicked => { root.show-properties = !root.show-properties; } }
                                DropdownItem { label: root.show-output ? "Output  [on]" : "Output  [off]"; shortcut: "Ctrl+3"; clicked => { root.show-output = !root.show-output; } }
                                DropdownItem { label: root.show-assets ? "Assets  [on]" : "Assets  [off]"; shortcut: "Ctrl+4"; clicked => { root.show-assets = !root.show-assets; } }
                                DropdownItem { label: root.show-collaboration ? "Collaborate  [on]" : "Collaborate  [off]"; shortcut: "Ctrl+5"; clicked => { root.show-collaboration = !root.show-collaboration; } }
                                DropdownItem { label: root.show-command-bar ? "Command Bar  [on]" : "Command Bar  [off]"; shortcut: "Ctrl+K"; clicked => { root.show-command-bar = !root.show-command-bar; } }
                                DropdownSeparator {}
                                DropdownHeader { label: "CAMERA"; }
                                DropdownItem { label: "Focus Selection"; shortcut: "F"; clicked => { root.on-focus-selection(); } }
                            }
                        }
                    }
                }
                
                // ── INSERT ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: insert-label.preferred-width + 12px;
                    background: insert-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    insert-touch := TouchArea { clicked => { insert-popup.show(); } }
                    insert-label := Text { text: "Insert"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    insert-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 260px;
                        height: 600px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 260px;
                            height: 600px;
                            
                            ScrollView {
                                width: 100%;
                                height: 100%;
                                
                                VerticalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    width: 240px;

                                    // ── Pinned common inserts ──
                                    // Kept hardcoded for ergonomics + the
                                    // fast primitive-mesh path (`insert:part`
                                    // etc. spawn with a real block/sphere
                                    // mesh, not a blank Part template).
                                    DropdownHeader { label: "COMMON"; }
                                    DropdownItem { icon: @image-url("../../assets/icons/part.svg"); label: "Part (Block)"; clicked => { root.on-menu-action("insert:part"); } }
                                    DropdownItem { icon: @image-url("../../assets/icons/part.svg"); label: "Sphere"; clicked => { root.on-menu-action("insert:sphere"); } }
                                    DropdownItem { icon: @image-url("../../assets/icons/part.svg"); label: "Cylinder"; clicked => { root.on-menu-action("insert:cylinder"); } }
                                    DropdownItem { icon: @image-url("../../assets/icons/part.svg"); label: "Wedge"; clicked => { root.on-menu-action("insert:wedge"); } }
                                    DropdownItem { icon: @image-url("../../assets/icons/model.svg"); label: "Model"; clicked => { root.on-menu-action("insert:model"); } }
                                    DropdownItem { icon: @image-url("../../assets/icons/folder.svg"); label: "Folder"; clicked => { root.on-menu-action("insert:folder"); } }
                                    DropdownSeparator {}

                                    // ── All creatable registered classes ──
                                    // Data-driven from the ClassRegistry
                                    // (`set_insert_classes`), grouped by
                                    // category. Each row emits the canonical
                                    // PascalCase `insert:<ClassName>` action,
                                    // routed through `create_instance` on the
                                    // Rust side. `show-header` (precomputed in
                                    // Rust) draws the category heading above
                                    // the first row of each group.
                                    for item in root.insert-classes: VerticalLayout {
                                        if item.show-header: DropdownHeader {
                                            label: item.category;
                                        }
                                        DropdownItem {
                                            // Per-category icon. Slint @image-url is compile-time,
                                            // so a ternary over the (precomputed) category gives the
                                            // dynamic rows real icons instead of one generic glyph.
                                            icon: item.category == "Parts" ? @image-url("../../assets/icons/part.svg")
                                                : item.category == "Structure" ? @image-url("../../assets/icons/folder.svg")
                                                : item.category == "Lighting" ? @image-url("../../assets/icons/lighting.svg")
                                                : item.category == "Constraints" ? @image-url("../../assets/icons/weldconstraint.svg")
                                                : item.category == "Effects" ? @image-url("../../assets/icons/particleemitter.svg")
                                                : item.category == "Audio" ? @image-url("../../assets/icons/sound.svg")
                                                : item.category == "GUI" ? @image-url("../../assets/icons/screengui.svg")
                                                : item.category == "Scripting" ? @image-url("../../assets/icons/script.svg")
                                                : item.category == "Animation" ? @image-url("../../assets/icons/animator.svg")
                                                : item.category == "Meshes" ? @image-url("../../assets/icons/meshpart.svg")
                                                : item.category == "Data" ? @image-url("../../assets/icons/filetypes/table.svg")
                                                : @image-url("../../assets/icons/instance.svg");
                                            label: item.display;
                                            clicked => { root.on-menu-action("insert:" + item.class-name); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                // ── MODEL ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: model-label.preferred-width + 12px;
                    background: model-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    model-touch := TouchArea { clicked => { model-popup.show(); } }
                    model-label := Text { text: "Model"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    model-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 200px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 200px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownItem { label: "Group"; shortcut: "Ctrl+G"; clicked => { root.on-group(); } }
                                DropdownItem { label: "Ungroup"; shortcut: "Ctrl+U"; clicked => { root.on-ungroup(); } }
                            }
                        }
                    }
                }
                
                // ── TEST ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: test-label.preferred-width + 12px;
                    background: test-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    test-touch := TouchArea { clicked => { test-popup.show(); } }
                    test-label := Text { text: "Test"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    test-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 200px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 200px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownItem { label: "Run"; shortcut: root.shortcut-play-solo; clicked => { root.on-play-solo(); } }
                                DropdownItem { label: "Play"; shortcut: root.shortcut-play-character; clicked => { root.on-play-with-character(); } }
                                DropdownItem { label: "Pause"; shortcut: root.shortcut-pause-resume; clicked => { root.on-pause(); } }
                                DropdownItem { label: "Stop"; shortcut: root.shortcut-stop-play; clicked => { root.on-stop(); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Stress Test..."; clicked => { root.on-show-stress-test(); } }
                            }
                        }
                    }
                }
                
                // ── PLUGINS ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: plugins-label.preferred-width + 12px;
                    background: plugins-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    plugins-touch := TouchArea { clicked => { plugins-popup.show(); } }
                    plugins-label := Text { text: "Plugins"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    plugins-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 200px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 200px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownItem { label: "View Plugins Folder"; clicked => { root.on-plugin-action("system:open-plugins-folder"); } }
                                DropdownItem { label: "Reload Plugins"; clicked => { root.on-plugin-action("system:reload-plugins"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "INSTALLED"; }
                                DropdownItem { label: "MindSpace"; clicked => { root.on-plugin-action("mindspace:toggle-panel"); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Plugin Marketplace..."; clicked => { root.on-plugin-action("system:marketplace"); } }
                            }
                        }
                    }
                }
                
                // ── NETWORK ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: network-label.preferred-width + 12px;
                    background: network-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    network-touch := TouchArea { clicked => { network-popup.show(); } }
                    network-label := Text { text: "Network"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    network-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 220px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 220px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownHeader { label: "SERVER"; }
                                DropdownItem { label: "Start Local Server"; shortcut: "F9"; clicked => { root.on-start-server(); } }
                                DropdownItem { label: "Stop Server"; clicked => { root.on-stop-server(); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "FORGE CLOUD"; }
                                DropdownItem { label: "Connect to Forge..."; clicked => { root.on-show-forge-connect(); } }
                                DropdownItem { label: "Allocate Server"; clicked => { root.on-plugin-action("network:forge-allocate"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "BENCHMARK"; }
                                DropdownItem { label: "Network Panel"; clicked => { root.on-show-network-panel(); } }
                                DropdownItem { label: "Start Stress Test..."; clicked => { root.on-show-stress-test(); } }
                            }
                        }
                    }
                }
                
                // ── DATA ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: data-label.preferred-width + 12px;
                    background: data-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    data-touch := TouchArea { clicked => { data-popup.show(); } }
                    data-label := Text { text: "Data"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    data-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 220px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 220px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownHeader { label: "CONFIGURATION"; }
                                DropdownItem { label: "Manage Global Sources..."; clicked => { root.on-show-global-sources(); } }
                                DropdownItem { label: "Manage Domains..."; clicked => { root.on-show-domains(); } }
                                DropdownItem { label: "Global Variables..."; clicked => { root.on-show-global-variables(); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "SYNC"; }
                                DropdownItem { label: "Sync Domain to Object Type..."; clicked => { root.on-show-sync-domain(); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "QUICK ADD SOURCE"; }
                                DropdownItem { label: "HTTP / REST API"; clicked => { root.on-add-data-source("REST"); } }
                                DropdownItem { label: "GraphQL"; clicked => { root.on-add-data-source("GraphQL"); } }
                                DropdownItem { label: "PostgreSQL"; clicked => { root.on-add-data-source("PostgreSQL"); } }
                                DropdownItem { label: "CSV / Excel File"; clicked => { root.on-add-data-source("CSV"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "CLOUD PROVIDERS"; }
                                DropdownItem { label: "Firebase"; clicked => { root.on-add-data-source("Firebase"); } }
                                DropdownItem { label: "Supabase"; clicked => { root.on-add-data-source("Supabase"); } }
                                DropdownItem { label: "AWS S3"; clicked => { root.on-add-data-source("S3"); } }
                                DropdownItem { label: "Azure Blob"; clicked => { root.on-add-data-source("AzureBlob"); } }
                                DropdownItem { label: "Oracle Cloud"; clicked => { root.on-add-data-source("Oracle"); } }
                            }
                        }
                    }
                }
                
                // ── TERRAIN ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: terrain-label.preferred-width + 12px;
                    background: terrain-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    terrain-touch := TouchArea { clicked => { terrain-popup.show(); } }
                    terrain-label := Text { text: "Terrain"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    terrain-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 200px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 200px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownHeader { label: "GENERATE"; }
                                DropdownItem { label: "Small (128m)"; clicked => { root.on-spawn-terrain("small"); } }
                                DropdownItem { label: "Medium (512m)"; clicked => { root.on-spawn-terrain("medium"); } }
                                DropdownItem { label: "Large (2km)"; clicked => { root.on-spawn-terrain("large"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "FLAT BASEPLATE"; }
                                DropdownItem { label: "Flat Small (320 m)"; clicked => { root.on-spawn-terrain("flat-small"); } }
                                DropdownItem { label: "Flat Medium (576 m)"; clicked => { root.on-spawn-terrain("flat"); } }
                                DropdownItem { label: "Flat Large (1.1 km)"; clicked => { root.on-spawn-terrain("flat-large"); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Toggle Edit Mode"; shortcut: "T"; clicked => { root.on-toggle-terrain-edit(); } }
                                DropdownItem { label: "Show/Hide Terrain"; clicked => { root.on-menu-action("terrain:toggle-visibility"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "BRUSH TOOLS"; }
                                DropdownItem { label: "Raise"; shortcut: "1"; clicked => { root.on-set-terrain-brush("raise"); } }
                                DropdownItem { label: "Lower"; shortcut: "2"; clicked => { root.on-set-terrain-brush("lower"); } }
                                DropdownItem { label: "Smooth"; shortcut: "3"; clicked => { root.on-set-terrain-brush("smooth"); } }
                                DropdownItem { label: "Flatten"; shortcut: "4"; clicked => { root.on-set-terrain-brush("flatten"); } }
                                DropdownItem { label: "Paint"; shortcut: "5"; clicked => { root.on-set-terrain-brush("paint"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "ASSETS"; }
                                DropdownItem { label: "Import Heightmap..."; clicked => { root.on-import-heightmap(); } }
                                DropdownItem { label: "Export Heightmap..."; clicked => { root.on-export-heightmap(); } }
                            }
                        }
                    }
                }
                
                // ── HELP ──
                Rectangle {
                    width: self.preferred-width;
                    preferred-width: help-label.preferred-width + 12px;
                    background: help-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 2px;
                    
                    help-touch := TouchArea { clicked => { help-popup.show(); } }
                    help-label := Text { text: "Help"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    
                    help-popup := PopupWindow {
                        x: 0px;
                        y: parent.height;
                        width: 200px;
                        
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 200px;
                            
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                
                                DropdownHeader { label: "DOCUMENTATION"; }
                                DropdownItem { label: "Documentation"; clicked => { root.on-open-url("https://docs.eustress.dev"); } }
                                DropdownItem { label: "API Browser"; clicked => { root.on-menu-action("help:api-browser"); } }
                                DropdownItem { label: "Services Browser"; clicked => { root.on-menu-action("help:services-browser"); } }
                                DropdownItem { label: "API Reference (Web)"; clicked => { root.on-open-url("https://docs.eustress.dev/api"); } }
                                DropdownItem { label: "Tutorials"; clicked => { root.on-open-url("https://docs.eustress.dev/tutorials"); } }
                                DropdownItem { label: "Soul Scripting Guide"; clicked => { root.on-open-url("https://docs.eustress.dev/soul"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "EXTERNAL TOOLS"; }
                                DropdownItem { label: "Setup IDE"; clicked => { root.on-open-url("https://eustress.dev/learn/ide"); } }
                                DropdownItem { label: "Setup MCP"; clicked => { root.on-open-url("https://eustress.dev/learn/mcp"); } }
                                DropdownItem { label: "Setup Rune LSP Server"; clicked => { root.on-open-url("https://eustress.dev/learn/lsp"); } }
                                DropdownSeparator {}
                                DropdownHeader { label: "COMMUNITY"; }
                                DropdownItem { label: "Send Feedback…"; clicked => { root.on-menu-action("help:send-feedback"); } }
                                DropdownItem { label: "Website"; clicked => { root.on-open-url("https://eustress.dev"); } }
                                DropdownItem { label: "Discord"; clicked => { root.on-open-url("https://discord.gg/DGP9my8DYN"); } }
                                DropdownItem { label: "GitHub"; clicked => { root.on-open-url("https://github.com/eustressengine/eustress"); } }
                                DropdownSeparator {}
                                DropdownItem { label: "Eustress Constitution"; clicked => { root.on-menu-action("help:constitution"); } }
                                DropdownItem { label: "About Eustress Engine"; clicked => { root.on-show-about(); } }
                            }
                        }
                    }
                }
                
                // Spacer pushes status badges to the right
                Rectangle { horizontal-stretch: 1; }
                
                // Unsaved indicator
                if root.has-unsaved-changes: Rectangle {
                    width: 60px;
                    height: 20px;
                    background: #3d2a1a;  // theme-exempt: unsaved-badge tinted surface, no matching token
                    border-radius: 4px;
                    
                    Text {
                        text: "Unsaved";
                        color: Theme.cat-constraint;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                
                // 8px gap before unit badge
                Rectangle { width: 8px; }

                // Display unit selector — small badge with the current
                // unit symbol, clicking pops a 6-row chooser. Width sized
                // for the longest symbol ("studs"). Same neutral palette
                // as the sync badge so it reads as status, not a tool.
                Rectangle {
                    // Wide enough for "Units: studs" — the longest label.
                    width: 110px;
                    height: 20px;
                    background: #1a1a2e;  // theme-exempt: units-badge tinted surface, no matching token
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #2a2a4a;  // theme-exempt: units-badge tinted border, no matching token

                    unit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { unit-popup.show(); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: "Units: " + root.display-unit-symbol;
                            color: Theme.text-accent;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "▾";
                            color: Theme.text-secondary;
                            font-size: 8px;
                            vertical-alignment: center;
                        }
                    }

                    unit-popup := PopupWindow {
                        // Centred below the badge (popup is wider, so
                        // shift left by half the extra width).
                        x: (parent.width - 170px) / 2;
                        y: parent.height + 2px;
                        width: 170px;
                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 170px;

                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                DropdownHeader { label: "DISPLAY UNIT"; }
                                DropdownItem { label: "Meters (m)"; clicked => { root.on-set-display-unit("m"); } }
                                DropdownItem { label: "Centimeters (cm)"; clicked => { root.on-set-display-unit("cm"); } }
                                DropdownItem { label: "Millimeters (mm)"; clicked => { root.on-set-display-unit("mm"); } }
                                DropdownItem { label: "Feet (ft)"; clicked => { root.on-set-display-unit("ft"); } }
                                DropdownItem { label: "Inches (in)"; clicked => { root.on-set-display-unit("in"); } }
                                DropdownItem { label: "Studs"; clicked => { root.on-set-display-unit("studs"); } }
                            }
                        }
                    }
                }

                // (Removed) Categorical color picker badge — moved into the
                // Properties panel's BrickColor row (see BrickColorRow).

                // 8px gap before sync badge
                Rectangle { width: 8px; }

                // Sync status badge
                Rectangle {
                    width: 80px;
                    height: 20px;
                    background: #1a2e1a;  // theme-exempt: sync-badge tinted surface, no matching token
                    border-radius: 4px;

                    Text {
                        text: root.sync-status;
                        color: Theme.cat-structure;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Update badge (only visible when update available)
                if root.update-available: Rectangle { width: 8px; }
                if root.update-available: Rectangle {
                    width: root.update-status == "downloading" ? 160px : (root.update-status == "ready" ? 150px : 120px);
                    height: 20px;
                    background: root.update-status == "ready" ? #1a3a1a : (root.update-status == "downloading" ? #2a2a3a : #1a2a3a);  // theme-exempt: update-badge tinted surfaces (ready/downloading/pending), no matching token
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.update-status == "ready" ? Theme.cat-structure.with-alpha(0.5) : #4a9eff60;  // theme-exempt: downloading-state blue border tint, no near token

                    update-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.on-update-clicked(); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;

                        // Icon
                        Text {
                            text: root.update-status == "ready" ? "✓" : (root.update-status == "downloading" ? "⬇" : "⬆");
                            color: root.update-status == "ready" ? Theme.cat-structure : #4a9eff;  // theme-exempt: downloading-state blue accent, no near token (see border-color above)
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        // Label
                        Text {
                            text: root.update-status == "ready"
                                ? "Restart to update"
                                : (root.update-status == "downloading"
                                    ? "Downloading " + root.update-progress + "%"
                                    : "Update to " + root.update-version);
                            color: root.update-status == "ready" ? Theme.cat-structure : #4a9eff;  // theme-exempt: downloading-state blue accent, no near token (see border-color above)
                            font-size: 10px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // 8px gap before Bliss badge
                Rectangle { width: 8px; }

                // Bliss node badge + dropdown
                Rectangle {
                    width: 110px;
                    height: 20px;
                    background: root.bliss-enabled ? #2a2a3a : Theme.background-secondary;  // theme-exempt: bliss-badge tinted surface, no matching token
                    border-radius: 4px;

                    bliss-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { bliss-popup.show(); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            text: "Bliss";
                            color: root.bliss-enabled ? #ffffff : Theme.text-secondary;  // theme-exempt: white foreground on colored bliss badge, no white token
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.bliss-balance-short;
                            color: Theme.text-primary;
                            font-size: 10px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    bliss-popup := PopupWindow {
                        x: -80px;
                        y: parent.height + 2px;
                        width: 260px;

                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 260px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                // Header
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Bliss";
                                        color: #ffffff;  // theme-exempt: white foreground on colored/accent surface, no white token
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.bliss-balance;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: " BLS";
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Pending
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Pending";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.bliss-pending;
                                        color: Theme.cat-structure;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                DropdownSeparator {}

                                // Node mode header
                                DropdownHeader { label: "NODE MODE"; }

                                // Light node option
                                Rectangle {
                                    height: 40px;
                                    background: root.bliss-node-mode == "Light" ? Theme.selection-background : (light-touch.has-hover ? Theme.button-hover : transparent);
                                    border-radius: 4px;
                                    border-width: root.bliss-node-mode == "Light" ? 1px : 0px;
                                    border-color: Theme.border-highlight.with-alpha(0.25);

                                    light-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.on-bliss-set-light(); }
                                    }

                                    VerticalLayout {
                                        padding: 4px;
                                        padding-left: 8px;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Light Node";
                                                color: Theme.text-primary;
                                                font-size: 11px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "DEFAULT";
                                                color: #ffffff;  // theme-exempt: white foreground on colored/accent surface, no white token
                                                font-size: 8px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: "1.0x";
                                                color: Theme.text-secondary;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "~200MB RAM — earn by creating, zero setup";
                                            color: Theme.text-secondary;
                                            font-size: 9px;
                                        }
                                    }
                                }

                                // Full node option
                                Rectangle {
                                    height: 40px;
                                    background: root.bliss-node-mode == "Full" ? #1a3a1a : (full-touch.has-hover ? Theme.button-hover : transparent);  // theme-exempt: full-node-selected green tinted surface, no matching token
                                    border-radius: 4px;
                                    border-width: root.bliss-node-mode == "Full" ? 1px : 0px;
                                    border-color: Theme.cat-structure.with-alpha(0.25);

                                    full-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.on-bliss-set-full(); }
                                    }

                                    VerticalLayout {
                                        padding: 4px;
                                        padding-left: 8px;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Full Node";
                                                color: Theme.text-primary;
                                                font-size: 11px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "+10% BLS";
                                                color: Theme.cat-structure;
                                                font-size: 8px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: "1.1x";
                                                color: Theme.cat-structure;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "~2GB RAM — blockchain storage, block production";
                                            color: Theme.text-secondary;
                                            font-size: 9px;
                                        }
                                    }
                                }

                                DropdownSeparator {}

                                // Bonus info
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Bonus multiplier";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.bliss-bonus;
                                        color: root.bliss-node-mode == "Full" ? Theme.cat-structure : Theme.text-primary;
                                        font-size: 10px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 8px gap before account badge
                Rectangle { width: 8px; }

                // Account badge / Sign In button
                if root.account-status == "Logged out": Rectangle {
                    width: 70px;
                    height: 20px;
                    background: Theme.button-primary;
                    border-radius: 4px;

                    sign-in-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.on-open-login(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "Sign In";
                            color: #ffffff;  // theme-exempt: white foreground on colored/accent surface, no white token
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.account-status != "Logged out": Rectangle {
                    width: 100px;
                    height: 20px;
                    background: account-touch.has-hover ? Theme.button-hover : Theme.background-secondary;
                    border-radius: 4px;

                    account-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { account-popup.show(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;

                        // Green online dot
                        VerticalLayout {
                            alignment: center;
                            width: 6px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.accent-green;
                            }
                        }

                        Text {
                            text: root.account-name;
                            color: Theme.text-primary;
                            font-size: 10px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    account-popup := PopupWindow {
                        x: -80px;
                        y: parent.height + 2px;
                        width: 200px;

                        Rectangle {
                            background: Theme.dialog-background;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: Theme.shadow-color;
                            width: 200px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                // Username header
                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-bottom: 4px;

                                    Text {
                                        text: root.account-name;
                                        color: #ffffff;  // theme-exempt: white foreground on colored/accent surface, no white token
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.account-status;
                                        color: Theme.accent-green;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Separator
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border-color;
                                }

                                // Session time
                                HorizontalLayout {
                                    padding-top: 4px;
                                    spacing: 4px;

                                    Text {
                                        text: "Session";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.session-hours;
                                        color: Theme.text-primary;
                                        font-size: 10px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                // Total time
                                HorizontalLayout {
                                    spacing: 4px;

                                    Text {
                                        text: "Total";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.total-hours;
                                        color: Theme.text-primary;
                                        font-size: 10px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                // Sync status
                                HorizontalLayout {
                                    spacing: 4px;
                                    padding-bottom: 4px;

                                    Text {
                                        text: "Sync";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.sync-status;
                                        color: Theme.text-primary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Separator
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border-color;
                                }

                                // Saved identities (quick switch)
                                if root.saved-identities.length > 1: Rectangle {
                                    height: root.saved-identities.length * 24px + 20px;

                                    VerticalLayout {
                                        padding-top: 4px;
                                        spacing: 1px;

                                        Text {
                                            text: "Switch Account";
                                            color: Theme.text-secondary;
                                            font-size: 9px;
                                            font-weight: 600;
                                            horizontal-alignment: left;
                                        }

                                        for identity[idx] in root.saved-identities: Rectangle {
                                            height: 24px;
                                            background: id-touch.has-hover ? Theme.button-hover : (identity.active ? Theme.selection-background : transparent);
                                            border-radius: 3px;

                                            id-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if !identity.active {
                                                        root.on-switch-identity(identity.username);
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;

                                                // Active indicator
                                                VerticalLayout {
                                                    alignment: center;
                                                    width: 6px;
                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: identity.active ? Theme.accent-green : Theme.border-color;
                                                    }
                                                }

                                                Text {
                                                    text: identity.username;
                                                    color: identity.active ? Theme.text-primary : Theme.text-secondary;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: identity.public-key-short;
                                                    color: Theme.text-secondary;
                                                    font-size: 8px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Separator before sign out
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border-color;
                                }

                                // Sign Out button
                                Rectangle {
                                    height: 28px;
                                    background: sign-out-touch.has-hover ? Theme.button-hover : transparent;
                                    border-radius: 4px;

                                    sign-out-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.on-sign-out(); }
                                    }

                                    Text {
                                        text: "Sign Out";
                                        color: Theme.text-error;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // ── Ribbon tab selector row ──
        Rectangle {
            height: 22px;
            background: Theme.ribbon-background;
            
            // Simulation controls — absolute left
            HorizontalLayout {
                x: 6px;
                y: 1px;
                width: 142px;
                height: 20px;
                spacing: 2px;
                
                // Play (Run solo)
                Rectangle {
                    width: 26px;
                    height: 20px;
                    background: root.play-state == "playing" ? Theme.accent-green : 
                                play-solo-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 3px;
                    
                    play-solo-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if root.play-state == "stopped" { root.on-play-solo(); } }
                    }
                    Image {
                        x: 5px; y: 2px; width: 16px; height: 16px;
                        source: @image-url("../../assets/icons/ui/play.svg");
                        image-fit: contain; colorize: Theme.accent-green;
                    }
                }
                // Play Here with Character
                Rectangle {
                    width: 26px;
                    height: 20px;
                    background: play-char-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 3px;
                    
                    play-char-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if root.play-state == "stopped" { root.on-play-with-character(); } }
                    }
                    Image {
                        x: 5px; y: 2px; width: 16px; height: 16px;
                        source: @image-url("../../assets/icons/ui/gamepad.svg");
                        image-fit: contain; colorize: Theme.accent-green;
                    }
                }
                // Pause
                Rectangle {
                    width: 26px;
                    height: 20px;
                    background: root.play-state == "paused" ? Theme.accent-yellow :
                                pause-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 3px;
                    
                    pause-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if root.play-state == "playing" { root.on-pause(); } }
                    }
                    Image {
                        x: 5px; y: 2px; width: 16px; height: 16px;
                        source: @image-url("../../assets/icons/ui/pause.svg");
                        image-fit: contain; colorize: Theme.cat-constraint;
                    }
                }
                // Stop
                Rectangle {
                    width: 26px;
                    height: 20px;
                    background: stop-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 3px;

                    stop-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if root.play-state != "stopped" { root.on-stop(); } }
                    }
                    Image {
                        x: 5px; y: 2px; width: 16px; height: 16px;
                        source: @image-url("../../assets/icons/ui/stop.svg");
                        image-fit: contain; colorize: Theme.text-error;
                    }
                }

                // Simulation Settings
                Rectangle {
                    width: 26px;
                    height: 20px;
                    background: sim-cfg-touch.has-hover ? Theme.button-hover : transparent;
                    border-radius: 3px;

                    sim-cfg-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.on-show-simulation-settings(); }
                    }
                    Image {
                        x: 5px; y: 2px; width: 16px; height: 16px;
                        source: @image-url("../../assets/icons/ui/sim-settings.svg");
                        image-fit: contain;
                    }
                }
            }
            
            // Tab pills — absolute centered in full row width
            tabs-row := HorizontalLayout {
                x: (parent.width - self.preferred-width) / 2;
                y: 1px;
                width: self.preferred-width;
                height: 20px;
                spacing: 6px;
                
                // Data-driven: fed from Rust (`sync_active_mode_to_slint`),
                // filtered to the active Mode's ribbon-tab subset. Falls
                // back to nothing pre-first-frame; the sync system pushes
                // the full 9-tab set immediately on startup.
                for tab-item in root.ribbon-tabs : Rectangle {
                    width: tab-text.preferred-width + 16px;
                    height: 20px;
                    border-radius: 4px;
                    background: root.ribbon-tab == tab-item.id ? tab-item.color :
                                tab-touch.has-hover ? Theme.button-hover : transparent;

                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.ribbon-tab = tab-item.id; }
                    }

                    tab-text := Text {
                        text: tab-item.name;
                        color: root.ribbon-tab == tab-item.id ? #ffffff : Theme.text-secondary;  // theme-exempt: white foreground on colored tab-pill fill, no white token
                        font-size: 11px;
                        font-weight: root.ribbon-tab == tab-item.id ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate font-weight { duration: 140ms; easing: ease-in-out; }
                    }

                    // Tab-underline — 2px `accent-eustress` bar anchored
                    // to the bottom of the active tab. Width + opacity
                    // animate on ribbon-tab change so the accent slides
                    // between tabs rather than snapping. 140ms ease-in-
                    // out per TOOLSET_UX.md §2.4.
                    Rectangle {
                        y: parent.height - 2px;
                        x: (parent.width - self.width) / 2;
                        width: root.ribbon-tab == tab-item.id ? parent.width * 0.8 : 0px;
                        height: 2px;
                        background: Theme.accent-eustress;
                        border-radius: 1px;
                        animate width   { duration: 140ms; easing: ease-in-out; }
                        animate x       { duration: 140ms; easing: ease-in-out; }
                    }
                }
            }
        }
        
        // ── Toolbar content area — switches based on active ribbon tab ──
        Rectangle {
            height: 72px;
            background: Theme.ribbon-background;
            
            // ════════════════════════════════════════════════════════════
            // HOME TAB — File, History, Clipboard, Tools, Space, Utils
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "home": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;
                
                // ── FILE group ──
                ToolGroup {
                    label: "File";
                    IconButton { icon: @image-url("../../assets/icons/ui/new-file.svg"); label: "New"; shortcut: root.shortcut-new; tooltip: "New Space"; tint: Theme.cat-parts; clicked => { root.on-new-scene(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/import.svg"); label: "Open"; shortcut: root.shortcut-open; tooltip: "Open File"; tint: Theme.cat-parts; clicked => { root.on-open-scene(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/save.svg"); label: "Save"; shortcut: root.shortcut-save; tooltip: "Save Space"; tint: Theme.cat-parts; clicked => { root.on-save-scene(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/import.svg"); label: "Import"; tooltip: "Import into this Space: image, video, Gaussian splat (.ply), or Roblox place/model (.rbxl/.rbxlx/.rbxm/.rbxmx)"; tint: Theme.cat-structure; clicked => { root.on-import-asset(); } }
                }
                GroupDivider {}

                // ── HISTORY group ──
                ToolGroup {
                    label: "History";
                    IconButton { icon: @image-url("../../assets/icons/ui/undo.svg"); label: "Undo"; shortcut: root.shortcut-undo; tooltip: "Undo"; tint: Theme.cat-constraint; clicked => { root.on-undo(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/redo.svg"); label: "Redo"; shortcut: root.shortcut-redo; tooltip: "Redo"; tint: Theme.cat-constraint; clicked => { root.on-redo(); } }
                }
                GroupDivider {}

                // ── CLIPBOARD group ──
                ToolGroup {
                    label: "Clipboard";
                    IconButton { icon: @image-url("../../assets/icons/ui/cut.svg"); label: "Cut"; shortcut: root.shortcut-cut; tooltip: "Cut"; tint: Theme.cat-data; clicked => { root.on-cut(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/copy.svg"); label: "Copy"; shortcut: root.shortcut-copy; tooltip: "Copy"; tint: Theme.cat-data; clicked => { root.on-copy(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/paste.svg"); label: "Paste"; shortcut: root.shortcut-paste; tooltip: "Paste"; tint: Theme.cat-data; clicked => { root.on-paste(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/duplicate.svg"); label: "Duplicate"; shortcut: root.shortcut-duplicate; tooltip: "Duplicate"; tint: Theme.cat-structure; clicked => { root.on-duplicate(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/delete.svg"); label: "Delete"; shortcut: root.shortcut-delete; tooltip: "Delete"; tint: Theme.text-error; clicked => { root.on-delete(); } }
                }
                GroupDivider {}

                // ── TOOLS group ──
                ToolGroup {
                    label: "Tools";
                    IconButton { icon: @image-url("../../assets/icons/ui/cursor.svg"); label: "Select"; shortcut: root.shortcut-select; tooltip: "Select"; tint: Theme.text-primary; selected: root.current-tool == "select"; clicked => { root.on-select-tool("select"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/move.svg"); label: "Move"; shortcut: root.shortcut-move; tooltip: "Move"; tint: Theme.accent-green; selected: root.current-tool == "move"; clicked => { root.on-select-tool("move"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/scale.svg"); label: "Scale"; shortcut: root.shortcut-scale; tooltip: "Scale"; tint: Theme.accent-yellow; selected: root.current-tool == "scale"; clicked => { root.on-select-tool("scale"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/rotate.svg"); label: "Rotate"; shortcut: root.shortcut-rotate; tooltip: "Rotate"; tint: Theme.text-accent; selected: root.current-tool == "rotate"; clicked => { root.on-select-tool("rotate"); } }
                }
                GroupDivider {}
                
                // ── SPACE group — World/Local toggle ──
                ToolGroup {
                    label: "Space";
                    Rectangle {
                        width: 72px; height: 24px;
                        background: Theme.input-background; border-radius: 3px; border-width: 1px; border-color: Theme.input-border;
                        HorizontalLayout {
                            padding: 2px; spacing: 1px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.transform-mode == "world" ? Theme.selection-background : transparent;
                                border-radius: 2px;
                                TouchArea { clicked => { root.on-set-transform-mode("world"); } }
                                Text { text: "World"; color: root.transform-mode == "world" ? Theme.text-primary : Theme.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.transform-mode == "local" ? Theme.selection-background : transparent;
                                border-radius: 2px;
                                TouchArea { clicked => { root.on-set-transform-mode("local"); } }
                                Text { text: "Local"; color: root.transform-mode == "local" ? Theme.text-primary : Theme.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
                GroupDivider {}
                
                // ── EDIT group ──
                ToolGroup {
                    label: "Edit";
                    IconButton { icon: @image-url("../../assets/icons/ui/group.svg"); label: "Group"; shortcut: root.shortcut-group; tooltip: "Group"; tint: Theme.cat-parts; clicked => { root.on-group(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/ungroup.svg"); label: "Ungroup"; shortcut: root.shortcut-ungroup; tooltip: "Ungroup"; tint: Theme.cat-parts; clicked => { root.on-ungroup(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/lock.svg"); label: "Lock"; shortcut: root.shortcut-lock; tooltip: "Lock"; selected: root.current-tool == "lock"; tint: Theme.accent-yellow; clicked => { root.on-menu-action("edit:lock"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/unlock.svg"); label: "Unlock All"; shortcut: root.shortcut-unlock; tooltip: "Unlock All"; selected: root.current-tool == "unlock"; tint: Theme.accent-yellow; clicked => { root.on-menu-action("edit:unlock"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/anchor.svg"); label: "Anchor"; shortcut: root.shortcut-anchor; tooltip: "Anchor (click parts; Esc to exit)"; selected: root.current-tool == "anchor"; tint: Theme.accent-purple; clicked => { root.on-menu-action("edit:anchor"); } }
                }
                
                GroupDivider {}

                // ── UTILS group ──
                ToolGroup {
                    label: "Utils";
                    IconButton { icon: @image-url("../../assets/icons/ui/keyboard.svg"); label: "Keys"; tooltip: "Keyboard Shortcuts"; tint: Theme.accent-purple; clicked => { root.on-show-keybindings(); } }
                    IconButton { icon: @image-url("../../assets/icons/soulservice.svg"); label: "Soul"; tooltip: "Soul Settings"; tint: Theme.accent-purple; clicked => { root.on-show-soul-settings(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/terminal.svg"); label: "Console"; tooltip: "Command Palette (Ctrl+K)"; tint: Theme.accent-purple; clicked => { root.on-toggle-command-bar(); } }
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // DRAFTING TAB — Smart Edit · Align · Pattern · Boolean
            // All buttons are live. Modal tools (Smart Edit / Pattern)
            // arm on click → pick in viewport → toast confirms step.
            // Align / Boolean act on the current selection immediately.
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "cad": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;

                // ── SMART EDIT — click tool → pick parts in viewport
                ToolGroup {
                    label: "Smart Edit";
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/gap-fill.svg");
                        label: "Gap Fill"; shortcut: root.shortcut-gap-fill;
                        tooltip: "Gap Fill";
                        tint: Theme.accent-cyan;
                        selected: root.active-modal-tool-id == "gap_fill";
                        clicked => { root.on-activate-modal-tool("gap_fill"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/resize-align.svg");
                        label: "Resize"; shortcut: root.shortcut-resize-align;
                        tooltip: "Resize Align";
                        tint: Theme.accent-cyan;
                        selected: root.active-modal-tool-id == "resize_align";
                        clicked => { root.on-activate-modal-tool("resize_align"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/edge-align.svg");
                        label: "Edge"; shortcut: root.shortcut-edge-align;
                        tooltip: "Edge Align";
                        tint: Theme.accent-cyan;
                        selected: root.active-modal-tool-id == "edge_align";
                        clicked => { root.on-activate-modal-tool("edge_align"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/part-swap.svg");
                        label: "Swap"; shortcut: root.shortcut-part-swap;
                        tooltip: "Part Swap";
                        tint: Theme.accent-cyan;
                        selected: root.active-modal-tool-id == "part_swap_positions";
                        clicked => { root.on-activate-modal-tool("part_swap_positions"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/mirror.svg");
                        label: "Mirror"; shortcut: root.shortcut-model-reflect;
                        tooltip: "Mirror";
                        tint: Theme.accent-cyan;
                        selected: root.active-modal-tool-id == "model_reflect";
                        clicked => { root.on-activate-modal-tool("model_reflect"); }
                    }
                }
                GroupDivider {}

                // ── ALIGN — requires multi-selection first
                ToolGroup {
                    label: "Align";
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/align-center.svg");
                        label: "X"; shortcut: "";
                        tooltip: "Align centers on X";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("align:center:x"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/align-center.svg");
                        label: "Y"; shortcut: "";
                        tooltip: "Align centers on Y";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("align:center:y"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/align-center.svg");
                        label: "Z"; shortcut: "";
                        tooltip: "Align centers on Z";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("align:center:z"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/distribute.svg");
                        label: "Dist X"; shortcut: "";
                        tooltip: "Distribute evenly on X";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("distribute:x"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/distribute.svg");
                        label: "Dist Y"; shortcut: "";
                        tooltip: "Distribute evenly on Y";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("distribute:y"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/distribute.svg");
                        label: "Dist Z"; shortcut: "";
                        tooltip: "Distribute evenly on Z";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("distribute:z"); }
                    }
                }
                GroupDivider {}

                // ── PATTERN — ModalTool with options panel (Apply)
                ToolGroup {
                    label: "Pattern";
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/array-linear.svg");
                        label: "Linear"; shortcut: root.shortcut-linear-array;
                        tooltip: "Linear Array";
                        tint: Theme.cat-modify;
                        selected: root.active-modal-tool-id == "linear_array";
                        clicked => { root.on-activate-modal-tool("linear_array"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/array-radial.svg");
                        label: "Radial"; shortcut: root.shortcut-radial-array;
                        tooltip: "Radial Array";
                        tint: Theme.cat-modify;
                        selected: root.active-modal-tool-id == "radial_array";
                        clicked => { root.on-activate-modal-tool("radial_array"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/array-grid.svg");
                        label: "Grid"; shortcut: root.shortcut-grid-array;
                        tooltip: "Grid Array";
                        tint: Theme.cat-modify;
                        selected: root.active-modal-tool-id == "grid_array";
                        clicked => { root.on-activate-modal-tool("grid_array"); }
                    }
                    // `path_array` has been in `ModalToolRegistry` (array_tools.rs)
                    // since Phase 2 but had no ribbon entry, so the only way to
                    // reach it was MCP or a scripted activation. Reuses route.svg
                    // — there is no array-path.svg and the route glyph already
                    // reads as "follow a polyline".
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/route.svg");
                        label: "Path"; shortcut: root.shortcut-path-array;
                        tooltip: "Path Array";
                        tint: Theme.cat-modify;
                        selected: root.active-modal-tool-id == "path_array";
                        clicked => { root.on-activate-modal-tool("path_array"); }
                    }
                }
                GroupDivider {}

                // ── BOOLEAN — real truck CSG (Block/Ball/Cylinder)
                ToolGroup {
                    label: "Boolean";
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/csg-union.svg");
                        label: "Union"; shortcut: "";
                        tooltip: "Union";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("csg:union"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/csg-subtract.svg");
                        label: "Subtract"; shortcut: "";
                        tooltip: "Subtract";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("csg:negate"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/csg-intersect.svg");
                        label: "Intersect"; shortcut: "";
                        tooltip: "Intersect";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("csg:intersect"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/csg-separate.svg");
                        label: "Separate"; shortcut: "";
                        tooltip: "Separate";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("csg:separate"); }
                    }
                }
            }

            // ════════════════════════════════════════════════════════════
            // MODEL TAB — Parts, Structure, Constraints, Effects, CSG, Assets
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "model": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;
                
                ToolGroup {
                    label: "Parts";
                    IconButton { icon: @image-url("../../assets/icons/part.svg"); label: "Part"; tooltip: "Insert Part"; tint: Theme.cat-parts; clicked => { root.on-menu-action("insert:part"); } }
                    IconButton { icon: @image-url("../../assets/icons/unionoperation.svg"); label: "Union"; tooltip: "Insert Union"; tint: Theme.cat-parts; clicked => { root.on-menu-action("insert:unionoperation"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/seat.svg"); label: "Seat"; tooltip: "Insert Seat"; tint: Theme.cat-parts; clicked => { root.on-menu-action("insert:seat"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/vehicle.svg"); label: "Vehicle"; tooltip: "Insert VehicleSeat"; tint: Theme.cat-parts; clicked => { root.on-menu-action("insert:vehicleseat"); } }

                    // ── Parametric — feature-tree CadPart (eustress-cad)
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/block.svg");
                        label: "Plate"; shortcut: "";
                        tooltip: "Parametric plate";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_plate"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/block.svg");
                        label: "Box"; shortcut: "";
                        tooltip: "Parametric cube";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_box"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/cylinder.svg");
                        label: "Cylinder"; shortcut: "";
                        tooltip: "Parametric cylinder";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_cylinder"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/csg-subtract.svg");
                        label: "Hole"; shortcut: "";
                        tooltip: "Plate + through-hole";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_plate_hole"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/corner.svg");
                        label: "L-Bracket"; shortcut: "";
                        tooltip: "L-bracket polyline extrude";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_lbracket"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/cad-frame.svg");
                        label: "Frame"; shortcut: "";
                        tooltip: "Constrained frame sketch";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_frame"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/block.svg");
                        label: "Shell"; shortcut: "";
                        tooltip: "Shelled box";
                        tint: Theme.cat-parts;
                        clicked => { root.on-menu-action("insert:cad_shell"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/export.svg");
                        label: "GLB"; shortcut: "";
                        tooltip: "Export selected CadPart to .glb (self-describing extras with variables)";
                        tint: Theme.accent-yellow;
                        clicked => { root.on-menu-action("cad:export_glb"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/cad-solve.svg");
                        label: "Solve"; shortcut: "";
                        tooltip: "Run 2D constraint solver on all sketches in the selected CadPart";
                        tint: Theme.accent-green;
                        clicked => { root.on-menu-action("cad:solve_sketch"); }
                    }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Structure";
                    IconButton { icon: @image-url("../../assets/icons/model.svg"); label: "Model"; tooltip: "Insert Model"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:model"); } }
                    IconButton { icon: @image-url("../../assets/icons/folder.svg"); label: "Folder"; tooltip: "Insert Folder"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:folder"); } }
                    IconButton { icon: @image-url("../../assets/icons/spawnlocation.svg"); label: "Spawn"; tooltip: "Insert SpawnLocation"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:spawnlocation"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Constraints";
                    IconButton { icon: @image-url("../../assets/icons/attachment.svg"); label: "Attach"; tooltip: "Insert Attachment"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("insert:attachment"); } }
                    IconButton { icon: @image-url("../../assets/icons/weldconstraint.svg"); label: "Weld"; tooltip: "Insert Weld"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("insert:weldconstraint"); } }

                    // ── Assembly mates — live Avian joints (eustress-cad).
                    // Coincident is covered by "Weld" above (same practical
                    // effect — two parts locked rigid), so there is no
                    // separate "Fixed" button here. Same amber tint as
                    // Attach/Weld/Motor — one constraint family.
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/hinge.svg");
                        label: "Hinge"; shortcut: "";
                        tooltip: "Revolute mate";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("cad:mate_revolute"); }
                    }
                    IconButton { icon: @image-url("../../assets/icons/motor6d.svg"); label: "Motor"; tooltip: "Insert Motor6D"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("insert:motor6d"); } }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/cad-slide.svg");
                        label: "Slide"; shortcut: "";
                        tooltip: "Prismatic mate";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("cad:mate_prismatic"); }
                    }
                    IconButton {
                        icon: @image-url("../../assets/icons/ui/cad-ball.svg");
                        label: "Ball"; shortcut: "";
                        tooltip: "Ball mate";
                        tint: Theme.cat-constraint;
                        clicked => { root.on-menu-action("cad:mate_ball"); }
                    }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Effects";
                    IconButton { icon: @image-url("../../assets/icons/particleemitter.svg"); label: "Particles"; tooltip: "Insert Particles"; tint: Theme.accent-purple; clicked => { root.on-menu-action("insert:particleemitter"); } }
                    IconButton { icon: @image-url("../../assets/icons/pointlight.svg"); label: "Point"; tooltip: "Insert PointLight"; tint: Theme.accent-yellow; clicked => { root.on-menu-action("insert:pointlight"); } }
                    IconButton { icon: @image-url("../../assets/icons/spotlight.svg"); label: "Spot"; tooltip: "Insert SpotLight"; tint: Theme.accent-yellow; clicked => { root.on-menu-action("insert:spotlight"); } }
                    IconButton { icon: @image-url("../../assets/icons/sound.svg"); label: "Sound"; tooltip: "Insert Sound"; tint: Theme.cat-data; clicked => { root.on-menu-action("insert:sound"); } }
                    IconButton { icon: @image-url("../../assets/icons/beam.svg"); label: "Beam"; tooltip: "Insert Beam"; tint: Theme.cat-data; clicked => { root.on-menu-action("insert:beam"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Assets";
                    IconButton { icon: @image-url("../../assets/icons/ui/import.svg"); label: "Import"; tooltip: "Import Model (OBJ/FBX/GLTF)"; tint: Theme.cat-data; clicked => { root.on-menu-action("model:import"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/export.svg"); label: "Export"; tooltip: "Export Selection"; tint: Theme.cat-data; clicked => { root.on-menu-action("model:export"); } }
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // UI TAB — Containers, Display, Interactive, Layout
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "ui": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;
                
                ToolGroup {
                    label: "Containers";
                    IconButton { icon: @image-url("../../assets/icons/ui/screen.svg"); label: "Screen"; tooltip: "ScreenGui"; tint: Theme.accent-blue; clicked => { root.on-menu-action("insert:screengui"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/billboard.svg"); label: "Billboard"; tooltip: "BillboardGui"; tint: Theme.accent-blue; clicked => { root.on-menu-action("insert:billboardgui"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/surface.svg"); label: "Surface"; tooltip: "SurfaceGui"; tint: Theme.accent-blue; clicked => { root.on-menu-action("insert:surfacegui"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/frame.svg"); label: "Frame"; tooltip: "Frame"; tint: Theme.accent-blue; clicked => { root.on-menu-action("insert:frame"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/scroll.svg"); label: "Scroll"; tooltip: "ScrollingFrame"; tint: Theme.accent-blue; clicked => { root.on-menu-action("insert:scrollingframe"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Display";
                    IconButton { icon: @image-url("../../assets/icons/ui/text.svg"); label: "Text"; tooltip: "TextLabel"; tint: Theme.text-success; clicked => { root.on-menu-action("insert:textlabel"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/image.svg"); label: "Image"; tooltip: "ImageLabel"; tint: Theme.text-success; clicked => { root.on-menu-action("insert:imagelabel"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Interactive";
                    IconButton { icon: @image-url("../../assets/icons/ui/button.svg"); label: "Button"; tooltip: "TextButton"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("insert:textbutton"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/image.svg"); label: "ImgBtn"; tooltip: "ImageButton"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("insert:imagebutton"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/textbox.svg"); label: "TextBox"; tooltip: "TextBox"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("insert:textbox"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/viewport.svg"); label: "Viewport"; tooltip: "ViewportFrame"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:viewportframe"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/video.svg"); label: "Video"; tooltip: "VideoFrame"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:videoframe"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/document.svg"); label: "Doc"; tooltip: "DocumentFrame"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:documentframe"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/web.svg"); label: "Web"; tooltip: "WebFrame"; tint: Theme.cat-structure; clicked => { root.on-menu-action("insert:webframe"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Layout";
                    IconButton { icon: @image-url("../../assets/icons/ui/align-left.svg"); label: "Left"; tooltip: "Align Left"; tint: Theme.text-primary; clicked => { root.on-menu-action("ui:align-left"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/align-center.svg"); label: "Center"; tooltip: "Align Center"; tint: Theme.text-primary; clicked => { root.on-menu-action("ui:align-center"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/align-right.svg"); label: "Right"; tooltip: "Align Right"; tint: Theme.text-primary; clicked => { root.on-menu-action("ui:align-right"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/distribute.svg"); label: "Distribute"; tooltip: "Distribute Evenly"; tint: Theme.text-primary; clicked => { root.on-menu-action("ui:distribute"); } }
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // TERRAIN TAB — Generate, Edit, Brushes, Water, Assets
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "terrain": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;
                
                ToolGroup {
                    label: "Generate";
                    IconButton { icon: @image-url("../../assets/icons/terrain.svg"); label: "Small"; tooltip: "Small Terrain (128m)"; tint: Theme.accent-green; clicked => { root.on-spawn-terrain("small"); } }
                    IconButton { icon: @image-url("../../assets/icons/terrain.svg"); label: "Medium"; tooltip: "Medium Terrain (512m)"; tint: Theme.accent-green; clicked => { root.on-spawn-terrain("medium"); } }
                    IconButton { icon: @image-url("../../assets/icons/terrain.svg"); label: "Large"; tooltip: "Large Terrain (2km)"; tint: Theme.accent-green; clicked => { root.on-spawn-terrain("large"); } }
                    // Flat baseplate — a dead-level sculptable plate, written
                    // straight to disk. Small/Medium/Large above run the full
                    // worldgen pipeline (rivers, climate, materials) and take
                    // a while; this one returns immediately.
                    IconButton { icon: @image-url("../../assets/icons/ui/array-grid.svg"); label: "Flat"; tooltip: "Flat baseplate terrain (576 m, sculptable) — instant, no rivers or biomes"; tint: Theme.accent-green; clicked => { root.on-spawn-terrain("flat"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Edit";
                    IconButton { icon: @image-url("../../assets/icons/ui/check.svg"); label: "Edit"; tooltip: "Toggle Edit Mode (T)"; tint: Theme.accent-yellow; selected: root.terrain-edit-mode; clicked => { root.on-toggle-terrain-edit(); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "View";
                    // Show/Hide is VISIBILITY only — terrain entities, voxel
                    // chunks and files are untouched, so it's instant and
                    // reversible. Distinct from Clear (in Assets), which
                    // despawns and deletes.
                    IconButton {
                        icon: @image-url("../../assets/icons/terrain.svg");
                        label: "Show/Hide";
                        tooltip: "Show or hide terrain in the viewport (visibility only — does not delete)";
                        tint: Theme.text-success;
                        clicked => { root.on-menu-action("terrain:toggle-visibility"); }
                    }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Brushes";
                    raise-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/chevron-up.svg"); 
                        label: "Raise"; 
                        tooltip: "Raise (1) | Hold or right-click for settings"; 
                        tint: Theme.cat-structure; 
                        selected: root.current-terrain-brush == "raise";
                        clicked => { root.on-set-terrain-brush("raise"); }
                        right-clicked => { 
                            root.settings-brush-name = "Raise";
                            root.settings-modal-x = raise-btn.absolute-position.x;
                            root.settings-modal-y = raise-btn.absolute-position.y + raise-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Raise";
                            root.settings-modal-x = raise-btn.absolute-position.x;
                            root.settings-modal-y = raise-btn.absolute-position.y + raise-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                    lower-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/chevron-down.svg"); 
                        label: "Lower"; 
                        tooltip: "Lower (2) | Hold or right-click for settings"; 
                        tint: Theme.accent-red; 
                        selected: root.current-terrain-brush == "lower";
                        clicked => { root.on-set-terrain-brush("lower"); }
                        right-clicked => { 
                            root.settings-brush-name = "Lower";
                            root.settings-modal-x = lower-btn.absolute-position.x;
                            root.settings-modal-y = lower-btn.absolute-position.y + lower-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Lower";
                            root.settings-modal-x = lower-btn.absolute-position.x;
                            root.settings-modal-y = lower-btn.absolute-position.y + lower-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                    smooth-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/filter.svg"); 
                        label: "Smooth"; 
                        tooltip: "Smooth (3) | Hold or right-click for settings"; 
                        tint: Theme.cat-parts; 
                        selected: root.current-terrain-brush == "smooth";
                        clicked => { root.on-set-terrain-brush("smooth"); }
                        right-clicked => { 
                            root.settings-brush-name = "Smooth";
                            root.settings-modal-x = smooth-btn.absolute-position.x;
                            root.settings-modal-y = smooth-btn.absolute-position.y + smooth-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Smooth";
                            root.settings-modal-x = smooth-btn.absolute-position.x;
                            root.settings-modal-y = smooth-btn.absolute-position.y + smooth-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                    flatten-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/reset.svg"); 
                        label: "Flatten"; 
                        tooltip: "Flatten (4) | Hold or right-click for settings"; 
                        tint: Theme.cat-constraint; 
                        selected: root.current-terrain-brush == "flatten";
                        clicked => { root.on-set-terrain-brush("flatten"); }
                        right-clicked => { 
                            root.settings-brush-name = "Flatten";
                            root.settings-modal-x = flatten-btn.absolute-position.x;
                            root.settings-modal-y = flatten-btn.absolute-position.y + flatten-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Flatten";
                            root.settings-modal-x = flatten-btn.absolute-position.x;
                            root.settings-modal-y = flatten-btn.absolute-position.y + flatten-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                    paint-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/palette.svg"); 
                        label: "Paint"; 
                        tooltip: "Paint (5) | Hold or right-click for settings"; 
                        tint: Theme.accent-purple; 
                        selected: root.current-terrain-brush == "paint";
                        clicked => { root.on-set-terrain-brush("paint"); }
                        right-clicked => { 
                            root.settings-brush-name = "Paint";
                            root.settings-modal-x = paint-btn.absolute-position.x;
                            root.settings-modal-y = paint-btn.absolute-position.y + paint-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Paint";
                            root.settings-modal-x = paint-btn.absolute-position.x;
                            root.settings-modal-y = paint-btn.absolute-position.y + paint-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                    region-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/frame.svg"); 
                        label: "Region"; 
                        tooltip: "Region | Hold or right-click for settings"; 
                        tint: Theme.cat-parts; 
                        selected: root.current-terrain-brush == "region";
                        clicked => { root.on-set-terrain-brush("region"); }
                        right-clicked => { 
                            root.settings-brush-name = "Region";
                            root.settings-modal-x = region-btn.absolute-position.x;
                            root.settings-modal-y = region-btn.absolute-position.y + region-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Region";
                            root.settings-modal-x = region-btn.absolute-position.x;
                            root.settings-modal-y = region-btn.absolute-position.y + region-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                    fill-btn := IconButton { 
                        icon: @image-url("../../assets/icons/ui/palette.svg"); 
                        label: "Fill"; 
                        tooltip: "Fill | Hold or right-click for settings"; 
                        tint: Theme.cat-structure; 
                        selected: root.current-terrain-brush == "fill";
                        clicked => { root.on-set-terrain-brush("fill"); }
                        right-clicked => { 
                            root.settings-brush-name = "Fill";
                            root.settings-modal-x = fill-btn.absolute-position.x;
                            root.settings-modal-y = fill-btn.absolute-position.y + fill-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                        long-pressed => { 
                            root.settings-brush-name = "Fill";
                            root.settings-modal-x = fill-btn.absolute-position.x;
                            root.settings-modal-y = fill-btn.absolute-position.y + fill-btn.height;
                            root.show-brush-settings = true;
                            brush-settings-modal.show();
                        }
                    }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Water";
                    IconButton { icon: @image-url("../../assets/icons/ui/water.svg"); label: "Water"; tooltip: "Show or hide the water plane at the terrain's sea level"; tint: Theme.text-accent; clicked => { root.on-menu-action("terrain:water"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Assets";
                    IconButton { icon: @image-url("../../assets/icons/ui/import.svg"); label: "Import"; tooltip: "Import Heightmap"; tint: Theme.cat-data; clicked => { root.on-import-heightmap(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/export.svg"); label: "Export"; tooltip: "Export Heightmap"; tint: Theme.cat-data; clicked => { root.on-export-heightmap(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/delete.svg"); label: "Clear"; tooltip: "Clear Terrain"; tint: Theme.text-error; clicked => { root.on-menu-action("terrain:clear"); } }
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // TEST TAB — Server, Clients, Play, Network, Benchmark, Debug
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "test": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;
                
                ToolGroup {
                    label: "Server";
                    IconButton { icon: @image-url("../../assets/icons/ui/server.svg"); label: "Start"; tooltip: "Start Server (F9)"; tint: Theme.accent-green; clicked => { root.on-start-server(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/close.svg"); label: "Stop"; tooltip: "Stop Server"; tint: Theme.text-error; clicked => { root.on-stop-server(); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Clients";
                    IconButton { icon: @image-url("../../assets/icons/ui/client.svg"); label: "Spawn"; tooltip: "Spawn Synthetic Clients"; tint: Theme.cat-parts; clicked => { root.on-plugin-action("network:spawn-clients"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/close.svg"); label: "Disconnect"; tooltip: "Disconnect All"; tint: Theme.accent-red; clicked => { root.on-plugin-action("network:disconnect-all"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Play";
                    IconButton { icon: @image-url("../../assets/icons/ui/gamepad.svg"); label: "Play"; tooltip: "Play Here"; tint: Theme.accent-green; clicked => { root.on-play-with-character(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/pause.svg"); label: "Pause"; tooltip: "Pause"; tint: Theme.cat-constraint; clicked => { root.on-pause(); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Network";
                    IconButton { icon: @image-url("../../assets/icons/ui/server.svg"); label: "Server"; tooltip: "Dedicated Server"; tint: Theme.cat-parts; clicked => { root.on-start-server(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/client.svg"); label: "Client"; tooltip: "Join as Client"; tint: Theme.cat-parts; clicked => { root.on-menu-action("test:join-client"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/network.svg"); label: "Local"; tooltip: "Local Server + Client"; tint: Theme.cat-parts; clicked => { root.on-menu-action("test:local"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Benchmark";
                    IconButton { icon: @image-url("../../assets/icons/ui/network.svg"); label: "Network"; tooltip: "Network Panel"; tint: Theme.accent-yellow; clicked => { root.on-show-network-panel(); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/stress.svg"); label: "Stress"; tooltip: "Stress Test"; tint: Theme.accent-yellow; clicked => { root.on-show-stress-test(); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "Debug";
                    IconButton { icon: @image-url("../../assets/icons/ui/terminal.svg"); label: "Output"; tooltip: "Output Console"; tint: Theme.text-primary; clicked => { root.on-menu-action("test:console"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/debug.svg"); label: "Debug"; tooltip: "Debug Mode"; tint: Theme.text-primary; clicked => { root.on-menu-action("test:debug"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/cleanup.svg"); label: "Reset"; tooltip: "Reset Simulation"; tint: Theme.text-error; clicked => { root.on-stop(); } }
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // MINDSPACE TAB — Panel, Labels, Connect, File, AI Tools
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "mindspace": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;
                
                ToolGroup {
                    label: "Labels";
                    IconButton { icon: @image-url("../../assets/icons/ui/label.svg"); label: "Add"; tooltip: "Add Label (Ctrl+L)"; tint: Theme.accent-purple; clicked => { root.on-plugin-action("mindspace:add-label"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/close.svg"); label: "Remove"; tooltip: "Remove Label"; tint: Theme.accent-red; clicked => { root.on-plugin-action("mindspace:remove-label"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Connect";
                    IconButton { icon: @image-url("../../assets/icons/ui/link.svg"); label: "Connect"; tooltip: "Connect Nodes (Ctrl+K)"; tint: Theme.accent-green; clicked => { root.on-plugin-action("mindspace:connect"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Size";
                    IconButton { icon: @image-url("../../assets/icons/ui/expand-all.svg"); label: "Larger"; tooltip: "Grow the selected label 5% (billboard + text)"; tint: Theme.accent-blue; clicked => { root.on-plugin-action("mindspace:billboard-larger"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/collapse-all.svg"); label: "Smaller"; tooltip: "Shrink the selected label 5% (billboard + text)"; tint: Theme.accent-blue; clicked => { root.on-plugin-action("mindspace:billboard-smaller"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "File";
                    IconButton { icon: @image-url("../../assets/icons/ui/import.svg"); label: "Import"; tooltip: "Import Mind Map"; tint: Theme.cat-data; clicked => { root.on-plugin-action("mindspace:import"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/export.svg"); label: "Export"; tooltip: "Export Mind Map"; tint: Theme.accent-red; clicked => { root.on-plugin-action("mindspace:export"); } }
                }
                GroupDivider {}
                
                ToolGroup {
                    label: "AI Tools";
                    IconButton { icon: @image-url("../../assets/icons/ui/suggest.svg"); label: "Suggest"; tooltip: "AI Suggestions"; tint: Theme.cat-structure; clicked => { root.on-plugin-action("mindspace:ai-suggest"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/auto-layout.svg"); label: "Layout"; tooltip: "Auto Layout"; tint: Theme.cat-structure; clicked => { root.on-plugin-action("mindspace:ai-layout"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/summary.svg"); label: "Summary"; tooltip: "Generate Summary"; tint: Theme.cat-structure; clicked => { root.on-plugin-action("mindspace:ai-summarize"); } }
                }
            }

            // ════════════════════════════════════════════════════════════
            // DATA TAB — Data Platform: Source · Table · Analyze · Visualize
            //            · Record · Experiment. Buttons route through the
            //            existing on-menu-action("data:*") callback.
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "data": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;

                ToolGroup {
                    label: "Source";
                    IconButton { icon: @image-url("../../assets/icons/ui/import.svg"); label: "Import"; tooltip: "Import CSV / JSON / Parquet"; tint: Theme.cat-data; clicked => { root.on-menu-action("data:import"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/link.svg"); label: "Connect"; tooltip: "Connect a live source"; tint: Theme.cat-data; clicked => { root.on-menu-action("data:connect"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Table";
                    IconButton { icon: @image-url("../../assets/icons/filetypes/table.svg"); label: "Grid"; tooltip: "Open the Data Grid"; tint: Theme.cat-parts; clicked => { root.on-menu-action("data:grid"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/array-grid.svg"); label: "Columns"; tooltip: "Add a calculated column"; tint: Theme.cat-parts; clicked => { root.on-menu-action("data:columns"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Analyze";
                    IconButton { icon: @image-url("../../assets/icons/ui/summary.svg"); label: "Stats"; tooltip: "Descriptive statistics"; tint: Theme.cat-structure; clicked => { root.on-menu-action("data:stats"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/brain.svg"); label: "Fit"; tooltip: "Curve fit (linear / polynomial)"; tint: Theme.cat-structure; clicked => { root.on-menu-action("data:fit"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/sparkle.svg"); label: "FFT"; tooltip: "Spectral analysis"; tint: Theme.cat-structure; clicked => { root.on-menu-action("data:fft"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/array-radial.svg"); label: "Cluster"; tooltip: "k-means clustering"; tint: Theme.cat-structure; clicked => { root.on-menu-action("data:cluster"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/search.svg"); label: "Anomaly"; tooltip: "Anomaly detection"; tint: Theme.cat-structure; clicked => { root.on-menu-action("data:anomaly"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Visualize";
                    IconButton { icon: @image-url("../../assets/icons/ui/viewport.svg"); label: "Chart"; tooltip: "Open a Chart tab"; tint: Theme.text-accent; clicked => { root.on-menu-action("data:chart"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/palette.svg"); label: "Overlay"; tooltip: "Color the 3D scene by a metric"; tint: Theme.text-accent; clicked => { root.on-menu-action("data:overlay"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/layout-default.svg"); label: "Dashboard"; tooltip: "Compose a dashboard"; tint: Theme.text-accent; clicked => { root.on-menu-action("data:dashboard"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Record";
                    IconButton { icon: @image-url("../../assets/icons/ui/play.svg"); label: "Record"; tooltip: "Start the timeseries Recorder"; tint: Theme.accent-purple; clicked => { root.on-menu-action("data:record"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/history.svg"); label: "Timeline"; tooltip: "Open the Recorder timeline"; tint: Theme.accent-purple; clicked => { root.on-menu-action("data:timeline"); } }
                }
                GroupDivider {}

                ToolGroup {
                    label: "Experiment";
                    IconButton { icon: @image-url("../../assets/icons/filetypes/git.svg"); label: "Branch"; tooltip: "Snapshot a Run (signals + world + stats)"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("data:branch"); } }
                    IconButton { icon: @image-url("../../assets/icons/ui/swap.svg"); label: "Compare"; tooltip: "Compare Runs (overlay + deltas)"; tint: Theme.cat-constraint; clicked => { root.on-menu-action("data:compare"); } }
                }
            }

            // ════════════════════════════════════════════════════════════
            // PLUGINS TAB — fully data-driven from `plugin-sections` /
            // `plugin-buttons` (populated from `TabRegistry`, which is in
            // turn populated by real `StudioPlugin`s via `PluginApi` — see
            // `road_tool.rs` for the first real plugin). Every OTHER tab
            // above is a hardcoded `ToolGroup`/`IconButton` list because its
            // buttons are fixed at compile time; this is the one tab where
            // the button set itself is Rust-side data, so a hot-enabled
            // plugin's UI appears without touching this file again.
            // ════════════════════════════════════════════════════════════
            if root.ribbon-tab == "plugins": HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;

                for section in root.plugin-sections: ToolGroup {
                    label: section.label;
                    for button in root.plugin-buttons: IconButton {
                        // `for X: if Y: Component {}` is not valid Slint syntax
                        // (a compile-time parse error — confirmed the hard way).
                        // The proven pattern in this codebase for a filtered
                        // for-loop is `visible:` + an explicit zero-size
                        // override on the SAME target component (see
                        // services_browser.slint's `for service[idx] in
                        // root.services: ServiceSidebarItem { visible: ...;
                        // height: ... ? 30px : 0px; }`) — visible alone isn't
                        // trusted here to fully collapse layout space, so width
                        // is forced to 0 too when this button belongs to a
                        // different section.
                        property <bool> in-this-section: button.tab-id == section.tab-id && button.section-id == section.section-id;
                        visible: in-this-section;
                        width: in-this-section ? self.preferred-width : 0px;
                        icon: @image-url("../../assets/icons/ui/settings.svg");
                        label: button.label;
                        tooltip: button.tooltip;
                        tint: Theme.accent-purple;
                        clicked => { root.on-plugin-action(button.action-id); }
                    }
                }

                if root.plugin-sections.length == 0: Text {
                    text: "No plugins enabled";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            // CUSTOM MODE TABS — a mode's own tabs beyond the 9 built-ins
            // (e.g. Business's "Product"/"Manufacturing"). The section/tool
            // models hold EVERY tab of the active mode, filtered here to
            // `tab-id == root.ribbon-tab`. Hidden entries collapse via
            // `clip: true` + zero WIDTH — critically, all layout `spacing`
            // here is 0 and gaps live INSIDE each visible child's width,
            // because layout spacing is charged between hidden zero-width
            // children too (the original spacing: 6px version scattered
            // phantom gaps across the strip — one 6px slot per hidden
            // section, plus 4px per hidden button inside every ToolGroup).
            // Each section draws its own trailing GroupDivider-style rule,
            // matching the built-in tabs' group separators.
            // ════════════════════════════════════════════════════════════
            if !root.ribbon-tab-is-builtin: HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 0px;
                alignment: center;

                for section in root.custom-tab-sections: Rectangle {
                    property <bool> section-in-this-tab: section.tab-id == root.ribbon-tab;
                    clip: true;
                    height: 70px;
                    width: section-in-this-tab ? section-body.preferred-width + 13px : 0px;

                    section-body := VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: max(0px, parent.width - 13px);
                        height: parent.height;
                        padding: 0px;
                        spacing: 0px;

                        HorizontalLayout {
                            height: 56px;
                            padding-left: 4px;
                            padding-right: 0px;
                            spacing: 0px;
                            alignment: center;

                            for tool in root.custom-tab-tools: Rectangle {
                                property <bool> in-this-section: tool.tab-id == section.tab-id && tool.section-id == section.section-id;
                                clip: true;
                                width: (section-in-this-tab && in-this-section) ? tool-btn.preferred-width + 4px : 0px;

                                tool-btn := IconButton {
                                    x: 0px;
                                    width: self.preferred-width;
                                    icon: root.tool-icon-image(tool.action-id);
                                    label: tool.label;
                                    tooltip: tool.tooltip;
                                    tint: tool.tint;
                                    votes: tool.votes;
                                    vote-feedback: root.telemetry-enabled;
                                    clicked => { root.on-menu-action(tool.action-id); }
                                }
                            }

                            // User-authored manifests may still declare a
                            // section ahead of its tooling (built-ins no
                            // longer do — a test enforces it).
                            if section-in-this-tab && section.tool-count == 0: Text {
                                text: "Coming soon";
                                color: Theme.text-disabled;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            height: 14px;
                            text: section.label;
                            color: Theme.text-secondary;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Trailing group separator (mirrors GroupDivider).
                    Rectangle {
                        x: parent.width - 7px;
                        y: 3px;
                        width: 1px;
                        height: 64px;
                        background: Theme.border-color;
                        visible: section-in-this-tab;
                    }
                }
            }
        }
    }
    
    // Brush settings modal - positioned beneath clicked brush button
    brush-settings-modal := BrushSettingsModal {
        x: root.settings-modal-x;
        y: root.settings-modal-y;
        brush-name: root.settings-brush-name;
        brush-size: root.brush-size;
        brush-strength: root.brush-strength;
        brush-falloff: root.brush-falloff;
        
        size-changed(val) => { 
            root.brush-size = val;
            root.on-brush-size-changed(val);
        }
        strength-changed(val) => { 
            root.brush-strength = val;
            root.on-brush-strength-changed(val);
        }
        falloff-changed(val) => { 
            root.brush-falloff = val;
            root.on-brush-falloff-changed(val);
        }
    }
}
