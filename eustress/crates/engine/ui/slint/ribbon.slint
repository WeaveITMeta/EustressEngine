// ============================================================================
// Eustress Engine Studio - Ribbon Component
// Top toolbar with menus, tools, and play controls
// ============================================================================

import { HorizontalBox, VerticalBox, ScrollView, Slider } from "std-widgets.slint";
import { Theme, IconButton, ToolbarSeparator } from "theme.slint";

// An "Eustress Mode" entry for the Modes dropdown (id/name/icon-id pushed
// from Rust's ModeRegistry). `icon-id` is one of the small compile-time
// allowlisted names ("gear", "gavel") — resolved to an image below, never an
// arbitrary path. `has-submodes` shows an expand affordance in the dropdown;
// the submode rows themselves come from `SubmodeData` filtered by `mode-id`.
export struct ModeData {
    id: string,
    name: string,
    icon-id: string,
    has-submodes: bool,
    // Mode-selection-menu identity color (e.g. its Roblox BrickColor).
    // `has-menu-color: false` → fall back to default label styling.
    menu-color: color,
    has-menu-color: bool,
}

// One entry in a mode's secondary submenu (e.g. Military's six branches),
// filtered by `mode-id` when the dropdown expands that mode's row.
export struct SubmodeData {
    mode-id: string,
    id: string,
    name: string,
    // Per-submode identity color (e.g. Justice's Civil=white/Criminal=red,
    // or each Military branch's own color). `has-submode-color: false` →
    // fall back to the active-state highlight (accent when selected, else
    // secondary text) — mirrors `ModeData.menu-color`/`has-menu-color`.
    submode-color: color,
    has-submode-color: bool,
    // Discipline glyph (allowlisted archetype id, resolved by `tool-icon()`
    // below — e.g. mathematics="sigma", navy="anchor"). Empty = no icon.
    icon-id: string,
}

// One ribbon tab pill, fed from Rust so the active Mode can filter which
// tabs show (`RIBBON_TAB_TABLE` in slint_ui.rs mirrors this literal). Also
// used for a mode's CUSTOM tabs (beyond the 9 built-ins) — same shape, so
// the tab-strip rendering below needs no changes to show both.
export struct RibbonTabData {
    name: string,
    id: string,
    color: color,
}

// One section inside a mode's custom tab (mirrors PluginSectionData/
// PluginButtonData's flat-list-plus-filter pattern below).
export struct CustomTabSectionData {
    tab-id: string,
    section-id: string,
    label: string,
    // 0 = render a "Coming soon" placeholder instead of an empty group —
    // Rust precomputes this since Slint can't count a filtered subset inline.
    tool-count: int,
}
export struct CustomTabToolData {
    tab-id: string,
    section-id: string,
    label: string,
    tooltip: string,
    action-id: string,
    // Archetype glyph id (see `tool_metadata.rs` / `tool-icon()` below) and
    // a per-SECTION tint cycled through the theme palette by Rust — every
    // group reads tone-coherent while adjacent groups differ, matching the
    // built-in tabs' color rhythm (no settings-gear/single-accent monoculture).
    icon-id: string,
    tint: color,
    // Session-cumulative votes for this tool, so the button can show the
    // tally it has been promising in the toast.
    votes: int,
}

// Saved identity for multi-user quick switch
export struct SavedIdentityData {
    username: string,
    public-key-short: string,
    active: bool,
}

// One insertable class in the data-driven Insert dropdown. Fed from the
// Rust side (`insert_classes::build_catalog`) off the live ClassRegistry,
// filtered to classes that have a creatable template. `class-name` is the
// canonical ClassName string the click routes through
// `on-menu-action("insert:" + class-name)`; `show-header` marks the first
// row of each category so the loop can draw a heading above it.
export struct InsertClassData {
    class-name: string,
    category: string,
    display: string,
    show-header: bool,
}

// A plugin-contributed section (button group) on the "Plugins" tab, and a
// button within one. Fed from Rust (`TabRegistry`, populated by real
// `StudioPlugin`s via `PluginApi::add_tab_section`/`add_tab_button`) —
// mirrors `InsertClassData`'s flat-scalars-only shape (Slint's nested-
// models-in-structs support is uneven; two parallel flat lists, each button
// carrying its owning section/tab id, sidesteps that entirely). Every
// button routes through the SAME `on-plugin-action` callback the Insert
// dropdown and other hardcoded plugin buttons already use — clicking fires
// a `PluginActionEvent` on the Rust side, no per-button callback needed.
export struct PluginSectionData {
    tab-id: string,
    section-id: string,
    label: string,
}
export struct PluginButtonData {
    tab-id: string,
    section-id: string,
    label: string,
    tooltip: string,
    action-id: string,
}

// Floating brush settings modal that appears beneath toolbar buttons
component BrushSettingsModal inherits PopupWindow {
    in property <string> brush-name: "";
    in property <float> brush-size: 10.0;
    in property <float> brush-strength: 0.5;
    in property <string> brush-falloff: "smooth";
    
    callback size-changed(float);
    callback strength-changed(float);
    callback falloff-changed(string);
    
    width: 220px;
    
    Rectangle {
        background: Theme.dialog-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border-color;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.shadow-color;
        
        VerticalBox {
            padding: 12px;
            spacing: 10px;
            
            // Header
            Text {
                text: root.brush-name + " Settings";
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
            }
            
            Rectangle { height: 1px; background: Theme.border-color; }
            
            // Size slider
            VerticalBox {
                spacing: 4px;
                
                HorizontalBox {
                    Text {
                        text: "Size";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Math.round(root.brush-size);
                        color: Theme.text-primary;
                        font-size: 11px;
                        min-width: 30px;
                        horizontal-alignment: right;
                    }
                }
                
                Slider {
                    minimum: 1.0;
                    maximum: 100.0;
                    value: root.brush-size;
                    changed(val) => { root.size-changed(val); }
                }
            }
            
            // Strength slider
            VerticalBox {
                spacing: 4px;
                
                HorizontalBox {
                    Text {
                        text: "Strength";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Math.round(root.brush-strength * 100) + "%";
                        color: Theme.text-primary;
                        font-size: 11px;
                        min-width: 40px;
                        horizontal-alignment: right;
                    }
                }
                
                Slider {
                    minimum: 0.0;
                    maximum: 1.0;
                    value: root.brush-strength;
                    changed(val) => { root.strength-changed(val); }
                }
            }
            
            // Falloff selector
            VerticalBox {
                spacing: 4px;
                
                Text {
                    text: "Falloff";
                    color: Theme.text-secondary;
                    font-size: 11px;
                }
                
                HorizontalBox {
                    spacing: 4px;
                    
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;
                        background: root.brush-falloff == "linear" ? Theme.selection-background : Theme.button-background;
                        border-radius: 3px;
                        TouchArea { clicked => { root.falloff-changed("linear"); } }
                        Text {
                            text: "Linear";
                            color: Theme.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;
                        background: root.brush-falloff == "smooth" ? Theme.selection-background : Theme.button-background;
                        border-radius: 3px;
                        TouchArea { clicked => { root.falloff-changed("smooth"); } }
                        Text {
                            text: "Smooth";
                            color: Theme.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;
                        background: root.brush-falloff == "sharp" ? Theme.selection-background : Theme.button-background;
                        border-radius: 3px;
                        TouchArea { clicked => { root.falloff-changed("sharp"); } }
                        Text {
                            text: "Sharp";
                            color: Theme.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Grouped toolbar section with icon row + compact category label
component ToolGroup inherits Rectangle {
    in property <string> label: "";
    
    height: 70px;
    background: transparent;
    
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        
        // Icon row
        HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 4px;
            alignment: center;
            
            @children
        }
        
        // Category label
        Text {
            height: 14px;
            text: root.label;
            color: Theme.text-secondary;
            font-size: 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Vertical group divider with subtle line
component GroupDivider inherits Rectangle {
    width: 1px;
    height: 64px;
    background: Theme.border-color;
}

// Dropdown menu item — clickable row with label and shortcut
component DropdownItem inherits Rectangle {
    in property <string> label: "";
    in property <string> shortcut: "";
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    background: item-touch.has-hover && root.enabled ? Theme.button-hover : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    item-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;

        Image {
            width: 16px;
            height: 16px;
            source: root.icon;
            image-fit: contain;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text-primary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.shortcut != "": Text {
            text: root.shortcut;
            color: Theme.text-secondary;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

// Dropdown section header
component DropdownHeader inherits Rectangle {
    in property <string> label: "";
    
    height: 20px;
    
    HorizontalLayout {
        padding-left: 10px;
        
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 9px;
            font-weight: 600;
            vertical-alignment: center;
            letter-spacing: 0.5px;
        }
    }
}

// Dropdown separator line
component DropdownSeparator inherits Rectangle {
    height: 5px;
    
    Rectangle {
        y: 2px;
        height: 1px;
        x: 8px;
        width: parent.width - 16px;
        background: Theme.border-color;
    }
}

export component Ribbon inherits Rectangle {
    // Properties
    in property <string> current-tool: "select";
    // Active terrain brush id ("raise", "lower", ...) and sculpt-mode flag,
    // pushed from Rust off TerrainBrush / TerrainMode. The Terrain tab's
    // brush buttons had no `selected` binding at all, so an armed brush
    // looked identical to an unarmed one.
    in property <string> current-terrain-brush: "";
    in property <bool> terrain-edit-mode: false;
    /// Data-driven Insert-menu catalog — every creatable registered class,
    /// grouped by category, fed from Rust (`set_insert_classes`). Drives
    /// the dynamic section of the Insert dropdown below the pinned items.
    in property <[InsertClassData]> insert-classes: [];
    /// Plugins ribbon tab content — flattened section/button lists fed from
    /// `TabRegistry` each sync tick (mirrors `insert-classes` above). See
    /// `PluginSectionData`/`PluginButtonData` for why this is two flat
    /// lists instead of a nested model.
    in property <[PluginSectionData]> plugin-sections: [];
    in property <[PluginButtonData]> plugin-buttons: [];
    /// Stable ID of the currently-active modal tool (Smart Edit / Pattern /
    /// Mirror). Empty when no modal tool is running. Drives the per-button
    /// `selected:` highlight on the CAD tab so users can see which tool is
    /// armed without hunting for the floating bar/panel.
    in property <string> active-modal-tool-id: "";
    in property <string> transform-mode: "world";
    in property <string> play-state: "stopped";
    in property <bool> has-unsaved-changes: false;
    
    // Panel visibility (bound from main)
    in-out property <bool> show-explorer: true;
    in-out property <bool> show-properties: true;
    in-out property <bool> show-output: true;
    in-out property <bool> show-assets: false;
    in-out property <bool> show-collaboration: false;
    in-out property <bool> show-command-bar: false;

    // Account and sync state
    in property <string> account-name: "Guest";
    in property <string> account-status: "Logged out";
    in property <string> sync-status: "Local-first";
    in property <string> session-hours: "0h 0m";
    in property <string> total-hours: "0h";
    in property <[SavedIdentityData]> saved-identities: [];
    callback on-sign-out();
    callback on-switch-identity(string);    // username to switch to
    callback on-remove-identity(string);    // username to remove from saved list

    // Display unit (status-bar dropdown).
    // The badge label is the unit's canonical symbol ("m" / "cm" / "mm"
    // / "ft" / "in" / "studs"); the Bevy side owns the DisplayUnit
    // Resource and re-renders the Properties panel whenever this
    // changes. The Slint side is read-only for the value and emits
    // `on-set-display-unit` with the new symbol on user click.
    in property <string> display-unit-symbol: "m";
    callback on-set-display-unit(string);

    // Update system
    in property <bool> update-available: false;
    in property <string> update-version: "";
    in property <string> update-status: "";  // "", "downloading", "ready"
    in property <int> update-progress: 0;    // 0-100 download progress
    callback on-update-clicked();

    // Dynamic keyboard shortcuts — Bevy writes these on startup + on every
    // Keybindings change so the ribbon subtitles stay in sync with File >
    // Settings > Keybindings. Empty string hides the subtitle.
    //
    // These are the ONLY source for a shortcut label anywhere in the ribbon
    // or its dropdown menus: a hardcoded "Ctrl+N" next to a menu item starts
    // lying the moment the user rebinds it, and the lie is invisible because
    // nothing cross-checks the two. Every item that shows a shortcut binds
    // one of these instead.
    in property <string> shortcut-new: "";
    in property <string> shortcut-new-universe: "";
    in property <string> shortcut-open: "";
    in property <string> shortcut-save: "";
    in property <string> shortcut-save-as: "";
    in property <string> shortcut-publish-universe: "";
    in property <string> shortcut-publish-space: "";
    in property <string> shortcut-undo: "";
    in property <string> shortcut-redo: "";
    in property <string> shortcut-cut: "";
    in property <string> shortcut-copy: "";
    in property <string> shortcut-paste: "";
    in property <string> shortcut-duplicate: "";
    in property <string> shortcut-delete: "";
    in property <string> shortcut-select: "";
    in property <string> shortcut-move: "";
    in property <string> shortcut-scale: "";
    in property <string> shortcut-rotate: "";
    in property <string> shortcut-group: "";
    in property <string> shortcut-ungroup: "";
    in property <string> shortcut-lock: "";
    in property <string> shortcut-unlock: "";
    in property <string> shortcut-anchor: "";
    in property <string> shortcut-focus: "";
    // Modal build tools + play controls. Bound rather than hardcoded so a
    // remap in the Keyboard Shortcuts dialog reaches the button subtitles —
    // a literal here is correct only until the user rebinds it.
    in property <string> shortcut-gap-fill: "";
    in property <string> shortcut-resize-align: "";
    in property <string> shortcut-edge-align: "";
    in property <string> shortcut-part-swap: "";
    in property <string> shortcut-model-reflect: "";
    in property <string> shortcut-linear-array: "";
    in property <string> shortcut-radial-array: "";
    in property <string> shortcut-grid-array: "";
    in property <string> shortcut-path-array: "";
    in property <string> shortcut-play-character: "";
    in property <string> shortcut-play-solo: "";
    in property <string> shortcut-pause-resume: "";
    in property <string> shortcut-stop-play: "";

    // Bliss node state
    in property <string> bliss-balance: "0.00";
    in property <string> bliss-balance-short: "0.00";
    in property <string> bliss-pending: "+0.0 pts today";
    in property <string> bliss-node-mode: "Light";  // "Light" or "Full"
    in property <string> bliss-bonus: "1.0x";
    in property <bool> bliss-enabled: true;
    callback on-bliss-set-light();
    callback on-bliss-set-full();
    callback on-bliss-toggle-enabled();
    
    // File callbacks
    callback on-new-universe();
    callback on-new-scene();
    callback on-open-scene();
    callback on-save-scene();
    callback on-save-scene-as();
    callback on-import-asset();
    callback on-import-roblox-place();
    callback on-publish-universe();
    callback on-publish-space();
    callback on-exit();
    
    // Edit callbacks
    callback on-undo();
    callback on-redo();
    callback on-copy();
    callback on-cut();
    callback on-paste();
    callback on-delete();
    callback on-duplicate();
    callback on-select-all();
    callback on-group();
    callback on-ungroup();
    
    // Tool callbacks
    callback on-select-tool(string);
    callback on-set-transform-mode(string);
    /// Activate a modal tool by id — routed to ActivateModalToolEvent
    /// on the Rust side (see `modal_tool::ModalToolRegistry`).
    callback on-activate-modal-tool(string);
    
    // Play callbacks
    callback on-play-solo();
    callback on-play-with-character();
    callback on-pause();
    callback on-stop();
    callback on-show-simulation-settings();
    
    // View callbacks
    callback on-focus-selection();
    
    // Network callbacks
    callback on-start-server();
    callback on-stop-server();
    callback on-show-forge-connect();
    callback on-show-network-panel();
    callback on-show-stress-test();
    
    // Data callbacks
    callback on-show-global-sources();
    callback on-show-domains();
    callback on-show-global-variables();
    callback on-show-sync-domain();
    callback on-add-data-source(string);
    
    // Terrain callbacks
    callback on-spawn-terrain(string);
    callback on-toggle-terrain-edit();
    callback on-set-terrain-brush(string);
    callback on-import-heightmap();
    callback on-export-heightmap();
    callback on-brush-size-changed(float);
    callback on-brush-strength-changed(float);
    callback on-brush-falloff-changed(string);
    
    // Brush settings properties
    in-out property <float> brush-size: 10.0;
    in-out property <float> brush-strength: 0.5;
    in-out property <string> brush-falloff: "smooth";
    in-out property <bool> show-brush-settings: false;
    in-out property <string> settings-brush-name: "";
    in-out property <length> settings-modal-x: 0px;
    in-out property <length> settings-modal-y: 0px;
    
    // Plugin callbacks
    callback on-plugin-action(string);
    
    // Other callbacks
    callback on-toggle-command-bar();
    callback on-show-keybindings();
    callback on-show-about();
    callback on-show-soul-settings();
    callback on-show-settings();
    callback on-open-url(string);
    callback on-open-login();
    callback on-menu-action(string);
    
    // Active ribbon tab: "home", "model", "ui", "terrain", "test", "mindspace"
    in-out property <string> ribbon-tab: "home";

    // Eustress Modes — the loaded mode list (pushed from Rust's
    // ModeRegistry), the active mode id, and the ribbon-tab subset the
    // active mode filters to. `select-mode` fires the Rust round-trip that
    // swaps the tab set + default Layout + accent overlay.
    in property <[ModeData]> available-modes: [];
    in-out property <string> active-mode-id: "engineering";
    // Pushed alongside active-mode-id so the menu-bar icon never needs to
    // search `available-modes` inside a binding (Slint bindings are pure
    // expressions, not loops).
    in property <string> active-mode-icon-id: "gear";
    // The active mode's display name — shown as the menu-bar button label
    // (the button reads the current mode, e.g. "Engineering", not "Mode").
    in property <string> active-mode-name: "Mode";
    // The active mode's stable identity color (its `menu-color`, resolved
    // the same way as each `available-modes` row — see
    // `sync_active_mode_to_slint`). Drives the collapsed menu-bar icon/label
    // so e.g. Justice reads khaki there too, not the live amber accent ring.
    in property <color> active-mode-menu-color: #ffffff;
    in property <[RibbonTabData]> ribbon-tabs: [];
    callback select-mode(string);

    // Submodes — a secondary menu on modes that have one (Justice's
    // Civil/Criminal/Judge, Military's six branches). `select-submode`
    // activates the PARENT mode and records which submode is active.
    in property <[SubmodeData]> available-submodes: [];
    in-out property <string> active-submode-id: "";
    callback select-submode(string, string); // (mode-id, submode-id)
    // Which mode's submode list is currently expanded in the dropdown
    // (empty = none expanded). Local UI state, not persisted.
    property <string> expanded-mode-id: "";

    // Custom tabs (beyond the 9 built-ins) — a mode's own Product/
    // Manufacturing/Notebook/etc. Pushed alongside ribbon-tabs whenever the
    // active mode changes; already filtered to the active mode.
    in property <[CustomTabSectionData]> custom-tab-sections: [];
    in property <[CustomTabToolData]> custom-tab-tools: [];
    // Mirrors the main window's usage-telemetry switch. Vote affordances on
    // tool buttons appear only while clicks are genuinely being recorded.
    in property <bool> telemetry-enabled: true;
    // Per-tool COMPOSED icon (base archetype + action badge, generated by
    // scripts/gen_tool_icons.py into assets/icons/tools/<id>.svg) — resolved
    // by Rust at runtime with a cache, because 1,400+ compile-time
    // @image-url branches is not a thing. Falls back Rust-side to the
    // archetype glyph, then the settings gear.
    pure callback tool-icon-image(string) -> image;

    // Resolve a mode's allowlisted icon-id to its image. Kept as a function
    // (not a path string) so manifests can never reference arbitrary files —
    // unknown ids fall back to the gear.
    pure function mode-icon(id: string) -> image {
        if id == "gavel" { return @image-url("../../assets/icons/ui/gavel.svg"); }
        if id == "gamepad" { return @image-url("../../assets/icons/ui/gamepad.svg"); }
        if id == "bridge" { return @image-url("../../assets/icons/ui/bridge.svg"); }
        if id == "scales" { return @image-url("../../assets/icons/ui/scales.svg"); }
        if id == "factory" { return @image-url("../../assets/icons/ui/factory.svg"); }
        if id == "mortarboard" { return @image-url("../../assets/icons/ui/mortarboard.svg"); }
        if id == "briefcase" { return @image-url("../../assets/icons/ui/briefcase.svg"); }
        if id == "health" { return @image-url("../../assets/icons/ui/health.svg"); }
        if id == "military" { return @image-url("../../assets/icons/ui/military.svg"); }
        if id == "capitol" { return @image-url("../../assets/icons/ui/capitol.svg"); }
        if id == "handshake" { return @image-url("../../assets/icons/ui/handshake.svg"); }
        return @image-url("../../assets/icons/ui/settings.svg");
    }

    // Resolve a tool/submode archetype icon-id to its image — the allowlist
    // mirrors `TOOL_ICON_IDS` in the generated `tool_metadata.rs` (same
    // never-an-arbitrary-path posture as `mode-icon()` above; unknown ids
    // fall back to the settings gear, a cosmetic-only failure).
    pure function tool-icon(id: string) -> image {
        if id == "anchor" { return @image-url("../../assets/icons/ui/anchor.svg"); }
        if id == "array-grid" { return @image-url("../../assets/icons/ui/array-grid.svg"); }
        if id == "array-radial" { return @image-url("../../assets/icons/ui/array-radial.svg"); }
        if id == "atom" { return @image-url("../../assets/icons/ui/atom.svg"); }
        if id == "block" { return @image-url("../../assets/icons/ui/block.svg"); }
        if id == "book" { return @image-url("../../assets/icons/ui/book.svg"); }
        if id == "brain" { return @image-url("../../assets/icons/ui/brain.svg"); }
        if id == "briefcase" { return @image-url("../../assets/icons/ui/briefcase.svg"); }
        if id == "build" { return @image-url("../../assets/icons/ui/build.svg"); }
        if id == "building" { return @image-url("../../assets/icons/ui/building.svg"); }
        if id == "cad-ball" { return @image-url("../../assets/icons/ui/cad-ball.svg"); }
        if id == "cad-frame" { return @image-url("../../assets/icons/ui/cad-frame.svg"); }
        if id == "cad-slide" { return @image-url("../../assets/icons/ui/cad-slide.svg"); }
        if id == "cad-solve" { return @image-url("../../assets/icons/ui/cad-solve.svg"); }
        if id == "calc" { return @image-url("../../assets/icons/ui/calc.svg"); }
