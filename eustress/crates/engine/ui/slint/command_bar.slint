// ============================================================================
// Eustress Engine Studio - Command Bar
// Docked at the bottom of the engine window for executing Rune/Luau scripts.
// Output goes to the existing Output panel, not rendered here.
//
// Multi-line: pasted scripts arrive intact. Plain Enter submits (REPL feel),
// Shift+Enter inserts a newline.
// ============================================================================

import { HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct CommandSuggestion {
    id: string,
    label: string,
    description: string,
    shortcut: string,
    category: string,
}

export struct ScriptOutputEntry {
    text: string,
    is-error: bool,
    timestamp: string,
}

export component CommandBar inherits Rectangle {
    in-out property <string> command-text: "";
    in-out property <string> language: "rune";

    out property <bool> input-has-focus: input-area.has-focus;

    callback on-execute(/* language */ string, /* script */ string);
    callback on-close();
    callback on-text-changed(string);
    callback on-select-suggestion(int);
    callback on-clear-output();

    // The language's one tint: Rune orange, Luau the accent text blue.
    property <color> lang-tint: root.language == "luau" ? Theme.text-accent : Theme.accent-orange;

    width: 100%;
    // Bar grows with content up to 200px, then scrolls. Single-line use
    // collapses to the original ~28px height.
    height: max(28px, min(200px, input-area.preferred-height + 6px));
    background: Theme.header-background;
    border-width: 1px;
    border-color: Theme.border-color;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 4px;

        // Language selector: a chip that flips Rune and Luau. Fixed width,
        // top-aligned so it stays on the first line as the input grows.
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 54px;
                height: 22px;
                background: lang-touch.pressed ? root.lang-tint.with-alpha(0.26)
                    : lang-touch.has-hover ? root.lang-tint.with-alpha(0.2)
                    : root.lang-tint.with-alpha(0.12);
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.lang-tint.with-alpha(0.45);
                animate background { duration: 100ms; }

                lang-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.language = root.language == "luau" ? "rune" : "luau";
                    }
                }

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 6px;
                    spacing: 4px;
                    Text {
                        text: root.language == "luau" ? "Luau" : "Rune";
                        color: root.lang-tint;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 9px;
                            height: 9px;
                            source: @image-url("../../assets/icons/ui/swap.svg");
                            image-fit: contain;
                            colorize: root.lang-tint.with-alpha(0.8);
                        }
                    }
                }
            }
        }

        // The input field: a prompt icon inside the field on the left, then
        // the multi-line input, which stretches to fill the space before the
        // Run button. Focus draws the selection cyan ring.
        Rectangle {
            horizontal-stretch: 1;
            border-width: 1px;
            border-color: input-area.has-focus ? Theme.accent-cyan : Theme.input-border;
            background: Theme.input-background;
            border-radius: Theme.radius-sm;

            Image {
                x: 7px;
                y: 5px;
                width: 12px;
                height: 12px;
                source: @image-url("../../assets/icons/ui/terminal.svg");
                image-fit: contain;
                colorize: input-area.has-focus ? root.lang-tint : Theme.text-secondary;
            }

            // Placeholder while empty.
            if root.command-text == "": Text {
                x: 26px;
                y: 2px;
                height: 18px;
                width: parent.width - 32px;
                text: root.language == "luau"
                    ? "Run Luau in the open Space. Enter runs, Shift+Enter adds a line."
                    : "Run Rune in the open Space. Enter runs, Shift+Enter adds a line.";
                color: Theme.text-disabled;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            scroll := ScrollView {
                x: 26px;
                y: 2px;
                width: parent.width - 30px;
                height: parent.height - 4px;
                viewport-width: self.width;
                viewport-height: max(self.height, input-area.preferred-height);

                input-area := TextInput {
                    width: parent.width;
                    color: Theme.text-primary;
                    selection-background-color: Theme.accent-cyan.with-alpha(0.35);
                    font-size: 12px;
                    text <=> root.command-text;
                    single-line: false;
                    wrap: word-wrap;

                    edited => { root.on-text-changed(self.text); }

                    key-pressed(ev) => {
                        // Plain Enter submits (REPL convention). Shift+Enter
                        // falls through and inserts a newline so multi-line
                        // editing works normally. Ctrl+Enter also submits as
                        // a power-user fallback. Pasted multi-line content
                        // bypasses this — paste doesn't fire key-pressed.
                        if ev.text == Key.Return {
                            if ev.modifiers.shift {
                                return reject;
                            }
                            if self.text != "" {
                                root.on-execute(root.language, self.text);
                                root.command-text = "";
                            }
                            return accept;
                        }
                        reject
                    }
                }
            }
        }

        // Run button: fixed width, bottom-pinned so it stays by the last
        // line as the input grows taller with multi-line content. Dimmed
        // while there is nothing to run.
        VerticalLayout {
            alignment: end;
            Rectangle {
                width: 26px;
                height: 22px;
                background: root.command-text == "" ? Theme.input-background
                    : run-touch.pressed ? Theme.accent-green.with-alpha(0.32)
                    : run-touch.has-hover ? Theme.accent-green.with-alpha(0.24)
                    : Theme.accent-green.with-alpha(0.14);
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.command-text == "" ? Theme.input-border : Theme.accent-green.with-alpha(0.5);
                animate background { duration: 100ms; }

                run-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.command-text != "" {
                            root.on-execute(root.language, root.command-text);
                            root.command-text = "";
                        }
                    }
                }

                Image {
                    width: 11px;
                    height: 11px;
                    source: @image-url("../../assets/icons/ui/play.svg");
                    image-fit: contain;
                    colorize: root.command-text == "" ? Theme.text-disabled : Theme.accent-green;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}
