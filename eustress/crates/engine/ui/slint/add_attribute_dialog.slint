// ============================================================================
// Add / Edit Attribute Dialog. Law 1 chrome: DialogScrim > DialogCard >
// DialogFooter (dialog_kit.slint). Custom in-card type list (no std ComboBox)
// so it:
//   • never overflows the card (the card sizes to its content, so it grows
//     while the list is open),
//   • is scroll-captured (scrolling the list never zooms the viewport),
//   • keeps Cancel/Add pinned and visible.
// Rows are left-aligned labels + value fields. Enter in a field confirms once
// there is a name; Escape cancels.
// ============================================================================

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton } from "dialog_kit.slint";

// The label to the left of a field.
component FieldLabel inherits Text {
    width: 64px;
    color: Theme.text-secondary;
    font-size: Theme.font-sm;
    font-weight: 600;
    vertical-alignment: center;
    horizontal-alignment: left;
}

export component AddAttributeDialog inherits Rectangle {
    in property <bool> is-edit: false;
    in-out property <string> attr-name: "";
    in-out property <string> attr-type: "String";
    in-out property <string> attr-value: "";
    in property <[string]> type-options: [];

    callback on-confirm(string, string, string);
    callback on-cancel();

    property <bool> type-open: false;

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(440px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/label.svg");
            title: root.is-edit ? "Edit attribute" : "Add attribute";
            subtitle: root.is-edit ? "Change the value of " + root.attr-name : "A custom value on the selected object";
            close => { root.on-cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        if root.type-open {
                            root.type-open = false;
                        } else {
                            root.on-cancel();
                        }
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 10px;
                        alignment: start;

                        // Name
                        HorizontalLayout {
                            spacing: 10px;
                            FieldLabel { text: "Name"; }
                            name-edit := LineEdit {
                                placeholder-text: "Attribute name";
                                text <=> root.attr-name;
                                enabled: !root.is-edit;
                                init => { if !root.is-edit { self.focus(); } }
                                accepted(t) => {
                                    if root.attr-name != "" {
                                        root.on-confirm(root.attr-name, root.attr-type, root.attr-value);
                                    }
                                }
                            }
                        }

                        // Type (custom dropdown) and its list; the gap under the
                        // field only exists while the list is open.
                        VerticalLayout {
                            spacing: root.type-open ? 6px : 0px;

                            // Type (custom dropdown)
                            HorizontalLayout {
                                spacing: 10px;
                                FieldLabel { text: "Type"; }
                                Rectangle {
                                    height: 32px;
                                    border-radius: Theme.radius-sm;
                                    background: type-field-ta.has-hover ? Theme.button-hover : Theme.input-background;
                                    border-width: 1px;
                                    border-color: root.type-open ? Theme.accent-cyan : Theme.input-border;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text {
                                            text: root.attr-type;
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: root.type-open
                                                    ? @image-url("../../assets/icons/ui/chevron-up.svg")
                                                    : @image-url("../../assets/icons/ui/chevron-down.svg");
                                                image-fit: contain;
                                                colorize: root.type-open ? Theme.accent-cyan : Theme.text-secondary;
                                            }
                                        }
                                    }
                                    type-field-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.type-open = !root.type-open; }
                                    }
                                }
                            }

                            // Inline type list: scroll-captured (ScrollView), in-card.
                            // ALWAYS present but visibility/height-gated (NOT `if type-open`)
                            // so selecting a row, which sets `type-open = false` from a row
                            // TouchArea INSIDE this block, only hides the list instead of
                            // destroying the element mid-handler (that self-destruction is
                            // the Slint "Recursion detected" crash class).
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle { width: 64px; }
                                Rectangle {
                                    visible: root.type-open;
                                    height: root.type-open ? 150px : 0px;
                                    background: Theme.input-background;
                                    border-radius: Theme.radius-sm;
                                    border-width: root.type-open ? 1px : 0px;
                                    border-color: Theme.input-border;
                                    clip: true;
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 3px;
                                            spacing: 1px;
                                            for t in root.type-options: Rectangle {
                                                height: 26px;
                                                border-radius: Theme.radius-sm;
                                                background: t == root.attr-type ? Theme.accent-cyan.with-alpha(0.14)
                                                    : trow-ta.has-hover ? Theme.button-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: t;
                                                        color: t == root.attr-type ? Theme.accent-cyan : Theme.text-primary;
                                                        font-size: 12px;
                                                        font-weight: t == root.attr-type ? 600 : 400;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    if t == root.attr-type: VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            width: 12px;
                                                            height: 12px;
                                                            source: @image-url("../../assets/icons/ui/check.svg");
                                                            image-fit: contain;
                                                            colorize: Theme.accent-cyan;
                                                        }
                                                    }
                                                }
                                                trow-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.attr-type = t;
                                                        root.type-open = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Value
                        HorizontalLayout {
                            spacing: 10px;
                            FieldLabel { text: "Value"; }
                            value-edit := LineEdit {
                                placeholder-text: "Initial value";
                                text <=> root.attr-value;
                                init => { if root.is-edit { self.focus(); } }
                                accepted(t) => {
                                    if root.attr-name != "" {
                                        root.on-confirm(root.attr-name, root.attr-type, root.attr-value);
                                    }
                                }
                            }
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-cancel(); }
                        }
                        KitButton {
                            text: root.is-edit ? "Save" : "Add";
                            kind: "primary";
                            enabled: root.attr-name != "";
                            clicked => { root.on-confirm(root.attr-name, root.attr-type, root.attr-value); }
                        }
                    }
                }
            }
        }
    }
}
