// ============================================================================
// Eustress Studio: Services browser panel
// Browsable catalog of the default services every Space includes. Each
// service shows a description, its properties, and a link to its /learn page
// on eustress.dev.
//
// A docked tab panel (not a modal): the shared FloatingPanelHeader on top,
// a sidebar of NavItems grouped by category, and the detail on the right.
//
// Table of Contents:
//   1. Data Structures: ServiceBrowserEntry, ServicePropertySummary
//   2. ServiceLook: icon and tint per service, category and type
//   3. ServiceCard: detail view for a selected service
//   4. ServicesBrowserPanel: main panel with sidebar + detail
// ============================================================================

import { ScrollView } from "std-widgets.slint";
import { Theme, FloatingPanelHeader } from "theme.slint";
import { KitDivider, KitButton, KitSectionLabel, SettingsGroup, NavItem } from "dialog_kit.slint";

// ============================================================================
// 1. Data Structures
// ============================================================================

// Summary of a single property within a service
export struct ServicePropertySummary {
    name: string,
    property-type: string,   // "float", "bool", "string", "color", "enum", "int"
    default-value: string,
    description: string,
}

// Full entry for a service in the browser
export struct ServiceBrowserEntry {
    name: string,               // "Workspace", "Lighting", etc.
    icon-text: string,          // Emoji or unicode symbol for the service icon
    icon-color: color,          // Color tint for the icon circle
    class-name: string,         // ECS class name: "Workspace", "Lighting", etc.
    category: string,           // "Core", "Player", "Data", "Scripting", "Rendering"
    summary: string,            // One-line summary
    description: string,        // Multi-paragraph description
    learn-url: string,          // URL path: "/learn/services/workspace"
    property-count: int,
    properties: [ServicePropertySummary],
}

// ============================================================================
// 2. ServiceLook: icons and tints
// ============================================================================
// The host sends an emoji in `icon-text`, which renders blank in the default
// font, so the panel draws a UI icon chosen by class name instead. Tints come
// from the `cat-*` tokens only (Law 3); the host's `icon-color` is not drawn.

global ServiceLook {
    pure public function icon(class-name: string) -> image {
        return class-name == "Workspace" ? @image-url("../../assets/icons/ui/globe.svg")
            : class-name == "Lighting" ? @image-url("../../assets/icons/ui/sun.svg")
            : class-name == "Chat" ? @image-url("../../assets/icons/ui/send.svg")
            : class-name == "Players" ? @image-url("../../assets/icons/ui/users.svg")
            : class-name == "StarterPlayer" ? @image-url("../../assets/icons/ui/user.svg")
            : class-name == "StarterGui" ? @image-url("../../assets/icons/ui/screen.svg")
            : class-name == "StarterPack" ? @image-url("../../assets/icons/ui/briefcase.svg")
            : class-name == "Teams" ? @image-url("../../assets/icons/ui/flag.svg")
            : class-name == "ReplicatedStorage" ? @image-url("../../assets/icons/ui/package.svg")
            : class-name == "ServerStorage" ? @image-url("../../assets/icons/ui/lock.svg")
            : class-name == "ServerScriptService" ? @image-url("../../assets/icons/ui/server.svg")
            : class-name == "SoulService" ? @image-url("../../assets/icons/ui/brain.svg")
            : class-name == "MaterialService" ? @image-url("../../assets/icons/ui/palette.svg")
            : class-name == "SoundService" ? @image-url("../../assets/icons/ui/audio.svg")
            : class-name == "AdornmentService" ? @image-url("../../assets/icons/ui/sparkle.svg")
            : @image-url("../../assets/icons/ui/settings.svg");
    }

    pure public function category-tint(category: string) -> color {
        return category == "Core" ? Theme.cat-parts
            : category == "Player" ? Theme.cat-structure
            : category == "Data" ? Theme.cat-constraint
            : category == "Scripting" ? Theme.cat-modify
            : Theme.cat-data;
    }

    pure public function type-tint(property-type: string) -> color {
        return property-type == "bool" ? Theme.cat-structure
            : property-type == "float" || property-type == "int" ? Theme.cat-parts
            : property-type == "string" ? Theme.cat-constraint
            : property-type == "color" ? Theme.cat-modify
            : Theme.cat-data;
    }
}

// A small tinted label: a category or a property type.
component TintChip inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <bool> mono: false;

    width: chip-text.preferred-width + 12px;
    height: 18px;
    border-radius: Theme.radius-sm;
    background: root.tint.with-alpha(0.14);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.35);

    chip-text := Text {
        text: root.text;
        color: root.tint;
        font-size: 10px;
        font-weight: 600;
        font-family: root.mono ? "Cascadia Code, Consolas, monospace" : "";
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One property: name, type and default on the first line, what it does
// under them. `divider` draws the rule above it.
component PropertyRow inherits VerticalLayout {
    in property <ServicePropertySummary> prop;
    in property <bool> divider: true;

    spacing: 0;

    if root.divider: KitDivider { }

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.prop.name;
                color: Theme.text-accent;
                font-size: 12px;
                font-weight: 600;
                font-family: "Cascadia Code, Consolas, monospace";
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                TintChip {
                    text: root.prop.property-type;
                    tint: ServiceLook.type-tint(root.prop.property-type);
                    mono: true;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.prop.default-value;
                color: Theme.text-secondary;
                font-size: 11px;
                font-family: "Cascadia Code, Consolas, monospace";
                vertical-alignment: center;
            }
        }

        if root.prop.description != "": Text {
            text: root.prop.description;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
}

// ============================================================================
// 3. ServiceCard: detail view for a selected service
// ============================================================================

component ServiceCard inherits Rectangle {
    in property <ServiceBrowserEntry> service;
    callback open-learn-url(string);

    property <color> tint: ServiceLook.category-tint(root.service.category);

    background: transparent;

    ScrollView {
        VerticalLayout {
            padding: 18px;
            spacing: 14px;
            alignment: start;

            // ---- Header: icon disc, name, category and class, docs link ----
            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: root.tint.with-alpha(0.16);
                        border-width: 1px;
                        border-color: root.tint.with-alpha(0.4);

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 22px;
                            height: 22px;
                            source: ServiceLook.icon(root.service.class-name);
                            image-fit: contain;
                            colorize: root.tint;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    alignment: center;

                    Text {
                        text: root.service.name;
                        color: Theme.text-primary;
                        font-size: 17px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        TintChip {
                            text: root.service.category;
                            tint: root.tint;
                        }

                        Text {
                            text: root.service.class-name;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-family: "Cascadia Code, Consolas, monospace";
                            vertical-alignment: center;
                        }
                    }
                }

                if root.service.learn-url != "": VerticalLayout {
                    alignment: center;
                    KitButton {
                        text: "Documentation";
                        has-icon: true;
                        icon: @image-url("../../assets/icons/ui/book.svg");
                        clicked => { root.open-learn-url(root.service.learn-url); }
                    }
                }
            }

            KitDivider { }

            // ---- Summary and description ----
            Text {
                text: root.service.summary;
                color: Theme.text-primary;
                font-size: 12px;
                wrap: word-wrap;
            }

            if root.service.description != "": Text {
                text: root.service.description;
                color: Theme.text-secondary;
                font-size: 11px;
                wrap: word-wrap;
            }

            // ---- Properties ----
            if root.service.properties.length > 0: SettingsGroup {
                title: "PROPERTIES  " + root.service.property-count;

                for prop[i] in root.service.properties: PropertyRow {
                    prop: prop;
                    divider: i > 0;
                }
            }
        }
    }
}

// ============================================================================
// 4. ServicesBrowserPanel: main component
// ============================================================================

export component ServicesBrowserPanel inherits Rectangle {
    // ---- Data ----
    in property <[ServiceBrowserEntry]> services: [];
    in-out property <int> selected-index: 0;

    // ---- Callbacks ----
    callback open-service-url(string);

    background: Theme.panel-background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Header ----
        FloatingPanelHeader {
            icon: @image-url("../../assets/icons/ui/server.svg");
            title: "Services";
            subtitle: root.services.length + " services in every Space";
            closable: false;
        }

        KitDivider { }

        // ---- Content: sidebar + detail ----
        content := Rectangle {
            vertical-stretch: 1;

            // Sidebar
            sidebar := Rectangle {
                x: 0px;
                y: 0px;
                width: 190px;
                height: parent.height;
                background: Theme.background-primary.with-alpha(0.35);

                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 0px;
                        alignment: start;

                        // One heading and one filtered list per category.
                        // A row outside its category is zero-height.
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            KitSectionLabel { text: "CORE"; }
                        }
                        for service[idx] in root.services: Rectangle {
                            visible: service.category == "Core";
                            height: service.category == "Core" ? 34px : 0px;
                            NavItem {
                                y: 1px;
                                width: parent.width;
                                icon: ServiceLook.icon(service.class-name);
                                text: service.name;
                                selected: idx == root.selected-index;
                                clicked => { root.selected-index = idx; }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-top: 12px;
                            padding-bottom: 4px;
                            KitSectionLabel { text: "PLAYER"; }
                        }
                        for service[idx] in root.services: Rectangle {
                            visible: service.category == "Player";
                            height: service.category == "Player" ? 34px : 0px;
                            NavItem {
                                y: 1px;
                                width: parent.width;
                                icon: ServiceLook.icon(service.class-name);
                                text: service.name;
                                selected: idx == root.selected-index;
                                clicked => { root.selected-index = idx; }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-top: 12px;
                            padding-bottom: 4px;
                            KitSectionLabel { text: "DATA"; }
                        }
                        for service[idx] in root.services: Rectangle {
                            visible: service.category == "Data";
                            height: service.category == "Data" ? 34px : 0px;
                            NavItem {
                                y: 1px;
                                width: parent.width;
                                icon: ServiceLook.icon(service.class-name);
                                text: service.name;
                                selected: idx == root.selected-index;
                                clicked => { root.selected-index = idx; }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-top: 12px;
                            padding-bottom: 4px;
                            KitSectionLabel { text: "SCRIPTING"; }
                        }
                        for service[idx] in root.services: Rectangle {
                            visible: service.category == "Scripting";
                            height: service.category == "Scripting" ? 34px : 0px;
                            NavItem {
                                y: 1px;
                                width: parent.width;
                                icon: ServiceLook.icon(service.class-name);
                                text: service.name;
                                selected: idx == root.selected-index;
                                clicked => { root.selected-index = idx; }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-top: 12px;
                            padding-bottom: 4px;
                            KitSectionLabel { text: "RENDERING"; }
                        }
                        for service[idx] in root.services: Rectangle {
                            visible: service.category == "Rendering";
                            height: service.category == "Rendering" ? 34px : 0px;
                            NavItem {
                                y: 1px;
                                width: parent.width;
                                icon: ServiceLook.icon(service.class-name);
                                text: service.name;
                                selected: idx == root.selected-index;
                                clicked => { root.selected-index = idx; }
                            }
                        }
                    }
                }
            }

            // Drag handle to resize the sidebar: a 5px grip drawn as a 1px
            // rule that lights up in the selection cyan while hovered.
            Rectangle {
                x: sidebar.width;
                y: 0px;
                width: 5px;
                height: parent.height;
                background: transparent;

                Rectangle {
                    x: 0px;
                    width: splitter-touch.has-hover || splitter-touch.pressed ? 3px : 1px;
                    height: parent.height;
                    background: splitter-touch.has-hover || splitter-touch.pressed
                        ? Theme.accent-cyan.with-alpha(0.6) : Theme.ribbon-separator;
                }

                splitter-touch := TouchArea {
                    mouse-cursor: col-resize;
                    // Capped at 40% of the content area (`content`, not this
                    // 5px grip, whose 40% would pin every drag to 120px).
                    moved => {
                        sidebar.width = max(120px, min(content.width * 0.4, sidebar.width + self.mouse-x - self.pressed-x));
                    }
                }
            }

            // Detail panel
            Rectangle {
                x: sidebar.width + 5px;
                y: 0px;
                width: parent.width - sidebar.width - 5px;
                height: parent.height;
                clip: true;

                // Empty state
                if root.services.length == 0: Rectangle {
                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "No services loaded";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Service detail card
                if root.services.length > 0 && root.selected-index >= 0 && root.selected-index < root.services.length: ServiceCard {
                    service: root.services[root.selected-index];
                    open-learn-url(url) => { root.open-service-url(url); }
                }
            }
        }
    }
}
