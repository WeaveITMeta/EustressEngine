// ============================================================================
// Eustress Engine - Manage Domains Dialog
// Create, edit and remove the domains a space knows about, and the object
// type each one maps onto when it is synced into the scene.
//
// Chrome is the shared dialog kit (DRAFTING_UX.md Law 1): DialogScrim >
// DialogCard > DialogFooter. The footer's two buttons are always mounted and
// change meaning with `form-open` (Close / New domain, or Cancel / Add or
// Save), so no button sits inside the `if` its own click tears down; that
// self-destruction is the Slint "Recursion detected" crash class.
// ============================================================================

import { LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSectionLabel, SettingsGroup, SettingRow } from "dialog_kit.slint";

// One configured domain. Mirrors `DomainConfig` on the Rust side: `id` is the
// stable row identity every callback speaks in, `field-count` is the size of
// the domain's schema (0 renders as "no fields yet" rather than "0 fields").
export struct DomainEntry {
    id: int,
    name: string,
    description: string,
    object-type: string,
    field-count: int,
}

// A row's delete control. Two-step: idle it is a bin icon, armed it widens
// into a red "Confirm". One element that changes face, not two behind an
// `if`, so the click that arms it never destroys the thing being clicked.
component DomainsDeleteButton inherits Rectangle {
    in property <bool> armed: false;
    callback clicked();

    width: root.armed ? 76px : 28px;
    height: 28px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.armed || ta.has-hover ? Theme.accent-red.with-alpha(0.6) : Theme.border-color;
    background: ta.pressed ? Theme.accent-red.with-alpha(0.35)
        : root.armed || ta.has-hover ? Theme.accent-red.with-alpha(0.22)
        : Theme.button-background;
    animate background { duration: 100ms; easing: ease-out; }
    animate width { duration: 120ms; easing: ease-out; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        visible: !root.armed;
        source: @image-url("../../assets/icons/ui/delete.svg");
        image-fit: contain;
        colorize: ta.has-hover ? Theme.accent-red : Theme.text-secondary;
    }

    Text {
        width: 100%;
        height: 100%;
        visible: root.armed;
        text: "Confirm";
        color: Theme.accent-red;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DomainsDialog inherits Rectangle {
    // ── Data (pushed from Rust) ──────────────────────────────────────────
    /// Every configured domain, in render order.
    in property <[DomainEntry]> domains: [];
    /// Object types a domain may map onto. Defaulted so the dialog is usable
    /// before Rust pushes the live class list.
    in property <[string]> available-object-types: ["Part", "SpherePart", "CylinderPart", "Model", "Folder"];

    // ── Form state ───────────────────────────────────────────────────────
    // In-out because the form is driven from both ends: a row's Edit button
    // fills it locally so the dialog works standalone, and Rust overwrites it
    // with the authoritative record once `on-edit-domain` lands.
    /// True while the add/edit form is expanded.
    in-out property <bool> form-open: false;
    /// Row being edited, or -1 when the form is composing a new domain.
    in-out property <int> editing-id: -1;
    in-out property <string> form-name: "";
    in-out property <string> form-description: "";
    in-out property <string> form-object-type: "Part";
    /// Row armed for deletion — its × has become a "Confirm" button. -1 when
    /// nothing is armed, so a stray click can never drop a domain outright.
    in-out property <int> pending-delete-id: -1;

    // ── Callbacks ────────────────────────────────────────────────────────
    /// Commit the form as a NEW domain (name/description/object-type).
    callback on-add-domain();
    /// Commit the form onto the domain with this id.
    callback on-save-domain(int);
    /// A row's Edit was clicked — Rust may re-fill the form from its record.
    callback on-edit-domain(int);
    /// Delete confirmed for this domain id.
    callback on-delete-domain(int);
    callback on-close();

    // A name is the one thing a domain cannot do without, so Add/Save stay
    // disabled until there is one.
    property <bool> form-valid: root.form-name != "";

    width: 100%;
    height: 100%;

    // Swallow keys so nothing leaks to the Explorer/viewport behind the modal.
    // Escape backs out one level at a time: it collapses an open form first,
    // then closes the dialog. LineEdit children take focus when clicked and
    // keep receiving their own keystrokes normally.
    keys := FocusScope {
        width: 0px; height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.form-open) {
                    root.form-open = false;
                    root.editing-id = -1;
                } else {
                    root.on-close();
                }
                return accept;
            }
            return accept;
        }
        key-released(event) => { return accept; }
    }

    // Backdrop: click-away closes, and scrolling never reaches the scene.
    DialogScrim {
        dismiss => { root.on-close(); }

        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 620px;
            height: min(parent.height - 80px, 560px);
            icon: @image-url("../../assets/icons/ui/layers.svg");
            title: "Domains";
            subtitle: "Kinds of records, and the object each one becomes in the scene";
            close => { root.on-close(); }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;

                    // ── Add / edit form ──
                    if root.form-open: SettingsGroup {
                        title: root.editing-id < 0 ? "New domain" : "Edit domain";
                        note: "Records in this domain spawn as the chosen object type when synced.";

                        SettingRow {
                            label: "Name";
                            description: "Required";
                            divider: false;
                            LineEdit {
                                width: 320px;
                                placeholder-text: "Patient";
                                text <=> root.form-name;
                            }
                        }

                        SettingRow {
                            label: "Description";
                            description: "Optional";
                            LineEdit {
                                width: 320px;
                                placeholder-text: "What this domain describes";
                                text <=> root.form-description;
                            }
                        }

                        SettingRow {
                            label: "Object type";
                            description: "What each record becomes";
                            ComboBox {
                                width: 320px;
                                model: root.available-object-types;
                                current-value <=> root.form-object-type;
                            }
                        }
                    }

                    // ── Configured domains ──
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            padding-left: 2px;
                            KitSectionLabel { text: "Configured domains"; }
                        }

                        Rectangle {
                            background: Theme.background-secondary.with-alpha(0.6);
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-color;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                // ── Empty state ──
                                if root.domains.length == 0: VerticalLayout {
                                    padding-top: 28px;
                                    padding-bottom: 28px;
                                    spacing: 6px;
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            width: 22px;
                                            height: 22px;
                                            source: @image-url("../../assets/icons/ui/layers.svg");
                                            image-fit: contain;
                                            colorize: Theme.text-disabled;
                                        }
                                    }

                                    Text {
                                        text: "No domains yet";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-md;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "A domain names a kind of record and the object type it becomes in the scene.";
                                        color: Theme.text-disabled;
                                        font-size: Theme.font-xs;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                // ── Domain rows ──
                                // The row open in the form is the selected row:
                                // cyan tint and the cyan bar on the left edge.
                                for d in root.domains: dom-row := Rectangle {
                                    property <bool> current: root.form-open && root.editing-id == d.id;

                                    height: 50px;
                                    border-radius: Theme.radius-sm;
                                    background: dom-row.current ? Theme.accent-cyan.with-alpha(0.14)
                                        : row-ta.has-hover ? Theme.explorer-item-hover
                                        : transparent;
                                    animate background { duration: Theme.panel-anim-duration-fast * Theme.motion-scale; }

                                    row-ta := TouchArea {
                                        // Hover surface only: the row's actions own
                                        // every click, so a stray press does nothing.
                                        clicked => { }
                                    }

                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: dom-row.current ? 20px : 0px;
                                        border-radius: 1.5px;
                                        background: Theme.accent-cyan;
                                        animate height { duration: 120ms; easing: ease-out; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        // Domain marker: the Data category tint.
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: Theme.cat-data;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            alignment: center;

                                            Text {
                                                text: d.name;
                                                color: Theme.text-primary;
                                                font-size: 12px;
                                                font-weight: dom-row.current ? 600 : 500;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: d.description != ""
                                                    ? d.description
                                                    : (d.field-count > 0 ? d.field-count + " mapped fields" : "No fields mapped yet");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                overflow: elide;
                                            }
                                        }

                                        // Object-type pill.
                                        VerticalLayout {
                                            horizontal-stretch: 0;
                                            alignment: center;
                                            Rectangle {
                                                height: 20px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.cat-data.with-alpha(0.14);
                                                border-width: 1px;
                                                border-color: Theme.cat-data.with-alpha(0.35);

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    Text {
                                                        text: d.object-type != "" ? d.object-type : "Unmapped";
                                                        color: Theme.cat-data;
                                                        font-size: Theme.font-xs;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 0;
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 6px;

                                                KitButton {
                                                    horizontal-stretch: 0;
                                                    text: "Edit";
                                                    has-icon: true;
                                                    icon: @image-url("../../assets/icons/ui/pen.svg");
                                                    clicked => {
                                                        root.pending-delete-id = -1;
                                                        root.editing-id = d.id;
                                                        root.form-name = d.name;
                                                        root.form-description = d.description;
                                                        root.form-object-type = d.object-type;
                                                        root.form-open = true;
                                                        root.on-edit-domain(d.id);
                                                    }
                                                }

                                                // Delete is two-step: the first click
                                                // arms the row and the button becomes
                                                // "Confirm".
                                                DomainsDeleteButton {
                                                    armed: root.pending-delete-id == d.id;
                                                    clicked => {
                                                        if (root.pending-delete-id == d.id) {
                                                            root.pending-delete-id = -1;
                                                            root.on-delete-domain(d.id);
                                                        } else {
                                                            root.pending-delete-id = d.id;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Footer ──
            DialogFooter {
                Text {
                    text: root.domains.length == 1
                        ? "1 domain"
                        : root.domains.length + " domains";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }

                KitButton {
                    text: root.form-open ? "Cancel" : "Close";
                    clicked => {
                        if (root.form-open) {
                            root.form-open = false;
                            root.editing-id = -1;
                        } else {
                            root.on-close();
                        }
                    }
                }

                KitButton {
                    kind: "primary";
                    text: !root.form-open ? "New domain" : root.editing-id < 0 ? "Add" : "Save";
                    has-icon: true;
                    icon: !root.form-open || root.editing-id < 0
                        ? @image-url("../../assets/icons/ui/plus.svg")
                        : @image-url("../../assets/icons/ui/check.svg");
                    enabled: !root.form-open || root.form-valid;
                    clicked => {
                        if (root.form-open) {
                            if (root.editing-id < 0) {
                                root.on-add-domain();
                            } else {
                                root.on-save-domain(root.editing-id);
                            }
                            root.form-open = false;
                            root.editing-id = -1;
                        } else {
                            root.editing-id = -1;
                            root.form-name = "";
                            root.form-description = "";
                            root.form-object-type = "Part";
                            root.pending-delete-id = -1;
                            root.form-open = true;
                        }
                    }
                }
            }
        }
    }
}
