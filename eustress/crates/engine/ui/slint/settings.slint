// ============================================================================
// Eustress Engine - Settings
// ============================================================================
// Studio preferences on the shared dialog chrome (dialog_kit.slint): a
// sidebar of pages, each page a stack of SettingsGroups. Every control here
// is wired: main.slint binds the dialog's properties to the root, and the
// grid, snap, Graphics, Audio and Auto-save controls talk to the engine
// through the `Preferences` global (engine/src/preferences.rs).
//
// `active-tab` numbering, stored by main.slint in `settings-active-tab`:
// 0 General, 1 Graphics, 2 Audio, 3 AI keys (Soul), 4 Notifications,
// 5 Appearance (themes).

import { ScrollView, LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    DialogScrim, DialogCard, DialogFooter, KitButton, KitSwitch, KitDivider,
    KitSegmented, SettingsGroup, SettingRow, NavItem, KitNotice, KitSectionLabel,
} from "dialog_kit.slint";

// The grid, snap, Graphics, Audio and Auto-save preferences. Rust owns every value: it
// loads them from the editor settings, pushes them here, and applies and
// saves each change. A control never writes a value itself; it asks with
// `set` (apply and save) or, while a slider moves, `preview` (apply only;
// the release sends `set`). Keys are the EditorSettings field names.
export global Preferences {
    // Editing. Snap is the same setting as the Home tab's Snap button.
    in property <bool> show-grid: true;
    in property <bool> snap: true;
    // Graphics
    in property <int> quality: 2; // 0 Low, 1 Medium, 2 High, 3 Ultra
    in property <bool> vsync: false;
    in property <bool> shadows: true;
    in property <bool> anti-aliasing: true;
    in property <int> max-fps: 120; // 0 is unlimited
    // Audio, 0 to 100
    in-out property <float> master-volume: 100;
    in-out property <float> effects-volume: 100;
    in-out property <float> music-volume: 100;
    // Auto-save
    in property <bool> auto-save: true;
    in property <int> auto-save-minutes: 5;

    callback set(string, string);
    callback preview(string, string);
    // Graphics and Audio back to their defaults (Reset to defaults).
    callback reset();
}

// A volume slider and its percentage. Moving it previews the level live;
// letting go saves it.
component VolumeSlider inherits HorizontalLayout {
    in property <string> key;
    in-out property <float> value;

    spacing: 10px;
    Slider {
        width: 180px;
        minimum: 0;
        maximum: 100;
        value <=> root.value;
        changed(v) => { Preferences.preview(root.key, round(v)); }
        released(v) => { Preferences.set(root.key, round(v)); }
    }
    Text {
        width: 40px;
        text: round(root.value) + "%";
        color: Theme.text-primary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// One row in the Settings > Appearance picker, pushed from Rust
// (ThemeRegistry). swatch-bg/swatch-accent are the theme's own
// background-primary/accent-eustress, so each card previews the palette it
// applies.
export struct ThemeEntry {
    id: string,
    name: string,
    description: string,
    swatch-bg: color,
    swatch-accent: color,
    builtin: bool,
}

// A page's heading: its name and one line on what it holds.
component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;

    spacing: 3px;
    padding-bottom: 4px;

    Text {
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 600;
    }
    Text {
        text: root.subtitle;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
}

// A password field with its label above, for the AI keys page.
component KeyField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <string> value;

    spacing: 5px;
    padding-top: 10px;
    padding-bottom: 10px;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 12px;
        font-weight: 500;
    }
    LineEdit {
        text <=> root.value;
        input-type: password;
        placeholder-text: "Paste a key";
        font-size: 12px;
    }
    Text {
        text: root.hint;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
}

// One theme in the Appearance grid: a miniature of the palette, its name,
// and the selection outline in cyan when it is the active one.
component ThemeCard inherits Rectangle {
    in property <ThemeEntry> entry;
    in property <bool> active;
    callback picked();

    height: 118px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.button-hover : Theme.background-secondary.with-alpha(0.6);
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent-cyan : Theme.border-color;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // The miniature: the theme's background with a ribbon strip, a
        // panel and an accent button.
        Rectangle {
            height: 52px;
            border-radius: Theme.radius-sm;
            background: root.entry.swatch-bg;
            border-width: 1px;
            border-color: Theme.border-highlight;
            clip: true;

            Rectangle {
                y: 0;
                height: 10px;
                background: root.entry.swatch-bg.brighter(0.4);
            }
            Rectangle {
                x: 8px;
                y: 16px;
                width: parent.width * 0.3;
                height: parent.height - 24px;
                border-radius: 2px;
                background: root.entry.swatch-bg.brighter(0.6);
            }
            Rectangle {
                x: parent.width * 0.3 + 16px;
                y: 18px;
                width: parent.width * 0.4;
                height: 5px;
                border-radius: 2px;
                background: root.entry.swatch-bg.brighter(1.2);
            }
            Rectangle {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                width: 36px;
                height: 12px;
                border-radius: 3px;
                background: root.entry.swatch-accent;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: root.entry.name;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.active: VerticalLayout {
                alignment: center;
                Image {
                    width: 13px;
                    height: 13px;
                    source: @image-url("../../assets/icons/ui/check.svg");
                    colorize: Theme.accent-cyan;
                }
            }
            Text {
                text: root.entry.builtin ? "Built-in" : "Yours";
                color: Theme.text-disabled;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.entry.description;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

export component SettingsDialog inherits Rectangle {
    // Which page is showing. See the header for the numbering.
    in-out property <int> active-tab: 0;

    // Appearance: themes from the ThemeRegistry. Clicking a card applies it
    // at once and saves the choice; Rescan re-reads the user Themes folder.
    in property <[ThemeEntry]> available-themes: [];
    in-out property <string> active-theme-id: "modern";
    callback select-theme(string);
    callback rescan-themes();

    // Notifications
    in-out property <bool> notifications-enabled: true;
    // Privacy: anonymous tool-click counts. Persisted in EditorSettings.
    in-out property <bool> usage-telemetry-enabled: true;
    in-out property <bool> notifications-show-dismiss: true;
    in-out property <bool> notifications-mute-file: false;
    in-out property <bool> notifications-mute-script: false;
    in-out property <bool> notifications-mute-editor: false;
    in-out property <bool> notifications-mute-simulation: false;
    in-out property <bool> notifications-mute-network: false;
    in-out property <bool> notifications-mute-task: false;
    in-out property <bool> notifications-mute-general: false;
    in-out property <bool> notifications-mute-info: false;
    in-out property <bool> notifications-mute-warning: false;
    callback on-notifications-changed();

    // General: the Properties panel's help links.
    in-out property <bool> show-help-icons: true;
    in-out property <bool> help-opens-in-tab: false;

    // AI keys (Soul)
    in-out property <string> soul-api-key: "";
    // Set by Rust after the key is validated.
    in property <bool> soul-api-key-valid: false;
    in property <string> soul-error-message: "";
    // "Test connection": one line per provider, and whether it is running.
    in property <string> soul-test-status: "";
    in property <bool> soul-test-running: false;
    // Keys for the other Workshop providers, BYOK like Anthropic's.
    in-out property <string> soul-xai-api-key: "";
    in-out property <string> soul-openai-api-key: "";

    callback on-close();
    callback on-save();
    callback on-reset-defaults();
    callback on-help-icons-changed(bool);
    callback on-help-opens-in-tab-changed(bool);
    callback on-test-soul-connection();
    // Keyboard: the shortcut editor is its own dialog.
    callback open-keybindings();

    // The page to draw; anything out of range shows General.
    property <int> page: root.active-tab >= 0 && root.active-tab <= 5 ? root.active-tab : 0;

    // Max FPS choices, and the one showing (-1 when the cap is another
    // number, set by EUSTRESS_MAX_FPS).
    property <[int]> fps-caps: [60, 120, 144, 240, 0];
    property <int> fps-index: Preferences.max-fps == 60 ? 0
        : Preferences.max-fps == 120 ? 1
        : Preferences.max-fps == 144 ? 2
        : Preferences.max-fps == 240 ? 3
        : Preferences.max-fps == 0 ? 4 : -1;

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-close(); }

        // Esc closes; every other key stays inside the dialog instead of
        // reaching the Explorer or the viewport behind it. Text fields take
        // their own keys when they have focus.
        FocusScope {
            width: 0px;
            height: 0px;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.on-close();
                }
                return accept;
            }
            key-released(event) => { return accept; }
        }

        DialogCard {
            width: min(parent.width - 48px, 760px);
            height: min(parent.height - 64px, 580px);
            icon: @image-url("../../assets/icons/ui/settings.svg");
            title: "Settings";
            subtitle: "Studio preferences, saved on this computer";
            close => { root.on-close(); }

            HorizontalLayout {
                vertical-stretch: 1;
                padding: 0;
                spacing: 0;

                // ── Sidebar ──
                Rectangle {
                    width: 188px;
                    background: Theme.background-primary.with-alpha(0.5);

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        alignment: start;

                        NavItem {
                            text: "General";
                            icon: @image-url("../../assets/icons/ui/settings.svg");
                            selected: root.page == 0;
                            clicked => { root.active-tab = 0; }
                        }
                        NavItem {
                            text: "Graphics";
                            icon: @image-url("../../assets/icons/ui/screen.svg");
                            selected: root.page == 1;
                            clicked => { root.active-tab = 1; }
                        }
                        NavItem {
                            text: "Audio";
                            icon: @image-url("../../assets/icons/ui/audio.svg");
                            selected: root.page == 2;
                            clicked => { root.active-tab = 2; }
                        }
                        NavItem {
                            text: "Appearance";
                            icon: @image-url("../../assets/icons/ui/palette.svg");
                            selected: root.page == 5;
                            clicked => { root.active-tab = 5; }
                        }
                        NavItem {
                            text: "AI keys";
                            icon: @image-url("../../assets/icons/ui/brain.svg");
                            selected: root.page == 3;
                            clicked => { root.active-tab = 3; }
                        }
                        NavItem {
                            text: "Notifications";
                            icon: @image-url("../../assets/icons/ui/bell.svg");
                            selected: root.page == 4;
                            clicked => { root.active-tab = 4; }
                        }

                        Rectangle { height: 6px; }
                        KitDivider { }
                        Rectangle { height: 6px; }

                        NavItem {
                            text: "Keyboard shortcuts";
                            icon: @image-url("../../assets/icons/ui/keyboard.svg");
                            clicked => { root.open-keybindings(); }
                        }
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.ribbon-separator;
                }

                // ── Page ──
                page-scroll := ScrollView {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        width: page-scroll.visible-width;
                        padding: 20px;
                        spacing: 18px;
                        alignment: start;

                        if root.page == 0: VerticalLayout {
                            spacing: 18px;

                            PageTitle {
                                title: "General";
                                subtitle: "How the editor behaves while you build.";
                            }

                            SettingsGroup {
                                title: "EDITING";
                                note: "Snap increments are on the Home tab, beside the Snap button.";
                                SettingRow {
                                    divider: false;
                                    label: "Show grid";
                                    description: "The ground grid in the viewport.";
                                    KitSwitch {
                                        managed: true;
                                        checked: Preferences.show-grid;
                                        toggled(on) => { Preferences.set("show_grid", on ? "1" : "0"); }
                                    }
                                }
                                SettingRow {
                                    label: "Snap to grid";
                                    description: "Moves and rotations land on the snap increments.";
                                    KitSwitch {
                                        managed: true;
                                        checked: Preferences.snap;
                                        toggled(on) => { Preferences.set("snap_enabled", on ? "1" : "0"); }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "AUTO-SAVE";
                                note: "Each auto-save writes the Space and commits it to the Space's own git history, so any one can be restored.";
                                SettingRow {
                                    divider: false;
                                    label: "Auto-save";
                                    description: "Saves the open Space while you work. Skipped in Play and when nothing changed.";
                                    KitSwitch {
                                        managed: true;
                                        checked: Preferences.auto-save;
                                        toggled(on) => { Preferences.set("auto_save_enabled", on ? "1" : "0"); }
                                    }
                                }
                                if Preferences.auto-save: SettingRow {
                                    label: "Every";
                                    description: "Time between auto-saves.";
                                    KitSegmented {
                                        managed: true;
                                        options: ["1 min", "2 min", "5 min", "10 min", "15 min"];
                                        current-index: Preferences.auto-save-minutes == 1 ? 0
                                            : Preferences.auto-save-minutes == 2 ? 1
                                            : Preferences.auto-save-minutes == 5 ? 2
                                            : Preferences.auto-save-minutes == 10 ? 3
                                            : Preferences.auto-save-minutes == 15 ? 4 : -1;
                                        selected(i) => {
                                            Preferences.set("auto_save_interval",
                                                i == 0 ? "60" : i == 1 ? "120" : i == 2 ? "300" : i == 3 ? "600" : "900");
                                        }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "PROPERTIES PANEL";
                                SettingRow {
                                    divider: false;
                                    label: "Help icons";
                                    description: "A ? beside every documented property.";
                                    KitSwitch {
                                        checked <=> root.show-help-icons;
                                        toggled(on) => { root.on-help-icons-changed(on); }
                                    }
                                }
                                SettingRow {
                                    label: "Open help in a Studio tab";
                                    description: "Otherwise help opens in your web browser.";
                                    KitSwitch {
                                        checked <=> root.help-opens-in-tab;
                                        toggled(on) => { root.on-help-opens-in-tab-changed(on); }
                                    }
                                }
                            }
                        }

                        if root.page == 1: VerticalLayout {
                            spacing: 18px;

                            PageTitle {
                                title: "Graphics";
                                subtitle: "How the viewport draws. Changes apply at once.";
                            }

                            SettingsGroup {
                                title: "QUALITY";
                                SettingRow {
                                    divider: false;
                                    label: "Shadow quality";
                                    description: "Shadow sharpness and how far from the camera they reach. Low is fastest on large Spaces.";
                                    KitSegmented {
                                        managed: true;
                                        options: ["Low", "Medium", "High", "Ultra"];
                                        current-index: Preferences.quality;
                                        selected(i) => { Preferences.set("render_quality", i); }
                                    }
                                }
                                SettingRow {
                                    label: "Shadows";
                                    description: "Lights cast shadows. Turn off for the most speed.";
                                    KitSwitch {
                                        managed: true;
                                        checked: Preferences.shadows;
                                        toggled(on) => { Preferences.set("shadows_enabled", on ? "1" : "0"); }
                                    }
                                }
                                SettingRow {
                                    label: "Anti-aliasing";
                                    description: "Smooths jagged edges (SMAA).";
                                    KitSwitch {
                                        managed: true;
                                        checked: Preferences.anti-aliasing;
                                        toggled(on) => { Preferences.set("anti_aliasing", on ? "1" : "0"); }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "DISPLAY";
                                SettingRow {
                                    divider: false;
                                    label: "V-Sync";
                                    description: "Match the monitor's refresh. Stops tearing and adds a little input delay.";
                                    KitSwitch {
                                        managed: true;
                                        checked: Preferences.vsync;
                                        toggled(on) => { Preferences.set("vsync", on ? "1" : "0"); }
                                    }
                                }
                                SettingRow {
                                    label: "Frame rate while editing";
                                    description: "The most frames per second Studio draws while you build. Play always runs uncapped.";
                                    KitSegmented {
                                        managed: true;
                                        options: ["60", "120", "144", "240", "Unlimited"];
                                        current-index: root.fps-index;
                                        selected(i) => { Preferences.set("max_fps", root.fps-caps[i]); }
                                    }
                                }
                            }
                        }

                        if root.page == 2: VerticalLayout {
                            spacing: 18px;

                            PageTitle {
                                title: "Audio";
                                subtitle: "Studio's volume, in Edit and in Play. Sounds already playing follow the sliders.";
                            }

                            SettingsGroup {
                                title: "VOLUME";
                                SettingRow {
                                    divider: false;
                                    label: "Master";
                                    description: "Every sound.";
                                    VolumeSlider {
                                        key: "master_volume";
                                        value <=> Preferences.master-volume;
                                    }
                                }
                                SettingRow {
                                    label: "Effects";
                                    description: "Sounds in the SFX, Voice and UI groups. In Play, one-shot sounds.";
                                    VolumeSlider {
                                        key: "effects_volume";
                                        value <=> Preferences.effects-volume;
                                    }
                                }
                                SettingRow {
                                    label: "Music";
                                    description: "Sounds in the Music and Ambient groups. In Play, looping sounds.";
                                    VolumeSlider {
                                        key: "music_volume";
                                        value <=> Preferences.music-volume;
                                    }
                                }
                            }
                        }

                        if root.page == 5: VerticalLayout {
                            spacing: 18px;

                            HorizontalLayout {
                                spacing: 12px;
                                PageTitle {
                                    horizontal-stretch: 1;
                                    title: "Appearance";
                                    subtitle: "Pick a theme. It applies at once, no restart.";
                                }
                                VerticalLayout {
                                    alignment: start;
                                    KitButton {
                                        text: "Rescan";
                                        has-icon: true;
                                        icon: @image-url("../../assets/icons/ui/refresh.svg");
                                        clicked => { root.rescan-themes(); }
                                    }
                                }
                            }

                            theme-grid := Rectangle {
                                property <int> cols: 2;
                                property <length> gap: 10px;
                                property <length> cell: (self.width - self.gap) / self.cols;
                                height: ceil(root.available-themes.length / self.cols) * (118px + self.gap);

                                for entry[i] in root.available-themes: ThemeCard {
                                    x: mod(i, theme-grid.cols) * (theme-grid.cell + theme-grid.gap);
                                    y: floor(i / theme-grid.cols) * (118px + theme-grid.gap);
                                    width: theme-grid.cell;
                                    entry: entry;
                                    active: entry.id == root.active-theme-id;
                                    picked => {
                                        root.active-theme-id = entry.id;
                                        root.select-theme(entry.id);
                                    }
                                }
                            }

                            Text {
                                text: "Themes are TOML files. Put your own in %LOCALAPPDATA%/Eustress/Themes, then press Rescan.";
                                color: Theme.text-disabled;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                        }

                        if root.page == 3: VerticalLayout {
                            spacing: 18px;

                            PageTitle {
                                title: "AI keys";
                                subtitle: "Bring your own keys for Soul and the Workshop. They are stored on this computer and never sent to Eustress.";
                            }

                            SettingsGroup {
                                title: "PROVIDERS";
                                note: "Pick the model in the Workshop panel, next to its Mode pill.";
                                KeyField {
                                    label: "Anthropic (Claude)";
                                    hint: "Used by Soul, the Workshop and the UI Builder's Claude mode.";
                                    value <=> root.soul-api-key;
                                }
                                KitDivider { }
                                KeyField {
                                    label: "xAI (Grok)";
                                    hint: "Used when the Workshop's model is an xAI model.";
                                    value <=> root.soul-xai-api-key;
                                }
                                KitDivider { }
                                KeyField {
                                    label: "OpenAI";
                                    hint: "Used when the Workshop's model is an OpenAI model.";
                                    value <=> root.soul-openai-api-key;
                                }
                            }

                            if root.soul-api-key-valid: KitNotice {
                                kind: "success";
                                text: "Anthropic key validated.";
                            }
                            if root.soul-error-message != "": KitNotice {
                                kind: "error";
                                text: root.soul-error-message;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                KitButton {
                                    text: root.soul-test-running ? "Testing..." : "Test connection";
                                    has-icon: true;
                                    icon: @image-url("../../assets/icons/ui/plug.svg");
                                    enabled: !root.soul-test-running;
                                    clicked => { root.on-test-soul-connection(); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Tests the keys typed above, saved or not.";
                                        color: Theme.text-disabled;
                                        font-size: Theme.font-xs;
                                    }
                                }
                            }
                            // One line per provider: OK, rejected, unreachable or not set.
                            if root.soul-test-status != "": KitNotice {
                                kind: "info";
                                text: root.soul-test-status;
                            }
                        }

                        if root.page == 4: VerticalLayout {
                            spacing: 18px;

                            PageTitle {
                                title: "Notifications";
                                subtitle: "Which toasts Studio shows, and what it may count.";
                            }

                            SettingsGroup {
                                title: "TOASTS";
                                SettingRow {
                                    divider: false;
                                    label: "Show notifications";
                                    KitSwitch {
                                        checked <=> root.notifications-enabled;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Dismiss button on toasts";
                                    KitSwitch {
                                        checked <=> root.notifications-show-dismiss;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "PRIVACY";
                                SettingRow {
                                    divider: false;
                                    label: "Send anonymous usage statistics";
                                    description: "Counts which tools you click, so the most-wanted ones get built first. Never your scenes, files or personal data.";
                                    KitSwitch {
                                        checked <=> root.usage-telemetry-enabled;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "MUTE BY LEVEL";
                                SettingRow {
                                    divider: false;
                                    label: "Mute info";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-info;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Mute warnings";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-warning;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                            }

                            SettingsGroup {
                                title: "MUTE BY CATEGORY";
                                SettingRow {
                                    divider: false;
                                    label: "File";
                                    description: "Save, load and rename.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-file;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Script";
                                    description: "Build, compile and run.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-script;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Editor";
                                    description: "Selection and transforms.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-editor;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Simulation";
                                    description: "Play mode.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-simulation;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Network";
                                    description: "Replication and sign-in.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-network;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "Task";
                                    description: "Imports, exports and background jobs.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-task;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: "General";
                                    description: "Everything else.";
                                    KitSwitch {
                                        checked <=> root.notifications-mute-general;
                                        toggled => { root.on-notifications-changed(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            DialogFooter {
                pack-end: false;
                KitButton {
                    text: "Reset to defaults";
                    kind: "ghost";
                    clicked => {
                        root.on-reset-defaults();
                        Preferences.reset();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                KitButton {
                    text: "Cancel";
                    clicked => { root.on-close(); }
                }
                KitButton {
                    text: "Save";
                    kind: "primary";
                    clicked => { root.on-save(); }
                }
            }
        }
    }
}
