// ============================================================================
// Rename Tag dialog: renames a CollectionService tag across EVERY entity
// carrying it. Created at the StudioWindow root via `if show-rename-tag-dialog`,
// so it never mutates the tag-chip subtree or reflows the chip row (a tree
// mutation during mouse/render is what crashed every inline attempt).
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Enter renames, Escape cancels; Rename waits for a name.
// ============================================================================

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton } from "dialog_kit.slint";

export component RenameTagDialog inherits Rectangle {
    in property <string> old-name: "";
    in-out property <string> new-name: "";

    callback on-rename(/* new-name */ string);
    callback on-cancel();

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(400px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/tag.svg");
            title: "Rename tag";
            subtitle: "Renames '" + root.old-name + "' on every tagged object";
            close => { root.on-cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.on-cancel();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "New name";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: 600;
                        }

                        name-edit := LineEdit {
                            text <=> root.new-name;
                            placeholder-text: "New tag name";
                            init => { self.focus(); }
                            accepted(t) => { if t != "" { root.on-rename(t); } }
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-cancel(); }
                        }
                        KitButton {
                            text: "Rename";
                            kind: "primary";
                            enabled: root.new-name != "";
                            clicked => { if root.new-name != "" { root.on-rename(root.new-name); } }
                        }
                    }
                }
            }
        }
    }
}
