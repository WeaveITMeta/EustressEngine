// ============================================================================
// Eustress Engine Studio - Context Menu
// Right-click context menu with proper positioning and scrollable submenus
// ============================================================================

import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Menu item data
export struct MenuItem {
    id: string,
    label: string,
    shortcut: string,
    icon: image,
    enabled: bool,
    separator-after: bool,
}

// ── Menu Item Row ─────────────────────────────────────────────────────────

component MenuItemRow inherits Rectangle {
    in property <string> label: "";
    in property <string> shortcut: "";
    in property <image> icon;
    in property <bool> enabled: true;

    callback clicked();

    height: 26px;
    background: self.enabled && touch.has-hover ? Theme.button-hover : transparent;
    border-radius: 3px;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    // Absolute positioning inside the row instead of HorizontalLayout —
    // the Layout was cross-stretching the Image, which pushed the 14px
    // glyph to the TOP of the 26px row rather than vertical centre, so
    // icons sat visibly higher than their text. Explicit `y` bindings
    // centre each child against the row's own height.

    Image {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: root.icon;
        image-fit: contain;
        colorize: root.enabled ? Theme.text-secondary : Theme.text-disabled;
    }

    Text {
        x: 32px;
        y: (parent.height - self.height) / 2;
        width: root.shortcut != ""
            ? parent.width - 32px - 8px - shortcut-text.preferred-width - 8px
            : parent.width - 32px - 8px;
        text: root.label;
        color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    shortcut-text := Text {
        x: parent.width - self.preferred-width - 10px;
        y: (parent.height - self.height) / 2;
        text: root.shortcut;
        color: Theme.text-disabled;
        font-size: 10px;
        vertical-alignment: center;
        visible: root.shortcut != "";
    }
}

// ── Separator ─────────────────────────────────────────────────────────────

component MenuSeparator inherits Rectangle {
    height: 5px;

    Rectangle {
        y: 2px;
        height: 1px;
        x: 8px;
        width: parent.width - 16px;
        background: Theme.border-color;
    }
}

// ============================================================================
// Context Menu — main component
// ============================================================================

export component ContextMenu inherits Rectangle {
    in property <[MenuItem]> items: [];

    // Which surface the right-click came from — mirrors
    // `context-menu-target-type` on the root window. `"viewport"` swaps the
    // Explorer entity menu for the build-oriented set below; everything
    // else ("entity", "file", "soul-script", …) keeps the default menu.
    in property <string> kind: "";

    // Live shortcut text, pushed from `slint_ui::sync_keybindings_to_slint`
    // and threaded through by main.slint. NOTHING here is hardcoded: the
    // menu used to spell "Ctrl+Shift+G" for Ungroup while the real binding
    // was Ctrl+U, and a literal string can never notice a remap. Reading
    // the same properties the ribbon subtitles read makes that whole class
    // of drift impossible.
    in property <string> shortcut-cut: "";
    in property <string> shortcut-copy: "";
    in property <string> shortcut-paste: "";
    in property <string> shortcut-duplicate: "";
    in property <string> shortcut-delete: "";
    in property <string> shortcut-rename: "";
    in property <string> shortcut-copy-path: "";
    in property <string> shortcut-group: "";
    in property <string> shortcut-ungroup: "";
    in property <string> shortcut-focus: "";
    in property <string> shortcut-anchor: "";
    in property <string> shortcut-lock: "";

    callback on-action(string);
    callback on-close();

    width: 220px;
    // Height hugs content via the inner layout's `min-height` (sum of
    // children, independent of parent). `preferred-height` creates a
    // circular binding when the parent height drives the child, which
    // can resolve to 0 and hide the menu entirely.
    height: body.min-height;
    clip: true;
    // Theme-backed background + border instead of the old hardcoded
    // #1e1f2e purple that clashed with the rest of the dark UI.
    background: Theme.dialog-background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-color;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.shadow-float;

    // Absorb clicks on the menu body
    TouchArea {
        scroll-event(event) => { return accept; }
    }

    body := VerticalLayout {
        padding: 4px;
        spacing: 1px;

        // ── Dynamic items (file menu) ──
        if root.items.length > 0: VerticalLayout {
                spacing: 1px;

                for item in root.items: VerticalLayout {
                    spacing: 0px;

                    MenuItemRow {
                        icon: item.icon;
                        label: item.label;
                        shortcut: item.shortcut;
                        enabled: item.enabled;
                        clicked => { root.on-action(item.id); }
                    }

                    if item.separator-after: MenuSeparator {}
                }
            }

            // ── Viewport build menu ──
            //
            // A right-click in the 3D viewport is a BUILD gesture, not a
            // tree-management gesture, so it gets its own set: put something
            // where the cursor is, get the camera onto it, then the
            // per-object toggles a builder reaches for mid-block-out.
            // `insert-here` / `paste-here` place at the ray hit point the
            // producer recorded (`ViewportContextTarget.hit_point`); every
            // other item acts on the current selection, which the producer
            // has already synced to whatever the click landed on.
            if root.items.length == 0 && root.kind == "viewport": VerticalLayout {
                spacing: 1px;

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/plus.svg");
                    label: "Insert Part Here"; shortcut: "";
                    clicked => { root.on-action("insert-here"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/paste.svg");
                    label: "Paste Here"; shortcut: root.shortcut-paste;
                    clicked => { root.on-action("paste-here"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/crosshair.svg");
                    label: "Focus Selection"; shortcut: root.shortcut-focus;
                    clicked => { root.on-action("focus-selection"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/binoculars.svg");
                    label: "Zoom to Selection"; shortcut: "";
                    clicked => { root.on-action("zoom-to-selection"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/duplicate.svg");
                    label: "Duplicate"; shortcut: root.shortcut-duplicate;
                    clicked => { root.on-action("duplicate"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/copy.svg");
                    label: "Copy"; shortcut: root.shortcut-copy;
                    clicked => { root.on-action("copy"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/cut.svg");
                    label: "Cut"; shortcut: root.shortcut-cut;
                    clicked => { root.on-action("cut"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/anchor.svg");
                    label: "Toggle Anchor"; shortcut: root.shortcut-anchor;
                    clicked => { root.on-action("toggle-anchor"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/lock.svg");
                    label: "Toggle Lock"; shortcut: root.shortcut-lock;
                    clicked => { root.on-action("toggle-lock"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/group.svg");
                    label: "Group"; shortcut: root.shortcut-group;
                    clicked => { root.on-action("group"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/ungroup.svg");
                    label: "Ungroup"; shortcut: root.shortcut-ungroup;
                    clicked => { root.on-action("ungroup"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/link.svg");
                    label: "Copy Path"; shortcut: root.shortcut-copy-path;
                    clicked => { root.on-action("copy-path"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/delete.svg");
                    label: "Delete"; shortcut: root.shortcut-delete;
                    clicked => { root.on-action("delete"); }
                }
            }

            // ── Default entity menu ──
            //
            // Order: edit clipboard ops → identity ops → structure ops →
            // destructive (Delete) last so a misclick can't nuke the node.
            // "Insert Object..." lives in the File menu; we don't duplicate
            // it here.
            if root.items.length == 0 && root.kind != "viewport": VerticalLayout {
                spacing: 1px;

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/cut.svg");
                    label: "Cut"; shortcut: root.shortcut-cut;
                    clicked => { root.on-action("cut"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/copy.svg");
                    label: "Copy"; shortcut: root.shortcut-copy;
                    clicked => { root.on-action("copy"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/paste.svg");
                    label: "Paste"; shortcut: root.shortcut-paste;
                    clicked => { root.on-action("paste"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/duplicate.svg");
                    label: "Duplicate"; shortcut: root.shortcut-duplicate;
                    clicked => { root.on-action("duplicate"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/rename.svg");
                    label: "Rename"; shortcut: root.shortcut-rename;
                    clicked => { root.on-action("rename"); }
                }
                // Copy Path — yields the `@entity:Space/Name` canonical handle
                // so the user can paste it straight into the Workshop chat
                // and @reference the selected entity.
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/link.svg");
                    label: "Copy Path"; shortcut: root.shortcut-copy-path;
                    clicked => { root.on-action("copy-path"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/group.svg");
                    label: "Group"; shortcut: root.shortcut-group;
                    clicked => { root.on-action("group"); }
                }
                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/ungroup.svg");
                    label: "Ungroup"; shortcut: root.shortcut-ungroup;
                    clicked => { root.on-action("ungroup"); }
                }

                MenuSeparator {}

                MenuItemRow {
                    icon: @image-url("../../assets/icons/ui/delete.svg");
                    label: "Delete"; shortcut: root.shortcut-delete;
                    clicked => { root.on-action("delete"); }
                }
            }
        }
    }
