// ============================================================================
// Eustress Engine Studio - Login Dialog
// SPI (Sign in with Private Identity): identity.toml
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Enter signs in once a file is picked; Escape closes.
// ============================================================================

import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitNotice } from "dialog_kit.slint";

export component LoginDialog inherits Rectangle {
    // Properties
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> status-message: "";
    in property <string> identity-path: "";

    // Callbacks
    callback on-login();
    callback on-close();
    callback on-browse-identity();

    property <bool> can-sign-in: root.identity-path != "" && !root.is-loading;

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-close(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(420px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/key.svg");
            title: "Sign in to Eustress";
            subtitle: "Use your eustress-username.toml to authenticate";
            close => { root.on-close(); }

            keys := FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.on-close();
                        return accept;
                    }
                    if event.text == Key.Return && root.can-sign-in {
                        root.on-login();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Identity file";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: 600;
                        }

                        // File picker: the entire row is clickable.
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: file-row-touch.has-hover && !root.is-loading ? Theme.button-hover : Theme.input-background;
                            border-width: 1px;
                            border-color: root.error-message != "" ? Theme.border-error
                                : file-row-touch.has-hover && !root.is-loading ? Theme.accent-cyan
                                : Theme.input-border;

                            file-row-touch := TouchArea {
                                mouse-cursor: root.is-loading ? default : pointer;
                                enabled: !root.is-loading;
                                clicked => { root.on-browse-identity(); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 4px;
                                spacing: 8px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        source: @image-url("../../assets/icons/ui/folder-open.svg");
                                        image-fit: contain;
                                        colorize: root.identity-path != "" ? Theme.accent-cyan : Theme.text-secondary;
                                    }
                                }

                                Text {
                                    text: root.identity-path != "" ? root.identity-path : "Choose your eustress .toml file";
                                    color: root.identity-path != "" ? Theme.text-primary : Theme.text-disabled;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    KitButton {
                                        text: "Browse";
                                        kind: "ghost";
                                        enabled: !root.is-loading;
                                        clicked => { root.on-browse-identity(); }
                                    }
                                }
                            }
                        }

                        KitNotice {
                            kind: "info";
                            text: "Your eustress-username.toml holds your Ed25519 keypair. Get one at eustress.dev/login. Never share your private key.";
                        }

                        if root.status-message != "": KitNotice {
                            kind: "info";
                            text: root.status-message;
                        }

                        if root.error-message != "": KitNotice {
                            kind: "error";
                            text: root.error-message;
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-close(); }
                        }
                        KitButton {
                            text: root.is-loading ? "Signing in..." : "Sign in";
                            kind: "primary";
                            has-icon: true;
                            icon: @image-url("../../assets/icons/ui/key.svg");
                            enabled: root.can-sign-in;
                            clicked => { root.on-login(); }
                        }
                    }
                }
            }
        }
    }
}
