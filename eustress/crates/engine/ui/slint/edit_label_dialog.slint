// ============================================================================
// Edit Label Text dialog: opened by Enter on a selected part that has a
// TextLabel descendant. Window-root modal (same pattern as NewSpace /
// RenameTag), so it never mutates the 3D billboard / part subtree.
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Enter saves, Escape cancels.
// ============================================================================

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton } from "dialog_kit.slint";

export component EditLabelDialog inherits Rectangle {
    in-out property <string> label-text: "";

    callback on-confirm(/* new-text */ string);
    callback on-cancel();

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(440px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/text.svg");
            title: "Edit label text";
            subtitle: "The TextLabel on the selected part";
            close => { root.on-cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.on-cancel();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Text";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: 600;
                        }

                        text-edit := LineEdit {
                            text <=> root.label-text;
                            placeholder-text: "Label text";
                            init => { self.focus(); }
                            accepted(t) => { root.on-confirm(t); }
                        }

                        Text {
                            text: "Enter saves. Esc cancels.";
                            color: Theme.text-disabled;
                            font-size: Theme.font-xs;
                            wrap: word-wrap;
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-cancel(); }
                        }
                        KitButton {
                            text: "Save";
                            kind: "primary";
                            clicked => { root.on-confirm(root.label-text); }
                        }
                    }
                }
            }
        }
    }
}
