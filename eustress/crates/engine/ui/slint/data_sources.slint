// ============================================================================
// Eustress Engine - Data Sources Dialog
// Manage global data sources (REST, GraphQL, PostgreSQL, etc.)
// ============================================================================
//
// CONTRACT (read this before binding the dialog in main.slint)
//
//   `sources`     the caller owns the list. Every row carries both its
//                 standing connection `status` AND the result of the last
//                 explicit Test in `test-state` / `test-detail` /
//                 `tested-at`. Those three are what gives the Test button
//                 somewhere to put its answer: the handler for
//                 `on-test-source(id)` sets the row to "testing", runs the
//                 probe off the UI thread, then writes back "ok" or "failed"
//                 with a one-line detail.
//   `on-add-source()`
//                 reads `new-source-name` / `new-source-type` /
//                 `new-source-url` off `self`. The Add button is disabled
//                 until name and URL are both non-empty, so the handler can
//                 assume they are populated. Clearing the fields and
//                 lowering `adding-source` is the caller's job; the dialog
//                 does not guess whether the add succeeded.
//   `on-close()`  fired by the ×, the Close button, a backdrop click, and
//                 Escape.
//
// Chrome is the shared dialog kit (DRAFTING_UX.md Law 1): DialogScrim >
// DialogCard > DialogFooter. The footer's two buttons are always present and
// change meaning with `adding-source` (Close / Add source, or Cancel / Add),
// so no button ever sits inside the `if` its own click tears down.
//
// Secrets never live here. A source's credential is named by an env var on
// the Rust side; this dialog only ever shows an endpoint.
// ============================================================================

import { LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitSectionLabel, SettingsGroup, SettingRow, KitNotice } from "dialog_kit.slint";

// Data source entry
export struct DataSourceEntry {
    id: int,
    name: string,
    source-type: string, // "REST", "GraphQL", "PostgreSQL", "CSV", etc.
    url: string,
    status: string, // "connected", "disconnected", "error"

    // ── Last explicit Test ──
    // "idle"    never tested this session; the row shows nothing
    // "testing" a probe is in flight; the Test button is greyed
    // "ok"      the probe reached the endpoint
    // "failed"  the probe did not
    test-state: string,
    // One line of human-readable evidence: "200 OK · 41 ms", "auth failed",
    // "connection refused". Shown under the endpoint, elided if long.
    test-detail: string,
    // When the probe ran, e.g. "12:04". Empty hides the timestamp.
    tested-at: string,
}

// The text field of the new-source form. It reports caret entry and exit the
// instant they happen, not on the first keystroke: the parent needs to know
// before a key is pressed, or the Delete shortcut fires once against the scene.
component DSField inherits LineEdit {
    in-out property <string> value: "";
    out property <bool> editing: self.has-focus;

    callback focus-changed(bool);
    changed editing => { root.focus-changed(self.editing); }

    width: 300px;
    text <=> root.value;
}

// A square icon-only button for a row's delete action. Red only on hover.
component DSIconButton inherits Rectangle {
    in property <image> icon;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent-red.with-alpha(0.6) : Theme.border-color;
    background: ta.pressed ? Theme.accent-red.with-alpha(0.35)
        : ta.has-hover ? Theme.accent-red.with-alpha(0.22)
        : Theme.button-background;
    animate background { duration: 100ms; easing: ease-out; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        source: root.icon;
        image-fit: contain;
        colorize: ta.has-hover ? Theme.accent-red : Theme.text-secondary;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DataSourcesDialog inherits Rectangle {
    // ── Properties ───────────────────────────────────────────────────────
    in property <[DataSourceEntry]> sources: [];
    in-out property <int> selected-source: -1;
    in-out property <string> new-source-name: "";
    in-out property <string> new-source-type: "REST";
    in-out property <string> new-source-url: "";
    in-out property <bool> adding-source: false;

    // Both required fields must carry something before Add is live. Exposed
    // so a caller can mirror the gate rather than re-deriving it.
    out property <bool> can-add: root.new-source-name != "" && root.new-source-url != "";

    // Caret state of the new-source form. The caller must suppress the
    // viewport Delete/Backspace shortcut while this is set, or erasing a
    // character deletes the selected part instead. The `adding-source` guard
    // matters: the fields are inside an `if`, so tearing the form down
    // destroys them without a final focus-lost, and the raw flags would
    // otherwise stay stuck true.
    out property <bool> text-input-focused:
        root.adding-source && (root.name-focused || root.url-focused);
    private property <bool> name-focused: false;
    private property <bool> url-focused: false;

    // ── Callbacks ────────────────────────────────────────────────────────
    callback on-add-source();
    callback on-remove-source(int);
    callback on-edit-source(int);
    // Probe one source. The handler is expected to flip that row's
    // `test-state` to "testing" immediately, then to "ok"/"failed" with a
    // `test-detail` line when the probe returns.
    callback on-test-source(int);
    callback on-close();

    // Human label for a row's last test. Kept as a function so the row markup
    // stays readable and the four states are stated in one place.
    pure function test-label(entry: DataSourceEntry) -> string {
        entry.test-state == "testing" ? "Testing…"
        : entry.test-state == "ok"
            ? "Reachable" + (entry.test-detail == "" ? "" : " · " + entry.test-detail)
        : entry.test-state == "failed"
            ? "Unreachable" + (entry.test-detail == "" ? "" : " · " + entry.test-detail)
        : "";
    }

    pure function test-color(entry: DataSourceEntry) -> color {
        entry.test-state == "ok" ? Theme.text-success
        : entry.test-state == "failed" ? Theme.text-error
        : Theme.text-secondary
    }

    width: 100%;
    height: 100%;

    // Swallows keys so they cannot reach the Explorer or the viewport behind
    // the modal, and turns Escape into a close. Escape backs out of the
    // add-source form first, so one keypress does not discard a half-typed
    // source and shut the dialog in the same motion.
    keys := FocusScope {
        width: 0px; height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.adding-source { root.adding-source = false; return accept; }
                root.on-close();
                return accept;
            }
            return accept;
        }
        key-released(event) => { return accept; }
    }

    DialogScrim {
        dismiss => { root.on-close(); }

        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 580px;
            height: min(parent.height - 80px, 520px);
            icon: @image-url("../../assets/icons/ui/database.svg");
            title: "Data sources";
            subtitle: "APIs, databases and files your scripts can read";
            close => { root.on-close(); }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;

                    // ── New source form ──
                    if root.adding-source: VerticalLayout {
                        spacing: 8px;

                        SettingsGroup {
                            title: "New source";

                            SettingRow {
                                label: "Name";
                                description: "How the source appears in lists and bindings";
                                divider: false;
                                DSField {
                                    value <=> root.new-source-name;
                                    placeholder-text: "Weather API";
                                    focus-changed(f) => { root.name-focused = f; }
                                }
                            }

                            SettingRow {
                                label: "Type";
                                description: "The protocol Eustress uses to read it";
                                ComboBox {
                                    width: 300px;
                                    model: ["REST", "GraphQL", "PostgreSQL", "CSV", "Firebase", "Supabase"];
                                    current-value <=> root.new-source-type;
                                }
                            }

                            SettingRow {
                                // CSV points at a file, everything else at a
                                // service, so the label follows the type rather
                                // than calling a path a URL.
                                label: root.new-source-type == "CSV" ? "File path" : "Endpoint";
                                description: root.new-source-type == "CSV" ? "A CSV file on this machine" : "The URL or connection string";
                                DSField {
                                    value <=> root.new-source-url;
                                    placeholder-text: root.new-source-type == "CSV" ? "C:/data/readings.csv" : "https://api.example.com/v1";
                                    focus-changed(f) => { root.url-focused = f; }
                                }
                            }
                        }

                        if !root.can-add: KitNotice {
                            kind: "info";
                            text: root.new-source-type == "CSV"
                                ? "Name and file path are both required."
                                : "Name and endpoint are both required.";
                        }
                    }

                    // ── Configured sources ──
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            padding-left: 2px;
                            KitSectionLabel { text: "Configured sources"; }
                        }

                        Rectangle {
                            background: Theme.background-secondary.with-alpha(0.6);
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-color;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                // Empty state
                                if root.sources.length == 0: VerticalLayout {
                                    padding-top: 28px;
                                    padding-bottom: 28px;
                                    spacing: 6px;
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            width: 22px;
                                            height: 22px;
                                            source: @image-url("../../assets/icons/ui/database.svg");
                                            image-fit: contain;
                                            colorize: Theme.text-disabled;
                                        }
                                    }

                                    Text {
                                        text: "No data sources yet";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-md;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "Add a source to connect to external APIs and databases.";
                                        color: Theme.text-disabled;
                                        font-size: Theme.font-xs;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Sources list
                                for source in root.sources: Rectangle {
                                    // Three lines: name, endpoint, last test.
                                    height: 58px;
                                    border-radius: Theme.radius-sm;
                                    background: source.id == root.selected-source ? Theme.accent-cyan.with-alpha(0.14)
                                        : source-touch.has-hover ? Theme.explorer-item-hover
                                        : transparent;
                                    animate background { duration: Theme.panel-anim-duration-fast * Theme.motion-scale; }

                                    source-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected-source = source.id; }
                                    }

                                    // The selection bar on the left edge.
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: source.id == root.selected-source ? 22px : 0px;
                                        border-radius: 1.5px;
                                        background: Theme.accent-cyan;
                                        animate height { duration: 120ms; easing: ease-out; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        // Standing connection status
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: source.status == "connected" ? Theme.text-success
                                                    : source.status == "error" ? Theme.text-error
                                                    : Theme.text-disabled;
                                            }
                                        }

                                        // Info
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            alignment: center;

                                            Text {
                                                text: source.name;
                                                color: Theme.text-primary;
                                                font-size: 12px;
                                                font-weight: source.id == root.selected-source ? 600 : 500;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: source.source-type + " · " + source.url;
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                overflow: elide;
                                            }

                                            // Where the Test button's answer lands.
                                            // Hidden until the source has been probed,
                                            // so an untested row stays quiet rather
                                            // than claiming an outcome it does not have.
                                            if source.test-state != "" && source.test-state != "idle": Text {
                                                text: root.test-label(source)
                                                    + (source.tested-at == "" ? "" : "  (" + source.tested-at + ")");
                                                color: root.test-color(source);
                                                font-size: Theme.font-xs;
                                                overflow: elide;
                                            }
                                        }

                                        // Actions. Stretch 0 so the buttons keep
                                        // their own width and the info column
                                        // takes the free space.
                                        VerticalLayout {
                                            horizontal-stretch: 0;
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 6px;

                                                KitButton {
                                                    horizontal-stretch: 0;
                                                    text: source.test-state == "testing" ? "Testing" : "Test";
                                                    has-icon: true;
                                                    icon: @image-url("../../assets/icons/ui/plug.svg");
                                                    enabled: source.test-state != "testing";
                                                    clicked => { root.on-test-source(source.id); }
                                                }

                                                KitButton {
                                                    horizontal-stretch: 0;
                                                    text: "Edit";
                                                    has-icon: true;
                                                    icon: @image-url("../../assets/icons/ui/pen.svg");
                                                    clicked => { root.on-edit-source(source.id); }
                                                }

                                                DSIconButton {
                                                    icon: @image-url("../../assets/icons/ui/delete.svg");
                                                    clicked => { root.on-remove-source(source.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Footer ──
            // Both buttons stay mounted and switch meaning with the form, so
            // neither is destroyed by its own click.
            DialogFooter {
                // The footer packs its children at their preferred width
                // against the right edge, so the count sits beside Close.
                Text {
                    text: root.sources.length == 1 ? "1 source" : "\{root.sources.length} sources";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }

                KitButton {
                    text: root.adding-source ? "Cancel" : "Close";
                    clicked => {
                        if root.adding-source {
                            root.adding-source = false;
                        } else {
                            root.on-close();
                        }
                    }
                }

                KitButton {
                    kind: "primary";
                    text: root.adding-source ? "Add" : "Add source";
                    has-icon: true;
                    icon: @image-url("../../assets/icons/ui/plus.svg");
                    enabled: !root.adding-source || root.can-add;
                    clicked => {
                        if root.adding-source {
                            root.on-add-source();
                        } else {
                            root.adding-source = true;
                        }
                    }
                }
            }
        }
    }
}
