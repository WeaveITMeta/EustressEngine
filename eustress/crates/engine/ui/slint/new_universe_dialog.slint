// ============================================================================
// New Universe Dialog: two-step creation, Universe name then Space name.
// Step 1: ask the user for the Universe folder name.
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Enter creates, Escape cancels; Create waits for a name.
// ============================================================================

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton } from "dialog_kit.slint";

export component NewUniverseDialog inherits Rectangle {
    in-out property <string> universe-name: "";

    callback on-create(/* universe-name */ string);
    callback on-cancel();

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-cancel(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(400px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/globe.svg");
            title: "New Universe";
            subtitle: "Step 1 of 2: name the Universe folder";
            close => { root.on-cancel(); }

            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.on-cancel();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Universe name";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: 600;
                        }

                        input-field := LineEdit {
                            text <=> root.universe-name;
                            placeholder-text: "My Universe";
                            init => { self.focus(); }
                            accepted(t) => { if t != "" { root.on-create(t); } }
                        }

                        Text {
                            text: "A Universe is a folder that holds your Spaces. Next you name its first Space.";
                            color: Theme.text-disabled;
                            font-size: Theme.font-xs;
                            wrap: word-wrap;
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Cancel";
                            clicked => { root.on-cancel(); }
                        }
                        KitButton {
                            text: "Create";
                            kind: "primary";
                            enabled: root.universe-name != "";
                            clicked => { root.on-create(root.universe-name); }
                        }
                    }
                }
            }
        }
    }
}
