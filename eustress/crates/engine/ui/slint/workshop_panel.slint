// ============================================================================
// Eustress Engine Studio - Workshop Panel
// Conversational ideation interface for product creation (System 0)
//
// Table of Contents:
//   1. Data Structures — ChatMessage, MCP command card, pipeline step
//   2. ChatBubble — message display (user, system, MCP command, approval gate)
//   3. MCPCommandCard — inline MCP endpoint display with approve/edit/skip
//   4. PipelineStep — compact step status indicator
//   5. WorkshopPanel — main panel with chat scroll, input, pipeline sidebar
// ============================================================================

import { VerticalBox, HorizontalBox, ScrollView, Button, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme, PanelHeader, SidePanelHeader } from "theme.slint";
import { MentionPopup, MentionItemData } from "mention_popup.slint";

export { MentionItemData }

// ============================================================================
// 1. Data Structures
// ============================================================================

// A table lifted out of a reply by `workshop::markdown::parse_blocks`.
//
// Cells are flattened row-major rather than nested, because Slint models do not
// nest arrays. `columns` is what turns the flat list back into a grid, and the
// Rust side guarantees `cells.length == rows * columns` by padding or
// truncating ragged rows, so the index arithmetic below can never read out of
// bounds.
export struct ChatTable {
    headers: [string],
    cells: [string],
    columns: int,
    // Explicit index models: 0..rows-1 and 0..columns-1, filled by Rust.
    //
    // Slint iterates a model, and while newer versions also accept a bare
    // integer as one, nothing else in this codebase relies on that. Two small
    // arrays cost almost nothing and remove the question entirely.
    row-indices: [int],
    col-indices: [int],
}

// One renderable run of a message: prose or a table, in order.
export struct ChatBlock {
    kind: string,        // "text" | "table"
    text: string,        // populated when kind == "text"
    table: ChatTable,    // populated when kind == "table"
}

// A single message in the ideation conversation
export struct ChatMessage {
    id: int,
    role: string,           // "user" | "system" | "mcp" | "approval" | "artifact" | "error"
    content: string,        // Message text (markdown-ish)
    timestamp: string,      // Display timestamp
    mcp-endpoint: string,   // For role="mcp": the MCP endpoint being called
    mcp-method: string,     // For role="mcp": GET/POST
    mcp-status: string,     // For role="mcp": "pending" | "approved" | "running" | "done" | "skipped" | "error"
    artifact-path: string,  // For role="artifact": file path of generated artifact
    artifact-type: string,  // For role="artifact": "patent" | "sota" | "requirements" | "mesh" | "toml" | "readme" | "catalog"
    // Entity-affordance fields — populated by `sync_workshop_to_slint`
    // when the tool call created or targeted a scene entity (e.g.
    // create_entity, update_entity). When `entity-name` is non-empty
    // the chat bubble renders a clickable entity chip with class icon
    // + name, and `select-entity(name)` fires when clicked so the
    // Explorer jumps to that entity.
    entity-class: string,   // class_name, e.g. "Part" | "SoulScript" | "BillboardGui"
    entity-name: string,    // human-readable entity name
    entity-icon: image,     // pre-loaded class icon (same source the Explorer uses)
    // Image the user attached to this message. Loaded from the message's
    // saved PNG by `sync_workshop_to_slint`, same as `entity-icon`, because
    // Slint can only resolve `@image-url` at compile time and this path is
    // only known at runtime.
    attachment: image,
    has-attachment: bool,
    // Message body split into prose and tables. Always at least one block, so
    // the renderer never has to special-case an empty message.
    blocks: [ChatBlock],
    // Tool rows (role "mcp"). `tool-summary` is the one-line argument preview
    // shown collapsed; `tool-input` (pretty-printed arguments) and
    // `tool-result` (what the tool returned) open on click. The Rust side caps
    // both, so an enormous result cannot stall layout.
    tool-summary: string,
    tool-input: string,
    tool-result: string,
    // Assistant rows: which model answered, e.g. "Sonnet 5".
    model-label: string,
}

// Past conversation summary for history browser
export struct ConversationSummary {
    session-id: string,
    /// Human-readable short label. Generated by Claude Haiku from the
    /// first user message when available; falls back to product_name,
    /// first-message preview, or a short session id otherwise. Always
    /// non-empty — safe to use directly in tab labels and list rows.
    title: string,
    product-name: string,     // e.g. "V-Cell 4680" or "Untitled"
    state: string,            // "idle" | "running" | "complete" etc.
    message-count: int,
    cost: string,             // formatted: "$1.23"
    last-active: string,      // formatted date: "Apr 11, 2026"
    preview: string,          // first user message (truncated)
}

// Pipeline step status for the compact sidebar
export struct PipelineStepData {
    index: int,
    label: string,
    status: string,         // "waiting" | "active" | "done" | "error" | "skipped"
    artifact-count: int,    // Number of files generated in this step
}

// One row of the model picker.
//
// The list is no longer a hardcoded array of names: it comes from the model
// catalog (`soul::workshop_model`), which the API worker recompiles nightly,
// so a model released this week appears here without a rebuild.
//
// Everything except `name` is presentation the Rust side has already resolved.
// `price` arrives preformatted and `section-start` is precomputed rather than
// derived here, because Slint has no grouping construct and no float
// formatting — doing it in Rust keeps one obvious place where a row is
// described, instead of arithmetic scattered through the layout.
export struct WorkshopModelEntry {
    name: string,           // "Sonnet 5" — also the id passed back to Rust
    provider: string,       // "Anthropic" — section header text
    tagline: string,        // one short line on what this model is for
    price: string,          // "$3 / $15 per Mtok", already formatted
    section-start: bool,    // first row of its provider group: draw the header
    key-missing: bool,      // selectable, but its BYOK key is not set yet
    is-new: bool,           // listed by its provider for your key, not yet in Eustress's table
}

// ============================================================================
// 2. Chat rows
// ============================================================================
//
// Every role gets its own shape, because each answers a different question:
//
//   user            what you asked           tinted bubble, indented left
//   system          what Workshop said       open prose under a quiet header
//   mcp             what Workshop did        one line, click to open
//   mcp (pending)   what it wants to do      a card that shows the arguments
//                                            before you say yes
//   notice          what changed             a centred muted line ("Stopped")
//   error           what went wrong          red-edged, never read as prose
//   artifact        what it produced         a clickable file chip
//
// Tool calls used to be full cards that hid their own arguments and results,
// so a ten-step turn was a wall of identical boxes saying nothing about what
// happened. Now each is one line, and a click opens its input and result.

// Prose and tables in order. Shared by every role that shows message text, so
// a table renders the same whoever wrote it.
component MessageBody inherits VerticalLayout {
    in property <[ChatBlock]> blocks: [];
    in property <brush> text-color: Theme.text-primary;
    spacing: 8px;

    for block in root.blocks: VerticalLayout {
        // ---- Prose ------------------------------------------------------
        if block.kind != "table": TextInput {
            text: block.text;
            color: root.text-color;
            font-size: 12px;
            wrap: word-wrap;
            read-only: true;
            single-line: false;
            selection-background-color: Theme.selection-background;
            selection-foreground-color: Theme.text-primary;
        }

        // ---- Table ------------------------------------------------------
        // Drawn as a real grid. Columns share the width evenly via
        // horizontal-stretch rather than measuring content, because a chat
        // row is narrow and a content-sized column would push the table off
        // the panel.
        if block.kind == "table": Rectangle {
            border-width: 1px;
            border-color: Theme.border-color;
            border-radius: 3px;
            background: Theme.background-secondary;

            // Columns line up because every cell declares `min-width: 0` and
            // an equal `horizontal-stretch`.
            //
            // Stretch ALONE is not enough: Slint first gives each Text its
            // content-derived minimum width and only shares out what is left
            // over, so a row holding "919 Wh/kg" and a row holding "98%"
            // resolve different boundaries and the columns visibly stagger.
            // Zeroing min-width removes the content term, so each row splits
            // its width into N equal shares and every row agrees.
            //
            // Deriving an explicit cell width from this Rectangle's own width
            // is the tempting fix and is a Slint binding loop: the container
            // is sized by its content, so width -> cell-w -> cell width ->
            // layoutinfo-h -> width. The compiler rejects it.
            VerticalLayout {
                padding: 1px;
                spacing: 0px;

                // Header row
                Rectangle {
                    background: Theme.background-tertiary;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 10px;
                        for h in block.table.headers: Text {
                            text: h;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            color: Theme.text-secondary;
                            font-size: 10.5px;
                            font-weight: 700;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }

                // Body. `r` and `c` are integer models, so the flat cell list
                // is addressed as r * columns + c.
                for r in block.table.row-indices: Rectangle {
                    background: mod(r, 2) == 1
                        ? Theme.background-tertiary.with-alpha(0.35)
                        : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 10px;
                        for c in block.table.col-indices: Text {
                            text: block.table.cells[r * block.table.columns + c];
                            horizontal-stretch: 1;
                            min-width: 0px;
                            color: Theme.text-primary;
                            font-size: 11px;
                            wrap: word-wrap;
                            // Centred so a wrapped two-line cell keeps its
                            // single-line neighbours on the same visual band.
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Small text button used across the Workshop: Run, Skip, Stop, Copy.
component PillButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> tint: Theme.button-background;
    in property <brush> tint-hover: Theme.button-hover;
    in property <brush> label-color: Theme.text-primary;
    in property <length> label-size: 10.5px;
    callback clicked();

    width: pill-label.preferred-width + 20px;
    height: 22px;
    border-radius: 5px;
    background: pill-touch.has-hover ? root.tint-hover : root.tint;

    pill-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    pill-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.label-color;
        font-size: root.label-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Muted inline "Copy" that confirms itself for a moment after a click, so the
// user knows the clipboard changed without a toast.
component CopyButton inherits Rectangle {
    in property <string> label: "Copy";
    callback clicked();
    property <bool> copied: false;

    width: copy-text-el.preferred-width + 12px;
    height: 16px;
    border-radius: 3px;
    background: copy-touch.has-hover ? Theme.button-hover : transparent;

    copy-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
            root.copied = true;
        }
    }

    // Runs only after a click, once, so an idle row costs no wakeups.
    Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    copy-text-el := Text {
        width: parent.width;
        height: parent.height;
        text: root.copied ? "Copied" : root.label;
        color: root.copied ? Theme.accent-green
            : copy-touch.has-hover ? Theme.text-primary : Theme.text-disabled;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ChatBubble inherits VerticalLayout {
    in property <string> role: "system";
    in property <string> content: "";
    in property <[ChatBlock]> blocks: [];
    in property <string> timestamp: "";
    in property <string> mcp-endpoint: "";
    in property <string> mcp-method: "";
    in property <string> mcp-status: "pending";
    in property <string> artifact-path: "";
    in property <string> artifact-type: "";
    in property <int> message-id: 0;

    // Entity affordances (see ChatMessage struct comments)
    in property <string> entity-class: "";
    in property <string> entity-name: "";
    in property <image>  entity-icon;

    // Attached image (see ChatMessage struct comments)
    in property <image>  attachment;
    in property <bool>   has-attachment: false;

    in property <string> tool-summary: "";
    in property <string> tool-input: "";
    in property <string> tool-result: "";
    in property <string> model-label: "";

    // Flipped by the panel twice a second while Workshop is working, so a
    // running tool's dot breathes without every row owning a timer.
    in property <bool> pulse: false;

    callback approve-mcp(int);
    callback skip-mcp(int);
    callback open-artifact(string);
    callback select-entity(string);
    callback copy-text(string);

    // Whether this tool row is open. Local to the row, and it survives new
    // messages arriving because the host updates the message model in place
    // rather than replacing it, so this instance is never rebuilt under you.
    property <bool> expanded: false;
    property <bool> is-tool: root.role == "mcp";
    property <bool> is-pending: root.is-tool && root.mcp-status == "pending";
    property <bool> is-active-tool: root.is-tool
        && (root.mcp-status == "running" || root.mcp-status == "approved");

    padding-left: 8px;
    padding-right: 8px;
    padding-top: root.is-tool && !root.is-pending ? 1px : 5px;
    padding-bottom: root.is-tool && !root.is-pending ? 1px : 5px;
    spacing: 3px;

    // ── You ─────────────────────────────────────────────────────────────────
    if root.role == "user": HorizontalLayout {
        // Indented, lightly tinted: your own words read as yours at a glance
        // without a heavy coloured bubble.
        padding-left: 28px;

        Rectangle {
            background: Theme.accent-blue.with-alpha(0.14);
            border-radius: 10px;

            VerticalLayout {
                padding-left: 11px;
                padding-right: 11px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                // The picture is usually the subject and the words the
                // question about it, so it goes first. Capped in height so a
                // tall screenshot cannot push the conversation off screen.
                if root.has-attachment: Image {
                    source: root.attachment;
                    height: min(self.preferred-height, 220px);
                    image-fit: contain;
                    horizontal-alignment: left;
                }

                MessageBody {
                    blocks: root.blocks;
                }
            }
        }
    }

    if root.role == "user" && root.timestamp != "": Text {
        text: root.timestamp;
        color: Theme.text-disabled;
        font-size: 9px;
        horizontal-alignment: right;
    }

    // ── Workshop's reply ────────────────────────────────────────────────────
    if root.role == "system" || root.role == "approval": VerticalLayout {
        spacing: 4px;

        HorizontalLayout {
            height: 16px;
            spacing: 6px;

            Text {
                text: "Workshop";
                color: root.role == "approval" ? Theme.accent-orange : Theme.accent-eustress;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.model-label != "": Text {
                text: root.model-label;
                color: Theme.text-disabled;
                font-size: 9px;
                vertical-alignment: center;
            }

            if root.timestamp != "": Text {
                text: root.timestamp;
                color: Theme.text-disabled;
                font-size: 9px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            CopyButton {
                clicked => { root.copy-text(root.content); }
            }
        }

        MessageBody {
            blocks: root.blocks;
        }
    }

    // ── A tool Workshop ran, or is running ──────────────────────────────────
    if root.is-tool && !root.is-pending: Rectangle {
        height: 24px;
        border-radius: 5px;
        background: row-touch.has-hover || root.expanded ? Theme.background-tertiary : transparent;

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expanded = !root.expanded; }
        }

        // Status as a shape, not a glyph: a font without the character would
        // draw a box, and these have to read at a glance.
        status-icon := Rectangle {
            x: 7px;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;

            if root.mcp-status == "done": Image {
                width: 12px;
                height: 12px;
                source: @image-url("../../assets/icons/ui/check.svg");
                image-fit: contain;
                colorize: Theme.accent-green;
            }

            if root.mcp-status == "error": Image {
                x: 1px;
                y: 1px;
                width: 10px;
                height: 10px;
                source: @image-url("../../assets/icons/ui/close.svg");
                image-fit: contain;
                colorize: Theme.accent-red;
            }

            if root.mcp-status == "skipped": Rectangle {
                x: 2px;
                y: 5px;
                width: 8px;
                height: 2px;
                border-radius: 1px;
                background: Theme.text-disabled;
            }

            if root.is-active-tool: Rectangle {
                x: 2px;
                y: 2px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent-eustress;
                opacity: root.pulse ? 0.3 : 1.0;
                animate opacity { duration: 450ms; }
            }
        }

        tool-name := Text {
            x: status-icon.x + status-icon.width + 7px;
            y: (parent.height - self.height) / 2;
            width: min(self.preferred-width, parent.width * 0.5);
            text: root.mcp-endpoint;
            color: root.mcp-status == "skipped" ? Theme.text-secondary : Theme.text-primary;
            font-family: "Consolas";
            font-size: 11px;
            font-weight: 600;
            overflow: elide;
        }

        Text {
            x: tool-name.x + tool-name.width + 8px;
            y: (parent.height - self.height) / 2;
            width: max(0px, parent.width - self.x - 22px);
            text: root.mcp-status == "skipped" ? "skipped"
                : root.mcp-status == "error" && root.tool-summary == "" ? "failed"
                : root.tool-summary;
            color: root.mcp-status == "error" ? Theme.text-error : Theme.text-secondary;
            font-size: 10.5px;
            overflow: elide;
        }

        Text {
            x: parent.width - 16px;
            y: (parent.height - self.height) / 2;
            text: root.expanded ? "▾" : "▸";
            color: Theme.text-disabled;
            font-size: 9px;
        }
    }

    // Opened tool row: exactly what went in and what came back, selectable.
    if root.is-tool && !root.is-pending && root.expanded: Rectangle {
        background: Theme.background-secondary;
        border-radius: 5px;
        border-width: 1px;
        border-color: Theme.border-color;

        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            HorizontalLayout {
                height: 16px;

                Text {
                    text: "INPUT";
                    color: Theme.text-disabled;
                    font-size: 8.5px;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                CopyButton {
                    label: "Copy input";
                    clicked => { root.copy-text(root.tool-input); }
                }
            }

            TextInput {
                text: root.tool-input != "" ? root.tool-input : "(no arguments)";
                color: Theme.text-primary;
                font-family: "Consolas";
                font-size: 10.5px;
                wrap: word-wrap;
                read-only: true;
                single-line: false;
                selection-background-color: Theme.selection-background;
                selection-foreground-color: Theme.text-primary;
            }

            if root.tool-result != "": HorizontalLayout {
                height: 16px;

                Text {
                    text: root.mcp-status == "error" ? "ERROR" : "RESULT";
                    color: root.mcp-status == "error" ? Theme.accent-red : Theme.text-disabled;
                    font-size: 8.5px;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                CopyButton {
                    label: "Copy result";
                    clicked => { root.copy-text(root.tool-result); }
                }
            }

            if root.tool-result != "": TextInput {
                text: root.tool-result;
                color: root.mcp-status == "error" ? Theme.text-error : Theme.text-primary;
                font-family: "Consolas";
                font-size: 10.5px;
                wrap: word-wrap;
                read-only: true;
                single-line: false;
                selection-background-color: Theme.selection-background;
                selection-foreground-color: Theme.text-primary;
            }

            if root.tool-result == "" && root.is-active-tool: Text {
                text: "Running…";
                color: Theme.text-secondary;
                font-size: 10px;
            }
        }
    }

    // ── A tool waiting for your yes ─────────────────────────────────────────
    //
    // The arguments are open by default: this is the moment you most need to
    // see exactly what is about to happen.
    if root.is-pending: Rectangle {
        background: Theme.accent-orange.with-alpha(0.08);
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent-orange.with-alpha(0.5);

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            Text {
                text: "Workshop wants to run";
                color: Theme.accent-orange;
                font-size: 10px;
                font-weight: 700;
            }

            Text {
                text: root.mcp-endpoint;
                color: Theme.text-primary;
                font-family: "Consolas";
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
            }

            if root.tool-input != "": Rectangle {
                background: Theme.background-secondary;
                border-radius: 5px;

                VerticalLayout {
                    padding: 8px;

                    TextInput {
                        text: root.tool-input;
                        color: Theme.text-primary;
                        font-family: "Consolas";
                        font-size: 10.5px;
                        wrap: word-wrap;
                        read-only: true;
                        single-line: false;
                        selection-background-color: Theme.selection-background;
                        selection-foreground-color: Theme.text-primary;
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                height: 24px;

                PillButton {
                    height: 24px;
                    label: "Run";
                    tint: Theme.accent-green.with-alpha(0.85);
                    tint-hover: Theme.accent-green;
                    label-color: white;
                    clicked => { root.approve-mcp(root.message-id); }
                }

                PillButton {
                    height: 24px;
                    label: "Skip";
                    clicked => { root.skip-mcp(root.message-id); }
                }

                // Typing a message while this is waiting skips it and tells
                // Workshop what to do instead, in one step.
                Text {
                    horizontal-stretch: 1;
                    text: "or reply below to redirect";
                    color: Theme.text-secondary;
                    font-size: 9.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Entity chip: the tool created or targeted a scene entity. Clicking
    // selects it and scrolls the Explorer to it. Icon and name are centred
    // with explicit y arithmetic, because a HorizontalLayout top-aligns
    // fixed-height children.
    if root.is-tool && root.entity-name != "": Rectangle {
        height: 26px;
        background: entity-touch.has-hover ? Theme.accent-blue.with-alpha(0.22) : Theme.accent-blue.with-alpha(0.10);
        border-radius: 4px;
        border-width: 1px;
        border-color: entity-touch.has-hover ? Theme.accent-blue : Theme.accent-blue.with-alpha(0.35);

        entity-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.select-entity(root.entity-name); }
        }

        entity-icon-img := Image {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: root.entity-icon;
            image-fit: contain;
        }

        entity-name-text := Text {
            x: entity-icon-img.x + entity-icon-img.width + 8px;
            y: (parent.height - self.height) / 2;
            width: parent.width - self.x - entity-class-text.width - 16px;
            text: root.entity-name;
            color: Theme.text-primary;
            font-size: 11px;
            font-weight: 600;
            font-family: "Consolas";
            overflow: elide;
        }

        entity-class-text := Text {
            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            text: root.entity-class;
            color: Theme.text-secondary;
            font-size: 10px;
        }
    }

    // ── A note from Workshop itself: stopped, skipped, redirected ───────────
    if root.role == "notice": Text {
        text: root.content;
        color: Theme.text-secondary;
        font-size: 10px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    // ── What went wrong ─────────────────────────────────────────────────────
    if root.role == "error": Rectangle {
        background: Theme.accent-red.with-alpha(0.08);
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.accent-red.with-alpha(0.35);

        VerticalLayout {
            padding: 10px;
            spacing: 4px;

            HorizontalLayout {
                height: 16px;

                Text {
                    text: "Something went wrong";
                    color: Theme.accent-red;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                CopyButton {
                    clicked => { root.copy-text(root.content); }
                }
            }

            MessageBody {
                blocks: root.blocks;
                text-color: Theme.text-error;
            }
        }
    }

    // ── A file Workshop produced ────────────────────────────────────────────
    if root.role == "artifact": Rectangle {
        height: 26px;
        background: artifact-touch.has-hover ? Theme.accent-green.with-alpha(0.2) : Theme.accent-green.with-alpha(0.1);
        border-radius: 5px;

        artifact-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-artifact(root.artifact-path); }
        }

        artifact-icon := Image {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../../assets/icons/ui/new-file.svg");
            image-fit: contain;
            colorize: Theme.accent-green;
        }

        Text {
            x: artifact-icon.x + artifact-icon.width + 8px;
            y: (parent.height - self.height) / 2;
            width: parent.width - self.x - 8px;
            text: root.artifact-path;
            color: Theme.accent-green;
            font-size: 11px;
            font-family: "Consolas";
            overflow: elide;
        }
    }
}

// ============================================================================
// 3. PipelineStep — compact step indicator in sidebar
// ============================================================================

component PipelineStep inherits Rectangle {
    in property <int> index: 0;
    in property <string> label: "";
    in property <string> status: "waiting";
    in property <int> artifact-count: 0;

    height: 28px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        // Status dot
        VerticalLayout {
            alignment: center;
            width: 10px;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.status == "done" ? Theme.accent-green :
                            root.status == "active" ? Theme.accent-blue :
                            root.status == "error" ? Theme.accent-red :
                            root.status == "skipped" ? Theme.text-disabled :
                            Theme.text-disabled;
            }
        }

        // Step label
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.status == "active" ? Theme.text-primary :
                   root.status == "done" ? Theme.text-success :
                   root.status == "error" ? Theme.text-error :
                   Theme.text-secondary;
            font-size: 11px;
            font-weight: root.status == "active" ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        // Artifact count badge
        if root.artifact-count > 0: Rectangle {
            width: 18px;
            height: 16px;
            background: Theme.accent-green.with-alpha(0.2);
            border-radius: 8px;

            Text {
                text: root.artifact-count;
                color: Theme.accent-green;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ============================================================================
// 4. WorkshopPanel — main conversational ideation panel
// ============================================================================

export component WorkshopPanel inherits Rectangle {
    // ---- Properties ----
    in property <[ChatMessage]> messages: [];
    in-out property <string> input-text: "";
    in property <[PipelineStepData]> pipeline-steps: [];
    // True when the chat TextInput or command bar is focused. The host
    // reads this to gate engine keyboard handling — without it, WASD /
    // shortcut keys leak through to the viewport while the user is
    // typing a message, moving the camera under their fingers.
    out property <bool> input-has-focus: input-area.has-focus;

    // The status bar + step list hide on idle/conversing so the panel
    // doesn't look like it's working when the user is just chatting.
    in property <string> pipeline-state: "idle";
    // Collapsed by default — user clicks the chevron in the status row
    // to drop down the 13-step detail list. Without this the step list
    // took ~400 px of vertical space on every frame of real work.
    in-out property <bool> pipeline-steps-expanded: false;
    in property <string> product-name: "";
    in property <int> total-artifacts: 0;
    in property <string> estimated-cost: "$0.00";
    in property <bool> api-key-valid: false;

    // Stage 2: Active modes (AI-inferred, multiple simultaneous) + command bar
    in property <string> active-modes-text: "⚡ General";   // formatted badge text
    in-out property <string> command-text: "";
    in property <int> tool-count: 0;
    in property <string> active-tool: "";          // currently executing tool name (empty = idle)

    // Conversation history — live list from SoulService/Workshop/.
    // Host refreshes this via `sync_workshop_sessions_to_slint` every
    // ~500 ms so new conversations appear without an engine restart.
    in property <[ConversationSummary]> past-conversations: [];
    /// Session id of the conversation currently loaded in the chat.
    /// Drives the highlighted tab in the session tab strip.
    in property <string> active-session-id: "";
    in-out property <bool> show-history-modal: false;
    in-out property <string> history-search: "";
    /// Fires when the user clicks the × on a session tab. The host
    /// handler removes the entry from `past-conversations` (it may
    /// also delete the on-disk folder — host decision).
    callback on-close-conversation(string);
    /// Fires when a drag-reorder ends. `session_id` is the tab that
    /// was dragged; `target_index` is its new 0-based position in
    /// `past-conversations`. Host maintains the order override and
    /// pushes the reordered list back on the next sync tick.
    callback on-reorder-tab(string /* session_id */, int /* target_index */);

    // ── Drag-to-reorder state ───────────────────────────────────────────
    // The dragged tab's session id while the mouse is held down on it,
    // plus the live x-offset relative to its resting position so we
    // can translate it during the drag. Slint has no native drag-drop
    // API; we synthesise it from TouchArea.pressed + mouse-x deltas.
    private property <string> drag-session-id: "";
    private property <length> drag-offset-x: 0px;
    // Horizontal cursor position (relative to the tab strip's left
    // edge) while dragging. Drives the target-index computation on
    // release and lives on the root so per-tab Rectangles can read it.
    private property <length> drag-cursor-x: 0px;
    // Approximate tab stride — the tabs use `min(180, label+40)` so a
    // uniform stride here is an acceptable heuristic; drop-zone math
    // rounds cursor-x / stride to pick the target index. If we ever
    // add variable-width tabs with per-tab bounds reporting we'd
    // replace this with an exact hit-test.
    private property <length> drag-tab-stride: 120px;

    // ── @ Mention autocomplete ───────────────────────────────────────────
    // Popup state driven by user typing. When the user types `@`, the host
    // (Bevy side) receives the query prefix, searches the MentionIndex,
    // and pushes results back via `mention-items`. Enter commits the
    // selected item, which replaces the `@foo` token in `input-text` with
    // the chosen entry's canonical path.
    in property <[MentionItemData]> mention-items: [];
    in-out property <bool> mention-popup-visible: false;
    in-out property <int> mention-selected-index: 0;
    /// Prefix the user has typed after `@` (no `@` char). Bevy side
    /// watches this and re-queries on change.
    in-out property <string> mention-query: "";
    /// Character position where the `@` sits in `input-text`. Needed so
    /// commit can splice the chip in exactly the right spot.
    in-out property <int> mention-at-pos: -1;

    callback on-mention-query-changed(string);  // emit when prefix changes
    callback on-mention-commit(int);            // item index committed (also fires record_usage)
    callback on-mention-cancel();               // popup dismissed without commit

    // ── Image attachment ─────────────────────────────────────────────────
    // Set by Rust when the user pastes an image (Ctrl+V) or clicks the
    // attach button. Clear by clicking the × on the preview strip.
    in-out property <image> attached-image;
    in-out property <bool> has-attached-image: false;
    callback on-attach-image();      // user clicked the attach / paste button
    callback on-clear-image();       // user clicked × on preview

    // ── Mode selector ────────────────────────────────────────────────────
    // The active mode name shown in the dropdown (e.g. "General").
    // Rust keeps this in sync with the engine's ActiveModes.
    in-out property <string> active-mode-name: "General";
    // Fires when the user picks a different mode from the dropdown.
    callback on-mode-changed(string);
    // Available mode names (populated once at startup).
    in property <[string]> available-modes: ["General", "Simulation", "Manufacturing", "Fabrication", "Finance", "Shopping", "Travel", "Supply Chain", "Warehousing", "Universe"];

    // ── Model selector ───────────────────────────────────────────────────
    // Which model powers this conversation's executor (e.g. "Sonnet 5").
    // Rust keeps this in sync with GlobalSoulSettings::workshop_model.
    in-out property <string> active-model-name: "Sonnet 5";
    // Fires when the user picks a different model from the dropdown.
    callback on-model-changed(string);
    // Available models — one global list, not mode-specific. Rust fills this
    // from the model catalog; the default below is the compiled-in seed, so
    // the .slint previews on its own and a catalog fetch that never lands
    // still shows a full picker.
    in property <[WorkshopModelEntry]> available-models: [
        { name: "Sonnet 5", provider: "Anthropic", tagline: "Balanced speed and depth. The everyday driver.", price: "$2 / $10 per Mtok", section-start: true, key-missing: false },
        { name: "Opus 5.5", provider: "Anthropic", tagline: "The newest Opus. Deep reasoning at a lower price.", price: "$4 / $20 per Mtok", section-start: false, key-missing: false },
        { name: "Opus 5", provider: "Anthropic", tagline: "Deeper reasoning for work that has to be right.", price: "$5 / $25 per Mtok", section-start: false, key-missing: false },
        { name: "Fable 5.1", provider: "Anthropic", tagline: "Always-on thinking. The advisor on hard calls.", price: "$10 / $50 per Mtok", section-start: false, key-missing: false },
        { name: "Grok 4.6", provider: "xAI", tagline: "Fast and cheap, with live search built in.", price: "$2 / $6 per Mtok", section-start: true, key-missing: false },
        { name: "GPT-6 Astra", provider: "OpenAI", tagline: "OpenAI flagship. Long context, agentic reasoning.", price: "$10 / $50 per Mtok", section-start: true, key-missing: false },
    ];
    // How many provider groups the list above spans. Passed in rather than
    // derived because the popup's height has to be known before the rows are
    // laid out, and Slint cannot fold over a model to count the groups.
    in property <int> model-provider-count: 3;

    // ── Gauntlet toggle ──────────────────────────────────────────────────
    // AAA verify-loop mode. Off by default: it deliberately spends extra
    // tokens per artifact, so it's an explicit opt-in. Rust keeps this in
    // sync with GlobalSoulSettings::workshop_gauntlet.
    in-out property <bool> gauntlet-enabled: false;
    callback on-gauntlet-toggled(bool);

    // Auto mode: run approval-gated tools without stopping to ask. Syncs with
    // GlobalSoulSettings::workshop_auto_approve. Green rather than the
    // gauntlet's amber, because this one saves you work instead of spending
    // tokens.
    in-out property <bool> auto-enabled: false;
    callback on-auto-toggled(bool);

    // ── Chat scroll position ─────────────────────────────────────────────
    // Two-way bound to the chat ScrollView's viewport-y and out to the
    // window root, so it survives this panel being torn down on tab switch.
    // The host restores the value belonging to the active session.
    in-out property <length> chat-scroll-y: 0px;

    // Follow new messages while you are at the bottom, and stop following the
    // moment you scroll up to read. Hoisted to the window root beside
    // `chat-scroll-y` so it survives the panel being rebuilt on tab switch.
    in-out property <bool> chat-stick-bottom: true;

    // ── What the agent is doing right now ────────────────────────────────
    // Pushed by the host only when it changes. `agent-activity` is a short
    // phrase such as "Thinking" or "Running create_entity"; empty when idle.
    in property <bool> agent-busy: false;
    in property <string> agent-activity: "";
    // Tool calls waiting for Run or Skip.
    in property <int> pending-approvals: 0;
    // Messages typed while Workshop was busy. They send, in order, the moment
    // the current turn finishes. One line each, flattened by the host.
    in property <[string]> queued-messages: [];
    // Whether the key for the SELECTED model's provider is set. Distinct from
    // `api-key-valid`, which is the Anthropic key the ideation pipeline always
    // spends: picking Grok with only an xAI key must not claim a key is
    // missing, and must not enable the pipeline either.
    in property <bool> chat-key-valid: true;
    in property <string> chat-key-hint: "";
    // Your last message, recalled by Up in an empty input.
    in property <string> last-prompt: "";
    // Shown on an empty Workshop, one click each.
    in property <[string]> starter-prompts: [
        "Give me a quick tour of this Space",
        "Add a glowing blue Part above the spawn point",
        "Write a script that makes the selected Part spin",
        "Design a solid-state sodium-sulfur battery pack",
    ];

    callback on-stop-agent();
    callback on-approve-all();
    callback on-skip-all();
    callback on-remove-queued(int);
    callback on-copy-text(string);

    // Half-seconds this turn has been running, and a flip-flop that makes
    // running dots breathe. The timer only runs while busy, so an idle panel
    // costs no wakeups at all.
    property <int> busy-ticks: 0;
    property <bool> pulse: mod(root.busy-ticks, 2) == 1;
    changed agent-busy => { root.busy-ticks = 0; }
    busy-timer := Timer {
        interval: 500ms;
        running: root.agent-busy;
        triggered => { root.busy-ticks += 1; }
    }

    // One path for every way of sending: Enter, the send button, a starter
    // prompt. Sending always re-pins the chat to the bottom so your own
    // message, and the reply to it, come into view.
    function send-input() {
        if root.input-text == "" && !root.has-attached-image {
            return;
        }
        root.chat-stick-bottom = true;
        root.on-send-message(root.input-text);
        root.input-text = "";
    }

    /// Scan `input-text` for a trailing `@prefix` token; if found, open
    /// the popup and emit a query. Called from the input field's `edited`
    /// hook every keystroke. Cursor position isn't directly exposed by
    /// Slint's TextInput so we scan from the end — works perfectly for
    /// the common case (user types `@` at the caret).
    function update-mention-state() {
        // Find the last `@` in input-text. If the tail from there to end
        // contains whitespace, the user already closed a previous mention;
        // don't re-open.
        // Slint has no .find() for strings — emulate via manual scan.
        // For performance: input text is typically < 1 KB, linear scan is fine.
        //
        // Algorithm:
        //   1. Walk characters from end to start.
        //   2. If we hit whitespace before an `@`, no active mention.
        //   3. If we hit `@`, extract the tail after it as the query.
        //
        // We implement this in a compact inline form.
        //
        // NOTE: Slint .character-count and string slicing are limited; we
        // rely on the host callback to do the heavy lifting by passing
        // the raw input-text. The host parses it and pushes query back
        // via `mention-query` so the UI stays reactive.
        root.on-mention-query-changed(root.input-text);
    }

    // ---- Callbacks ----
    callback on-send-message(string);               // User sends a message
    callback on-approve-mcp(int);                   // User approves an MCP command by message id
    callback on-skip-mcp(int);                      // User skips an MCP command
    callback on-edit-mcp(int);                      // User wants to edit before running
    callback on-open-artifact(string);              // User clicks an artifact path
    callback on-select-entity(string);              // User clicks an entity chip in a chat bubble — select by name in Explorer
    callback on-start-pipeline();                   // Start the ideation pipeline
    callback on-pause-pipeline();                   // Pause to let user review
    callback on-resume-pipeline();                  // Resume after pause/edit
    callback on-cancel-pipeline();                  // Cancel the whole thing
    callback on-configure-api();                    // Open Soul Settings for API key
    callback on-optimize-and-build();               // Hand off to Systems 1-8
    callback on-execute-command(string);             // Command bar executed (Rune, /run workflow, etc.)
    callback on-load-conversation(string);           // Load a past conversation by session ID
    callback on-new-conversation();                  // Start a new conversation

    background: Theme.panel-background;

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Unified side-panel title — shared 36px gradient + bold
        // label + optional count badge, consistent with Properties /
        // History / Soul / Problems.
        SidePanelHeader {
            title: "Workshop";
            show-icon: true;
            icon: @image-url("../../assets/icons/wrench.svg");
        }

        // Secondary toolbar — + / history buttons moved here to keep
        // the title strip clean.
        Rectangle {
            height: 28px;
            background: Theme.header-background;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 4px;
                alignment: end;

                // New conversation button
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 3px;
                    background: new-conv-touch.has-hover ? Theme.button-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    new-conv-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.on-new-conversation(); }
                    }

                    Text {
                        text: "+";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // History button
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 3px;
                    background: hist-touch.has-hover ? Theme.button-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    hist-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-history-modal = true; }
                    }

                    Image {
                        width: 14px;
                        height: 14px;
                        source: @image-url("../../assets/icons/ui/history.svg");
                        image-fit: contain;
                        colorize: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── Session tab strip ───────────────────────────────────────────────
        //
        // Horizontal scrollable list of recent Workshop sessions. Each tab
        // shows the session's short title (Haiku-generated when available,
        // first-message fallback otherwise) and an × button. Clicking the
        // body switches the chat to that session; clicking × removes the
        // tab via `on-close-conversation`.
        //
        // Rendered only when there's at least one session on disk. An
        // empty strip takes zero vertical space so fresh installs aren't
        // cluttered.
        if root.past-conversations.length > 0: Rectangle {
            height: 32px;
            background: Theme.panel-background;

            // 1px bottom divider separating tabs from the chat area below.
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-color;
            }

            // Translate vertical scroll wheel into horizontal tab-strip
            // scrolling: down = scroll right, up = scroll left.
            // Large 120px steps so a single notch moves roughly one tab.
            TouchArea {
                scroll-event(event) => {
                    // delta-y > 0 when scrolling up (away from user).
                    // We want: scroll-up → shift tabs left (increase viewport-x toward 0).
                    //          scroll-down → shift tabs right (decrease viewport-x).
                    // Multiply delta-y by a large factor for fast movement.
                    let new-x = tab-flick.viewport-x + event.delta-y * 4;
                    // Clamp: viewport-x is <= 0 (leftmost), and >= -(content - visible)
                    let min-x = min(0px, -(tab-flick.viewport-width - tab-flick.width));
                    tab-flick.viewport-x = max(min-x, min(0px, new-x));
                    accept
                }
            }

            tab-flick := Flickable {
                x: 0px; y: 0px;
                width: 100%;
                height: 31px; // leave 1px for divider
                viewport-width: tab-row.preferred-width;
                viewport-height: self.height;

                tab-row := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: start;

                    // Outer Rectangle is a layout-controlled slot — only
                    // width/height/y live here because HorizontalLayout
                    // manages its children's x directly and Slint rejects
                    // any manual `x:` binding on a layout child. The
                    // visual tab (background, border, shadow, contents)
                    // is an inner Rectangle whose x shifts while dragging.
                    for conv[tab-index] in root.past-conversations: Rectangle {
                        property <bool> is-active: conv.session-id == root.active-session-id;
                        property <bool> is-dragging: conv.session-id == root.drag-session-id;
                        // Fixed tab width — referencing `label-text.preferred-width`
                        // from both this slot AND the nested tab-visual (whose
                        // HorizontalLayout contains label-text with
                        // horizontal-stretch + overflow: elide) tripped Slint's
                        // cycle detector. Uniform widths also match how
                        // VS Code / Chrome render their tab strips, so we pay
                        // a small readability cost (long titles elide) to get
                        // a stable layout.
                        width: 160px;
                        height: 26px;
                        y: 2px;
                        background: transparent;
                        clip: false;

                        // tab-touch is declared FIRST so tab-visual (and its
                        // nested close-touch) render on top and their
                        // TouchAreas win over this one for the × button.
                        // tab-touch lives at the layout slot (outside the
                        // translating tab-visual) so pressed-x / mouse-x
                        // stay in a stable coordinate frame during drag.
                        tab-touch := TouchArea {
                            mouse-cursor: is-dragging ? grabbing : pointer;

                            // Press-to-drag threshold: treat movement
                            // > 5px as a drag, anything less as a plain
                            // click. Without this threshold even tiny
                            // jitters on-click would register as drags.
                            pointer-event(ev) => {
                                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                                    root.drag-session-id = conv.session-id;
                                    root.drag-offset-x = 0px;
                                }
                                if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left {
                                    // Commit the reorder if we dragged far
                                    // enough in either direction. 0.5 tab-
                                    // widths is the threshold the cursor
                                    // must pass to snap into an adjacent slot.
                                    if root.drag-session-id == conv.session-id
                                       && abs(root.drag-offset-x / 1px) >= 30 {
                                        // Compute target index from cursor delta.
                                        // Positive delta → shift right; negative → left.
                                        // Clamp to [0, length-1].
                                        let raw = tab-index + round(root.drag-offset-x / root.drag-tab-stride);
                                        let clamped = max(0, min(root.past-conversations.length - 1, raw));
                                        root.on-reorder-tab(conv.session-id, clamped);
                                    }
                                    root.drag-session-id = "";
                                    root.drag-offset-x = 0px;
                                }
                            }

                            moved => {
                                if root.drag-session-id == conv.session-id && self.pressed {
                                    // mouse-x is relative to this TouchArea; pressed-x was
                                    // the initial grab position. Delta = live - initial.
                                    root.drag-offset-x = self.mouse-x - self.pressed-x;
                                }
                            }

                            clicked => {
                                // Only treat as a tab-switch click when
                                // we weren't dragging (offset stayed
                                // below the threshold on release).
                                if abs(root.drag-offset-x / 1px) < 5 {
                                    root.on-load-conversation(conv.session-id);
                                }
                            }
                        }

                        tab-visual := Rectangle {
                            // Match the fixed slot width. `parent.width`
                            // would pull through the outer Rectangle and
                            // Slint flagged that as recursive once
                            // label-text was nested here. A constant width
                            // sidesteps any layout-dependency chain.
                            width: 160px;
                            height: 26px;
                            // Translate the dragged tab by the cursor delta
                            // so it follows the mouse. A slight opacity drop
                            // + shadow reads as "being moved" since Slint
                            // doesn't expose z directly on layout children.
                            // NOTE: tab-touch stays OUTSIDE this Rectangle so
                            // it keeps its original coordinate frame — if
                            // the TouchArea translated with the visual, the
                            // self.mouse-x / self.pressed-x delta would chase
                            // its own tail and the drag would stall.
                            x: is-dragging ? root.drag-offset-x : 0px;
                            opacity: is-dragging ? 0.85 : 1.0;
                            background: is-active ? Theme.background-tertiary : (tab-touch.has-hover ? Theme.button-hover : transparent);
                            border-radius: 4px;
                            border-width: is-active || is-dragging ? 1px : 0px;
                            border-color: is-dragging ? Theme.accent-green : Theme.accent-blue;
                            drop-shadow-blur: is-dragging ? 12px : 0px;
                            drop-shadow-color: Theme.shadow-color;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 4px;
                                spacing: 4px;

                                label-text := Text {
                                    text: conv.title;
                                    color: is-active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: 11px;
                                    font-weight: is-active ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                // × close button. Only emits the callback —
                                // doesn't fire the outer tab click thanks to
                                // its own TouchArea eating the event.
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: close-touch.has-hover ? Theme.accent-red.with-alpha(0.25) : transparent;

                                    close-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.on-close-conversation(conv.session-id); }
                                    }

                                    Text {
                                        text: "×";
                                        color: close-touch.has-hover ? Theme.accent-red : Theme.text-disabled;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Thin horizontal scrollbar indicator — only visible when
            // tabs overflow the visible width. Sits on the 1px divider line.
            if tab-flick.viewport-width > tab-flick.width: Rectangle {
                x: {
                    // scroll-ratio: how far we've scrolled (0..1)
                    let scroll-range = tab-flick.viewport-width - tab-flick.width;
                    let ratio = scroll-range > 0px ? (-tab-flick.viewport-x / scroll-range) : 0;
                    let track-w = parent.width;
                    let thumb-w = max(30px, track-w * tab-flick.width / tab-flick.viewport-width);
                    ratio * (track-w - thumb-w)
                };
                y: parent.height - 3px;
                width: max(30px, parent.width * tab-flick.width / tab-flick.viewport-width);
                height: 2px;
                border-radius: 1px;
                background: #ffffff30;  // theme-exempt: translucent white scrollbar thumb, no matching neutral token
            }
        }

        // Missing key for the model you picked. Names the model and the
        // provider, because with three vendors in the picker "API key
        // required" no longer says which field to go and fill in.
        if !root.chat-key-valid: Rectangle {
            height: 34px;
            background: Theme.accent-yellow.with-alpha(0.14);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                Image {
                    width: 14px;
                    source: @image-url("../../assets/icons/ui/info.svg");
                    image-fit: contain;
                    colorize: Theme.accent-yellow;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.chat-key-hint != "" ? root.chat-key-hint : "Add an API key to start chatting.";
                    color: Theme.text-primary;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                PillButton {
                    label: "Add key";
                    clicked => { root.on-configure-api(); }
                }
            }
        }

        // ── Pipeline status row (only when work is happening or just done) ──
        //
        // Hidden entirely during `idle` and `conversing` — those are chat
        // states with nothing to report, and an empty progress bar was
        // making the panel look like it was churning when it wasn't.
        // `running | paused | complete | error` each get a one-line strip.
        if root.pipeline-state == "running"
            || root.pipeline-state == "paused"
            || root.pipeline-state == "complete"
            || root.pipeline-state == "error": Rectangle {
            height: 28px;
            background: root.pipeline-state == "complete" ? Theme.accent-green.with-alpha(0.2) :
                        root.pipeline-state == "error" ? Theme.accent-red.with-alpha(0.25) :
                        root.pipeline-state == "paused" ? Theme.accent-yellow.with-alpha(0.18) :
                        Theme.accent-blue.with-alpha(0.2);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Rectangle {
                    width: 8px;
                    y: (parent.height - self.height) / 2;
                    height: 8px;
                    border-radius: 4px;
                    background: root.pipeline-state == "running" ? Theme.accent-blue :
                                root.pipeline-state == "complete" ? Theme.accent-green :
                                root.pipeline-state == "paused" ? Theme.accent-yellow :
                                Theme.accent-red;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.pipeline-state == "running" ? "Creating " + root.product-name :
                          root.pipeline-state == "complete" ? root.product-name + " ready" :
                          root.pipeline-state == "paused" ? "Waiting for your input" :
                          "Pipeline error";
                    color: Theme.text-primary;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: "~" + root.estimated-cost;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.total-artifacts + " files";
                    color: Theme.accent-green;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                // Cancel: saves the session, then resets the pipeline.
                if root.pipeline-state == "running" || root.pipeline-state == "paused": Rectangle {
                    width: 52px;
                    y: (parent.height - self.height) / 2;
                    height: 20px;
                    border-radius: 3px;
                    background: cancel-touch.has-hover ? Theme.button-hover : transparent;

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.on-cancel-pipeline(); }
                    }

                    Text {
                        text: "Cancel";
                        color: Theme.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Expand/collapse the per-step detail list.
                Rectangle {
                    width: 20px;
                    y: (parent.height - self.height) / 2;
                    height: 20px;
                    border-radius: 3px;
                    background: chevron-touch.has-hover ? Theme.button-hover : transparent;
                    visible: root.pipeline-steps.length > 0;

                    chevron-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.pipeline-steps-expanded = !root.pipeline-steps-expanded;
                        }
                    }

                    Text {
                        text: root.pipeline-steps-expanded ? "▾" : "▸";
                        color: Theme.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── Start: build the brief from the conversation so far ────────────
        if root.pipeline-state == "conversing" && root.messages.length > 0: Rectangle {
            height: 32px;
            background: Theme.background-secondary;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.api-key-valid
                        ? "Ready? The brief is built from this conversation."
                        : "Add an API key to build the brief.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    width: 96px;
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    border-radius: 4px;
                    background: !root.api-key-valid ? Theme.button-background
                        : start-touch.has-hover ? Theme.accent-blue.darker(0.15) : Theme.accent-blue;
                    opacity: root.api-key-valid ? 1.0 : 0.5;

                    start-touch := TouchArea {
                        enabled: root.api-key-valid;
                        mouse-cursor: root.api-key-valid ? pointer : default;
                        clicked => { root.on-start-pipeline(); }
                    }

                    Text {
                        text: "Start pipeline";
                        color: Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── Step detail list — only when user expands the chevron ───────────
        //
        // The 13-step vertical list used to show permanently and ate the
        // whole chat panel. Now it's opt-in: click the chevron in the
        // status row to drop it down, capped to 180px with a scroll.
        if root.pipeline-steps-expanded
            && root.pipeline-steps.length > 0
            && (root.pipeline-state == "running"
                || root.pipeline-state == "paused"
                || root.pipeline-state == "complete"): Rectangle {
            max-height: 180px;
            background: Theme.background-secondary;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for step in root.pipeline-steps: PipelineStep {
                        index: step.index;
                        label: step.label;
                        status: step.status;
                        artifact-count: step.artifact-count;
                    }
                }
            }
        }

        // ── Empty conversation ─────────────────────────────────────────────
        //
        // Says what Workshop can actually do, then offers prompts that
        // exercise it. The old copy pitched only the product pipeline, which
        // is one thing Workshop does, not the agent it has become.
        if root.messages.length == 0: Rectangle {
            vertical-stretch: 1;
            background: Theme.panel-background;

            VerticalLayout {
                alignment: center;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    height: 34px;

                    Image {
                        width: 34px;
                        height: 34px;
                        source: @image-url("../../assets/icons/ui/sparkle.svg");
                        image-fit: contain;
                        colorize: Theme.accent-eustress;
                        opacity: 0.85;
                    }
                }

                Text {
                    text: "What should we build?";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Workshop builds and edits this Space, writes scripts, runs simulations and explains what it finds. It asks before anything risky.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    padding-top: 6px;
                    spacing: 5px;

                    for prompt in root.starter-prompts: Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: prompt-touch.has-hover ? Theme.accent-eustress.with-alpha(0.6) : Theme.border-color;
                        background: prompt-touch.has-hover ? Theme.accent-eustress.with-alpha(0.08) : transparent;

                        prompt-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.chat-stick-bottom = true;
                                root.on-send-message(prompt);
                            }
                        }

                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: prompt;
                            color: Theme.text-primary;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Text {
                    text: "Enter to send · Shift+Enter for a new line · @ to mention · Ctrl+V to paste an image";
                    color: Theme.text-disabled;
                    font-size: 9.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.messages.length > 0: Rectangle {
            vertical-stretch: 1;

            chat-scroll := ScrollView {
                width: parent.width;
                height: parent.height;

                // Chat scroll offset is hoisted to the panel root, and from
                // there to the window root, because the right-hand dock
                // instantiates this panel with `if right-tab-index == 3`.
                // Switching tabs away destroys the whole component, so anything
                // held in here (and in the ScrollView's own viewport-y) is gone
                // on return. The host keys the saved value by session id, so
                // each conversation comes back where you left it.
                viewport-y <=> root.chat-scroll-y;

                // Follow new output while you are at the bottom. Nothing used
                // to, so every reply landed below the fold and had to be
                // scrolled to by hand. `changed` runs once the content has
                // grown, so this lands exactly on the new bottom.
                changed viewport-height => {
                    if root.chat-stick-bottom {
                        self.viewport-y = min(0px, -(self.viewport-height - self.visible-height));
                    }
                }

                // Any scroll (wheel, drag, the host restoring a saved offset)
                // re-decides whether we are following. Within 24px of the
                // bottom counts as at the bottom.
                changed viewport-y => {
                    root.chat-stick-bottom = self.viewport-y
                        <= min(0px, -(self.viewport-height - self.visible-height)) + 24px;
                }

                // Forwards wheel events so scrolling still works while a
                // message's read-only TextInput has focus, which otherwise
                // swallows them.
                //
                // There used to be an edge auto-scroll here as well: a 16ms
                // timer that ran whenever the pointer was over the chat and
                // scrolled it whenever the pointer rested within 40px of the
                // top or bottom edge. Resting the mouse above the input box, or
                // passing it up to the tabs, scrolled the conversation by
                // itself, and it woke the UI sixty times a second while
                // hovering. Removed.
                scroll-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    scroll-event(ev) => {
                        let max-vp = max(0px, chat-scroll.viewport-height - chat-scroll.visible-height);
                        chat-scroll.viewport-y = clamp(
                            chat-scroll.viewport-y + ev.delta-y,
                            -max-vp,
                            0px
                        );
                        accept
                    }
                }

                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 10px;
                    spacing: 0px;

                    for msg in root.messages: ChatBubble {
                        role: msg.role;
                        content: msg.content;
                        blocks: msg.blocks;
                        timestamp: msg.timestamp;
                        mcp-endpoint: msg.mcp-endpoint;
                        mcp-method: msg.mcp-method;
                        mcp-status: msg.mcp-status;
                        artifact-path: msg.artifact-path;
                        artifact-type: msg.artifact-type;
                        entity-class: msg.entity-class;
                        entity-name: msg.entity-name;
                        entity-icon: msg.entity-icon;
                        attachment: msg.attachment;
                        has-attachment: msg.has-attachment;
                        tool-summary: msg.tool-summary;
                        tool-input: msg.tool-input;
                        tool-result: msg.tool-result;
                        model-label: msg.model-label;
                        message-id: msg.id;
                        pulse: root.pulse;

                        approve-mcp(id) => { root.on-approve-mcp(id); }
                        skip-mcp(id) => { root.on-skip-mcp(id); }
                        open-artifact(path) => { root.on-open-artifact(path); }
                        select-entity(name) => { root.on-select-entity(name); }
                        copy-text(text) => { root.on-copy-text(text); }
                    }
                }
            }

            // Only when you have scrolled away from where new output lands.
            if !root.chat-stick-bottom: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 10px;
                width: jump-label.preferred-width + 26px;
                height: 24px;
                border-radius: 12px;
                background: jump-touch.has-hover ? Theme.button-hover : Theme.dialog-background;
                border-width: 1px;
                border-color: Theme.border-color;
                drop-shadow-blur: 8px;
                drop-shadow-color: Theme.shadow-float;

                jump-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.chat-stick-bottom = true;
                        chat-scroll.viewport-y = min(0px, -(chat-scroll.viewport-height - chat-scroll.visible-height));
                    }
                }

                jump-label := Text {
                    width: parent.width;
                    height: parent.height;
                    text: "↓  Jump to latest";
                    color: Theme.text-primary;
                    font-size: 10.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // "Optimize & Build" handoff button (shown when ideation is complete)
        if root.pipeline-state == "complete": Rectangle {
            height: 44px;
            background: Theme.accent-green.with-alpha(0.2);

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    background: optimize-touch.has-hover ? Theme.accent-green : Theme.accent-green.with-alpha(0.8);
                    border-radius: 4px;

                    optimize-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.on-optimize-and-build(); }
                    }

                    HorizontalLayout {
                        // Centre the 14px child in the 28px row. A HorizontalLayout does
                        // NOT centre a fixed-height child: lower_layout pins it at
                        // y = padding.top and leaves its height alone, so with no vertical
                        // padding it sat flush against the top with 14px of dead space below.
                        padding-top: 7px;
                        padding-bottom: 7px;
                        alignment: center;
                        spacing: 6px;

                        Image {
                            width: 14px;
                            height: 14px;
                            source: @image-url("../../assets/icons/ui/play.svg");
                            image-fit: contain;
                            colorize: white;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Optimize & Build (Systems 1-8)";
                            color: white;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── What Workshop is doing right now ───────────────────────────────
        //
        // The agent loop does not stream, so between Send and the reply there
        // used to be nothing on screen at all: no sign the model was working,
        // no way to stop it. This strip is that sign, and it owns Stop.
        // Approvals outrank activity, because a waiting approval is the one
        // thing only you can unblock.
        if root.agent-busy || root.pending-approvals > 0: Rectangle {
            height: 32px;
            background: root.pending-approvals > 0
                ? Theme.accent-orange.with-alpha(0.10)
                : Theme.accent-eustress.with-alpha(0.07);

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border-color;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    width: 8px;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.pending-approvals > 0 ? Theme.accent-orange : Theme.accent-eustress;
                        opacity: root.pending-approvals > 0 || !root.pulse ? 1.0 : 0.3;
                        animate opacity { duration: 450ms; }
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.pending-approvals == 1 ? "Waiting for your approval"
                        : root.pending-approvals > 1 ? root.pending-approvals + " actions need your approval"
                        : (root.agent-activity != "" ? root.agent-activity : "Working")
                            + (root.busy-ticks >= 2 ? "  ·  " + floor(root.busy-ticks / 2) + "s" : "");
                    color: Theme.text-primary;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.pending-approvals > 1: PillButton {
                    label: "Run all";
                    tint: Theme.accent-green.with-alpha(0.85);
                    tint-hover: Theme.accent-green;
                    label-color: white;
                    clicked => { root.on-approve-all(); }
                }

                if root.pending-approvals > 1: PillButton {
                    label: "Skip all";
                    clicked => { root.on-skip-all(); }
                }

                if root.agent-busy && root.pending-approvals == 0: PillButton {
                    label: "Stop";
                    tint: Theme.accent-red.with-alpha(0.18);
                    tint-hover: Theme.accent-red.with-alpha(0.35);
                    label-color: Theme.accent-red;
                    clicked => { root.on-stop-agent(); }
                }
            }
        }

        // ── Messages waiting their turn ────────────────────────────────────
        //
        // A message sent while Workshop was working used to be appended ahead
        // of the reply it was waiting on, and then never answered: the guard
        // saw the assistant as the last to speak. Now it waits here, visibly,
        // and goes the moment the turn ends. × drops one.
        if root.queued-messages.length > 0: Rectangle {
            background: Theme.background-secondary;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 2px;
                spacing: 4px;

                Text {
                    text: root.queued-messages.length == 1
                        ? "Queued, sends when Workshop finishes"
                        : root.queued-messages.length + " queued, they send in order when Workshop finishes";
                    color: Theme.text-secondary;
                    font-size: 9.5px;
                }

                for queued[queued-index] in root.queued-messages: Rectangle {
                    height: 26px;
                    border-radius: 6px;
                    background: Theme.background-tertiary;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    Text {
                        x: 10px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: queued;
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        x: parent.width - 24px;
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;
                        background: unqueue-touch.has-hover ? Theme.accent-red.with-alpha(0.25) : transparent;

                        unqueue-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.on-remove-queued(queued-index); }
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "×";
                            color: unqueue-touch.has-hover ? Theme.accent-red : Theme.text-disabled;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Input area (always visible, dynamic height)
        Rectangle {
            min-height: 80px;
            background: Theme.background-secondary;

            // Top separator
            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border-color;
            }

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                // ── Mode dropdown + tool status row ──
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    alignment: start;

                    // Mode dropdown pill
                    Rectangle {
                        width: mode-label.preferred-width + 28px;
                        height: 24px;
                        background: mode-touch.has-hover ? Theme.background-tertiary : transparent;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border-color;

                        mode-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { mode-popup.show(); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 4px;
                            alignment: center;

                            mode-label := Text {
                                text: root.active-mode-name;
                                color: Theme.text-secondary;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "▾";
                                color: Theme.text-secondary;
                                font-size: 9px;
                                vertical-alignment: center;
                            }
                        }

                        mode-popup := PopupWindow {
                            x: 0px;
                            // Exact content height, and y derived from it so
                            // the two can never disagree. The previous
                            // independent `min()` caps did: with 10 modes the
                            // content needed 248px while height capped at
                            // 208px, clipping the last ~2 entries, and the
                            // separately-capped y put the popup's bottom edge
                            // *below* the pill so those entries overlapped the
                            // toolbar.
                            y: -(root.available-modes.length * 24px + 8px) - 4px;
                            width: 160px;
                            height: root.available-modes.length * 24px + 8px;

                            Rectangle {
                                background: Theme.background-secondary;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                drop-shadow-blur: 8px;
                                drop-shadow-color: Theme.shadow-float;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 0px;

                                    for m in root.available-modes: Rectangle {
                                        height: 24px;
                                        border-radius: 4px;
                                        background: m-touch.has-hover ? Theme.accent-blue.with-alpha(0.13) : transparent;

                                        m-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.active-mode-name = m;
                                                root.on-mode-changed(m);
                                                mode-popup.close();
                                            }
                                        }

                                        Text {
                                            x: 8px;
                                            text: m;
                                            color: m == root.active-mode-name ? Theme.accent-blue : Theme.text-primary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Model dropdown pill
                    Rectangle {
                        width: model-label.preferred-width + 28px;
                        height: 24px;
                        background: model-touch.has-hover ? Theme.background-tertiary : transparent;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border-color;

                        model-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { model-popup.show(); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 4px;
                            alignment: center;

                            model-label := Text {
                                text: root.active-model-name;
                                color: Theme.text-secondary;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "▾";
                                color: Theme.text-secondary;
                                font-size: 9px;
                                vertical-alignment: center;
                            }
                        }

                        model-popup := PopupWindow {
                            x: 0px;
                            // Same derivation as the mode popup above — a
                            // popup taller than the space above the toolbar
                            // gets clipped, so the height is computed rather
                            // than guessed. A row is 46px (name, tagline, and
                            // price); a provider header adds 22px to the first
                            // row of its group.
                            y: -(root.available-models.length * 46px + root.model-provider-count * 22px + 8px) - 4px;
                            width: 292px;
                            height: root.available-models.length * 46px + root.model-provider-count * 22px + 8px;

                            Rectangle {
                                background: Theme.background-secondary;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                drop-shadow-blur: 8px;
                                drop-shadow-color: Theme.shadow-float;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 0px;

                                    for m in root.available-models: VerticalLayout {
                                        spacing: 0px;

                                        // Provider header. Drawn only on the
                                        // first row of each group, so the list
                                        // reads as three short sections rather
                                        // than one undifferentiated column.
                                        if m.section-start: Rectangle {
                                            height: 22px;
                                            Text {
                                                x: 8px;
                                                text: m.provider;
                                                color: Theme.text-secondary;
                                                font-size: 9px;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            height: 46px;
                                            border-radius: 4px;
                                            background: m.name == root.active-model-name
                                                ? Theme.accent-blue.with-alpha(0.13)
                                                : (mm-touch.has-hover ? Theme.background-tertiary : transparent);

                                            mm-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.active-model-name = m.name;
                                                    root.on-model-changed(m.name);
                                                    model-popup.close();
                                                }
                                            }

                                            // Selected marker. A left bar
                                            // rather than a checkmark column:
                                            // it reads at a glance and costs
                                            // no horizontal room on rows that
                                            // already carry three fields.
                                            if m.name == root.active-model-name: Rectangle {
                                                x: 0px;
                                                y: 8px;
                                                width: 2px;
                                                height: 30px;
                                                background: Theme.accent-blue;
                                                border-radius: 1px;
                                            }

                                            VerticalLayout {
                                                x: 10px;
                                                y: 6px;
                                                width: parent.width - 20px;
                                                spacing: 2px;

                                                HorizontalLayout {
                                                    spacing: 6px;

                                                    Text {
                                                        text: m.name;
                                                        color: m.name == root.active-model-name
                                                            ? Theme.accent-blue
                                                            : Theme.text-primary;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }

                                                    // Says the model is
                                                    // selectable but will not
                                                    // run yet. Shown here, at
                                                    // the moment of choosing,
                                                    // rather than as an error
                                                    // after the first message
                                                    // fails to send.
                                                    if m.key-missing: Text {
                                                        text: "needs key";
                                                        color: #f0a022;
                                                        font-size: 9px;
                                                        vertical-alignment: center;
                                                    }

                                                    // Listed by its provider for
                                                    // your key and newer than
                                                    // anything in Eustress's own
                                                    // table. Its provider is the
                                                    // only thing vouching for
                                                    // it, which this says.
                                                    if m.is-new: Rectangle {
                                                        width: new-tag.preferred-width + 8px;
                                                        height: 13px;
                                                        border-radius: 3px;
                                                        background: Theme.accent-eustress.with-alpha(0.18);

                                                        new-tag := Text {
                                                            width: parent.width;
                                                            height: parent.height;
                                                            text: "NEW";
                                                            color: Theme.accent-eustress;
                                                            font-size: 8px;
                                                            font-weight: 700;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Rectangle { horizontal-stretch: 1; }

                                                    Text {
                                                        text: m.price;
                                                        color: Theme.text-secondary;
                                                        font-size: 9px;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: m.tagline;
                                                    color: Theme.text-secondary;
                                                    font-size: 9px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Gauntlet toggle pill — filled when ON so the extra
                    // token spend is never invisible.
                    Rectangle {
                        width: gauntlet-label.preferred-width + 26px;
                        height: 24px;
                        background: root.gauntlet-enabled
                            ? #f0a02233
                            : (gauntlet-touch.has-hover ? Theme.background-tertiary : transparent);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.gauntlet-enabled ? #f0a022 : Theme.border-color;

                        gauntlet-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.gauntlet-enabled = !root.gauntlet-enabled;
                                root.on-gauntlet-toggled(root.gauntlet-enabled);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            gauntlet-label := Text {
                                text: "⚔ Gauntlet";
                                color: root.gauntlet-enabled ? #f0a022 : Theme.text-secondary;
                                font-size: 10px;
                                font-weight: root.gauntlet-enabled ? 700 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Auto mode pill, sibling to the Gauntlet one.
                    Rectangle {
                        width: auto-label.preferred-width + 26px;
                        height: 24px;
                        background: root.auto-enabled
                            ? Theme.accent-green.with-alpha(0.2)
                            : (auto-touch.has-hover ? Theme.background-tertiary : transparent);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.auto-enabled ? Theme.accent-green : Theme.border-color;

                        auto-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.auto-enabled = !root.auto-enabled;
                                root.on-auto-toggled(root.auto-enabled);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            auto-label := Text {
                                text: "▶ Auto";
                                color: root.auto-enabled ? Theme.accent-green : Theme.text-secondary;
                                font-size: 10px;
                                font-weight: root.auto-enabled ? 700 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Spacer
                    Rectangle { horizontal-stretch: 1; }

                    // Cost warning — only while the expensive mode is live.
                    if root.gauntlet-enabled: Text {
                        text: "verify loop ×4, higher token use";
                        color: #f0a022;
                        font-size: 9px;
                        vertical-alignment: center;
                    }

                    // What is running now lives in the activity strip above
                    // the input, so this corner only shows the tool count.
                    if !root.agent-busy && root.tool-count > 0: Text {
                        text: root.tool-count + " tools";
                        color: Theme.text-secondary;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                }

                // ── Attached image preview strip ──
                if root.has-attached-image: Rectangle {
                    height: 72px;
                    background: Theme.background-tertiary;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-color;
                    clip: true;

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 6px;
                        alignment: start;

                        // Thumbnail
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 4px;
                            clip: true;
                            background: Theme.viewport-background;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.attached-image;
                                image-fit: contain;
                            }
                        }

                        // Label
                        Text {
                            vertical-alignment: center;
                            text: "Image attached";
                            color: Theme.text-secondary;
                            font-size: 10px;
                            horizontal-stretch: 1;
                        }

                        // × clear button
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 10px;
                            background: clear-touch.has-hover ? Theme.accent-red : Theme.button-background;

                            clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.on-clear-image(); }
                            }

                            Image {
                                width: 10px;
                                height: 10px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../../assets/icons/ui/close.svg");
                                image-fit: contain;
                                colorize: white;
                            }
                        }
                    }
                }

                // ── Chat input (multi-line, dynamic height) ──
                //
                // Windsurf / Cursor / ChatGPT convention: the box starts at
                // one line of text and grows as the user adds lines, up to
                // a cap of ~6 lines. Past that, a scrollbar appears and
                // the mouse wheel navigates the text inside. Mouse wheel
                // never leaks to the 3D viewport because the camera
                // controller already skips wheel input when the cursor is
                // over a UI panel (see camera_controller.rs: ui_focus.has_focus).
                HorizontalLayout {
                    spacing: 6px;

                    Rectangle {
                        horizontal-stretch: 1;
                        // Grow-to-fit with a 6-line cap. `input-area.preferred-height`
                        // is the natural height TextInput needs to render all text
                        // without clipping — cheap to read, recomputed automatically
                        // as the user types. We clamp to min=36px (one comfortable
                        // line + padding) and max=132px (six lines + padding);
                        // past that ScrollView kicks in.
                        // (Slint rejects `height` + `min-height` on the same
                        // element, so the floor lives inside the `max(...)`.)
                        height: min(132px, max(36px, input-area.preferred-height + 16px));
                        background: Theme.background-tertiary;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: input-area.has-focus ? Theme.accent-blue : Theme.border-color;
                        clip: true;

                        input-scroll := ScrollView {
                            x: 10px;
                            y: 6px;
                            width: parent.width - 20px;
                            height: parent.height - 12px;
                            // Tell the ScrollView exactly how tall the content is
                            // so its scrollbar + wheel handler activate at the
                            // right threshold. When preferred-height ≤ viewport,
                            // ScrollView hides the bar and behaves as a plain wrap.
                            viewport-width: self.width;
                            viewport-height: max(self.height, input-area.preferred-height);

                            input-area := TextInput {
                                width: parent.width;
                                color: Theme.text-primary;
                                font-size: 12px;
                                text <=> root.input-text;
                                single-line: false;
                                wrap: word-wrap;

                            // Live-edit hook — every keystroke scans back
                            // from the cursor for the most recent `@`. If
                            // one is found within 32 chars and not
                            // followed by whitespace, the popup opens with
                            // the prefix query.
                            edited => {
                                // Slint doesn't expose cursor-position here;
                                // we approximate by scanning from the end
                                // of input-text for the last `@` not
                                // preceded by alphanumerics.
                                // Simple heuristic: split on whitespace,
                                // examine the final token.
                                // Future refinement: expose cursor position
                                // via a custom property.
                                root.update-mention-state();
                            }

                            key-pressed(ev) => {
                                // Enter sends and Shift+Enter starts a new
                                // line. It used to be the other way round,
                                // Ctrl+Enter to send, on the stated premise
                                // that Discord, Slack and ChatGPT work that
                                // way. All three send on Enter, so every habit
                                // carried over from them typed a newline here
                                // instead. Ctrl+Enter still sends.
                                //
                                // With the @ popup open, Enter picks the
                                // highlighted mention instead.
                                if ev.text == Key.Return {
                                    if root.mention-popup-visible && root.mention-items.length > 0 {
                                        root.on-mention-commit(root.mention-selected-index);
                                        return accept;
                                    }
                                    if ev.modifiers.shift {
                                        return reject;
                                    }
                                    root.send-input();
                                    return accept;
                                }
                                // Ctrl+V — if clipboard contains an image,
                                // Rust intercepts via on-attach-image and
                                // sets has-attached-image + attached-image.
                                // We fire the callback and let Rust decide
                                // whether it's text (handled natively by
                                // TextInput) or an image (handled by Rust).
                                if ev.text == "v" && ev.modifiers.control {
                                    root.on-attach-image();
                                    // Don't return accept — text paste still
                                    // works via TextInput's built-in handling.
                                }
                                // Intercept nav keys only when popup is open.
                                if root.mention-popup-visible {
                                    if ev.text == Key.UpArrow {
                                        if root.mention-selected-index > 0 {
                                            root.mention-selected-index -= 1;
                                        }
                                        return accept;
                                    }
                                    if ev.text == Key.DownArrow {
                                        if root.mention-selected-index < root.mention-items.length - 1 {
                                            root.mention-selected-index += 1;
                                        }
                                        return accept;
                                    }
                                    if ev.text == Key.Escape {
                                        root.mention-popup-visible = false;
                                        root.on-mention-cancel();
                                        return accept;
                                    }
                                    if ev.text == Key.Tab {
                                        if root.mention-items.length > 0 {
                                            root.on-mention-commit(root.mention-selected-index);
                                        }
                                        return accept;
                                    }
                                }
                                // Up in an empty box brings back your last
                                // message, to fix a typo or ask again.
                                if ev.text == Key.UpArrow && root.input-text == "" && root.last-prompt != "" {
                                    root.input-text = root.last-prompt;
                                    return accept;
                                }
                                // Escape stops a running turn, the same as the
                                // Stop button.
                                if ev.text == Key.Escape && root.agent-busy {
                                    root.on-stop-agent();
                                    return accept;
                                }
                                return reject;
                            }
                        } // close TextInput (input-area)
                        } // close ScrollView (input-scroll)

                        // Placeholder. TextInput has none of its own, so this
                        // sits over it while the box is empty. Text takes no
                        // pointer events, so clicks still reach the input. It
                        // changes with the moment, because what typing does
                        // changes too: while Workshop works a message queues,
                        // and while an approval waits it redirects.
                        if root.input-text == "": Text {
                            // Same origin as `input-scroll`, so the hint sits
                            // exactly where the first typed character will.
                            x: input-scroll.x;
                            y: input-scroll.y;
                            width: input-scroll.width;
                            text: root.pending-approvals > 0 ? "Reply to skip and redirect, or approve above"
                                : root.agent-busy ? "Type to queue a message for when Workshop finishes"
                                : "Ask Workshop to build, script or simulate";
                            color: Theme.text-disabled;
                            font-size: 12px;
                            overflow: elide;
                        }
                    } // close outer Rectangle (input container)

                    // Send button (arrow-up icon). Bottom-pinned to the
                    // layout so the icon stays aligned with the first
                    // line of the input even as the box grows taller.
                    // 2px inset from the bottom keeps the arrow's visual
                    // centre on the text baseline.
                    //
                    // While Workshop works and the box is empty, this is Stop.
                    // With text in the box it sends, which queues the message
                    // if a turn is still running. An image alone is a valid
                    // message ("what is wrong with this?"); the host always
                    // accepted one, but this button used to stay disabled
                    // until you typed something.
                    send-btn := Rectangle {
                        property <bool> can-send: root.input-text != "" || root.has-attached-image;
                        property <bool> is-stop: root.agent-busy && !self.can-send;

                        width: 36px;
                        height: 36px;
                        y: parent.height - self.height - 2px;
                        background: self.is-stop
                            ? (send-touch.has-hover ? Theme.accent-red : Theme.accent-red.with-alpha(0.75))
                            : self.can-send
                                ? (send-touch.has-hover ? Theme.accent-green : Theme.button-primary)
                                : Theme.button-background;
                        border-radius: 8px;

                        send-touch := TouchArea {
                            mouse-cursor: send-btn.is-stop || send-btn.can-send ? pointer : default;
                            enabled: send-btn.is-stop || send-btn.can-send;
                            clicked => {
                                if send-btn.is-stop {
                                    root.on-stop-agent();
                                } else {
                                    root.send-input();
                                }
                            }
                        }

                        if send-btn.is-stop: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 11px;
                            height: 11px;
                            border-radius: 2px;
                            background: white;
                        }

                        // Icon centred inside the button with explicit
                        // x/y math — `horizontal-alignment`/`vertical-alignment`
                        // defaults can leave Image floating when its
                        // parent dimensions change at runtime. The
                        // arithmetic below keeps the glyph pixel-perfect
                        // regardless of button size.
                        if !send-btn.is-stop: Image {
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../assets/icons/ui/send.svg");
                            image-fit: contain;
                            colorize: send-btn.can-send ? white : Theme.text-disabled;
                        }
                    }
                }
            }
        }
    }

    // ── @ Mention Popup overlay ──────────────────────────────────────────
    // Floats above the input area. Anchored bottom-right of the chat so
    // it opens upward from the input. Host (Bevy) toggles visibility via
    // `mention-popup-visible` in response to the user typing `@`.
    if root.mention-popup-visible: Rectangle {
        // Position: centered on the chat, aligned with the input. Sits
        // just above the input area (~70px offset) so it doesn't
        // obscure what the user is typing. Height matches the popup's
        // own min(28 + 320, 348) budget when the list is long.
        x: (parent.width - 360px) / 2;
        y: parent.height - 120px - self.height;
        width: 360px;
        height: root.mention-items.length > 0
            ? min(28px + min(root.mention-items.length * 42px + 8px, 320px), 348px)
            : 68px;

        // Eat wheel events that hit the popup's outer rectangle (the
        // few pixels around the rounded border). Without this, scroll
        // past the corners falls through to the 3D viewport and zooms
        // the camera. Inner ScrollView handles wheel within the list.
        TouchArea {
            scroll-event(event) => { accept }
        }

        MentionPopup {
            items: root.mention-items;
            selected-index: root.mention-selected-index;
            show-recent-header: root.mention-query == "";
            title: root.mention-query == "" ? "Mentions" : "@" + root.mention-query;
            on-select(i) => { root.on-mention-commit(i); }
        }
    }

    // ── Conversation History Modal ──
    if root.show-history-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.modal-backdrop;

        TouchArea {
            clicked => { root.show-history-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 500px);
            height: min(parent.height - 60px, 450px);
            background: Theme.panel-background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-color;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;

            // Absorb clicks on the modal itself
            TouchArea {
                scroll-event(event) => { return accept; }
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Modal header
                Rectangle {
                    height: 44px;
                    background: Theme.header-background;
                    border-top-left-radius: 10px;
                    border-top-right-radius: 10px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;

                        Text {
                            text: "Conversations";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // Close button — matches the red-hover convention
                        // used by every other × in the Workshop (tab close,
                        // mention-popup close, etc.): dark-red background
                        // + bright-red glyph on hover.
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: hist-close-touch.has-hover ? Theme.accent-red.with-alpha(0.25) : transparent;
                            y: (parent.height - self.height) / 2;

                            hist-close-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-history-modal = false; }
                            }

                            Image {
                                width: 12px;
                                height: 12px;
                                source: @image-url("../../assets/icons/ui/close.svg");
                                image-fit: contain;
                                colorize: hist-close-touch.has-hover ? Theme.accent-red : Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Search bar
                Rectangle {
                    height: 36px;
                    background: Theme.header-background;

                    HorizontalLayout {
                        padding: 6px;
                        padding-left: 16px;
                        padding-right: 16px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: Theme.input-background;
                            border-width: 1px;
                            border-color: Theme.input-border;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                // `alignment: start` pins the icon to the
                                // left edge so it reads as a search prefix,
                                // not a centered decoration. The input still
                                // `horizontal-stretch: 1` and fills the rest.
                                alignment: start;

                                // Wrap the 14x14 icon in a Rectangle sized to
                                // the row height and center the Image inside.
                                // HorizontalLayout stretches children to fill
                                // height, so a bare Image with `vertical-
                                // alignment: center` drew the tiny glyph at
                                // the top-left of a stretched 14x34 cell.
                                Rectangle {
                                    width: 14px;
                                    height: parent.height;
                                    background: transparent;

                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        x: 0px;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../../assets/icons/ui/search.svg");
                                        image-fit: contain;
                                        colorize: Theme.text-secondary;
                                    }
                                }

                                hist-search-input := TextInput {
                                    font-size: 12px;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                    single-line: true;
                                    vertical-alignment: center;
                                    text <=> root.history-search;
                                }
                            }
                        }
                    }
                }

                // Separator
                Rectangle { height: 1px; background: Theme.border-color; }

                // Conversation list
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        for conv in root.past-conversations: Rectangle {
                            height: 64px;
                            border-radius: 6px;
                            background: conv-touch.has-hover ? Theme.button-hover : Theme.background-tertiary;

                            conv-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.on-load-conversation(conv.session-id);
                                    root.show-history-modal = false;
                                }
                            }

                            VerticalLayout {
                                padding: 10px;
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 4px;

                                // Title row: name + date
                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: conv.title != "" ? conv.title : "New Conversation";
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: conv.last-active;
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Preview + metadata
                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: conv.preview;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: conv.message-count + " msgs";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }

                                    if conv.cost != "$0.00": Text {
                                        text: conv.cost;
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.past-conversations.length == 0: Rectangle {
                            height: 60px;

                            Text {
                                text: "No past conversations";
                                color: Theme.text-secondary;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
