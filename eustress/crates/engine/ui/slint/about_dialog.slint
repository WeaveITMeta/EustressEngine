// ============================================================================
// About Eustress Engine: a simple identity card. Version, build info, links.
// Opened from the Help menu via the help:about action.
// Law 1 chrome: DialogScrim > DialogCard > DialogFooter (dialog_kit.slint).
// Escape or Enter closes.
// ============================================================================

import { Theme } from "theme.slint";
import { DialogScrim, DialogCard, DialogFooter, KitButton, KitDivider, KitSectionLabel } from "dialog_kit.slint";

// One outbound link: icon, name, the address, and an arrow. The whole row
// is the hit target; hover marks it in the selection cyan.
component LinkRow inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <string> url: "";
    callback open-url(string);

    height: 34px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.button-hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Image {
                width: 14px;
                height: 14px;
                source: root.icon;
                image-fit: contain;
                colorize: ta.has-hover ? Theme.accent-cyan : Theme.text-secondary;
            }
        }
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.url;
            color: ta.has-hover ? Theme.accent-cyan : Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Image {
                width: 12px;
                height: 12px;
                source: @image-url("../../assets/icons/ui/arrow-right.svg");
                image-fit: contain;
                colorize: ta.has-hover ? Theme.accent-cyan : Theme.text-disabled;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-url(root.url); }
    }
}

export component AboutDialog inherits Rectangle {
    in property <string> version: "";
    in property <string> commit: "";
    in property <string> build-date: "";
    callback open-url(string);
    callback on-close();

    width: 100%;
    height: 100%;

    DialogScrim {
        dismiss => { root.on-close(); }

        card := DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(440px, parent.width - 32px);
            height: min(card.preferred-height, parent.height - 32px);
            icon: @image-url("../../assets/icons/ui/sparkle.svg");
            title: "About Eustress Engine";
            subtitle: root.version != "" ? "Version " + root.version : "";
            close => { root.on-close(); }

            keys := FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Return {
                        root.on-close();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 20px;
                        padding-bottom: 16px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Eustress Engine";
                            color: Theme.text-primary;
                            font-size: Theme.font-xxl;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Version " + root.version;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }

                        if root.commit != "": Text {
                            text: "Build " + root.commit + (root.build-date != "" ? " • " + root.build-date : "");
                            color: Theme.text-disabled;
                            font-size: Theme.font-xs;
                            font-family: "Consolas";
                            horizontal-alignment: center;
                        }

                        Rectangle { height: 6px; }

                        Text {
                            text: "The AI-native orchestrator: Soul Scripts, Workshop AI and live world modeling on a Rust core.";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Rectangle { height: 10px; }

                        HorizontalLayout {
                            padding-left: 2px;
                            KitSectionLabel { text: "LINKS"; }
                        }

                        Rectangle {
                            background: Theme.background-secondary.with-alpha(0.6);
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-color;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 0;

                                LinkRow {
                                    icon: @image-url("../../assets/icons/ui/web.svg");
                                    label: "Website";
                                    url: "https://eustress.dev";
                                    open-url(u) => { root.open-url(u); }
                                }
                                KitDivider { }
                                LinkRow {
                                    icon: @image-url("../../assets/icons/ui/link.svg");
                                    label: "GitHub";
                                    url: "https://github.com/eustressengine/eustress";
                                    open-url(u) => { root.open-url(u); }
                                }
                                KitDivider { }
                                LinkRow {
                                    icon: @image-url("../../assets/icons/ui/users.svg");
                                    label: "Discord";
                                    url: "https://discord.gg/DGP9my8DYN";
                                    open-url(u) => { root.open-url(u); }
                                }
                            }
                        }

                        Rectangle { height: 6px; }

                        Text {
                            text: "© Anthropic-assisted. Built by humans who care.";
                            color: Theme.text-disabled;
                            font-size: Theme.font-xs;
                            horizontal-alignment: center;
                        }
                    }

                    DialogFooter {
                        KitButton {
                            text: "Close";
                            kind: "primary";
                            clicked => { root.on-close(); }
                        }
                    }
                }
            }
        }
    }
}
